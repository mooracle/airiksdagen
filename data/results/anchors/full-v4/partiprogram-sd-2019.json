 "84CE3F65-4701-4624-A16D-7221D97EB2B6", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "KU", "datum": "2023-10-25", "svag": false}]}, {"quote": "Brottsoffers och potentiella brottsoffers intressen måste i alla lägen sättas framför brottslingars", "block_id": "b0248", "offset": 0, "length": 99, "refs": [{"votering_id": "54E73DD8-4FFB-4237-826F-831F162B00BD", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "JuU", "datum": "2023-04-19", "svag": false}, {"votering_id": "56BC26E7-6F59-47F8-891A-8AC8DCF4AF89", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "JuU", "datum": "2023-04-19", "svag": false}]}, {"quote": "lagöverträdelser bestraffas snabbt och konsekvent", "block_id": "b0250", "offset": 117, "length": 49, "refs": [{"votering_id": "63631F8C-E259-4E2C-8F1E-C4045208F89A", "parti": "SD", "verdict": "kept", "tier": "off_axis", "utskott": "JuU", "datum": "2023-04-19", "svag": false}]}, {"quote": "Att medborgare skall vara lika inför lagen", "block_id": "b0250", "offset": 234, "length": 42, "refs": [{"votering_id": "627B4EDE-3B0E-4873-83F1-B5FE5E4D785F", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "KU", "datum": "2023-05-10", "svag": false}]}, {"quote": "Att medborgare skall vara lika inför lagen är en av rättsstatens", "block_id": "b0250", "offset": 234, "length": 64, "refs": [{"votering_id": "204F8DA6-EAF4-4F15-B8A6-B66BB25B9D1E", "parti": "SD", "verdict": "kept", "tier": "off_axis", "utskott": "JuU", "datum": "2023-06-20", "svag": false}]}, {"quote": "Polisen, gränsskyddet och de rättsvårdande myndigheterna måste tilldelas erforderliga resurser", "block_id": "b0251", "offset": 0, "length": 94, "refs": [{"votering_id": "D2E07CAC-C0EC-4BDC-AAF9-18049D6CC163", "parti": "SD", "verdict": "avstar", "tier": "explicit", "utskott": "JuU", "datum": "2023-05-03", "svag": false}, {"votering_id": "A599378A-BD1C-40C7-8D92-9A2B78F51CB3", "parti": "SD", "verdict": "kept", "tier": "explicit", "utskott": "JuU", "datum": "2023-06-07", "svag": false}, {"votering_id": "70ACCF25-BF8A-426A-8254-3D021202E4E0", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "JuU", "datum": "2023-09-13", "svag": false}]}, {"quote": "Sverigedemokraterna ser det militära försvaret som den yttersta garanten för bevarandet av vår", "block_id": "b0253", "offset": 0, "length": 94, "refs": [{"votering_id": "5F51A0CE-E352-4F7F-A3EE-F118AFA53FEF", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "JuU", "datum": "2023-05-31", "svag": false}]}, {"quote": "Den som åtnjuter ett lands frihet skall också vara beredd att försvara denna frihet.", "block_id": "b0255", "offset": 0, "length": 84, "refs": [{"votering_id": "B1FBAABA-1FD4-4CA3-BEBD-A644657310C4", "parti": "SD", "verdict": "diverged", "tier": "explicit", "utskott": "FöU", "datum": "2023-05-03", "svag": false}]}, {"quote": "Sverigedemokraterna är öppna för möjligheten att skapa en nordisk försvarsallians.", "block_id": "b0256", "offset": 0, "length": 82, "refs": [{"votering_id": "6B63ADBF-B6F8-4CE0-A574-230BEE238A46", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "UU", "datum": "2023-03-22", "svag": false}]}, {"quote": "Under överskådlig framtid kommer kärnkraften och vattenkraften att utgöra grundstommen i Sveriges", "block_id": "b0261", "offset": 0, "length": 97, "refs": [{"votering_id": "A8FF4A97-6AB2-445E-BA8F-9C2E1D23B3C5", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "NU", "datum": "2023-05-31", "svag": false}]}, {"quote": "nationalälvar ska bevaras från vidare vattenkraftsutbyggnad", "block_id": "b0261", "offset": 195, "length": 59, "refs": [{"votering_id": "8FCC61C4-2135-4E20-9BA7-73C182D45446", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "CU", "datum": "2023-05-10", "svag": false}, {"votering_id": "A8FF4A97-6AB2-445E-BA8F-9C2E1D23B3C5", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "NU", "datum": "2023-05-31", "svag": false}]}, {"quote": "Under utvecklingstiden och framtagandet av nya energisystem måste vi acceptera att vi använder", "block_id": "b0262", "offset": 0, "length": 94, "refs": [{"votering_id": "8C23BC3D-D1F0-4857-92AC-688CE5705CBE", "parti": "SD", "verdict": "kept", "tier": "off_axis", "utskott": "NU", "datum": "2023-05-31", "svag": false}]}, {"quote": "Försiktighetsprincipen är således central inom Sverigedemokraternas miljöpolitik", "block_id": "b0267", "offset": 208, "length": 80, "refs": [{"votering_id": "1D3F3FD3-1274-44AE-AD04-BE95A12BF5C2", "parti": "SD", "verdict": "kept", "tier": "off_axis", "utskott": "MJU", "datum": "2023-03-15", "svag": false}, {"votering_id": "53DAA907-E6A0-4CBC-ADE6-90E9FF3D8A67", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "MJU", "datum": "2023-03-15", "svag": false}, {"votering_id": "D2D39CC7-B661-4F78-92CC-F49295744CD9", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "MJU", "datum": "2023-03-15", "svag": false}, {"votering_id": "66A307FE-0BAB-41C3-B37D-BE27F97A77E3", "parti": "SD", "verdict": "kept", "tier": "off_axis", "utskott": "KrU", "datum": "2023-04-26", "svag": false}, {"votering_id": "03ECBEF1-07A4-4FA2-96F3-E72CE571F971", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "MJU", "datum": "2023-05-11", "svag": false}, {"votering_id": "B5720215-CFAD-4288-B6B7-6FB731DEEADA", "parti": "SD", "verdict": "avstar", "tier": "extrapolated", "utskott": "MJU", "datum": "2023-05-11", "svag": false}, {"votering_id": "816D505C-56DD-48F6-B164-666DAB03E25D", "parti": "SD", "verdict": "diverged", "tier": "extrapolated", "utskott": "KU", "datum": "2023-05-31", "svag": false}]}, {"quote": "positiva incitament till omställning mot ett mer hållbart levnadssätt", "block_id": "b0269", "offset": 104, "length": 69, "refs": [{"votering_id": "95D20ECF-956F-4366-8673-CE4CCC33747D", "parti": "SD", "verdict": "avstar", "tier": "off_axis", "utskott": "NU", "datum": "2023-05-11", "svag": false}]}, {"quote": "miljöförstörande verksamhet också tvingas kompensera för den skada de åsamkar.", "block_id": "b0270", "offset": 299, "length": 78, "refs": [{"votering_id": "4D6268A8-A4D7-4300-B868-226EEA083741", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "UU", "datum": "2023-06-20", "svag": false}]}, {"quote": "Vi inser också att de miljöpolitiska intressena ständigt måste vägas mot andra viktiga samhällsvärden,", "block_id": "b0271", "offset": 0, "length": 102, "refs": [{"votering_id": "B18E40DA-3D21-4D74-BAB9-4C1D56C64C6D", "parti": "SD", "verdict": "kept", "tier": "off_axis", "utskott": "MJU", "datum": "2023-06-07", "svag": false}]}, {"quote": "att merparten av miljöproblemen är av global karaktär, att Sverige inte ensamt kan lösa problemen", "block_id": "b0271", "offset": 103, "length": 97, "refs": [{"votering_id": "D475FBF9-C60A-4C65-8280-F90C6EACF5D9", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "MJU", "datum": "2023-03-15", "svag": false}]}, {"quote": "Vi ser omsorgen om djuren som ett mått på hur utvecklat ett samhälle är", "block_id": "b0272", "offset": 0, "length": 71, "refs": [{"votering_id": "412D3D43-3125-4B5C-8CD3-F0FF853E783C", "parti": "SD", "verdict": "kept", "tier": "extrapolated", "utskott": "MJU", "datum": "2023-03-23", "svag": false}]}, {"quote": "Vi ser omsorgen om djuren som ett mått på hur utvecklat ett samhälle är och strävar efter ett samhälle", "block_id": "b0272", "offset": 0, "length": 102, "refs": [{"votering_id": "CC3EA3D5-4422-4CC4-BD04-D5279C3609E8", "parti": "SD", "verdict": "avstar", "tier": "explicit", "utskott": "UbU", "datum": "2023-06-14", "svag": false}]}, {"quote": "dem ges en global plattform. Särskilt viktigt är detta då det är fråga om miljöhot, väpnade konflikter", "block_id": "b0275", "offset": 288, "length": 102, "refs": [{"votering_id": "4D6268A8-A4D7-4300-B868-226EEA083741", "parti": "SD", "verdict": "diverged", "tier": "off_axis", "utskott": "UU", "datum": "2023-06-20", "svag": false}]}, {"quote": "Vi ser med stark skepsis på samarbeten som tar sig", "block_id": "b0277", "offset": 445, "length": 50, "refs": [{"votering_id": "5B3BEC7C-A14E-46A3-9717-04E7343CD3C8", "parti": "SD", "verdict": "avstar", "tier": "off_axis", "utskott": "SoU", "datum": "2023-06-14", "svag": false}]}, {"quote": "Ingen stat eller nation har rätt kränka eller förslava något annat folk.", "block_id": "b0279", "offset": 213, "length": 72, "refs": [{"votering_id": "A791FC28-E6F3-4034-968E-58C84F1C9F5C", "parti": "SD", "verdict": "diverged", "tier": "extrapolated", "utskott": "UU", "datum": "2023-04-26", "svag": false}]}, {"quote": "folk som med obestridlig historisk rätt till sitt territorium och stöd i folkrätten strävar efter ökad autonomi", "block_id": "b0279", "offset": 301, "length": 111, "refs": [{"votering_id": "240AB337-C38F-42A6-B325-5EA02B71544C", "parti": "SD", "verdict": "avstar", "tier": "off_axis", "utskott": "KU", "datum": "2023-04-26", "svag": false}, {"votering_id": "A791FC28-E6F3-4034-968E-58C84F1C9F5C", "parti": "SD", "verdict": "diverged", "tier": "extrapolated", "utskott": "UU", "datum": "2023-04-26", "svag": false}]}]}