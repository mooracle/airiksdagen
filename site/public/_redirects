# Method / Documents-index / Data were merged into one About page (/om/, /en/about/).
# Exact-path rules only, so the /dokument/[slug] & /documents/[slug] detail pages are untouched.
/metod/            /om/#metod        301
/dokument/         /om/#dokument     301
/data/             /om/#data         301
/en/methodology/   /en/about/#metod  301
/en/documents/     /en/about/#dokument 301
/en/data/          /en/about/#data   301

# Koalition merged into the Parties page; the individual votes moved to each
# party's own page. Both were in the nav and are indexed, so they redirect
# rather than 404.
/koalition/        /parti/#koalition    301
/en/coalition/     /en/parties/#koalition 301
