---
import Base from '../layouts/Base.astro';
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, getIndex, getAggregate } from '../lib/data';
import { agreementColor } from '../lib/scale';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();
const index = getIndex();
const summary = getAggregate<{
  overall_agreement: number;
  n_decisions: number;
  per_party: Record<string, { n: number; agreement: number; kappa: number | null }>;
}>('summary');
/**
 * Plan-vs-behaviour gap (p6 runs only; null on the older vote-matching runs).
 * `headline` is deliberately the EXPLICIT evidence tier alone — the subset where
 * the party's plan spoke to what the vote turned on. The wider tiers are shown
 * beside it as context and never folded into the headline number.
 */
interface GapData {
  n_decisions: number;
  tiers: Record<string, number>;
  headline: { n: number; gap: number; gap_rate: number | null };
  per_party: Record<string, {
    n_decisions: number;
    tiers: Record<string, number>;
    explicit: { n: number; gap: number; gap_rate: number | null };
  }>;
  stance_skew: { unanimous_stodjer: number; n_cases_all_parties: number };
}
const gap = getAggregate<GapData>('gap');
const browserBase = localePath(lang, '/fall/');
const partyOrder = meta.hemicycle_order;

// timeline: per-month case counts + agreement for the navigator
const monthStats = new Map<string, { n: number; agree: number; compared: number }>();
for (const row of index) {
  const m = row.datum.slice(0, 7);
  const acc = monthStats.get(m) ?? { n: 0, agree: 0, compared: 0 };
  acc.n += 1;
  if (row.hasAi) {
    acc.agree += row.agree;
    acc.compared += row.compared;
  }
  monthStats.set(m, acc);
}
// every month that actually held a division, oldest first
const timelineMonths = [...monthStats.keys()].sort();
// Same diverging scale as the co-voting matrix, so the two heatmaps on the site
// read against one another. Months with no AI coverage yet get no fill at all
// rather than a grey one: on the old vivid ramp a flat grey was obviously "not a
// value", but against a scale whose midpoint is deliberately a pale neutral, a
// grey cell would read as "middling" instead of "nothing here".
const monthColor = (m: string) => {
  const s = monthStats.get(m)!;
  return s.compared ? agreementColor(s.agree / s.compared) : null;
};

/**
 * Evidence tiers, strongest first. These were three bare numbers in a row of
 * running text; as parts of one whole they belong in a proportional bar, so the
 * shape of the corpus (a minority explicit, a large majority off-axis) is
 * visible rather than something the reader has to compute.
 * Ramped from gold — strength of evidence, not category.
 */
const TIERS = [
  { key: 'explicit', color: '#c8961f', label: 'tier.explicit', tip: 'tier.explicitTip' },
  { key: 'extrapolated', color: '#e2c079', label: 'tier.extrapolated', tip: 'tier.extrapolatedTip' },
  { key: 'off_axis', color: '#e6e1d2', label: 'tier.off_axis', tip: 'tier.off_axisTip' },
] as const;
const tierTotal = gap ? Math.max(1, TIERS.reduce((n, tier) => n + gap.tiers[tier.key], 0)) : 1;
---

<Base lang={lang} description={t('home.intro')} path="/">
  {/* Opening band: the claim on the left, the headline figure on the right, and
      the chamber bled off the corner behind them. */}
  <section slot="hero" class="masthead">
    <img class="mh-mark" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logomark.svg`}
         alt="" aria-hidden="true" width="100" height="52" />
    <div class="mh-wrap">
      <div>
        <p class="eyebrow">{t('home.kicker')}</p>
        <h1>{t('site.tagline')}</h1>
        <p class="lede">{t('home.intro')}</p>
        <p class="disclaimer">{t('home.disclaimer')}</p>
      </div>
      {gap && gap.headline.gap_rate !== null ? (
        <div class="mh-stat">
          <div class="stat">
            <span class="num">{(gap.headline.gap_rate * 100).toFixed(0)}%</span>
            <span class="lbl">{t('home.gapHeadline')}</span>
            <span class="meta">n = {gap.headline.n}</span>
          </div>
          <hr />
          <p class="eyebrow" style="margin:0 0 0.5rem">{t('home.tiers')}</p>
          <div class="tierbar">
            {TIERS.map((tier) => (
              <span
                style={`width:${((gap.tiers[tier.key] / tierTotal) * 100).toFixed(2)}%;background:${tier.color}`}
                title={`${t(tier.label)}: ${gap.tiers[tier.key]}`}
              />
            ))}
          </div>
          <ul class="tierkeys">
            {TIERS.map((tier) => (
              <li title={t(tier.tip)}>
                <span class="sw" style={`background:${tier.color}`} />
                <span><b>{gap.tiers[tier.key]}</b> {t(tier.label)}</span>
              </li>
            ))}
          </ul>
        </div>
      ) : summary && (
        <div class="mh-stat">
          <div class="stat">
            <span class="num">{((1 - summary.overall_agreement) * 100).toFixed(1)}%</span>
            <span class="lbl">{t('home.driftHeadline')}</span>
            <span class="meta">n = {summary.n_decisions}</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <div class="audience">
    <a class="card apath" href={`${browserBase}?d=1`}>
      <span class="chip">{t('home.forJournalists')}</span>
      <strong>{t('home.forJournalistsTitle')}</strong>
      <p class="muted">{t('home.forJournalistsText')}</p>
    </a>
    <a class="card apath" href={`${localePath(lang, '/om/')}#metod`}>
      <span class="chip">{t('home.forResearchers')}</span>
      <strong>{t('home.forResearchersTitle')}</strong>
      <p class="muted">{t('home.forResearchersText')}</p>
    </a>
    <a class="card apath" href={browserBase}>
      <span class="chip">{t('home.forEveryone')}</span>
      <strong>{t('home.forEveryoneTitle')}</strong>
      <p class="muted">{t('home.forEveryoneText')}</p>
    </a>
  </div>

  {/* The one per-party block on the page, in the slot the monthly trend chart
      used to hold. That chart drew nine series over 45 months in 240px and was
      unreadable at any width; everything it actually said — how far each party's
      documented position sits from its floor record — is one bar per party.

      Two tabs because the corpus grades its own evidence and the two grades tell
      different stories: across ALL decisions the agent reads a stance for, S sits
      at 45%, but on the subset where its plan stated the commitment outright it
      sits at 25%. Showing only one would either overstate the case (all tiers
      includes decisions the plan never addressed) or hide most of the record.

      Radios, not scripted tabs: the page is static and this way the control is
      keyboard-operable and works before — and without — any JS. */}
  {gap && (
    <>
      <p class="eyebrow">{t('home.secParties')}</p>
      <h2>{t('home.gapByParty')}</h2>
      <div class="gaptabs">
        {/* Inputs sit here, not inside .tabbar, so that each panel is a *sibling*
            of the radio that reveals it — `:checked ~ .tp-…` cannot reach into
            another element. The labels stay grouped in .tabbar for layout. */}
        <input type="radio" name="gaptab" id="gt-explicit" checked />
        <input type="radio" name="gaptab" id="gt-all" />
        <div class="tabbar" role="group" aria-label={t('home.gapByParty')}>
          <label for="gt-explicit">{t('home.tabExplicit')}</label>
          <label for="gt-all">{t('home.tabAll')}</label>
        </div>

        {(['explicit', 'all_tiers'] as const).map((tier) => {
          const rows = partyOrder
            .filter((code) => gap.per_party[code]?.[tier].gap_rate !== null)
            .sort((a, b) => gap.per_party[b][tier].gap_rate! - gap.per_party[a][tier].gap_rate!);
          return (
            <div class={`tabpanel tp-${tier}`}>
              {/* The sentence the bars answer, above the bars. It replaces the
                  column headers this table used to carry: three figures per row,
                  two of them percentages measuring different things, needed a
                  key to read — which is the opposite of what a front page can
                  ask of anyone. */}
              <p class="gaplead">{t(tier === 'explicit' ? 'home.gapLead' : 'home.gapLeadAll')}</p>
              <figure class="fig card">
                {rows.map((code) => {
                  const e = gap.per_party[code][tier];
                  const pctText = `${(e.gap_rate! * 100).toFixed(0)}%`;
                  return (
                    <a class="prow" href={localePath(lang, `/parti/${code.toLowerCase()}/`)}
                       title={`${meta.parties[code]?.name}: ${e.gap} ${t('home.rowOf')} ${e.n}`}>
                      {/* Spelled out, not just the two-letter disc: a reader
                          arriving on the front page has not learned the codes
                          yet, and this is the first table they meet. */}
                      <span class="pr-name">
                        <PartyBadge code={code} parties={meta.parties} label="none" size={19} />
                        <span>{meta.parties[code]?.name}</span>
                      </span>
                      <span class="bar"><span style={`width:${(e.gap_rate! * 100).toFixed(1)}%;background:${meta.parties[code]?.color}`} /></span>
                      <span class="pr-pct">{pctText}</span>
                      {/* the count stays, in words rather than as a ratio — it is
                          what the percentage rests on, not a second measurement */}
                      <span class="pr-n muted">{e.gap} {t('home.rowOf')} {e.n}</span>
                    </a>
                  );
                })}
              </figure>
            </div>
          );
        })}
      </div>
    </>
  )}

  <p class="eyebrow">{t('home.secBrowse')}</p>
  <h2>{t('home.timeline')}</h2>
  <div class="card">
    <div class="timeline">
      {timelineMonths.map((m) => {
        const s = monthStats.get(m)!;
        const fill = monthColor(m);
        return (
          <a
            class="tcell"
            href={`${browserBase}?m=${m}`}
            data-empty={fill ? undefined : 'true'}
            style={fill ? `background:${fill}` : undefined}
            title={`${m}: ${s.n} ${t('home.cases')}${s.compared ? ` · ${s.agree}/${s.compared} ✓` : ''}`}
          >
            <span class="tm">{m.slice(2).replace('-', '/')}</span>
            <span class="tn">{s.n}</span>
          </a>
        );
      })}
    </div>
    <p class="muted" style="font-size:0.85rem;margin-bottom:0">{t('home.timelineNote')}</p>
  </div>

  <form class="searchrow" action={browserBase} method="get">
    <label class="srch-lbl" for="home-q">{t('home.search')}</label>
    <div class="srch-row">
      <input id="home-q" type="search" name="q" placeholder={t('browser.search')} />
      <button class="btn" type="submit">{t('home.searchBtn')}</button>
    </div>
    <a class="srch-all" href={browserBase}>{t('browser.title')} ({meta.n_cases}) →</a>
  </form>

  {/* p6 only: the divergence that the plan actually documents, party by party.
      Ordered left→right on the hemicycle so the government/opposition split in
      the numbers reads spatially rather than needing to be spelled out. */}
  
  <style>
    /* The three audience doors sit half-overlapping the masthead, so the band
       and the page below read as one composition rather than two stacked slabs. */
    .audience {
      display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      margin: -2.2rem 0 0.5rem; position: relative; z-index: 2;
    }
    .apath {
      text-decoration: none; color: inherit; display: block; margin: 0;
      box-shadow: var(--shadow);
    }
    .apath:hover { border-color: var(--accent); }
    .apath strong { display: block; margin: 0.5rem 0 0.25rem; font-size: 1.05rem; }
    .apath p { margin: 0; font-size: 0.88rem; }
    @media (max-width: 860px) { .audience { margin-top: 1.2rem; } }

    /* ── tabbed per-party panels ─────────────────────────────────────────
       CSS-only: the radio that owns the tab shows its panel via a sibling
       selector. The inputs are visually hidden but still focusable, so the pair
       behaves like the radio group it is — arrow keys move between tabs. */
    /* positioned so the visually-hidden radios below anchor here rather than to
       the page — otherwise focusing one can scroll the viewport somewhere odd */
    .gaptabs { margin-top: 0.9rem; position: relative; }
    .gaptabs > input {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .tabbar { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .tabbar label {
      display: inline-flex; align-items: center; height: 2.35rem; padding: 0 0.95rem;
      border: 1px solid var(--line); border-radius: 999px; background: var(--panel);
      font-size: 0.88rem; font-weight: 600; color: var(--ink-2); cursor: pointer;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .tabbar label:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
    #gt-explicit:checked ~ .tabbar label[for='gt-explicit'],
    #gt-all:checked ~ .tabbar label[for='gt-all'] {
      background: var(--accent); border-color: var(--accent); color: #fff;
    }
    #gt-explicit:focus-visible ~ .tabbar label[for='gt-explicit'],
    #gt-all:focus-visible ~ .tabbar label[for='gt-all'] {
      outline: 2.5px solid var(--accent); outline-offset: 2px;
    }
    .tabpanel { display: none; }
    #gt-explicit:checked ~ .tp-explicit,
    #gt-all:checked ~ .tp-all_tiers { display: block; }

    /* the question the bars answer, in a full sentence, directly above them */
    .gaplead { margin: 0.9rem 0 0.5rem; color: var(--ink-2); max-width: 62ch; }

    /* One bar per party, and exactly one number to read. A row is a link to that
       party's page. */
    .prow {
      display: grid; grid-template-columns: 13rem minmax(0, 1fr) 3.4rem 7rem;
      align-items: center; gap: 0.9rem; padding: 0.5rem 0.35rem;
      text-decoration: none; color: inherit; border-radius: 6px;
    }
    .prow:hover { background: var(--panel-2); }
    .prow .pr-name { display: inline-flex; align-items: center; gap: 0.5rem; min-width: 0; }
    .prow .pr-name > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .prow .bar { display: block; height: 10px; border-radius: 999px; background: #ebe8df; overflow: hidden; }
    .prow .bar > span { display: block; height: 100%; border-radius: 999px; }
    /* the one figure that carries the row */
    .prow .pr-pct { text-align: right; font-weight: 700; font-size: 1.05rem; font-variant-numeric: tabular-nums; }
    .prow .pr-n { text-align: right; font-size: 0.8rem; font-variant-numeric: tabular-nums; }

    @media (max-width: 760px) {
      /* name and figure on one line, the bar and its count beneath — the name
         column cannot shrink below its own text and the bar cannot shrink below
         being a bar, so they stop sharing a line before either is unreadable */
      .prow {
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas: 'name pct' 'bar count';
        row-gap: 0.3rem; column-gap: 0.7rem; padding: 0.6rem 0.35rem;
      }
      .prow .pr-name { grid-area: name; }
      .prow .bar { grid-area: bar; align-self: center; }
      .prow .pr-pct { grid-area: pct; }
      .prow .pr-n { grid-area: count; }
    }
    /* Flex with a real gap, not margin-right on inline spans: at 0.8rem with
       17px discs this was the smallest thing on the page, and on a phone it is
       the only key to nine lines the chart itself can no longer label legibly. */
    .legend {
      display: flex; flex-wrap: wrap; align-items: center;
      gap: 0.5rem 0.85rem; font-size: 0.88rem; margin: 0.55rem 0 0;
    }
    .legend > span { display: inline-flex; align-items: center; gap: 0.32rem; white-space: nowrap; }
    .swatch { display: inline-block; width: 0.85em; height: 0.85em; border-radius: 50%; }
    @media (max-width: 560px) {
      .legend { gap: 0.6rem 0.9rem; font-size: 0.92rem; margin-top: 0.7rem; }
    }
    .timeline { display: flex; flex-wrap: wrap; gap: 3px; margin-bottom: 0.6rem; }
    .tcell {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      width: 46px; height: 40px; border-radius: 4px; text-decoration: none;
      color: #1c1c1a; font-size: 0.62rem; line-height: 1.15;
    }
    .tcell:hover { outline: 2px solid var(--accent); }
    .tcell .tn { font-weight: 700; font-size: 0.75rem; }
    /* no AI coverage for this month: an outlined empty slot, not a filled cell */
    .tcell[data-empty] { box-shadow: inset 0 0 0 1px var(--line); color: var(--muted); }
    /* search: a keyed panel rather than a bare h2 with a loose input under it */
    .searchrow {
      margin: 2.6rem 0 0.5rem; padding: 1.3rem 1.5rem;
      background: var(--accent-wash); border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--line));
      border-radius: var(--radius);
      display: grid; gap: 0.7rem;
    }
    .srch-lbl { font-family: var(--display); font-size: 1.24rem; font-weight: 700; }
    .srch-row { display: flex; gap: 0.5rem; }
    .srch-row input { flex: 1; font-size: 1rem; background: #fff; }
    .srch-all { font-size: 0.88rem; justify-self: start; }
  </style>
</Base>
