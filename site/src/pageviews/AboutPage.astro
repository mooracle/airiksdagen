---
// Consolidated "Om" / "About" page: Methodology + Source documents + Data & code,
// each a section under one page. Replaces the former /metod/, /dokument/ (index)
// and /data/ pages (which 301-redirect here via public/_redirects). The
// /dokument/[slug] detail pages remain — case-page citations deep-link to them.
import Base from '../layouts/Base.astro';
import { getMeta, listCorpusDocs } from '../lib/data';
import { docTitle } from '../lib/doctext';
import { localePath, useTranslations, type Lang } from '../i18n/ui';
import example from '../data/example-request.json';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const sv = lang === 'sv';
const meta = getMeta();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = listCorpusDocs().sort();

const partyName = (code: string): string => meta.parties[code.toUpperCase()]?.name ?? code.toUpperCase();

// Shared with DocumentPage — see lib/doctext.ts.
const docLabel = (slug: string): string => docTitle(slug, { sv, partyName });

// --- Worked example: the exact request sent to two party agents for one case.
// Data (byte-accurate role/user text + the two verified decisions) lives in
// src/data/example-request.json, regenerated by scripts/gen_example_request.py
// straight from promptgen so it cannot drift from the prompt the run used.
// Party a is the aligned party, party b the one that diverged from its own plan.
const ex = example as any;
const voteEn: Record<string, string> = { Ja: 'Yes', Nej: 'No', 'Avstår': 'Abstain' };
const voteLabel = (v: string) => (sv ? v : voteEn[v] ?? v);
const confSv: Record<string, string> = { low: 'låg', medium: 'medel', high: 'hög' };
const confLabel = (c: string) => (sv ? confSv[c] ?? c : c);
const casePath = localePath(lang, `/fall/${ex.votering_id}/`);
const dokPath = (slug: string) => localePath(lang, `/dokument/${slug}/`);
const slugByKind = (list: { slug: string; kind: string }[], kind: string) =>
  list.find((d) => d.kind === kind)?.slug ?? null;
const answers = [
  { code: ex.party_a ?? 'M', dec: ex.decM, docs: ex.docsM },
  { code: ex.party_b ?? 'S', dec: ex.decS, docs: ex.docsS },
];
// p6 schema: the agent decides a STANCE on what the counter-proposal demands.
// `rost` is absent here on purpose — it is derived from `hallning` in code, never
// asked of the model, so the agent is never invited to guess floor tactics.
const schemaSummary = `{
  "hallning":   "stodjer" | "avvisar",
  "confidence": "low" | "medium" | "high",
  "coverage":   "explicit" | "inferred" | "not_covered",
  "motivering": "kort motivering på svenska (2–4 meningar)",
  "citations": [
    { "document": "valmanifest | partiprogram",
      "quote":    "ordagrant utdrag ur dokumentet",
      "princip":  "2–6 ord som namnger åtagandet" }
  ],
  "omvarld": { "paverkar": false, "faktorer": [] },
  "flags":   [],
  "plan_tacker_utskottets_skal": "ja" | "nej"
}`;
---

<Base lang={lang} title={sv ? 'Om projektet' : 'About'} description={t('meta.desc.about')} path="/om/">
