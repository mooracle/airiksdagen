---
import Base from '../layouts/Base.astro';
import CoalitionSection from './CoalitionSection.astro';
import PairsMatrix from './PairsMatrix.astro';
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, getAggregate } from '../lib/data';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();
const summary = getAggregate<{ per_party: Record<string, { agreement: number; n: number }> }>('summary');
const order = meta.hemicycle_order;
---

<Base lang={lang} title={t('party.title')} description={t('meta.desc.parties')} path="/parti/">
  <h1>{t('party.title')}</h1>
  <div class="grid">
    {order.map((code) => {
      const p = meta.parties[code];
      const s = summary?.per_party?.[code];
      return (
        <a class="card" href={localePath(lang, `/parti/${code.toLowerCase()}/`)} style="text-decoration:none;color:inherit">
          <PartyBadge code={code} parties={meta.parties} label="name" size={26} />
          {s && (
            <p class="muted" style="margin:0.4rem 0 0">
              {(s.agreement * 100).toFixed(1)}% · n = {s.n}
            </p>
          )}
        </a>
      );
    })}
  </div>

  {/* "Who votes with whom" moved here from Analysis: it is a party-by-party
      comparison, and it sets up the coalition tables below it — who votes
      together, then what explains each party's vote. */}
  <PairsMatrix lang={lang} />

  {/* Coalition analysis, formerly its own /koalition/ page and nav item. It is
      party-comparative content and was only ~3 screens once the individual votes
      moved to the party pages, so it belongs here rather than behind a second
      nav entry answering the same question. */}
  <CoalitionSection lang={lang} />
</Base>
