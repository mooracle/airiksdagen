---
import Base from '../layouts/Base.astro';
import MultiLineChart from '../components/MultiLineChart.astro';
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, getAggregate } from '../lib/data';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; code: string }
const { lang, code } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();
const party = meta.parties[code];

const summary = getAggregate<{
  per_party: Record<string, { n: number; agreement: number; kappa: number | null; avstar_recall: number | null }>;
}>('summary');
const timeseries = getAggregate<{ parti: string; month: string; agreement: number; n: number }[]>('party_timeseries') ?? [];
const confusion = getAggregate<Record<string, Record<string, Record<string, number>>>>('confusion');
const supportSeries = getAggregate<{ month: string; parti: string; support: number }[]>('party_support') ?? [];
const cohesionSeries = getAggregate<{ parti: string; month: string; cohesion: number; absence: number }[]>('cohesion') ?? [];

const stats = summary?.per_party?.[code];
const ts = timeseries.filter((r) => r.parti === code).sort((a, b) => a.month.localeCompare(b.month));
const support = supportSeries.filter((r) => r.parti === code).sort((a, b) => a.month.localeCompare(b.month));
const matrix = confusion?.[code];
const LABELS = ['Ja', 'Nej', 'Avstår'];
const voteLabel: Record<string, string> = { Ja: t('vote.Ja'), Nej: t('vote.Nej'), 'Avstår': t('vote.Avstår') };

// build-time SVG line charts
const W = 720, H = 180, PAD = 30;
const points = ts.map((r, i) => {
  const x = PAD + (i * (W - 2 * PAD)) / Math.max(1, ts.length - 1);
  const y = H - PAD - r.agreement * (H - 2 * PAD);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});

// polling support: y-scale 0..max(rounded up to next 5%)
const supportMax = Math.max(10, Math.ceil(Math.max(0, ...support.map((r) => r.support)) / 5) * 5);
const supportPoints = support.map((r, i) => {
  const x = PAD + (i * (W - 2 * PAD)) / Math.max(1, support.length - 1);
  const y = H - PAD - (r.support / supportMax) * (H - 2 * PAD);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const supportGrid = [0, 0.25, 0.5, 0.75, 1].map((f) => ({
  y: H - PAD - f * (H - 2 * PAD),
  label: `${(f * supportMax).toFixed(0)}%`,
}));
const latestSupport = support[support.length - 1];

const coh = cohesionSeries.filter((r) => r.parti === code).sort((a, b) => a.month.localeCompare(b.month));
const cohMonths = coh.map((r) => r.month);
const cohesionChart = [
  {
    key: lang === 'sv' ? 'Sammanhållning' : 'Cohesion',
    color: party?.color ?? '#333',
    width: 2.4,
    points: coh.map((r) => ({ month: r.month, value: r.cohesion * 100 })),
  },
  {
    key: lang === 'sv' ? 'Frånvaro' : 'Absence',
    color: '#8a95a0',
    points: coh.map((r) => ({ month: r.month, value: r.absence * 100 })),
  },
];
---

<Base lang={lang} title={party?.name ?? code} path={`/parti/${code.toLowerCase()}/`}>
  <h1><PartyBadge code={code} parties={meta.parties} size={32} /> {party?.name ?? code}</h1>

  {stats ? (
    <div class="card">
      <p style="margin:0">
        <strong style="font-size:1.5rem">{(stats.agreement * 100).toFixed(1)}%</strong>
        <span class="muted"> {t('home.agreement').toLowerCase()} · n = {stats.n} · κ = {stats.kappa ?? '–'}
        {stats.avstar_recall != null && ` · Avstår recall ${(stats.avstar_recall * 100).toFixed(0)}%`}</span>
      </p>
    </div>
  ) : (
    <p class="muted">{t('home.noai')}</p>
  )}

  {ts.length > 1 && (
    <>
      <h2>{t('party.agreement')}</h2>
      <div class="card">
        <svg viewBox={`0 0 ${W} ${H}`} style="width:100%;height:auto">
          {[0, 0.25, 0.5, 0.75, 1].map((f) => (
            <>
              <line x1={PAD} x2={W - PAD} y1={H - PAD - f * (H - 2 * PAD)} y2={H - PAD - f * (H - 2 * PAD)} stroke="#eee" />
              <text x={4} y={H - PAD - f * (H - 2 * PAD) + 4} font-size="10" fill="#999">{(f * 100).toFixed(0)}%</text>
            </>
          ))}
          <polyline points={points.join(' ')} fill="none" stroke={party?.color ?? '#333'} stroke-width="2.5" />
          <text x={PAD} y={H - 8} font-size="10" fill="#999">{ts[0]?.month}</text>
          <text x={W - PAD} y={H - 8} font-size="10" fill="#999" text-anchor="end">{ts[ts.length - 1]?.month}</text>
        </svg>
      </div>
    </>
  )}

  {support.length > 1 && (
    <>
      <h2>{t('party.support')}</h2>
      <div class="card">
        <p class="muted" style="margin:0 0 0.4rem">
          {latestSupport && `${latestSupport.month}: ${latestSupport.support.toFixed(1)}%`}
        </p>
        <svg viewBox={`0 0 ${W} ${H}`} style="width:100%;height:auto">
          {supportGrid.map((g) => (
            <>
              <line x1={PAD} x2={W - PAD} y1={g.y} y2={g.y} stroke="#eee" />
              <text x={4} y={g.y + 4} font-size="10" fill="#999">{g.label}</text>
            </>
          ))}
          <polyline points={supportPoints.join(' ')} fill="none" stroke={party?.color ?? '#333'} stroke-width="2.5" />
          <text x={PAD} y={H - 8} font-size="10" fill="#999">{support[0]?.month}</text>
          <text x={W - PAD} y={H - 8} font-size="10" fill="#999" text-anchor="end">{support[support.length - 1]?.month}</text>
        </svg>
        <p class="muted" style="margin:0.4rem 0 0;font-size:0.8rem">{t('party.supportSource')}</p>
      </div>
    </>
  )}

  {coh.length > 1 && (
    <>
      <h2>{t('party.cohesion')}</h2>
      <div class="card">
        <MultiLineChart series={cohesionChart} months={cohMonths} yMax={100} yFormat={(v) => `${v.toFixed(0)}%`} height={190} />
        <p class="muted" style="font-size:0.83rem;margin:0.4rem 0 0">
          <span style={`color:${party?.color}`}>■</span> {cohesionChart[0].key} ·
          <span style="color:#8a95a0"> ■</span> {cohesionChart[1].key} — {t('party.cohesionNote')}
        </p>
      </div>
    </>
  )}

  {matrix && (
    <>
      <h2>{t('party.confusion')}</h2>
      <table class="compare" style="max-width:420px">
        <thead>
          <tr><th>AI ↓ / {lang === 'sv' ? 'verklig' : 'actual'} →</th>{LABELS.map((l) => <th>{voteLabel[l]}</th>)}</tr>
        </thead>
        <tbody>
          {LABELS.map((ai) => (
            <tr>
              <td><strong>{voteLabel[ai]}</strong></td>
              {LABELS.map((act) => {
                const v = matrix[ai]?.[act] ?? 0;
                return <td style={ai === act ? 'font-weight:700' : ''}>{v}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  <p><a href={localePath(lang, '/parti/')}>← {t('party.title')}</a></p>
</Base>
