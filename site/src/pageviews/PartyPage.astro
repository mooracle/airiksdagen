---
import Base from '../layouts/Base.astro';
import ConfidenceMeter from '../components/ConfidenceMeter.astro';
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, getAggregate, corpusDocsByParty, corpusCitationStats } from '../lib/data';
import { docTitle } from '../lib/doctext';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; code: string }
const { lang, code } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();
const party = meta.parties[code];

const summary = getAggregate<{
  per_party: Record<string, { n: number; agreement: number; kappa: number | null; avstar_recall: number | null }>;
}>('summary');
const timeseries = getAggregate<{ parti: string; month: string; agreement: number; n: number }[]>('party_timeseries') ?? [];
const confusion = getAggregate<Record<string, Record<string, Record<string, number>>>>('confusion');
/** p6 gap, per party; null on the older vote-matching runs. */
interface ValidityLevel { n: number; gap_rate: number | null }
const gap = getAggregate<{
  per_party: Record<string, {
    explicit: { n: number; gap: number; gap_rate: number | null };
    /** every decided vote, whatever the plan had to say about it */
    all_tiers?: { n: number; gap: number; gap_rate: number | null };
    tiers: Record<string, number>;
    /** gap split by the model's own read strength; absent on pre-p6 exports */
    validity?: Record<string, Record<string, ValidityLevel>>;
    /** the same split INSIDE the headline tier — the robustness question */
    validity_explicit?: Record<string, Record<string, ValidityLevel>>;
  }>;
}>('gap');
const pgap = gap?.per_party?.[code];
/** Fixed level order per field — sorted alphabetically in the JSON, but these
 * are ordinal: the whole point is reading strongest → weakest down the table. */
const VALIDITY_ORDER: Record<string, string[]> = {
  coverage: ['explicit', 'inferred', 'not_covered'],
  confidence: ['high', 'medium', 'low'],
  plan_tacker_utskottets_skal: ['ja', 'nej'],
};
/** 95% CI half-width on a proportion. A 57% built on 28 decisions carries ±18pp
 * and must not be drawn as confidently as a 75% built on 493 (±4pp) — without
 * this the thinnest slice looks like the strongest evidence. */
const ciHalf = (p: number | null, n: number) =>
  p == null || n === 0 ? null : 1.96 * Math.sqrt((p * (1 - p)) / n);

/* What the headline number is computed over, and whether it holds inside that.
 *
 * THE PREVIOUS VERSION STARTED FROM A WRONG PREMISE and this is the correction.
 * It compared the headline against every other decided vote pooled together and
 * called the difference a validity test — so a party whose gap was larger among
 * votes its plan never addressed was reported as "Osäkert. 0 av 3 test", i.e.
 * as a measurement that fails. That is not what those votes are.
 *
 * A party programme is not a voting manual. It cannot speak to all 2,539
 * divisions and is not trying to: `gap.py` says so outright — "a plan that never
 * reached what the vote turned on cannot convict a party of defying it", and
 * `promptgen.evidence_tier` calls the off-axis case "the honest majority case".
 * The headline is deliberately the `explicit` tier alone, 14.5-25.4% of decided
 * votes depending on the party. The rest are not a weaker reading of the plan;
 * there is nothing there to read weakly. Treating them as evidence quality
 * framed full coverage as the target, which it never was.
 *
 * It was also circular: `evidence_tier` is DERIVED from coverage, confidence and
 * plan_tacker_utskottets_skal, the same three fields the tests were splitting
 * on, so "does the gap hold at explicit versus the rest" compared the headline's
 * own definition against its complement.
 *
 * So the section now states scope first — how much of the record can carry a
 * broken-promise claim at all — and then asks the one question that is a genuine
 * robustness check: INSIDE that tier, does the gap depend on how well the model
 * thought it had read the plan? (`validity_explicit`; coverage cannot vary
 * there, being what defines the tier.)
 */
const cov = pgap?.validity?.coverage;
const covN = (lv: string) => cov?.[lv]?.n ?? 0;
/** Two metrics about the party's documents, not one verdict about the method.
 *
 *  reach       — of the votes the party actually decided, how many its plan says
 *                anything about. 89.5-98.8% across the eight parties: a plan is
 *                almost always relevant to something in a case.
 *  explicitness — and of those, how many are an outright commitment rather than a
 *                position derived from the plan's principles. 14.7-26.6%, which
 *                is where the parties genuinely differ, and which is the number
 *                the headline gap is computed on.
 */
const reachTotal = covN('explicit') + covN('inferred') + covN('not_covered');
const scope = reachTotal
  ? {
      total: reachTotal,
      addressed: covN('explicit') + covN('inferred'),
      explicit: covN('explicit'),
      inferred: covN('inferred'),
      uncovered: covN('not_covered'),
      reach: (covN('explicit') + covN('inferred')) / reachTotal,
      explicitness: covN('explicit') / Math.max(1, covN('explicit') + covN('inferred')),
    }
  : null;

/** The one robustness question left once scope is stated plainly: inside the
 *  explicit tier, does the gap lean on the readings the model was least sure of?
 *  Coverage cannot vary here — it is what defines the tier — so confidence is
 *  the axis, and `high` is the overwhelming majority of it. */
const confRows = Object.entries(pgap?.validity_explicit?.confidence ?? {})
  .map(([lv, v]) => ({ lv, ...v, ci: ciHalf(v.gap_rate, v.n) }))
  .filter((r) => r.n > 0)
  .sort((a, b) => VALIDITY_ORDER.confidence.indexOf(a.lv) - VALIDITY_ORDER.confidence.indexOf(b.lv));
const sure = confRows.find((r) => r.lv === 'high') ?? null;
/* The conclusion has to be read off the comparison, not asserted. On V and KD
 * the confident subset lands within 2pp of the headline, so the gap plainly does
 * not rest on the shakier readings. On M it is 60% against a headline of 64% —
 * the 62 medium-confidence cases at 89% are lifting it, which is worth saying
 * rather than papering over with the same reassuring sentence. */
const sureDelta =
  sure?.gap_rate != null && pgap?.explicit.gap_rate != null
    ? sure.gap_rate - pgap.explicit.gap_rate
    : null;
const sureVerdict = sureDelta == null ? null : Math.abs(sureDelta) <= 0.03 ? 'steady' : 'lower';

// The per-level tables that used to sit behind a disclosure here are gone. They
// showed the gap split three ways across ALL decided votes, and needed a
// paragraph explaining that it was a contrast between different questions rather
// than a test of the number above — which is the tell that they did not belong on
// the page. `gap.json` still carries every level for anyone who wants them.
const supportSeries = getAggregate<{ month: string; parti: string; support: number }[]>('party_support') ?? [];
const cohesionSeries = getAggregate<{ parti: string; month: string; cohesion: number; absence: number }[]>('cohesion') ?? [];

/** This party's votes against its own programme. Previously all 471 were listed
 * together on /koalition/, where they were 98% of that page; split by party each
 * page carries only its own (16–131), and the reader already has the context. */
interface OverrideCase {
  votering_id: string; datum: string; rubrik: string; utskott: string; parti: string;
  ai_rost: string; actual: string; confidence: string; coverage: string;
  strict: boolean; authored_reservation: boolean; motivering: string;
  citations: { document: string; quote: string; princip?: string; svag?: boolean }[];
  /** English case title, and the AI reasoning/citations for this decision.
   * Both null until the translation pass covers this case — a missing one
   * falls back to Swedish rather than blanking the card. */
  rubrik_en?: string | null;
  en?: { motivering: string; citations: { quote: string; princip?: string }[] } | null;
}
const coalition = getAggregate<{ override_cases: OverrideCase[] }>('coalition');
const overrideCases = (coalition?.override_cases ?? [])
  .filter((c) => c.parti === code)
  .sort((a, b) => b.datum.localeCompare(a.datum));

const stats = summary?.per_party?.[code];
const ts = timeseries.filter((r) => r.parti === code).sort((a, b) => a.month.localeCompare(b.month));
const support = supportSeries.filter((r) => r.parti === code).sort((a, b) => a.month.localeCompare(b.month));
const matrix = confusion?.[code];
const LABELS = ['Ja', 'Nej', 'Avstår'];
const voteLabel: Record<string, string> = { Ja: t('vote.Ja'), Nej: t('vote.Nej'), 'Avstår': t('vote.Avstår') };

// Build-time SVG line charts, sized for the two-up grid they sit in rather than
// for the full column. An SVG at `width:100%` scales its whole coordinate system,
// text included, so the viewBox has to be near the rendered width or the labels
// go with it: the old 720-unit box in a ~380px half-column rendered its 10-unit
// tick labels at ~5px. At 380 the ratio is ~1:1 and they land at their nominal
// size, which is what lets these charts be half the width without being
// illegible. Below 760px the grid collapses to one column and they scale up.
const W = 380, H = 150, PAD = 26;
const points = ts.map((r, i) => {
  const x = PAD + (i * (W - 2 * PAD)) / Math.max(1, ts.length - 1);
  const y = H - PAD - r.agreement * (H - 2 * PAD);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});

// polling support: y-scale 0..max(rounded up to next 5%)
const supportMax = Math.max(10, Math.ceil(Math.max(0, ...support.map((r) => r.support)) / 5) * 5);
const supportPoints = support.map((r, i) => {
  const x = PAD + (i * (W - 2 * PAD)) / Math.max(1, support.length - 1);
  const y = H - PAD - (r.support / supportMax) * (H - 2 * PAD);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
});
const supportGrid = [0, 0.25, 0.5, 0.75, 1].map((f) => ({
  y: H - PAD - f * (H - 2 * PAD),
  label: `${(f * supportMax).toFixed(0)}%`,
}));
const latestSupport = support[support.length - 1];

/* Cohesion and absence, as two numbers rather than a chart.
 *
 * This was a monthly two-series line chart, and it could not say anything: party
 * cohesion in this chamber runs 99.1–100.0% for all eight parties, with a
 * standard deviation across 39 months of 0.02pp for KD and M. Drawn on the 0–100
 * axis it was a flat line on the ceiling, eight times over — 78 plotted points
 * carrying the information of one figure.
 *
 * The figure itself is worth keeping, and not as trivia: near-total cohesion is
 * what makes "the party's vote" a single thing, and the whole plan-vs-behaviour
 * gap on this page is computed against exactly that. Absence does vary (12.7–18.0%
 * mean, sd 3.0–6.4) but is not read here as absenteeism — pairing (kvittning)
 * makes a level of it routine — so it is stated plainly and left uninterpreted.
 */
const coh = cohesionSeries.filter((r) => r.parti === code);
const mean = (xs: number[]) => (xs.length ? xs.reduce((a, b) => a + b, 0) / xs.length : null);
const floorRecord = coh.length
  ? { cohesion: mean(coh.map((r) => r.cohesion))!, absence: mean(coh.map((r) => r.absence))!, months: coh.length }
  : null;

const BLOC_KEY = {
  government: 'bloc.government',
  support: 'bloc.support',
  opposition: 'bloc.opposition',
} as const;
const blocLabel = party?.bloc && party.bloc in BLOC_KEY
  ? t(BLOC_KEY[party.bloc as keyof typeof BLOC_KEY])
  : null;

// This party's own documents — the evidence every number above is measured
// against. The page led with a gap percentage and never named the texts it was
// computed from, so the reader had to find them via /parti/#dokument and pick
// this party out of eight. Same grouping and same counts as that list, from
// lib/data.ts, so the two can never disagree about what is this party's.
//
// Split by whether the p6 run actually shows the document to the agent: the
// budget motions and the Tidö agreement are published here for transparency but
// are not in the context, and listing them undifferentiated would imply the gap
// was measured against them too.
const sv = lang === 'sv';
const cites = corpusCitationStats();
const partyDocs = corpusDocsByParty(meta.hemicycle_order).byParty[code] ?? [];
const inContext = partyDocs.filter((s) => cites.has(s));
const alsoPublished = partyDocs.filter((s) => !cites.has(s));
const partyName = (c: string): string => meta.parties[c.toUpperCase()]?.name ?? c.toUpperCase();
const docLabel = (slug: string): string => docTitle(slug, { sv, partyName }).split(' — ')[0];
const dokPath = (slug: string) => localePath(lang, `/dokument/${slug}/`);
const num = (n: number) => n.toLocaleString(sv ? 'sv-SE' : 'en-GB');
---

<Base lang={lang} title={party?.name ?? code} description={`${party?.name ?? code} ${t('meta.desc.partySuffix')}`} path={`/parti/${code.toLowerCase()}/`}>
  {/* Explicit map rather than t(`bloc.${...}`): the key type is a union of the
      literal keys, so a template string is not assignable and `astro check`
      rejects it. This also keeps an unexpected bloc value from rendering the raw
      key on the page. */}
  <p class="eyebrow">{blocLabel ?? t('party.kicker')}</p>
  <h1 class="ptitle">
    <PartyBadge code={code} parties={meta.parties} size={34} /> {party?.name ?? code}
  </h1>

  {stats ? (
    <div class="card keyed phead" style={`--pc:${party?.color ?? 'var(--gold)'}`}>
      {/* Lead with the documented gap (explicit tier); vote agreement follows as
          calibration, since the derived vote is a consequence of the stance and
          never a prediction of floor tactics. */}
      {pgap && pgap.explicit.gap_rate !== null && (
        <div class="stat">
          <span class="num">{(pgap.explicit.gap_rate * 100).toFixed(0)}%</span>
          <span class="lbl">{t('home.gapHeadline')}</span>
          <span class="meta">n = {pgap.explicit.n}</span>
        </div>
      )}
      <p class="muted calib">
        {t('party.calibration')}: {(stats.agreement * 100).toFixed(1)}% · n = {stats.n} · κ = {stats.kappa ?? '–'}
        {stats.avstar_recall != null && ` · Avstår recall ${(stats.avstar_recall * 100).toFixed(0)}%`}
      </p>
      {/* Not a footnote: the gap above is a statement about how "the party" voted,
          and that phrase only means anything because the party votes as one bloc
          essentially always. The number that licenses the headline belongs under
          it. */}
      {floorRecord && (
        <p class="muted calib floor">
          {t('party.cohesion')} <b>{(floorRecord.cohesion * 100).toFixed(1)}%</b>
          {' · '}
          <span title={t('party.absenceTip')} class="abs">
            {t('party.absence')} <b>{(floorRecord.absence * 100).toFixed(1)}%</b>
          </span>
          {' · '}
          <span class="mo">{t('party.floorMonths').replace('{n}', String(floorRecord.months))}</span>
        </p>
      )}
    </div>
  ) : (
    <p class="muted">{t('home.noai')}</p>
  )}

  {/* Placed directly under the headline number rather than at the foot of the
      page: it is what that number was measured against, and a reader who wants
      to check a gap of 25% should not have to go looking for the texts. */}
  {partyDocs.length > 0 && (
    <div class="card pdocs">
      <p class="dhead">{t('party.ownDocs').replace('{party}', party?.name ?? code)}</p>
      <ul>
        {inContext.map((slug) => {
          const c = cites.get(slug)!;
          return (
            <li>
              <a href={dokPath(slug)}>{docLabel(slug)}</a>
              <span class="dstat" title={sv
                ? `${num(c.kept)} röster följde planen, ${num(c.diverged)} avvek`
                : `${num(c.kept)} votes followed the plan, ${num(c.diverged)} diverged`}>
                {sv
                  ? `${num(c.lines)} citerade rader · ${num(c.votes)} voteringar`
                  : `${num(c.lines)} cited lines · ${num(c.votes)} votes`}
              </span>
            </li>
          );
        })}
      </ul>
      {alsoPublished.length > 0 && (
        <details class="alsopub">
          <summary>{t('party.docsNotInContext').replace('{n}', String(alsoPublished.length))}</summary>
          <ul>
            {alsoPublished.map((slug) => <li><a href={dokPath(slug)}>{docLabel(slug)}</a></li>)}
          </ul>
        </details>
      )}
      <p class="dmore">
        <a href={`${localePath(lang, '/parti/')}#dokument`}>{t('party.allDocs')} →</a>
      </p>
    </div>
  )}

  {matrix && (
    <>
      <h2>{t('party.confusion')}</h2>
      <table class="compare" style="max-width:420px">
        <thead>
          <tr><th>{lang === 'sv' ? 'plan ↓ / verklig' : 'plan ↓ / actual'} →</th>{LABELS.map((l) => <th>{voteLabel[l]}</th>)}</tr>
        </thead>
        <tbody>
          {LABELS.map((ai) => (
            <tr>
              <td><strong>{voteLabel[ai]}</strong></td>
              {LABELS.map((act) => {
                const v = matrix[ai]?.[act] ?? 0;
                return <td style={ai === act ? 'font-weight:700' : ''}>{v}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </>
  )}

  {scope && (
    <>
      <h2>{t('party.validity')}</h2>
      <div class="card">
        {/* Two metrics about the party's DOCUMENTS, in the order they answer:
            how much of the chamber's business the plan speaks to at all, and how
            much of that is an outright commitment rather than a derivation. The
            second is the base of the headline gap, which is why it is here. */}
        {scope && (
          <div class="vmetrics">
            <div class="vmetric">
              <span class="vnum">{(scope.reach * 100).toFixed(0)}<small>%</small></span>
              <span class="vmlbl">{t('party.scopeReach')}</span>
              <span class="vmsub">
                {t('party.scopeReachSub')
                  .replace('{a}', num(scope.addressed))
                  .replace('{t}', num(scope.total))}
              </span>
            </div>
            <div class="vmetric lead">
              <span class="vnum">{(scope.explicitness * 100).toFixed(0)}<small>%</small></span>
              <span class="vmlbl">{t('party.scopeExplicit')}</span>
              <span class="vmsub">
                {t('party.scopeExplicitSub')
                  .replace('{e}', num(scope.explicit))
                  .replace('{i}', num(scope.inferred))}
              </span>
            </div>
          </div>
        )}
        {scope && (
          <p class="muted vlogic">
            {t('party.scopeNote')
              .replace('{e}', num(scope.explicit))
              .replace('{pct}', pgap?.explicit.gap_rate != null ? `${(pgap.explicit.gap_rate * 100).toFixed(0)}%` : '–')}
          </p>
        )}

        {/* The one genuine robustness check, once scope is no longer mistaken for
            evidence quality: inside the explicit tier, is the gap carried by the
            readings the model was surest of, or by the rest? */}
        {sure && sureVerdict && (
          <p class="vrobust" data-v={sureVerdict === 'steady' ? 'holds' : 'weak'}>
            {t(`party.robustNote.${sureVerdict}` as any)
              .replace('{n}', num(sure.n))
              .replace('{t}', num(pgap?.explicit.n ?? 0))
              .replace('{pct}', sure.gap_rate == null ? '–' : `${(sure.gap_rate * 100).toFixed(0)}%`)
              .replace('{head}', pgap?.explicit.gap_rate == null ? '–' : `${(pgap.explicit.gap_rate * 100).toFixed(0)}%`)}
          </p>
        )}
      </div>
    </>
  )}

  {/* The three month-by-month series, together and small.

      They used to be three full-width <h2> sections stacked directly under the
      headline number — roughly two screens of line chart before the reader
      reached the documents the number was measured from, or any of the tables
      that qualify it. They are context, not the finding: none of them is the
      plan-vs-behaviour gap this page is about (agreement is the calibration
      number, support is external polling, cohesion is floor behaviour with no AI
      in it at all). So they are one section of small multiples, below the
      evidence and the measurement quality rather than above them. */}
  {(ts.length > 1 || support.length > 1) && (
    <>
      <h2>{t('party.trends')}</h2>
      <div class="trends">
        {ts.length > 1 && (
          <div class="card tcard">
            <p class="thead">{t('party.agreement')}</p>
            <svg viewBox={`0 0 ${W} ${H}`} style="width:100%;height:auto">
              {[0, 0.5, 1].map((f) => (
                <>
                  <line x1={PAD} x2={W - PAD} y1={H - PAD - f * (H - 2 * PAD)} y2={H - PAD - f * (H - 2 * PAD)} stroke="#eee" />
                  <text x={4} y={H - PAD - f * (H - 2 * PAD) + 4} font-size="10" fill="#999">{(f * 100).toFixed(0)}%</text>
                </>
              ))}
              <polyline points={points.join(' ')} fill="none" stroke={party?.color ?? '#333'} stroke-width="2" />
              <text x={PAD} y={H - 8} font-size="10" fill="#999">{ts[0]?.month}</text>
              <text x={W - PAD} y={H - 8} font-size="10" fill="#999" text-anchor="end">{ts[ts.length - 1]?.month}</text>
            </svg>
          </div>
        )}

        {support.length > 1 && (
          <div class="card tcard">
            <p class="thead">
              {t('party.support')}
              {latestSupport && (
                <span class="tnow">{latestSupport.month}: {latestSupport.support.toFixed(1)}%</span>
              )}
            </p>
            <svg viewBox={`0 0 ${W} ${H}`} style="width:100%;height:auto">
              {supportGrid.map((g) => (
                <>
                  <line x1={PAD} x2={W - PAD} y1={g.y} y2={g.y} stroke="#eee" />
                  <text x={4} y={g.y + 4} font-size="10" fill="#999">{g.label}</text>
                </>
              ))}
              <polyline points={supportPoints.join(' ')} fill="none" stroke={party?.color ?? '#333'} stroke-width="2" />
              <text x={PAD} y={H - 8} font-size="10" fill="#999">{support[0]?.month}</text>
              <text x={W - PAD} y={H - 8} font-size="10" fill="#999" text-anchor="end">{support[support.length - 1]?.month}</text>
            </svg>
            <p class="tnote">{t('party.supportSource')}</p>
          </div>
        )}

      </div>
    </>
  )}

  {overrideCases.length > 0 && (
    <>
      <h2>{t('coalition.overrideTitle')} <span class="muted">({overrideCases.length})</span></h2>
      <p class="muted ovintro">{t('coalition.casesIntro')}</p>
      <div class="card">
        {/* Compact row per vote — title, date, plan→actual. The reasoning and the
            decisive quote sit behind the row's own disclosure: at 131 votes for L
            the old always-open card would have run to ~40 screens on one party. */}
        {overrideCases.map((c) => {
          // show the strongest quote: first non-weak citation, else the first
          const dcIdx = c.citations.findIndex((x) => !x.svag);
          const i = dcIdx >= 0 ? dcIdx : 0;
          const dc = c.citations[i];
          // English only on the English page, and only where it exists —
          // the same `||` fallback the case page uses
          const cEn = lang === 'en' ? c.en ?? null : null;
          const dcEn = cEn?.citations?.[i] ?? null;
          const title = (lang === 'en' ? c.rubrik_en : null) || c.rubrik;
          return (
            <details class="ovcase">
              <summary>
                <span class="ov-title">
                  <span class="ov-date muted">{c.datum}</span>
                  <span class="ov-name" title={title}>{title}</span>
                </span>
                {/* Meter first, at a fixed width, so the chips land in the same
                    column on every row — the old "(medium)" text appeared only on
                    non-strict rows and shoved those rows' chips out of line. */}
                <span class="ov-votes">
                  <ConfidenceMeter lang={lang} level={c.confidence} />
                  <span class="votechip" data-v={c.ai_rost}>{voteLabel[c.ai_rost] ?? c.ai_rost}</span>
                  <span class="muted" aria-hidden="true">→</span>
                  <span class="votechip" data-v={c.actual}>{voteLabel[c.actual] ?? c.actual}</span>
                </span>
              </summary>
              <p class="ov-mot">{cEn?.motivering || c.motivering}</p>
              {cEn?.motivering && (
                <details class="original">
                  <summary>{t('case.originalSv')}</summary>
                  <p>{c.motivering}</p>
                </details>
              )}
              {dc && (
                <blockquote class={dc.svag ? 'weakcite' : undefined}>
                  {dc.svag && <span class="chip weak" title={t('case.weakCiteTip')}>{t('case.weakCite')}</span>}{' '}
                  {/* the quote stays verbatim Swedish — it is the evidence, and
                      the citation deep-links match these exact bytes; the
                      translation rides underneath as a gloss */}
                  {dc.quote && <>»{dc.quote}«</>}
                  {(dcEn?.princip || dc.princip) && (
                    <span class="muted small">{dc.quote ? ' — ' : ''}{dcEn?.princip || dc.princip}</span>
                  )}
                  {/* Only alongside a Swedish quote, exactly as in
                      `CasePage.astro`. `repair-citations` BLANKS a quote it
                      cannot verify — the whole point being that the site never
                      shows it — but the English was translated before that pass
                      and is still committed. Rendered on its own it puts the
                      withdrawn text back on the page in the other language. */}
                  {dc.quote && dcEn?.quote && <span class="qtrans">“{dcEn.quote}”</span>}
                </blockquote>
              )}
              <p class="ov-link">
                <a href={localePath(lang, `/fall/${c.votering_id}/`)}>{t('case.open')} →</a>
              </p>
            </details>
          );
        })}
      </div>
    </>
  )}

  <p><a href={localePath(lang, '/parti/')}>← {t('party.title')}</a></p>

  <style>
    /* Validity: the gap re-cut by the model's own read strength. Three small
       blocks side by side rather than one wide table — each field is its own
       ordinal scale and they are read down, not across. */
    .ptitle { display: flex; align-items: center; gap: 0.55rem; }
    /* the party's own colour keys its headline panel */
    .phead { border-left-color: var(--pc, var(--gold)); }
    .phead .calib {
      margin: 0.9rem 0 0; font-size: 0.88rem;
      padding-top: 0.8rem; border-top: 1px solid var(--line-soft);
    }
    /* Second context line, under calibration — same family, no second rule. */
    .phead .floor { margin-top: 0.35rem; padding-top: 0; border-top: 0; }
    .phead .floor b { color: var(--ink-2); font-variant-numeric: tabular-nums; }
    .phead .floor .abs { cursor: help; text-decoration: underline dotted; }
    .phead .floor .mo { font-size: 0.92em; }
    /* The party's own corpus, directly under its headline number. Keyed to the
       party colour like .phead, because the two belong together: the panel is
       the claim, this is what the claim was read from. */
    .pdocs { border-left-color: var(--pc, var(--gold)); }
    .pdocs .dhead {
      margin: 0 0 0.6rem; font-size: 0.82rem; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted);
    }
    .pdocs ul { margin: 0; padding-left: 1.1rem; }
    .pdocs li { margin: 0.45rem 0; }
    /* Under the title, not beside it: a manifesto name plus a count wraps into
       two ragged lines in a narrow column otherwise. */
    .pdocs .dstat {
      display: block; font-size: 0.78rem; color: var(--muted);
      font-variant-numeric: tabular-nums; cursor: help;
    }
    /* Collapsed: published for transparency, but not what the gap was measured
       against, and an open list of four budget motions would outweigh the three
       documents that actually carry the finding. */
    .pdocs .alsopub { margin-top: 0.8rem; font-size: 0.88rem; }
    .pdocs .alsopub > summary { cursor: pointer; color: var(--muted); }
    .pdocs .alsopub > summary:hover { color: var(--accent-ink); }
    .pdocs .alsopub ul { margin-top: 0.4rem; }
    .pdocs .dmore {
      margin: 0.9rem 0 0; padding-top: 0.7rem;
      border-top: 1px solid var(--line-soft); font-size: 0.85rem;
    }
    /* Small multiples. `auto-fit` would stretch a lone chart back to full width,
       which is the shape this section exists to get away from — the two-up grid
       is fixed above 760px and collapses below it, where the SVG's own viewBox
       scaling makes a full-width chart the legible option again. */
    .trends { display: grid; gap: 0.9rem; grid-template-columns: minmax(0, 1fr); }
    .tcard { margin: 0; }
    .tcard .thead {
      display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem;
      margin: 0 0 0.5rem; font-size: 0.82rem; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted);
    }
    /* The number the sparkline is a history of — the chart is small enough now
       that the current value should not have to be read off it. */
    .tcard .tnow {
      font-weight: 400; letter-spacing: 0; text-transform: none;
      font-variant-numeric: tabular-nums; color: var(--ink-2);
    }
    .tcard .tnote { margin: 0.4rem 0 0; font-size: 0.8rem; color: var(--muted); }
    @media (min-width: 760px) {
      .trends { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
      .trends .wide { grid-column: 1 / -1; }
    }
    /* The two document metrics, read left to right as one sentence: how much of
       the chamber's business the plan reaches, and how much of that is an
       outright commitment. The second is the base of the headline, so it leads. */
    .vmetrics {
      display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      margin-bottom: 1rem;
    }
    .vmetric {
      padding: 0.7rem 0.9rem; border-left: 3px solid var(--line);
      background: var(--panel-2); border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }
    .vmetric.lead { border-left-color: var(--pc, var(--accent)); }
    .vnum { display: block; font-size: 1.9rem; font-weight: 700; line-height: 1.05; }
    .vnum small { font-size: 0.45em; font-weight: 700; margin-left: 0.08em; vertical-align: baseline; }
    .vmlbl { display: block; font-size: 0.88rem; color: var(--ink-2); margin-top: 0.15rem; }
    .vmsub {
      display: block; font-size: 0.78rem; color: var(--muted); margin-top: 0.3rem;
      font-variant-numeric: tabular-nums;
    }
    .vlogic { font-size: 0.88rem; max-width: 62ch; margin: 0 0 1.2rem; }

    /* One sentence, not a chart: the comparison it makes is two numbers, and the
       sentence states both. */
    .vrobust {
      margin: 0; padding: 0.75rem 0 0 0.6rem; border-top: 1px solid var(--line-soft);
      border-left: 3px solid var(--muted); font-size: 0.85rem; line-height: 1.5;
      color: var(--ink-2);
    }
    .vrobust[data-v='holds'] { border-left-color: var(--ja); }
    .vrobust[data-v='weak'] { border-left-color: var(--avstar); }
    .ovintro { font-size: 0.88rem; max-width: 46rem; }
    .ovcase { padding: 0.55rem 0; border-bottom: 1px solid var(--line-soft); }
    .ovcase:last-child { border-bottom: 0; }
    .ovcase > summary {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.5rem 0.9rem; flex-wrap: wrap; cursor: pointer; list-style: none;
    }
    .ovcase > summary::-webkit-details-marker { display: none; }
    /* Title takes the slack and clips; the votes column keeps its width so the
       chips stay in one column however long the case heading is. */
    /* flex-basis 0, not auto: wrapping is decided from each item's hypothetical
       size, and with basis:auto that is the untruncated heading (up to ~850px),
       so long rows wrapped their chips to a second line before any shrinking
       could happen. A zero basis lets the heading clip and keeps one line. */
    .ov-title { display: inline-flex; align-items: baseline; gap: 0.55rem; min-width: 0; flex: 1 1 0; }
    /* min-width:0 is load-bearing: a flex item defaults to min-width:auto, so
       .ov-title's min-content stayed as wide as the full heading and the chips
       wrapped to a second line instead of the heading clipping. */
    .ov-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ov-title::before {
      content: ''; flex: none; align-self: center;
      border-left: 5px solid var(--muted);
      border-top: 4px solid transparent; border-bottom: 4px solid transparent;
      transition: transform 0.15s ease;
    }
    .ovcase[open] > summary .ov-title::before { transform: rotate(90deg); }
    .ov-date { font-size: 0.82rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .ov-votes { display: inline-flex; align-items: center; gap: 0.4rem; flex: none; }
    .ov-mot { margin: 0.6rem 0 0.4rem; font-size: 0.92rem; }
    /* English gloss under the verbatim Swedish quote, and the Swedish original
       behind a disclosure — same treatment as the case page's party cards */
    .qtrans { display: block; margin-top: 0.25rem; font-size: 0.92em; color: var(--muted); font-style: italic; }
    details.original { margin: 0 0 0.4rem; font-size: 0.88rem; }
    details.original summary { color: var(--muted); cursor: pointer; }
    .small { font-size: 0.8rem; }
    .ov-link { margin: 0.45rem 0 0; font-size: 0.85rem; }
    .ovcase blockquote {
      margin: 0; padding: 0.5rem 0.85rem; background: #fbfaf5; border-radius: 6px;
      font-family: Georgia, serif; font-size: 0.98rem;
    }
    /* Phone: a clipped heading plus chips on one 340px line leaves room for
       neither, so give the heading the full line and drop the chips below it. */
    @media (max-width: 560px) {
      .ov-title { flex-basis: 100%; }
      .ov-votes { margin-left: 1.05rem; }
    }
  </style>
</Base>
