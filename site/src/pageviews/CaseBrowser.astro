      .cb .searchline input[type='search'], .cb .sel select, .cb .pbtn { font-size: 1rem; }
      /* 2.3rem is 37px — under the 44px thumb-target guideline on every control
         in the toolbar, which is the part of this page people actually poke at */
      .cb .searchline input[type='search'], .cb .sel select,
