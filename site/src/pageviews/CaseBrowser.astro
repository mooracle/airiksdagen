---
import Base from '../layouts/Base.astro';
import { getMeta, partyInk } from '../lib/data';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();
const indexUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/data/cases-index.json`;
const caseBase = localePath(lang, '/fall/');

// Party color + readable ink + name, passed to the client island so it can draw
// the same identity discs (<PartyBadge>) that the rest of the site uses.
const PARTY = Object.fromEntries(
  Object.entries(meta.parties).map(([code, info]) => [
    code,
    { color: info.color, ink: partyInk(info.color), name: info.name },
  ]),
);

// policy_area code -> localized label, for the topic filter (value stays the
// language-independent code; only the label is localized).
const POLICY: Record<string, string> = Object.fromEntries(
  Object.entries(meta.policy_areas || {}).map(([code, l]) => [code, l[lang]]),
);

// Strings the inline island needs (column headers are rendered server-side below).
const TR = {
  showing: t('browser.showing'), of: t('browser.of'), cases: t('browser.cases'),
  prev: t('browser.prev'), next: t('browser.next'), noResults: t('browser.noResults'),
  allMatch: t('browser.allMatch'), missTip: t('browser.missTip'), noAi: t('browser.noAi'),
  missTipX: t('browser.missTipX'),
};
---

<Base lang={lang} title={t('browser.title')} description={t('meta.desc.browser')} path="/fall/">
  <div class="cb">
    <p class="eyebrow">{t('home.kicker')}</p>
    {/* The count is the live, post-filter total — it was a static 2,539 in the
        heading plus a separate "showing 1–50 of 2,539" line, so the number you
        actually cared about (how many matched) was the one not in the title.
        Server-rendered with the full total so it is correct before the island
        boots and for crawlers. */}
    <h1>{t('browser.title')} <span class="muted count" id="count">({meta.n_cases})</span></h1>

    {/* Toolbar: search on its own line, then the narrowing controls. The
        riksmöte select is gone — it partitioned the same axis as the month
        select (a riksmöte is just a span of months), so the two could be set to
        contradict each other and return nothing. Months alone cover it. */}
    <div class="toolbar">
      <div class="searchline">
        <svg class="s-icon" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
          <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12.8 12.8 L17.5 17.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        <input id="q" type="search" placeholder={t('browser.search')} aria-label={t('browser.search')} autocomplete="off" />
      </div>
      <div class="filterline">
        <select id="month" aria-label={t('browser.filter.allMonths')}><option value="">{t('browser.filter.allMonths')}</option></select>
        <select id="utskott" aria-label={t('browser.filter.committee')}><option value="">{t('browser.filter.committee')}</option></select>
        <select id="area" aria-label={t('browser.filter.allAreas')}><option value="">{t('browser.filter.allAreas')}</option></select>
        {/* Flags as on/off pills: a bare checkbox next to a long sentence read as
            body text, so it was never obvious these were controls or which were
            active. The explanation moved to the tooltip. */}
        <label class="tog" title={t('browser.filter.disagreeTip')}>
          <input type="checkbox" id="disagree" />
          <span>{t('browser.filter.disagree')}</span>
        </label>
        <label class="tog" title={t('browser.filter.disagreeXTip')}>
          <input type="checkbox" id="disagreex" />
          <span>{t('browser.filter.disagreeX')}</span>
        </label>
        <button type="button" id="clear" class="clearbtn" hidden>{t('browser.clear')}</button>
      </div>
    </div>

    {/* Screen readers still need the change announced; sighted users read it off
        the heading, so the sentence lives in an off-screen live region. */}
    <p class="sr-only" id="summary" aria-live="polite"></p>

    <div class="table-wrap card flush">
      <table class="compare browser-table">
        <thead>
          <tr>
            <th class="c-date">{t('browser.col.date')}</th>
            <th class="c-title">{t('browser.col.case')}</th>
            <th class="c-ref">{t('browser.col.ref')}</th>
            <th class="c-ai">{t('browser.col.ai')}</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
      {/* Legend sits under the rows it explains, where a table legend belongs —
          it was competing with the result count for space above the table. */}
      <p class="note hint">{t('browser.hint')}</p>
    </div>

    <nav class="pager" id="pager" aria-label="Sidnavigering" hidden></nav>
  </div>

  <script is:inline define:vars={{ indexUrl, caseBase, lang, PARTY, POLICY, TR }}>
    const PAGE = 50;
    let rows = [];
    let filtered = [];
    let page = 1;

    const q = document.getElementById('q');
    const month = document.getElementById('month');
    const utskott = document.getElementById('utskott');
    const area = document.getElementById('area');
    const disagree = document.getElementById('disagree');
    const disagreex = document.getElementById('disagreex');
    const clearBtn = document.getElementById('clear');
    const tbody = document.getElementById('rows');
    const summary = document.getElementById('summary');
    const count = document.getElementById('count');
    const pager = document.getElementById('pager');
    const controls = document.querySelector('.toolbar');

    // "2026-06" -> "juni 2026" in the page's own language. The raw ISO stamps in
    // the month dropdown were the least readable thing in the toolbar.
    const monthFmt = new Intl.DateTimeFormat(lang === 'sv' ? 'sv-SE' : 'en-GB', {
      month: 'long', year: 'numeric', timeZone: 'UTC',
    });
    const monthLabel = (m) => {
      const label = monthFmt.format(new Date(`${m}-01T00:00:00Z`));
      return label.charAt(0).toUpperCase() + label.slice(1);
    };

    const norm = (s) => s.toLowerCase();
    const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

    // `strong` marks an explicit-tier divergence: the plan stated the commitment
    // outright and the party still voted the other way. Drawn with a dark ring so
    // the graded evidence is visible at a glance without a second column.
    function badge(code, strong) {
      const p = PARTY[code] || { color: '#888', ink: '#fff', name: code };
      const size = 20;
      const font = ((code.length > 1 ? 0.44 : 0.52) * size).toFixed(1);
      const name = esc(p.name);
      const cls = strong ? 'pbadge strong' : 'pbadge';
      const tip = strong ? `${name} — ${esc(TR.missTipX)}` : name;
      return `<span class="${cls}" style="--pb:${p.color};--pb-ink:${p.ink};width:${size}px;height:${size}px;font-size:${font}px" title="${tip}" role="img" aria-label="${tip}">${code}</span>`;
    }

    // The party discs make the count self-evident, so no N/N score is shown:
    // divergence rows list the diverging parties; a full match shows a check.
    function aiCell(r) {
      if (!r.hasAi) return `<span class="ai-cell"><span class="muted na" title="${esc(TR.noAi)}">—</span></span>`;
      const miss = r.miss || [];
      if (!miss.length)
        return `<span class="ai-cell allmatch" title="${esc(TR.allMatch)}"><span class="ok" aria-hidden="true">✓</span></span>`;
      const strong = new Set(r.missx || []);
      return `<span class="ai-cell"><span class="misses" title="${esc(TR.missTip)}">${miss.map((c) => badge(c, strong.has(c))).join('')}</span></span>`;
    }

    function rowHTML(r) {
      const title = esc((lang === 'en' && r.rubrik_en) || r.rubrik || r.titel);
      return (
        `<tr>` +
        `<td class="c-date muted">${r.datum}</td>` +
        `<td class="c-title"><a href="${caseBase}${r.id}/">${title}</a></td>` +
        `<td class="c-ref muted">${esc(r.bet)} <span class="pt">p.${r.punkt}</span></td>` +
        `<td class="c-ai">${aiCell(r)}</td>` +
        `</tr>`
      );
    }

    function pageList(cur, total) {
      const keep = new Set([1, total, cur - 1, cur, cur + 1]);
      const arr = [...keep].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
      const out = [];
      let prev = 0;
      for (const n of arr) {
        if (n - prev > 1) out.push('…');
        out.push(n);
        prev = n;
      }
      return out;
    }

    function renderPager(total) {
      if (total <= 1) { pager.hidden = true; pager.innerHTML = ''; return; }
      pager.hidden = false;
      const parts = [
        `<button class="pg nav" data-go="${page - 1}" ${page === 1 ? 'disabled' : ''} aria-label="${esc(TR.prev)}">‹</button>`,
      ];
      for (const n of pageList(page, total)) {
        parts.push(
          n === '…'
            ? `<span class="pg gap" aria-hidden="true">…</span>`
            : `<button class="pg num${n === page ? ' cur' : ''}" data-go="${n}" ${n === page ? 'aria-current="page"' : ''}>${n}</button>`,
        );
      }
      parts.push(
        `<button class="pg nav" data-go="${page + 1}" ${page === total ? 'disabled' : ''} aria-label="${esc(TR.next)}">›</button>`,
      );
      pager.innerHTML = parts.join('');
    }

    function render() {
      const total = Math.max(1, Math.ceil(filtered.length / PAGE));
      if (page > total) page = total;
      count.textContent = `(${filtered.length.toLocaleString(lang === 'sv' ? 'sv-SE' : 'en-GB')})`;
      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td class="empty muted" colspan="4">${esc(TR.noResults)}</td></tr>`;
        summary.textContent = `0 ${TR.cases}`;
        renderPager(1);
        return;
      }
      const start = (page - 1) * PAGE;
      const slice = filtered.slice(start, start + PAGE);
      tbody.innerHTML = slice.map(rowHTML).join('');
      summary.textContent = `${TR.showing} ${start + 1}–${start + slice.length} ${TR.of} ${filtered.length} ${TR.cases}`;
      renderPager(total);
    }

    function apply() {
      const term = norm(q.value.trim());
      const active = !!(term || month.value || utskott.value || area.value
        || disagree.checked || disagreex.checked);
      clearBtn.hidden = !active;
      filtered = rows.filter((r) => {
        if (month.value && !r.datum.startsWith(month.value)) return false;
        if (utskott.value && r.utskott !== utskott.value) return false;
        if (area.value && r.policy_area !== area.value) return false;
        if (disagree.checked && !(r.hasAi && r.agree < r.compared)) return false;
        // explicit-tier only: the plan stated the commitment and the party still
        // voted against it — the subset that can carry that claim.
        if (disagreex.checked && !(r.missx && r.missx.length)) return false;
        // display fields (already on the row) OR the precomputed lowercased
        // r.search blob (subject sv/en + subtopics) — so subject/subtopic terms
        // match without duplicating rubrik/bet into every index row.
        if (term) {
          const hay = norm(r.rubrik + ' ' + (r.rubrik_en || '') + ' ' + r.titel + ' ' + r.bet) +
            (r.search ? ' ' + r.search : '');
          if (!hay.includes(term)) return false;
        }
        return true;
      });
      filtered.sort((a, b) => b.datum.localeCompare(a.datum));
      page = 1;
      render();
    }

    pager.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-go]');
      if (!b || b.disabled) return;
      const n = Number(b.dataset.go);
      const total = Math.max(1, Math.ceil(filtered.length / PAGE));
      if (n >= 1 && n <= total) {
        page = n;
        render();
        controls.scrollIntoView({ block: 'start' });
      }
    });

    fetch(indexUrl)
      .then((r) => r.json())
      .then((data) => {
        rows = data;
        for (const o of [...new Set(rows.map((r) => r.utskott))].sort()) {
          const opt = document.createElement('option');
          opt.textContent = o;
          utskott.appendChild(opt);
        }
        // topic filter: option value = stable policy_area code, label = localized
        const areaCodes = [...new Set(rows.map((r) => r.policy_area).filter(Boolean))];
        areaCodes
          .map((code) => ({ code, label: POLICY[code] || code }))
          .sort((a, b) => a.label.localeCompare(b.label, lang))
          .forEach(({ code, label }) => {
            const opt = document.createElement('option');
            opt.value = code;
            opt.textContent = label;
            area.appendChild(opt);
          });
        const monthsAvail = [...new Set(rows.map((r) => r.datum.slice(0, 7)))].sort().reverse();
        for (const m of monthsAvail) {
          const opt = document.createElement('option');
          opt.value = m;
          opt.textContent = monthLabel(m);
          month.appendChild(opt);
        }
        // deep links from the homepage: /fall/?q=...&m=YYYY-MM&d=1
        const params = new URLSearchParams(location.search);
        if (params.get('q')) q.value = params.get('q');
        if (params.get('m') && monthsAvail.includes(params.get('m'))) month.value = params.get('m');
        if (params.get('d') === '1') disagree.checked = true;
        if (params.get('dx') === '1') disagreex.checked = true;
        apply();
      });

    for (const el of [q, month, utskott, area, disagree, disagreex]) el.addEventListener('input', apply);

    clearBtn.addEventListener('click', () => {
      q.value = '';
      month.value = '';
      utskott.value = '';
      area.value = '';
      disagree.checked = false;
      disagreex.checked = false;
      apply();
      q.focus();
    });
  </script>

  <!--
    is:global because the rows and pager buttons are built client-side via innerHTML;
    Astro's scoped styles only attach to template elements, never dynamic DOM. Every
    rule is anchored under .cb (unique to this page) so nothing leaks.
  -->
  <style is:global>
    /* ── toolbar ────────────────────────────────────────────────────────── */
    .cb .toolbar {
      margin: 1.1rem 0 0; padding: 1rem 1.1rem;
      background: var(--panel); border: 1px solid var(--line);
      border-radius: var(--radius); box-shadow: var(--shadow-sm);
      display: grid; gap: 0.7rem; max-width: none;
    }
    /* search sits in its own row, with the icon inside the field */
    .cb .searchline { position: relative; display: flex; }
    .cb .searchline .s-icon {
      position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%);
      width: 1.05rem; height: 1.05rem; color: var(--muted); pointer-events: none;
    }
    .cb .searchline input[type='search'] {
      flex: 1; height: 2.75rem; padding: 0 0.85rem 0 2.5rem;
      border: 1px solid var(--line); border-radius: var(--radius-sm);
      background: #fff; font-size: 1rem;
    }
    .cb .filterline { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
    .cb .filterline select {
      height: 2.3rem; padding: 0 0.55rem; border: 1px solid var(--line);
      border-radius: var(--radius-sm); background: #fff; font-size: 0.9rem; color: var(--ink-2);
      max-width: 15rem;
    }
    /* on/off pill. The checkbox stays in the DOM for keyboard and screen readers
       and is visually replaced by the pill it labels. */
    .cb .tog { display: inline-flex; cursor: pointer; }
    .cb .tog input {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .cb .tog > span {
      display: inline-flex; align-items: center; gap: 0.4rem;
      height: 2.3rem; padding: 0 0.85rem;
      border: 1px solid var(--line); border-radius: 999px; background: #fff;
      font-size: 0.88rem; font-weight: 600; color: var(--ink-2); white-space: nowrap;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    /* the dot doubles as the on/off indicator */
    .cb .tog > span::before {
      content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%;
      background: var(--line); box-shadow: inset 0 0 0 1px rgb(20 32 43 / 0.12);
    }
    .cb .tog:hover > span { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
    .cb .tog input:checked + span {
      background: var(--accent); border-color: var(--accent); color: #fff;
    }
    .cb .tog input:checked + span::before { background: var(--gold); box-shadow: none; }
    .cb .tog input:focus-visible + span { outline: 2.5px solid var(--accent); outline-offset: 2px; }
    .cb .clearbtn {
      height: 2.3rem; padding: 0 0.8rem; border: 0; background: none; cursor: pointer;
      font-size: 0.86rem; color: var(--accent); text-decoration: underline;
      text-underline-offset: 2px; margin-left: auto;
    }
    .cb .clearbtn:hover { color: var(--accent-ink); }

    .cb .count { font-variant-numeric: tabular-nums; }
    .cb .sr-only {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .cb .table-wrap .hint { font-size: 0.8rem; }

    /* ── table ──────────────────────────────────────────────────────────── */
    /* `overflow: visible` is load-bearing. `.card.flush` sets `overflow: hidden`
       to clip its corners, and ANY non-visible overflow makes this element the
       nearest scroll container — at which point the sticky `thead` offsets itself
       inside the card instead of against the viewport, opening a gap at the top
       and hiding the first row behind it. Corners are rounded on the header cells
       instead, and the columns collapse rather than scroll sideways. */
    .cb .table-wrap { overflow: visible; margin: 0; }
    .cb .browser-table thead th:first-child { border-top-left-radius: var(--radius); }
    .cb .browser-table thead th:last-child { border-top-right-radius: var(--radius); }
    /* nowrap + width:1% collapses date/ref/ai to content width; title takes the rest */
    .cb .browser-table { table-layout: auto; font-size: 0.95rem; }
    .cb .browser-table th, .cb .browser-table td { vertical-align: middle; }
    .cb .browser-table tbody td { padding-top: 0.7rem; padding-bottom: 0.7rem; }
    /* header rides just under the sticky site header while the 50-row page scrolls */
    .cb .browser-table thead th {
      position: sticky; top: 3.6rem; z-index: 3;
      background: var(--panel-2);
      box-shadow: inset 0 -2px 0 var(--line);
      border-bottom: 0;
    }
    .cb .browser-table tbody tr { transition: background 0.12s ease; }
    .cb .browser-table tbody tr:hover td { background: var(--accent-wash); }
    .cb .c-date {
      white-space: nowrap; width: 1%; font-size: 0.85rem;
      font-variant-numeric: tabular-nums; letter-spacing: -0.01em;
    }
    .cb .c-title { width: 100%; }
    .cb .c-title a { font-weight: 500; text-decoration: none; }
    .cb .c-title a:hover { text-decoration: underline; }
    .cb .c-ref {
      white-space: nowrap; width: 1%; font-size: 0.83rem; text-align: right;
      font-variant-numeric: tabular-nums;
    }
    .cb .c-ref .pt { opacity: 0.6; }
    .cb th.c-ref { text-align: right; }
    .cb .c-ai { white-space: nowrap; width: 1%; text-align: right; }
    .cb th.c-ai { text-align: right; }
    .cb td.empty { text-align: center; padding: 2.6rem 0.65rem; font-style: italic; }

    .cb .ai-cell { display: inline-flex; align-items: center; gap: 0.3rem; justify-content: flex-end; min-height: 20px; }
    .cb .ai-cell.allmatch .ok { color: #2f7d43; font-weight: 700; font-size: 1rem; }
    .cb .ai-cell .na { font-size: 0.95rem; }
    .cb .misses { display: inline-flex; align-items: center; gap: 0.28rem; }
    /* thin surface ring so same-hue neighbours (S/V red, MP/C green) stay separable */
    .cb .misses .pbadge { box-shadow: 0 0 0 1.5px var(--paper); }
    /* explicit-tier divergence: dark ring, so the strong claims stand out from
       the derived ones without needing a separate column */
    .cb .misses .pbadge.strong { box-shadow: 0 0 0 1.5px var(--paper), 0 0 0 3px #3c3a34; }

    .cb .pager { display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; margin: 1.1rem 0 0.5rem; }
    .cb .pg { min-width: 2.15rem; height: 2.15rem; padding: 0 0.55rem; border: 1px solid var(--line); background: var(--panel); border-radius: var(--radius-sm); cursor: pointer; font-size: 0.9rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
    .cb .pg:hover:not(:disabled):not(.cur) { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); color: var(--accent-ink); }
    .cb .pg.cur { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 700; cursor: default; }
    .cb .pg:disabled { opacity: 0.4; cursor: default; }
    .cb .pg.gap { border: none; background: none; cursor: default; min-width: 1.2rem; color: var(--muted); }

    @media (max-width: 560px) {
      .cb .filterline select { flex: 1 1 100%; max-width: none; }
      .cb .clearbtn { margin-left: 0; }
      .cb .c-ref, .cb th.c-ref { display: none; }
    }
  </style>
</Base>
