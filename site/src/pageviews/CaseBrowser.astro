         The card now supplies its own padding, so the gutter has to go. */
      .cb .table-wrap.card.flush > table.compare td:first-child,
      .cb .table-wrap.card.flush > table.compare td:last-child {
        padding-left: 0; padding-right: 0;
      }
      /* likewise the legend's gutter, now that the wrapper has no edges */
      .cb .table-wrap.card.flush > .note { padding-left: 0; padding-right: 0; }

      /* provenance line, above the title and quiet: which sitting, which report */
      .cb .c-date, .cb .c-ref { font-size: 0.75rem; letter-spacing: 0; }
      .cb .c-date { grid-area: 1 / 1; }
      .cb .c-ref, .cb th.c-ref { display: block; grid-area: 1 / 2; text-align: right; }

      .cb .c-title { grid-area: 2 / 1 / 3 / 3; margin: 0.2rem 0 0.5rem; }
      /* the case is the headline of its card, so it carries the weight the
         table's uniform 0.95rem could not give it */
      .cb .c-title a { font-size: 1.02rem; font-weight: 600; line-height: 1.33; }
      /* the whole card is the tap target, not just the words in the title —
         a 44px-tall card with a 20px link in it is a miss waiting to happen */
      .cb .c-title a::after {
        content: ''; position: absolute; inset: 0; border-radius: inherit;
      }

      /* separated from the case text: this is the finding about the case, not
         part of its description */
      .cb .c-ai { grid-area: 3 / 1 / 4 / 3; text-align: left; }
      .cb .c-ai:not(:empty) { border-top: 1px solid var(--line-soft); padding-top: 0.5rem; }
      .cb .ai-cell { justify-content: flex-start; min-height: 0; }
      .cb .ai-lbl { display: inline; font-size: 0.82rem; }
      .cb .ai-cell .na { display: none; }
      /* the divergence rows say it with discs; only the two wordless verdicts
         need the sentence */
      .cb .misses ~ .ai-lbl { display: none; }
      /* wider gaps rather than bigger discs: the size is set inline per badge
         (diameter and font together), so growing them here would need
         !important and would leave the letters at the old ratio */
      .cb .misses { gap: 0.4rem; }

      .cb td.empty { grid-area: 1 / 1 / 2 / 3; text-align: center; padding: 2rem 0; }
    }

    /* Two pickers to a row stops fitting once the labels are 16px: the English
       "All committees" truncated to "All commit…" at 390px. One per row costs a
       little height and buys full labels and a full-width tap target. */
    @media (max-width: 460px) {
      .cb .sel { flex: 1 1 100%; }
    }
  </style>
