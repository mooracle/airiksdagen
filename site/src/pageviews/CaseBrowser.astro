    }
    .cb .tog input:checked + span .ic { color: var(--gold); }
    .cb .tog input:focus-visible + span { outline: 2.5px solid var(--accent); outline-offset: 2px; }

    /* ── party picker ───────────────────────────────────────────────────── */
    .cb .pdrop { position: relative; display: inline-flex; flex: 0 0 auto; }
    .cb .pbtn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      height: 2.3rem; padding: 0 0.5rem 0 0.6rem; width: 11.5rem;
      border: 1px solid var(--line); border-radius: var(--radius-sm);
      background: #fff; font-size: 0.88rem; color: var(--ink-2); cursor: pointer;
      font-family: inherit;
    }
    .cb .pbtn:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
    .cb .pbtn:focus-visible { outline: 2.5px solid var(--accent); outline-offset: 2px; }
    /* holds either the generic icon or the selected party's disc, at one size so
       the button does not jump width when you pick */
    .cb .pbtn-face { display: inline-flex; align-items: center; flex: none; }
    .cb .pbtn-face .ic { width: 1rem; height: 1rem; color: var(--muted); }
    .cb .pbtn-txt { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cb .pbtn .chev { width: 0.7rem; height: 0.7rem; flex: none; color: var(--muted); margin-left: auto; }
    .cb .pbtn[aria-expanded='true'] { border-color: var(--accent); }
    .cb .pbtn[aria-expanded='true'] .chev { transform: rotate(180deg); }
    /* the button reads as "on" the same way the flag pills do */
    .cb .pbtn.on { background: var(--accent-wash); border-color: var(--accent); color: var(--accent-ink); font-weight: 600; }

    .cb .pmenu {
      position: absolute; top: calc(100% + 0.3rem); left: 0; z-index: 20;
      min-width: 15rem; margin: 0; padding: 0.3rem; list-style: none;
      background: var(--panel); border: 1px solid var(--line);
      border-radius: var(--radius-sm); box-shadow: 0 10px 28px rgb(20 32 43 / 0.16);
      max-height: 20rem; overflow-y: auto;
    }
    .cb .pitem {
      display: flex; align-items: center; gap: 0.5rem;
      padding: 0.38rem 0.45rem; border-radius: var(--radius-sm);
      font-size: 0.88rem; color: var(--ink-2); cursor: pointer; user-select: none;
    }
    .cb .pitem .ic { width: 1rem; height: 1rem; color: var(--muted); flex: none; }
    .cb .pitem .nm { flex: 1; white-space: nowrap; }
    /* count of matching cases under the filters already set — right-aligned and
       tabular so the column scans as a distribution */
    .cb .pitem .n { font-size: 0.8rem; color: var(--muted); font-variant-numeric: tabular-nums; }
    .cb .pitem:hover, .cb .pitem.active { background: var(--accent-wash); }
    .cb .pitem[aria-selected='true'] { font-weight: 700; color: var(--accent-ink); }
    /* nothing to find under the current filters — still selectable, but it says so */
    .cb .pitem.zero .nm, .cb .pitem.zero .n { opacity: 0.45; }

    /* far right of the flag row, where it reads as "undo all of this" rather
       than as a fourth filter */
    .cb .clearbtn {
      height: 2.3rem; padding: 0 0.2rem; border: 0; background: none; cursor: pointer;
      font-size: 0.85rem; color: var(--accent); text-decoration: underline;
      text-underline-offset: 2px; margin-left: auto;
    }
    .cb .clearbtn:hover { color: var(--accent-ink); }

    .cb .count { font-variant-numeric: tabular-nums; }
    .cb .sr-only {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
      overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }
    .cb .table-wrap .hint { font-size: 0.8rem; }

    /* ── table ──────────────────────────────────────────────────────────── */
    /* `overflow: visible` is load-bearing. `.card.flush` sets `overflow: hidden`
       to clip its corners, and ANY non-visible overflow makes this element the
       nearest scroll container — at which point the sticky `thead` offsets itself
       inside the card instead of against the viewport, opening a gap at the top
       and hiding the first row behind it. Corners are rounded on the header cells
