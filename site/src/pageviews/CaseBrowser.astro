    .cb .pg { min-width: 2.15rem; height: 2.15rem; padding: 0 0.55rem; border: 1px solid var(--line); background: var(--panel); border-radius: var(--radius-sm); cursor: pointer; font-size: 0.9rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }
