      .cb .clearbtn { flex: 1 1 100%; text-align: right; }
      .cb .pmenu { min-width: min(17rem, calc(100vw - 3rem)); }

      /* The table stops being a table. Eight party discs need ~200px on their
         own, which pushed the grid to 508px inside a 390px viewport and set the
         whole PAGE scrolling sideways — `.table-wrap` is deliberately
         `overflow: visible` (see above), so the table cannot scroll within its
         own card and escapes instead.
         Each row becomes a stacked list item: date + reference, then the title,
         then the discs. Nothing overflows, the reference column that used to be
         hidden at this width comes back, and it reads like a list on a phone
         rather than a table with a third of it off-screen. */
      .cb .browser-table, .cb .browser-table tbody { display: block; }
      .cb .browser-table thead { display: none; }

      /* The wrapper gives up its own card chrome — otherwise every case is a
         card inside a card, and the outer border adds an edge that belongs to
         nothing you can tap. */
      .cb .table-wrap.card {
        background: none; border: 0; box-shadow: none; padding: 0; overflow: visible;
      }

      /* One card per case. A flat run of hairline-separated blocks gives the
         thumb no target edges — at this width the list is 50 things you scroll
         past, so each wants its own surface. */
      .cb .browser-table tbody tr {
        position: relative;
        display: grid; grid-template-columns: auto 1fr;
        padding: 0.7rem 0.85rem 0.75rem;
