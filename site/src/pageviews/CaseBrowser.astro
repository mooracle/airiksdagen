      .cb .browser-table tbody tr:hover td { background: none; }

      /* `tbody td` to out-specify the desktop row padding above (0-2-2, so a
         plain `td` reset loses to it and left every row 1.4rem too tall) */
      .cb .browser-table td, .cb .browser-table tbody td {
        display: block; width: auto; padding: 0; border: 0; white-space: normal;
      }
      /* Base's `.card.flush > table.compare td:first-child` gutter is (0,4,2) and
