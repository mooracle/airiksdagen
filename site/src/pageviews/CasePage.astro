---
import Base from '../layouts/Base.astro';
import ConfidenceMeter from '../components/ConfidenceMeter.astro';
import Hemicycle from '../components/Hemicycle.astro';
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, citationDocSlug, quoteFragment, type CaseData } from '../lib/data';
import { useTranslations, localePath, metaDescription, type Lang } from '../i18n/ui';

interface Props { lang: Lang; caseData: CaseData }
const { lang, caseData: c } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();

const voteLabels: Record<string, string> = {
  Ja: t('vote.Ja'), Nej: t('vote.Nej'), 'Avstår': t('vote.Avstår'), 'Frånvarande': t('vote.Frånvarande'),
};
const partyOrder = meta.hemicycle_order.filter((p) => c.actual[p] || c.ai[p]);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// canonical (sv) path of this page; localePath translates slug + prefix
const pagePath = `/fall/${c.votering_id}/`;

// On the English site, show translated case texts and AI reasoning where the
// translation batch has run; otherwise fall back to Swedish (marked below).
const en = lang === 'en' ? c.en : null;
const rubrik = en?.rubrik || c.rubrik;
const dokTitel = en?.dok_titel || c.dok_titel;
const forslagText = en?.forslag_text || c.forslag_text;
const notis = (en && c.notis ? en.notis : '') || c.notis;
// neutral, pre-decision "what this is about" lead (Swedish source — not yet translated)
const sammanfattning = c.sammanfattning;
// case-metadata layer: a specific, bilingual subject lead (replaces the generic
// utsknotis blurb for bundle votes) + a why-it-matters block + a topic chip.
// Everything falls back cleanly when a case has no metadata record yet.
const cmeta = c.meta;
const subject = cmeta ? (lang === 'sv' ? cmeta.subject.sv : cmeta.subject.en) : null;
const lead = subject || sammanfattning;
const atStake = cmeta ? (lang === 'sv' ? cmeta.at_stake.sv : cmeta.at_stake.en) : null;
const topicLabel = cmeta ? (meta.policy_areas?.[cmeta.policy_area]?.[lang] ?? null) : null;
const altTexts = c.alternatives.map((a, i) => (en?.alternatives?.[i] || a.text));
// casemeta brief: the contested axis + both sides' substance. Each part is optional
// so cases exported before the casemeta layer still render (the block is skipped).
const pick = (v: { sv: string; en: string } | null | undefined) =>
  v ? (lang === 'sv' ? v.sv : v.en) || null : null;
const decisionText = pick(cmeta?.decision);
const jaText = pick(cmeta?.ja);
// join each Nej to its alternative so the brief can label it the same way the
// Motförslag list does (raw "Reservation N" label + the parties behind it)
const altById = new Map(c.alternatives.map((a, i) => [a.alt_id, { ...a, shownText: altTexts[i] }]));
const nejItems = (cmeta?.nej ?? [])
  .map((n: { alt_id: string; sv: string; en: string }) => {
    const alt = altById.get(n.alt_id);
    return {
      alt_id: n.alt_id,
      text: pick(n),
      label: alt?.shownText ?? n.alt_id,
      partier: alt?.source_partier ?? [],
    };
  })
  .filter((n: { text: string | null }) => n.text);
const hasBrief = Boolean(decisionText || jaText || nejItems.length);
// Meta description: prefer the contested axis, then why-it-matters, then the
// subject — the utsknotis blurb is the last resort because it describes the
// whole betänkande rather than this vote, and repeats across bundled cases.
const metaDesc = metaDescription([decisionText, atStake, subject, sammanfattning]);
// Page title: `rubrik` is often a boilerplate committee heading reused across
// many unrelated votes ("Regeringens lagförslag" covers 71 of them), which made
// those titles indistinguishable in search results. The casemeta subject names
// THIS vote; the betänkande point disambiguates the few topics voted repeatedly.
// rm is part of the ref because committee codes recur every riksmöte (FiU26
// exists in several years), so beteckning+punkt alone still collided.
const pageTitle = `${subject || rubrik} · ${c.rm}:${c.beteckning} p.${c.punkt}`;
const aiEn = (code: string) => (lang === 'en' ? c.ai[code]?.en ?? null : null);

const docLabel: Record<string, string> = {
  valmanifest: lang === 'sv' ? 'valmanifest 2022' : '2022 manifesto',
  partiprogram: lang === 'sv' ? 'partiprogram' : 'party programme',
  tidoavtalet: 'Tidöavtalet',
};

const docsBase = localePath(lang, '/dokument/');

function citationHref(party: string, document: string, quote: string): string | null {
  if (!quote?.trim()) return null;  // unverifiable quotes are blanked — no text fragment to deep-link
  const slug = citationDocSlug(party, document, c.datum);
  if (!slug) return null;
  return `${docsBase}${slug}/#:~:text=${quoteFragment(quote)}`;
}

// The division re-run with every explicit-tier divergence moved onto the plan's
// side. Absent when no party qualifies; see pipeline/aidag/aivotes.py.
const flip = c.flip;

// MPs who voted differently from their party's majority position
const dissenters = c.seats
  .filter(([parti, rost]) => {
    const pos = c.actual[parti]?.position;
    return rost !== 'Frånvarande' && pos && pos !== 'Frånvarande' && rost !== pos;
  })
  .map(([parti, rost, namn, valkrets]) => ({ parti, rost, namn, valkrets, line: c.actual[parti].position }));

// absolute URLs for the share/embed box (correct once SITE_URL is set in CI)
const site = (Astro.site?.toString() ?? 'https://airiksdagen.se/').replace(/\/$/, '');
const pageAbsUrl = `${site}${localePath(lang, pagePath)}`;
const embedAbsUrl = `${site}${base}/embed/${c.votering_id}/`;
const embedSnippet = `<iframe src="${embedAbsUrl}" width="100%" height="430" style="border:1px solid #ddd;border-radius:8px" title="AI Riksdag: ${(en?.rubrik || c.rubrik).replace(/"/g, "'")}" loading="lazy"></iframe>`;

// per-party document references used in this case (deduped), for the study box
const docRefs = partyOrder
  .filter((p) => c.ai[p])
  .map((p) => ({
    party: p,
    docs: [...new Set(c.ai[p].citations.map((cit) => cit.document))].map((d) => ({
      document: d,
      slug: citationDocSlug(p, d, c.datum),
    })),
  }))
  .filter((r) => r.docs.length > 0);

// Structured data for this case. Base fills in context, publisher, canonical
// @id and the build dates; everything here is case-specific.
// `headline` is clipped to 110 characters because Google ignores longer ones —
// the subject leads, so the clip only ever loses the betänkande reference.
// The vote itself is modelled as the `about` Event rather than folded into the
// article dates: `datum` is when the chamber voted, which is a different fact
// from when this analysis was published, and conflating them would misdate
// every page by up to four years.
const caseJsonLd = {
  '@type': 'Article',
  headline: metaDescription([pageTitle], 110),
  ...(metaDesc ? { description: metaDesc } : {}),
  about: {
    '@type': 'Event',
    name: subject || rubrik,
    startDate: c.datum,
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: {
      '@type': 'Place',
      name: lang === 'sv' ? 'Sveriges riksdag' : 'The Swedish Riksdag',
      address: { '@type': 'PostalAddress', addressLocality: 'Stockholm', addressCountry: 'SE' },
    },
    ...(atStake ? { description: atStake } : {}),
  },
  ...(topicLabel ? { articleSection: topicLabel } : {}),
  ...(cmeta?.subtopics?.length ? { keywords: cmeta.subtopics.join(', ') } : {}),
  // the primary sources this page is derived from
  isBasedOn: [c.riksdagen_url, c.fulltext_url, c.votering_url].filter(Boolean),
  // What the analysis actually cites: the party documents the agents quoted.
  // Deliberately NOT c.references — those are every motion bundled into the
  // betänkande (~50 of them, on unrelated subjects), so listing them here would
  // claim a climate-adaptation page cites "Sveriges 13 sämsta lagar".
  ...(docRefs.length
    ? {
        // `url` only where the corpus page exists — citationDocSlug returns null
        // for documents we cite but don't host (partiprogram), and pointing at
        // /dokument/null/ would put a dead link in the structured data.
        citation: docRefs.flatMap((r) =>
          r.docs.map((d) => ({
            '@type': 'CreativeWork',
            name: `${meta.parties[r.party]?.name ?? r.party}: ${docLabel[d.document] ?? d.document}`,
            ...(d.slug ? { url: `${site}${docsBase}${d.slug}/` } : {}),
          })),
        ),
      }
    : {}),
};
---

<Base
  lang={lang}
  title={pageTitle}
  description={metaDesc}
  path={pagePath}
  ogType="article"
  jsonLd={caseJsonLd}
>
  <p>
    <span class="chip">{c.datum}</span>
    <span class="chip">{c.rm}:{c.beteckning} · p.{c.punkt}</span>
    <span class="chip">{c.utskott}</span>
    {topicLabel && <span class="chip topic">{topicLabel}</span>}
  </p>
  <h1>{rubrik}</h1>
  {/* the metadata subject supersedes the raw betänkande title as the deck;
      only show the muted dok_titel line when there's no subject (fallback) */}
  {!subject && c.dok_titel !== c.rubrik && <p class="muted">{dokTitel}</p>}
  {lead && <p class="summary">{lead}</p>}
  {atStake && (
    <p class="atstake"><strong>{t('case.atStake')}:</strong> {atStake}</p>
  )}
  {lang === 'en' && (
    <p class="muted mtnote">{c.en ? t('case.mtNote') : t('case.notTranslated')}</p>
  )}

  {hasBrief && (
    <section class="brief">
      <h2>{t('case.brief')}</h2>
      {decisionText && <p class="brief-decision">{decisionText}</p>}
      {jaText && (
        <div class="card brief-side" data-side="Ja">
          <p class="brief-head"><span class="votechip" data-v="Ja">{voteLabels.Ja}</span> {t('case.briefJa')}</p>
          <p class="brief-body">{jaText}</p>
        </div>
      )}
      {nejItems.length > 0 && (
        <div class="card brief-side" data-side="Nej">
          <p class="brief-head"><span class="votechip" data-v="Nej">{voteLabels.Nej}</span> {t('case.briefNej')}</p>
          {nejItems.map((n) => (
            <div class="brief-alt">
              <p class="brief-altlabel">
                {n.label}
                {n.partier.length > 0 && <span class="muted"> ({n.partier.join(', ')})</span>}
              </p>
              <p class="brief-body">{n.text}</p>
            </div>
          ))}
        </div>
      )}
      <p class="muted briefnote">{t('case.briefNote')}</p>
    </section>
  )}

  <Hemicycle
    seats={c.seats}
    parties={meta.parties}
    ai={c.ai}
    actual={c.actual}
    voteLabels={voteLabels}
  />

  {/* The same division re-run with only the documented commitments moved. Sits
      directly under the chamber it re-runs. Rendered whenever any party
      qualifies, not only when the outcome changes: "these commitments were
      broken and the decision still held" is a result too, and showing it only
      on the 324 divisions that flip would make the marking look like the whole
      story. See aivotes.flip(). */}
  {flip && (
    <div class={flip.flips ? 'card flipbox hot' : 'card flipbox'}>
      <p class="fb-head">
        <span class="fb-mark" aria-hidden="true">⇄</span>
        {/* A tie is its own answer, not a held decision: the Riksdag settles it
            by lot, so neither side can be claimed. */}
        <strong>
          {flip.flips
            ? t('flip.caseFlips')
            : flip.counterfactual.outcome == null || flip.actual.outcome == null
              ? t('flip.caseTied')
              : t('flip.caseHolds')}
        </strong>
      </p>
      <p class="fb-who">
        {t('flip.caseWho')}{' '}
        {flip.parties.map((p, i) => (
          <>
            {i > 0 && <span class="muted">, </span>}
            <PartyBadge code={p} parties={meta.parties} size={19} label="name" />
          </>
        ))}
      </p>
      <p class="fb-counts">
        <span class="votechip" data-v={flip.actual.outcome}>{flip.actual.outcome ?? '–'}</span>
        <span class="muted"> {flip.actual.ja}–{flip.actual.nej}</span>
        <span class="fb-arrow" aria-hidden="true">→</span>
        <span class="votechip" data-v={flip.counterfactual.outcome}>{flip.counterfactual.outcome ?? t('flip.tie')}</span>
        <span class="muted"> {flip.counterfactual.ja}–{flip.counterfactual.nej}</span>
      </p>
      <p class="muted fb-note">{t('flip.caseNote')}</p>
    </div>
  )}

  {c.compact && (
    <>
      <h2>{t('case.meanings')}</h2>
      <div class="card meanings">
        <p><span class="votechip" data-v="Ja">{voteLabels.Ja}</span> {lang === 'sv' ? c.compact.ja_sv : c.compact.ja_en}</p>
        <p><span class="votechip" data-v="Nej">{voteLabels.Nej}</span> {lang === 'sv' ? c.compact.nej_sv : c.compact.nej_en}</p>
        <p><span class="votechip" data-v="Avstår">{voteLabels['Avstår']}</span> {lang === 'sv' ? c.compact.avstar_sv : c.compact.avstar_en}</p>
      </div>
    </>
  )}

  <h2>{t('case.ai')} / {t('case.actual')}</h2>
  <div class="tablewrap">
  <table class="compare tight">
    <thead>
      <tr>
        <th></th>
        <th>{t('col.plan')}</th>
        <th>{t('col.vote')}</th>
        <th></th>
        <th>{t('col.conf')}</th>
        <th>{t('col.tier')}</th>
      </tr>
    </thead>
    <tbody>
      {partyOrder.map((code) => {
        const d = c.ai[code];
        const a = c.actual[code];
        const comparable = a && a.position !== 'Frånvarande';
        const isMatch = d && comparable && d.rost === a.position;
        return (
          <tr id={`vote-${code}`}>
            <td>
              <PartyBadge code={code} parties={meta.parties} label="none" />
              {a?.authored_reservation && (
                <span
                  class="authored"
                  style={`--pc:${meta.parties[code]?.color ?? 'var(--muted)'}`}
                  title={`${t('coalition.ownRes')} — ${t('coalition.ownResTip')}`}
                >
                  <svg viewBox="0 0 12 14" aria-hidden="true" focusable="false">
                    <path d="M1.9 0.8h5L10.1 4v9.2H1.9z" fill="currentColor" opacity="0.18" />
                    <path
                      d="M1.9 0.8h5L10.1 4v9.2H1.9zM6.9 0.9V4h3.1"
                      fill="none" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round"
                    />
                    <path d="M4 7.3h4M4 9.7h4" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" />
                  </svg>
                  <span class="srtext">{t('coalition.ownRes')}</span>
                </span>
              )}
            </td>
            {/* p6: the stance is what the agent decided and the vote chip is
                DERIVED from it — strictly 1:1 across the whole corpus (avvisar→Ja,
                stodjer→Nej), so spelling the stance out beside the chip restated
                the same fact in words on every single row. The chip alone carries
                it; the full sentence lives in the tooltip. On p4/p5 runs `hallning`
                is null and the chip is simply the vote, exactly as before. */}
            <td>
              {d ? (
                <span
                  class="votechip"
                  data-v={d.rost}
                  title={d.hallning ? t(`stance.${d.hallning}` as any) : undefined}
                >{voteLabels[d.rost]}</span>
              ) : <span class="muted">–</span>}
            </td>
            <td>
              {a ? (
                <>
                  <span class="votechip" data-v={a.position}>{voteLabels[a.position]}</span>
                  <span class="counts muted" title={t('case.countsTip')}> {a.n_ja}/{a.n_nej}/{a.n_avstar}/{a.n_franvarande}</span>
                </>
              ) : <span class="muted">–</span>}
            </td>
            {/* Verdict and the override flag are glyph-only: both repeat down the
                column, and the word added nothing the ✓/✕ did not already say.
                Each keeps its meaning in `title` and in .srtext for screen
                readers, which read no glyph at all otherwise. */}
            <td class="c-verdict">
              {d && comparable && (
                <span
                  class={isMatch ? 'match' : 'mismatch'}
                  title={isMatch ? t('case.match') : t('case.mismatch')}
                >
                  <span aria-hidden="true">{isMatch ? '✓' : '✕'}</span>
                  <span class="srtext">{isMatch ? t('case.match') : t('case.mismatch')}</span>
                </span>
              )}
              {d?.program_override && (
                <span class="flag" title={`${t('coalition.override')}${d.program_override === 'strict' ? '' : '*'} — ${t('coalition.overrideTip')}`}>
                  <span aria-hidden="true">⚑{d.program_override === 'strict' ? '' : '*'}</span>
                  <span class="srtext">{t('coalition.override')}</span>
                </span>
              )}
            </td>
            {/* Confidence as a three-dot meter: low/medium/high is ordinal, so a
                filled-dot scale is read at a glance where the word had to be
                actually read. It also fixes the raw English "low"/"medium"/"high"
                that leaked onto the Swedish page — the level is now localized in
                the tooltip and the screen-reader text. */}
            <td class="c-conf">
              {d?.confidence && <ConfidenceMeter lang={lang} level={d.confidence} />}
            </td>
            <td class="muted">
              {d?.tier
                ? <span class="tier" data-tier={d.tier} title={t(`tier.${d.tier}Tip` as any)}>{t(`tier.${d.tier}Short` as any)}</span>
                : d ? t(`coverage.${d.coverage}` as any) : ''}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  </div>

  {dissenters.length > 0 && (
    <>
      <h2>{t('case.dissenters')}</h2>
      <div class="card">
        <table class="compare">
          <tbody>
            {dissenters.map((d) => (
              <tr>
                <td><span class="pbadge-wrap"><PartyBadge code={d.parti} parties={meta.parties} size={18} /><strong>{d.namn}</strong></span> <span class="muted">({d.parti}, {d.valkrets})</span></td>
                <td>
                  <span class="votechip" data-v={d.rost}>{voteLabels[d.rost]}</span>
                  <span class="muted"> — {t('case.dissentLine')}: </span>
                  <span class="votechip" data-v={d.line}>{voteLabels[d.line]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="muted" style="font-size:0.82rem;margin:0.5rem 0 0">{t('case.dissentersNote')}</p>
      </div>
    </>
  )}

  <h2>{t('case.committee')}</h2>
  <div class="card">
    <p style="white-space:pre-line; margin:0">{forslagText}</p>
    {en && (
      <details class="original">
        <summary>{t('case.originalSv')}</summary>
        <p style="white-space:pre-line">{c.forslag_text}</p>
      </details>
    )}
  </div>
  {c.notis && (
    <div class="card">
      <p style="margin:0"><strong>{t('case.decision')}:</strong> {notis}</p>
    </div>
  )}
  {c.alternatives.filter((a) => a.alt_id !== 'utskottet').length > 0 && (
    <>
      <h2>{t('case.alternatives')}</h2>
      <ul>
        {c.alternatives.map((a, i) => ({ ...a, shownText: altTexts[i] })).filter((a) => a.alt_id !== 'utskottet').map((a) => {
          const sub = a.substance ? (lang === 'sv' ? a.substance.sv : a.substance.en) : null;
          return (
            <li>
              {sub ? <span>{sub}</span> : a.shownText}
              {a.source_partier.length > 0 && <span class="muted"> ({a.source_partier.join(', ')})</span>}
              {sub && <span class="muted altlabel"> — {a.shownText}</span>}
            </li>
          );
        })}
      </ul>
    </>
  )}

  {Object.keys(c.ai).length > 0 && (
    <>
      <h2>{t('case.planVsReal')}</h2>
      <p class="muted mapnote">{t('case.planVsRealIntro')}</p>
      {/* One card per party, in hemicycle order so this reads as the same map as
          the table above. Divergences are highlighted rather than split into
          their own section: a party that voted WITH a well-cited plan is as much
          a result as one that voted against it, and giving only the deviations a
          heading framed the page around them. Every party's reasoning is the
          same one click away; the summary line carries the comparison so the map
          is complete unopened. */}
      {partyOrder.filter((p) => c.ai[p]).map((code) => {
        const d = c.ai[code];
        const dEn = aiEn(code);
        const a = c.actual[code];
        const comparable = a && a.position !== 'Frånvarande';
        const isMatch = comparable && d.rost === a.position;
        const diverges = comparable && !isMatch;
        // the decisive citation is the first NON-weak one; a weak (svag) broad
        // principle is never labelled decisive (-1 if the decision has only weak)
        const decIdx = d.citations.findIndex((x) => !x.svag);
        // The plan documents this party's decision rests on — formerly its own
        // table further down the page, which meant scrolling away from the
        // reasoning to find out what the reasoning was reading. One deduped list
        // per party, next to that party's answer.
        const partyDocs = [...new Set(d.citations.map((cit) => cit.document))].map((doc) => ({
          doc,
          slug: citationDocSlug(code, doc, c.datum),
        }));
        // Always-visible gist: the first sentence of the reasoning, so the
        // collapsed card says WHY, not just what. Falls back to a clipped
        // snippet when the text has no sentence break.
        const full = dEn?.motivering || d.motivering || '';
        const firstStop = full.search(/[.!?](\s|$)/);
        const gist = firstStop > 40 ? full.slice(0, firstStop + 1) : metaDescription([full], 150);
        return (
          <div
            class="card partycard"
            data-diverges={diverges ? 'true' : undefined}
            style={`--pc:${meta.parties[code]?.color ?? 'var(--muted)'}`}
          >
            <div class="pc-head">
              <span class="pc-who">
                <PartyBadge code={code} parties={meta.parties} size={20} />
                <strong>{meta.parties[code]?.name ?? code}</strong>
              </span>
              <span class="pc-cmp">
                <span class="votechip" data-v={d.rost} title={d.hallning ? t(`stance.${d.hallning}` as any) : undefined}>{voteLabels[d.rost]}</span>
                <span class="pc-arrow" aria-hidden="true">→</span>
                {a
                  ? <span class="votechip" data-v={a.position}>{voteLabels[a.position]}</span>
                  : <span class="muted">–</span>}
                {comparable && (
                  <span class={isMatch ? 'match' : 'mismatch'} title={isMatch ? t('case.match') : t('case.mismatch')}>
                    <span aria-hidden="true">{isMatch ? '✓' : '✕'}</span>
                    <span class="srtext">{isMatch ? t('case.match') : t('case.mismatch')}</span>
                  </span>
                )}
                {d.tier && (
                  <span class="tier" data-tier={d.tier} title={t(`tier.${d.tier}Tip` as any)}>
                    {t(`tier.${d.tier}Short` as any)}
                  </span>
                )}
              </span>
            </div>
            {gist && <p class="pc-gist">{gist}</p>}
            {partyDocs.length > 0 && (
              <p class="pc-docs">
                <span class="muted">{t('case.docrefs')}:</span>{' '}
                {partyDocs.map((pd, i) => (
                  <>
                    {i > 0 && <span class="muted"> · </span>}
                    {pd.slug
                      ? <a href={`${docsBase}${pd.slug}/`}>{docLabel[pd.doc] ?? pd.doc}</a>
                      : <span class="muted">{docLabel[pd.doc] ?? pd.doc}</span>}
                  </>
                ))}
              </p>
            )}
            <details class="pc-more">
            <summary>{t('case.showReasoning')}</summary>
            <p>{dEn?.motivering || d.motivering}</p>
            {dEn?.motivering && (
              <details class="original">
                <summary>{t('case.originalSv')}</summary>
                <p>{d.motivering}</p>
              </details>
            )}
            {d.citations.length > 0 && (
              <ul>
                {d.citations.map((cit, i) => {
                  const href = citationHref(code, cit.document, cit.quote);
                  const citEn = dEn?.citations?.[i] ?? null;
                  return (
                    <li class={cit.svag ? 'weakcite' : undefined}>
                      {(citEn?.princip || cit.princip) && <span class="chip">{citEn?.princip || cit.princip}</span>}
                      {i === decIdx && <span class="chip" style="background:#e5efdb">{t('case.decisive')}</span>}
                      {cit.svag && <span class="chip weak" title={t('case.weakCiteTip')}>{t('case.weakCite')}</span>}
                      {cit.quote && <><em>»{cit.quote}«</em>{' '}</>}
                      {href ? (
                        <a class="muted" href={href}>({docLabel[cit.document] ?? cit.document} ↗)</a>
                      ) : (
                        <span class="muted">({docLabel[cit.document] ?? cit.document})</span>
                      )}
                      {citEn?.quote && <span class="qtrans">“{citEn.quote}”</span>}
                    </li>
                  );
                })}
              </ul>
            )}
            {d.omvarld?.paverkar && d.omvarld.faktorer.length > 0 && (
              <p class="omvarld">
                <strong>{t('case.omvarld')}:</strong>{' '}
                {d.omvarld.faktorer.map((f, i) => {
                  const fEn = dEn?.omvarld?.[i] ?? null;
                  return <span>{i > 0 && '; '}<em>{fEn?.faktor || f.faktor}</em> — {fEn?.effekt || f.effekt}</span>;
                })}
              </p>
            )}
            {d.flags.length > 0 && <p class="muted">flags: {d.flags.join(', ')}</p>}
            {/* Only an explicit-tier divergence supports "the party voted against
                its own stated commitment"; anything weaker gets the honest note.
                It lives inside the disclosure because it is the same two
                sentences on every diverging card — printed always-visible it
                became wallpaper and stopped being read at all. The tier chip
                carries the short version in its tooltip. */}
            {diverges && (
              <p class="mm-note">
                {d.tier && d.tier !== 'explicit'
                  ? t('case.planVsRealNoteWeak')
                  : t('case.planVsRealNote')}
              </p>
            )}
            </details>
          </div>
        );
      })}
    </>
  )}

  <h2>{t('case.share')}</h2>
  <div class="card sharebox">
    <label>
      <span>{t('case.shareLink')}</span>
      <span class="row">
        <input type="text" readonly value={pageAbsUrl} data-copy />
        <button class="btn ghost" type="button" data-copybtn>{t('case.copy')}</button>
      </span>
    </label>
    <label>
      <span>{t('case.sharePartyLink')}</span>
      <span class="row">
        <select data-partysel>
          {partyOrder.map((code) => <option value={code}>{meta.parties[code]?.name ?? code}</option>)}
        </select>
        <input type="text" readonly value={`${pageAbsUrl}#vote-${partyOrder[0]}`} data-copy data-partylink />
        <button class="btn ghost" type="button" data-copybtn>{t('case.copy')}</button>
      </span>
    </label>
    <label>
      <span>{t('case.shareEmbed')} <a href={embedAbsUrl} target="_blank" rel="noopener">{t('case.embedPreview')}</a></span>
      <span class="row">
        <textarea readonly rows="3" data-copy>{embedSnippet}</textarea>
        <button class="btn ghost" type="button" data-copybtn>{t('case.copy')}</button>
      </span>
    </label>
  </div>

  <h2>{t('case.sources')}</h2>
  <div class="card">
    <ul class="srclist">
      <li><a href={c.riksdagen_url}>{t('case.sources.bet')}</a> <span class="muted">({c.rm}:{c.beteckning})</span></li>
      <li><a href={c.fulltext_url}>{t('case.sources.fulltext')}</a> <span class="muted">({c.dok_id})</span></li>
      <li><a href={c.votering_url}>{t('case.sources.votering')}</a></li>
      <li><a href={c.source_url}>{t('case.sources.status')}</a></li>
    </ul>
    {c.references.length > 0 && (
      <>
        <p style="margin:0.8rem 0 0.3rem"><strong>{t('case.sources.refs')}</strong></p>
        <ul class="srclist">
          {c.references.map((r) => (
            <li>
              <a href={`https://data.riksdagen.se/dokument/${r.dok_id}.html`}>{r.label}</a>
              {r.titel && <span class="muted"> — {r.titel}</span>}
              {r.undertitel && <span class="muted"> {r.undertitel}</span>}
            </li>
          ))}
        </ul>
      </>
    )}
    <p class="muted" style="font-size:0.82rem;margin:0.8rem 0 0">{t('case.source')}</p>
  </div>

  <script is:inline define:vars={{ pageAbsUrl }}>
    for (const btn of document.querySelectorAll('[data-copybtn]')) {
      btn.addEventListener('click', () => {
        const field = btn.parentElement.querySelector('[data-copy]');
        navigator.clipboard.writeText(field.value ?? field.textContent).then(() => {
          const old = btn.textContent;
          btn.textContent = '✓';
          setTimeout(() => (btn.textContent = old), 1200);
        });
      });
    }
    const sel = document.querySelector('[data-partysel]');
    const link = document.querySelector('[data-partylink]');
    if (sel && link) {
      sel.addEventListener('input', () => {
        link.value = `${pageAbsUrl}#vote-${sel.value}`;
      });
    }
  </script>

  <style>
    /* The plan's stance — the p6 product. Sits immediately before the vote chip
       it implies, so the derivation reads left to right. */
    .stance {
      display: inline-block; margin-right: 0.4rem; font-size: 0.78rem;
      color: var(--ink-2); white-space: nowrap; cursor: help;
    }
    /* Evidence tier. Only `explicit` is emphasised — the weaker tiers must not
       look like a verdict, so they stay grey and quiet. */
    .tier {
      display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.4rem;
      border-radius: 4px; font-size: 0.7rem; font-weight: 600; white-space: nowrap;
      vertical-align: middle; cursor: help; background: #ecebe6; color: #5d5a52;
    }
    .tier[data-tier='explicit'] { background: #d8e8d2; color: #2f5326; }
    /* Glyph-only cells need a text equivalent: a screen reader announces nothing
       for ✓/✕/⚑ and cannot reach a `title`, so the label is kept in the DOM and
       hidden visually rather than dropped. */
    .srtext {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0;
    }
    .compare.tight th, .compare.tight td { padding: 0.42rem 0.55rem; }
    /* Phone: six columns cannot all keep full width at 390px. The per-vote
       breakdown is the one cell that is reference detail rather than the
       comparison itself, so it collapses first (still in the DOM, still in the
       chip's tooltip). .tablewrap is the safety net — if a long tier label or a
       large font still overflows, the table scrolls inside its own box instead
       of forcing the whole page sideways. */
    .tablewrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    @media (max-width: 640px) {
      .compare.tight th, .compare.tight td { padding: 0.4rem 0.3rem; }
      .compare.tight .counts { display: none; }
      /* The last two columns are sized by their label, not their data — a 30px
         dot meter under a 95px "CONFIDENCE", and a tier chip held on one line.
         Shrinking the header and letting the chip wrap costs nothing a reader
         needs, and is better than abbreviating both to something cryptic. */
      .compare.tight th { font-size: 0.66rem; letter-spacing: 0.03em; }
      .compare.tight .tier { white-space: normal; }
    }
    /* Small phones (SE/mini). Past this the table would scroll inside .tablewrap
       — which is fine, but a slightly smaller header buys the last ~15px and
       keeps all six columns on screen instead. */
    @media (max-width: 430px) {
      .compare.tight th { font-size: 0.6rem; }
      .compare.tight .votechip { padding: 0.1rem 0.45rem; }
    }
    .c-verdict { white-space: nowrap; }
    .c-verdict .match, .c-verdict .mismatch { font-size: 1.02rem; cursor: help; }
    .flag { margin-left: 0.3rem; color: #7a4b12; font-size: 0.88rem; cursor: help; }
    /* "Authored the reservation": a document in the party's own colour — it is
       the party's own paper being voted down. Mixed toward ink because the raw
       brand colours are not all legible on the warm paper (SD yellow, MP lime
       and M sky-blue vanish otherwise), which is the same problem .pbadge
       solves with a hairline ring. */
    .authored {
      display: inline-flex; vertical-align: middle; margin-left: 0.35rem; cursor: help;
      color: color-mix(in srgb, var(--pc) 72%, var(--ink));
    }
    .authored svg { display: block; width: 11px; height: 13px; }
    /* Header/content alignment: .tier and .tag carry a left margin so they can
       sit after a chip inline in the cards below, but in the table they are the
       cell's only content and that margin pushed them off their <th>. */
    .compare .tier { margin-left: 0; }
    .c-conf { width: 3.2rem; }
    .tag {
      display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.4rem;
      border-radius: 4px; font-size: 0.7rem; font-weight: 600; white-space: nowrap;
      vertical-align: middle; cursor: help;
    }
    .tag.own { background: #eceae2; color: #55524a; }
    .omvarld { background: #eef3f8; border-radius: 6px; padding: 0.5rem 0.8rem; font-size: 0.88rem; }
    .summary { font-size: 1.05rem; line-height: 1.6; color: var(--ink-2); max-width: 46rem; margin: 0.55rem 0 0.2rem; }
    .atstake { font-size: 0.95rem; line-height: 1.55; color: var(--ink-2); max-width: 46rem; margin: 0.4rem 0 0.2rem; padding: 0.5rem 0.8rem; background: #eef3f8; border-radius: 6px; }
    .chip.topic { background: #e5efdb; color: #3f5a2a; font-weight: 600; }
    /* casemeta brief — the contested axis, then the Ja and Nej substance side by side */
    .brief { max-width: 46rem; }
    .brief-decision { font-size: 0.98rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 0.8rem; }
    .brief-side { margin-bottom: 0.7rem; border-left: 4px solid var(--muted); }
    .brief-side[data-side='Ja'] { border-left-color: #2f7d4f; }
    .brief-side[data-side='Nej'] { border-left-color: #a8452f; }
    .brief-head { margin: 0 0 0.5rem; font-weight: 600; font-size: 0.92rem; }
    .brief-head .votechip { min-width: 4.2rem; text-align: center; margin-right: 0.5rem; }
    .brief-body { margin: 0; font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); }
    .brief-alt + .brief-alt { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--rule, #e3e3e3); }
    .brief-altlabel { margin: 0 0 0.2rem; font-size: 0.85rem; font-weight: 600; }
    .briefnote { font-size: 0.78rem; font-style: italic; margin: 0.3rem 0 0; }
    .mtnote { font-size: 0.8rem; font-style: italic; }
    .qtrans { display: block; margin-top: 0.25rem; font-size: 0.92em; color: var(--muted); font-style: italic; }
    details.original { margin-top: 0.5rem; font-size: 0.88rem; }
    details.original summary { color: var(--muted); cursor: pointer; }
    .mm-note { font-size: 0.8rem; margin: 0.5rem 0 0; }
    .mapnote { font-size: 0.86rem; margin: -0.4rem 0 0.9rem; max-width: 46rem; }
    /* Per-party card. Every party gets the same shape; a divergence is marked by
       the party's own colour on the left edge and a tinted surface, not by being
       moved somewhere else. */
    .partycard { border-left: 3px solid transparent; }
    .partycard[data-diverges] {
      border-left-color: var(--pc);
      background: linear-gradient(90deg, color-mix(in srgb, var(--pc) 6%, var(--panel)), var(--panel) 22rem);
    }
    .pc-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 0.6rem 0.9rem; flex-wrap: wrap;
    }
    .pc-who { display: inline-flex; align-items: center; gap: 0.45rem; min-width: 0; }
    /* Always visible, so a closed card still answers "why" and "on what" —
       the disclosure below holds the full reasoning and every quote. */
    .pc-gist { margin: 0.5rem 0 0; font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); }
    .pc-docs { margin: 0.4rem 0 0; font-size: 0.84rem; }
    /* The "more info" affordance: a real button-ish target rather than a bare
       word, with a chevron that turns on open so the state is visible. */
    .pc-more { margin-top: 0.6rem; }
    .pc-more > summary {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.22rem 0.7rem 0.22rem 0.55rem; border: 1px solid var(--line);
      border-radius: 999px; background: var(--panel-2);
      font-size: 0.82rem; font-weight: 600; color: var(--accent);
      cursor: pointer; list-style: none;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .pc-more > summary::-webkit-details-marker { display: none; }
    .pc-more > summary::before {
      content: ''; flex: none;
      border-left: 5px solid currentColor;
      border-top: 4px solid transparent; border-bottom: 4px solid transparent;
      transition: transform 0.15s ease;
    }
    .pc-more[open] > summary::before { transform: rotate(90deg); }
    .pc-more > summary:hover {
      background: var(--accent-wash); border-color: var(--accent); color: var(--accent-ink);
    }
    .pc-more > p:first-of-type { margin-top: 0.7rem; }
    /* the tier caveat, closing the disclosure — set apart from the reasoning */
    .pc-more .mm-note {
      margin: 0.8rem 0 0; padding-top: 0.6rem; border-top: 1px solid var(--line-soft);
      color: var(--muted);
    }
    .pc-cmp { display: inline-flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
    /* plan → actual, so the summary reads as the same comparison as the table */
    .pc-arrow { color: var(--muted); font-size: 0.9rem; }
    .pc-cmp .match, .pc-cmp .mismatch { font-size: 1rem; cursor: help; }
    .pc-cmp .tier { margin-left: 0; }
    @media (max-width: 560px) {
      .partycard > summary { gap: 0.35rem 0.6rem; }
      .pc-cmp { font-size: 0.94rem; }
    }
    .srclist { margin: 0.2rem 0; padding-left: 1.2rem; }
    .srclist li { margin: 0.25rem 0; }
    .meanings p { margin: 0.45rem 0; }
    .meanings .votechip { min-width: 4.2rem; text-align: center; margin-right: 0.5rem; }
    /* counterfactual outcome. The gold left edge is only drawn when the decision
       actually changes — otherwise this is a null result and should not shout. */
    .flipbox { border-left: 3px solid var(--line); }
    .flipbox.hot { border-left-color: var(--gold, #d9a441); background: #fdfaf2; }
    .flipbox p { margin: 0.4rem 0; }
    .flipbox .fb-head { display: flex; align-items: center; gap: 0.5rem; margin-top: 0; }
    .flipbox .fb-mark {
      display: inline-flex; align-items: center; justify-content: center;
      width: 22px; height: 22px; border-radius: 50%; flex: 0 0 auto;
      background: var(--line); color: var(--ink-2); font-size: 13px; font-weight: 700;
    }
    .flipbox.hot .fb-mark { background: var(--gold, #d9a441); color: #1a1712; }
    .flipbox .fb-who { font-size: 0.92rem; }
    .flipbox .fb-who .pbadge-wrap { display: inline-flex; align-items: center; gap: 0.3rem; }
    .flipbox .fb-counts {
      display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;
      font-variant-numeric: tabular-nums;
    }
    .flipbox .fb-arrow { color: var(--muted); margin: 0 0.25rem; }
    .flipbox .fb-note { font-size: 0.8rem; margin-bottom: 0; }
    .sharebox label { display: block; margin-bottom: 0.9rem; font-size: 0.86rem; color: var(--muted); }
    .sharebox label > span:first-child { display: block; margin-bottom: 0.25rem; }
    .sharebox .row { display: flex; gap: 0.5rem; }
    .sharebox input[type='text'], .sharebox textarea { flex: 1; font-size: 0.84rem; font-family: ui-monospace, Menlo, monospace; }
    .sharebox textarea { resize: vertical; }
  </style>
</Base>
