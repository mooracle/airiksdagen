---
import Base from '../layouts/Base.astro';
import Hemicycle from '../components/Hemicycle.astro';
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, citationDocSlug, quoteFragment, type CaseData } from '../lib/data';
import { useTranslations, localePath, metaDescription, type Lang } from '../i18n/ui';

interface Props { lang: Lang; caseData: CaseData }
const { lang, caseData: c } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();

const voteLabels: Record<string, string> = {
  Ja: t('vote.Ja'), Nej: t('vote.Nej'), 'Avstår': t('vote.Avstår'), 'Frånvarande': t('vote.Frånvarande'),
};
const partyOrder = meta.hemicycle_order.filter((p) => c.actual[p] || c.ai[p]);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// canonical (sv) path of this page; localePath translates slug + prefix
const pagePath = `/fall/${c.votering_id}/`;

// On the English site, show translated case texts and AI reasoning where the
// translation batch has run; otherwise fall back to Swedish (marked below).
const en = lang === 'en' ? c.en : null;
const rubrik = en?.rubrik || c.rubrik;
const dokTitel = en?.dok_titel || c.dok_titel;
const forslagText = en?.forslag_text || c.forslag_text;
const notis = (en && c.notis ? en.notis : '') || c.notis;
// neutral, pre-decision "what this is about" lead (Swedish source — not yet translated)
const sammanfattning = c.sammanfattning;
// case-metadata layer: a specific, bilingual subject lead (replaces the generic
// utsknotis blurb for bundle votes) + a why-it-matters block + a topic chip.
// Everything falls back cleanly when a case has no metadata record yet.
const cmeta = c.meta;
const subject = cmeta ? (lang === 'sv' ? cmeta.subject.sv : cmeta.subject.en) : null;
const lead = subject || sammanfattning;
const atStake = cmeta ? (lang === 'sv' ? cmeta.at_stake.sv : cmeta.at_stake.en) : null;
const topicLabel = cmeta ? (meta.policy_areas?.[cmeta.policy_area]?.[lang] ?? null) : null;
const altTexts = c.alternatives.map((a, i) => (en?.alternatives?.[i] || a.text));
// casemeta brief: the contested axis + both sides' substance. Each part is optional
// so cases exported before the casemeta layer still render (the block is skipped).
const pick = (v: { sv: string; en: string } | null | undefined) =>
  v ? (lang === 'sv' ? v.sv : v.en) || null : null;
const decisionText = pick(cmeta?.decision);
const jaText = pick(cmeta?.ja);
// join each Nej to its alternative so the brief can label it the same way the
// Motförslag list does (raw "Reservation N" label + the parties behind it)
const altById = new Map(c.alternatives.map((a, i) => [a.alt_id, { ...a, shownText: altTexts[i] }]));
const nejItems = (cmeta?.nej ?? [])
  .map((n: { alt_id: string; sv: string; en: string }) => {
    const alt = altById.get(n.alt_id);
    return {
      alt_id: n.alt_id,
      text: pick(n),
      label: alt?.shownText ?? n.alt_id,
      partier: alt?.source_partier ?? [],
    };
  })
  .filter((n: { text: string | null }) => n.text);
const hasBrief = Boolean(decisionText || jaText || nejItems.length);
// Meta description: prefer the contested axis, then why-it-matters, then the
// subject — the utsknotis blurb is the last resort because it describes the
// whole betänkande rather than this vote, and repeats across bundled cases.
const metaDesc = metaDescription([decisionText, atStake, subject, sammanfattning]);
// Page title: `rubrik` is often a boilerplate committee heading reused across
// many unrelated votes ("Regeringens lagförslag" covers 71 of them), which made
// those titles indistinguishable in search results. The casemeta subject names
// THIS vote; the betänkande point disambiguates the few topics voted repeatedly.
// rm is part of the ref because committee codes recur every riksmöte (FiU26
// exists in several years), so beteckning+punkt alone still collided.
const pageTitle = `${subject || rubrik} · ${c.rm}:${c.beteckning} p.${c.punkt}`;
const aiEn = (code: string) => (lang === 'en' ? c.ai[code]?.en ?? null : null);

const docLabel: Record<string, string> = {
  valmanifest: lang === 'sv' ? 'valmanifest 2022' : '2022 manifesto',
  partiprogram: lang === 'sv' ? 'partiprogram' : 'party programme',
  tidoavtalet: 'Tidöavtalet',
};

const docsBase = localePath(lang, '/dokument/');

function citationHref(party: string, document: string, quote: string): string | null {
  if (!quote?.trim()) return null;  // unverifiable quotes are blanked — no text fragment to deep-link
  const slug = citationDocSlug(party, document);
  if (!slug) return null;
  return `${docsBase}${slug}/#:~:text=${quoteFragment(quote)}`;
}

// Evidence tiers, strongest first. Anything without a tier (p4/p5 runs) sorts
// with the middle group rather than being promoted above graded evidence.
const TIER_ORDER = ['explicit', 'extrapolated', 'off_axis'];
const tierRank = (tier?: string | null) =>
  tier ? TIER_ORDER.indexOf(tier) : 1;

// parties where the AI's plan-faithful vote differs from the actual vote —
// each shown with the decisive plan quote so the deviation claim is verifiable
const mismatches = partyOrder
  .filter((code) => {
    const d = c.ai[code];
    const a = c.actual[code];
    return d && a && a.position !== 'Frånvarande' && d.rost !== a.position;
  })
  .map((code) => {
    // back the deviation with the strongest available quote: the first
    // non-weak citation, only falling back to a weak one if that's all there is
    const cits = c.ai[code].citations;
    const di = cits.findIndex((x) => !x.svag);
    const idx = di === -1 ? (cits.length ? 0 : -1) : di;
    return {
      code,
      decision: c.ai[code],
      actual: c.actual[code],
      decisive: idx === -1 ? null : cits[idx],
      decisiveEn: idx === -1 ? null : aiEn(code)?.citations?.[idx] ?? null,
    };
  })
  // Strongest evidence first: a divergence the plan states outright is a
  // different kind of claim from one derived off a procedural committee reason,
  // and the reader should meet them in that order. Stable within a tier, so the
  // hemicycle ordering above survives.
  .sort((x, y) => tierRank(x.decision.tier) - tierRank(y.decision.tier));

// MPs who voted differently from their party's majority position
const dissenters = c.seats
  .filter(([parti, rost]) => {
    const pos = c.actual[parti]?.position;
    return rost !== 'Frånvarande' && pos && pos !== 'Frånvarande' && rost !== pos;
  })
  .map(([parti, rost, namn, valkrets]) => ({ parti, rost, namn, valkrets, line: c.actual[parti].position }));

// absolute URLs for the share/embed box (correct once SITE_URL is set in CI)
const site = (Astro.site?.toString() ?? 'https://airiksdagen.se/').replace(/\/$/, '');
const pageAbsUrl = `${site}${localePath(lang, pagePath)}`;
const embedAbsUrl = `${site}${base}/embed/${c.votering_id}/`;
const embedSnippet = `<iframe src="${embedAbsUrl}" width="100%" height="430" style="border:1px solid #ddd;border-radius:8px" title="AI Riksdag: ${(en?.rubrik || c.rubrik).replace(/"/g, "'")}" loading="lazy"></iframe>`;

// per-party document references used in this case (deduped), for the study box
const docRefs = partyOrder
  .filter((p) => c.ai[p])
  .map((p) => ({
    party: p,
    docs: [...new Set(c.ai[p].citations.map((cit) => cit.document))].map((d) => ({
      document: d,
      slug: citationDocSlug(p, d),
    })),
  }))
  .filter((r) => r.docs.length > 0);
---

<Base lang={lang} title={pageTitle} description={metaDesc} path={pagePath}>
  <p>
    <span class="chip">{c.datum}</span>
    <span class="chip">{c.rm}:{c.beteckning} · p.{c.punkt}</span>
    <span class="chip">{c.utskott}</span>
    {topicLabel && <span class="chip topic">{topicLabel}</span>}
  </p>
  <h1>{rubrik}</h1>
  {/* the metadata subject supersedes the raw betänkande title as the deck;
      only show the muted dok_titel line when there's no subject (fallback) */}
  {!subject && c.dok_titel !== c.rubrik && <p class="muted">{dokTitel}</p>}
  {lead && <p class="summary">{lead}</p>}
  {atStake && (
    <p class="atstake"><strong>{t('case.atStake')}:</strong> {atStake}</p>
  )}
  {lang === 'en' && (
    <p class="muted mtnote">{c.en ? t('case.mtNote') : t('case.notTranslated')}</p>
  )}

  {hasBrief && (
    <section class="brief">
      <h2>{t('case.brief')}</h2>
      {decisionText && <p class="brief-decision">{decisionText}</p>}
      {jaText && (
        <div class="card brief-side" data-side="Ja">
          <p class="brief-head"><span class="votechip" data-v="Ja">{voteLabels.Ja}</span> {t('case.briefJa')}</p>
          <p class="brief-body">{jaText}</p>
        </div>
      )}
      {nejItems.length > 0 && (
        <div class="card brief-side" data-side="Nej">
          <p class="brief-head"><span class="votechip" data-v="Nej">{voteLabels.Nej}</span> {t('case.briefNej')}</p>
          {nejItems.map((n) => (
            <div class="brief-alt">
              <p class="brief-altlabel">
                {n.label}
                {n.partier.length > 0 && <span class="muted"> ({n.partier.join(', ')})</span>}
              </p>
              <p class="brief-body">{n.text}</p>
            </div>
          ))}
        </div>
      )}
      <p class="muted briefnote">{t('case.briefNote')}</p>
    </section>
  )}

  <Hemicycle
    seats={c.seats}
    parties={meta.parties}
    ai={c.ai}
    actual={c.actual}
    voteLabels={voteLabels}
  />

  {c.compact && (
    <>
      <h2>{t('case.meanings')}</h2>
      <div class="card meanings">
        <p><span class="votechip" data-v="Ja">{voteLabels.Ja}</span> {lang === 'sv' ? c.compact.ja_sv : c.compact.ja_en}</p>
        <p><span class="votechip" data-v="Nej">{voteLabels.Nej}</span> {lang === 'sv' ? c.compact.nej_sv : c.compact.nej_en}</p>
        <p><span class="votechip" data-v="Avstår">{voteLabels['Avstår']}</span> {lang === 'sv' ? c.compact.avstar_sv : c.compact.avstar_en}</p>
      </div>
    </>
  )}

  <h2>{t('case.ai')} / {t('case.actual')}</h2>
  <table class="compare">
    <thead>
      <tr>
        <th></th>
        <th>{t('case.ai')}</th>
        <th>{t('case.actual')}</th>
        <th></th>
        <th>{t('case.confidence')}</th>
        <th>{t('tier.label')}</th>
      </tr>
    </thead>
    <tbody>
      {partyOrder.map((code) => {
        const d = c.ai[code];
        const a = c.actual[code];
        const comparable = a && a.position !== 'Frånvarande';
        const isMatch = d && comparable && d.rost === a.position;
        return (
          <tr id={`vote-${code}`}>
            <td>
              <PartyBadge code={code} parties={meta.parties} label="none" />
              {a?.authored_reservation && <span class="tag own" title={t('coalition.ownResTip')}>{t('coalition.ownRes')}</span>}
            </td>
            {/* p6: the stance is what the agent decided; the vote chip beside it is
                DERIVED from it. On p4/p5 runs `hallning` is null and only the vote
                is shown, exactly as before. */}
            <td>
              {d ? (
                <>
                  {d.hallning && (
                    <span class="stance" title={t(`stance.${d.hallning}` as any)}>
                      {t(`stance.short.${d.hallning}` as any)}
                    </span>
                  )}
                  <span class="votechip" data-v={d.rost}>{voteLabels[d.rost]}</span>
                </>
              ) : <span class="muted">–</span>}
            </td>
            <td>
              {a ? (
                <>
                  <span class="votechip" data-v={a.position}>{voteLabels[a.position]}</span>
                  <span class="muted" style="font-size:0.8rem"> {a.n_ja}/{a.n_nej}/{a.n_avstar}/{a.n_franvarande}</span>
                </>
              ) : <span class="muted">–</span>}
            </td>
            <td>
              {d && comparable && <span class={isMatch ? 'match' : 'mismatch'}>{isMatch ? `✓ ${t('case.match')}` : `✕ ${t('case.mismatch')}`}</span>}
              {d?.program_override && (
                <span class="tag override" title={t('coalition.overrideTip')}>
                  {t('coalition.override')}{d.program_override === 'strict' ? '' : '*'}
                </span>
              )}
            </td>
            <td class="muted">{d?.confidence ?? ''}</td>
            <td class="muted">
              {d?.tier
                ? <span class="tier" data-tier={d.tier} title={t(`tier.${d.tier}Tip` as any)}>{t(`tier.${d.tier}` as any)}</span>
                : d ? t(`coverage.${d.coverage}` as any) : ''}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>

  {mismatches.length > 0 && (
    <>
      <h2>{t('case.planVsReal')}</h2>
      {mismatches.map((m) => {
        const href = m.decisive ? citationHref(m.code, m.decisive.document, m.decisive.quote) : null;
        return (
          <div class="card mismatchbox" style={`border-left: 4px solid ${meta.parties[m.code]?.color}`}>
            <p class="mm-head">
              <PartyBadge code={m.code} parties={meta.parties} label="name" />
              <span>
                {t('case.ai')}: {m.decision.hallning && (
                  <span class="stance" title={t(`stance.${m.decision.hallning}` as any)}>
                    {t(`stance.short.${m.decision.hallning}` as any)}
                  </span>
                )}<span class="votechip" data-v={m.decision.rost}>{voteLabels[m.decision.rost]}</span>
                <span class="muted"> · </span>
                {t('case.actual')}: <span class="votechip" data-v={m.actual.position}>{voteLabels[m.actual.position]}</span>
                {m.decision.tier && (
                  <span class="tier" data-tier={m.decision.tier} title={t(`tier.${m.decision.tier}Tip` as any)}>
                    {t(`tier.${m.decision.tier}` as any)}
                  </span>
                )}
              </span>
            </p>
            {m.decisive && (
              <blockquote>
                {(m.decisiveEn?.princip || m.decisive.princip) && (
                  <span class="chip">{m.decisiveEn?.princip || m.decisive.princip}</span>
                )}
                {m.decisive.svag && (
                  <span class="chip weak" title={t('case.weakCiteTip')}>{t('case.weakCite')}</span>
                )}
                {m.decisive.quote && <>»{m.decisive.quote}«</>}
                {href ? (
                  <a class="muted src" href={href}>({docLabel[m.decisive.document] ?? m.decisive.document} ↗)</a>
                ) : (
                  <span class="muted src">({docLabel[m.decisive.document] ?? m.decisive.document})</span>
                )}
                {m.decisiveEn?.quote && (
                  <span class="qtrans">“{m.decisiveEn.quote}”</span>
                )}
              </blockquote>
            )}
            {/* Only an explicit-tier divergence supports "the party voted against
                its own stated commitment". Anything weaker gets the honest note. */}
            <p class="muted mm-note">
              {m.decision.tier && m.decision.tier !== 'explicit'
                ? t('case.planVsRealNoteWeak')
                : t('case.planVsRealNote')}
            </p>
          </div>
        );
      })}
    </>
  )}

  {dissenters.length > 0 && (
    <>
      <h2>{t('case.dissenters')}</h2>
      <div class="card">
        <table class="compare">
          <tbody>
            {dissenters.map((d) => (
              <tr>
                <td><span class="pbadge-wrap"><PartyBadge code={d.parti} parties={meta.parties} size={18} /><strong>{d.namn}</strong></span> <span class="muted">({d.parti}, {d.valkrets})</span></td>
                <td>
                  <span class="votechip" data-v={d.rost}>{voteLabels[d.rost]}</span>
                  <span class="muted"> — {t('case.dissentLine')}: </span>
                  <span class="votechip" data-v={d.line}>{voteLabels[d.line]}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="muted" style="font-size:0.82rem;margin:0.5rem 0 0">{t('case.dissentersNote')}</p>
      </div>
    </>
  )}

  {docRefs.length > 0 && (
    <>
      <h2>{t('case.docrefs')}</h2>
      <div class="card">
        <table class="compare">
          <tbody>
            {docRefs.map((r) => (
              <tr>
                <td style="width:3rem"><PartyBadge code={r.party} parties={meta.parties} label="none" /></td>
                <td>
                  {r.docs.map((d, i) => (
                    <>
                      {i > 0 && ' · '}
                      {d.slug ? (
                        <a href={`${docsBase}${d.slug}/`}>{docLabel[d.document] ?? d.document}</a>
                      ) : (
                        <span>{docLabel[d.document] ?? d.document}</span>
                      )}
                    </>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="muted" style="font-size:0.82rem;margin:0.5rem 0 0">{t('case.docrefsNote')}</p>
      </div>
    </>
  )}

  <h2>{t('case.committee')}</h2>
  <div class="card">
    <p style="white-space:pre-line; margin:0">{forslagText}</p>
    {en && (
      <details class="original">
        <summary>{t('case.originalSv')}</summary>
        <p style="white-space:pre-line">{c.forslag_text}</p>
      </details>
    )}
  </div>
  {c.notis && (
    <div class="card">
      <p style="margin:0"><strong>{t('case.decision')}:</strong> {notis}</p>
    </div>
  )}
  {c.alternatives.filter((a) => a.alt_id !== 'utskottet').length > 0 && (
    <>
      <h2>{t('case.alternatives')}</h2>
      <ul>
        {c.alternatives.map((a, i) => ({ ...a, shownText: altTexts[i] })).filter((a) => a.alt_id !== 'utskottet').map((a) => {
          const sub = a.substance ? (lang === 'sv' ? a.substance.sv : a.substance.en) : null;
          return (
            <li>
              {sub ? <span>{sub}</span> : a.shownText}
              {a.source_partier.length > 0 && <span class="muted"> ({a.source_partier.join(', ')})</span>}
              {sub && <span class="muted altlabel"> — {a.shownText}</span>}
            </li>
          );
        })}
      </ul>
    </>
  )}

  {Object.keys(c.ai).length > 0 && (
    <>
      <h2>{t('case.motivering')}</h2>
      {partyOrder.filter((p) => c.ai[p]).map((code) => {
        const d = c.ai[code];
        const dEn = aiEn(code);
        // the decisive citation is the first NON-weak one; a weak (svag) broad
        // principle is never labelled decisive (-1 if the decision has only weak)
        const decIdx = d.citations.findIndex((x) => !x.svag);
        return (
          <details class="card">
            <summary>
              <PartyBadge code={code} parties={meta.parties} size={20} />
              <strong>{meta.parties[code]?.name ?? code}</strong> — <span class="votechip" data-v={d.rost}>{voteLabels[d.rost]}</span>
            </summary>
            <p>{dEn?.motivering || d.motivering}</p>
            {dEn?.motivering && (
              <details class="original">
                <summary>{t('case.originalSv')}</summary>
                <p>{d.motivering}</p>
              </details>
            )}
            {d.citations.length > 0 && (
              <ul>
                {d.citations.map((cit, i) => {
                  const href = citationHref(code, cit.document, cit.quote);
                  const citEn = dEn?.citations?.[i] ?? null;
                  return (
                    <li class={cit.svag ? 'weakcite' : undefined}>
                      {(citEn?.princip || cit.princip) && <span class="chip">{citEn?.princip || cit.princip}</span>}
                      {i === decIdx && <span class="chip" style="background:#e5efdb">{t('case.decisive')}</span>}
                      {cit.svag && <span class="chip weak" title={t('case.weakCiteTip')}>{t('case.weakCite')}</span>}
                      {cit.quote && <><em>»{cit.quote}«</em>{' '}</>}
                      {href ? (
                        <a class="muted" href={href}>({docLabel[cit.document] ?? cit.document} ↗)</a>
                      ) : (
                        <span class="muted">({docLabel[cit.document] ?? cit.document})</span>
                      )}
                      {citEn?.quote && <span class="qtrans">“{citEn.quote}”</span>}
                    </li>
                  );
                })}
              </ul>
            )}
            {d.omvarld?.paverkar && d.omvarld.faktorer.length > 0 && (
              <p class="omvarld">
                <strong>{t('case.omvarld')}:</strong>{' '}
                {d.omvarld.faktorer.map((f, i) => {
                  const fEn = dEn?.omvarld?.[i] ?? null;
                  return <span>{i > 0 && '; '}<em>{fEn?.faktor || f.faktor}</em> — {fEn?.effekt || f.effekt}</span>;
                })}
              </p>
            )}
            {d.flags.length > 0 && <p class="muted">flags: {d.flags.join(', ')}</p>}
          </details>
        );
      })}
    </>
  )}

  {c.probe && (
    <>
      <h2>{t('case.probe')}</h2>
      <div class="card">
        <p style="margin:0">
          {c.probe.recalls_case ? t('case.probe.recalled') : t('case.probe.notRecalled')}
          <span class="muted"> ({c.probe.exact_match_count}/8)</span>
        </p>
      </div>
    </>
  )}

  <h2>{t('case.share')}</h2>
  <div class="card sharebox">
    <label>
      <span>{t('case.shareLink')}</span>
      <span class="row">
        <input type="text" readonly value={pageAbsUrl} data-copy />
        <button class="btn ghost" type="button" data-copybtn>{t('case.copy')}</button>
      </span>
    </label>
    <label>
      <span>{t('case.sharePartyLink')}</span>
      <span class="row">
        <select data-partysel>
          {partyOrder.map((code) => <option value={code}>{meta.parties[code]?.name ?? code}</option>)}
        </select>
        <input type="text" readonly value={`${pageAbsUrl}#vote-${partyOrder[0]}`} data-copy data-partylink />
        <button class="btn ghost" type="button" data-copybtn>{t('case.copy')}</button>
      </span>
    </label>
    <label>
      <span>{t('case.shareEmbed')} <a href={embedAbsUrl} target="_blank" rel="noopener">{t('case.embedPreview')}</a></span>
      <span class="row">
        <textarea readonly rows="3" data-copy>{embedSnippet}</textarea>
        <button class="btn ghost" type="button" data-copybtn>{t('case.copy')}</button>
      </span>
    </label>
  </div>

  <h2>{t('case.sources')}</h2>
  <div class="card">
    <ul class="srclist">
      <li><a href={c.riksdagen_url}>{t('case.sources.bet')}</a> <span class="muted">({c.rm}:{c.beteckning})</span></li>
      <li><a href={c.fulltext_url}>{t('case.sources.fulltext')}</a> <span class="muted">({c.dok_id})</span></li>
      <li><a href={c.votering_url}>{t('case.sources.votering')}</a></li>
      <li><a href={c.source_url}>{t('case.sources.status')}</a></li>
    </ul>
    {c.references.length > 0 && (
      <>
        <p style="margin:0.8rem 0 0.3rem"><strong>{t('case.sources.refs')}</strong></p>
        <ul class="srclist">
          {c.references.map((r) => (
            <li>
              <a href={`https://data.riksdagen.se/dokument/${r.dok_id}.html`}>{r.label}</a>
              {r.titel && <span class="muted"> — {r.titel}</span>}
              {r.undertitel && <span class="muted"> {r.undertitel}</span>}
            </li>
          ))}
        </ul>
      </>
    )}
    <p class="muted" style="font-size:0.82rem;margin:0.8rem 0 0">{t('case.source')}</p>
  </div>

  <script is:inline define:vars={{ pageAbsUrl }}>
    for (const btn of document.querySelectorAll('[data-copybtn]')) {
      btn.addEventListener('click', () => {
        const field = btn.parentElement.querySelector('[data-copy]');
        navigator.clipboard.writeText(field.value ?? field.textContent).then(() => {
          const old = btn.textContent;
          btn.textContent = '✓';
          setTimeout(() => (btn.textContent = old), 1200);
        });
      });
    }
    const sel = document.querySelector('[data-partysel]');
    const link = document.querySelector('[data-partylink]');
    if (sel && link) {
      sel.addEventListener('input', () => {
        link.value = `${pageAbsUrl}#vote-${sel.value}`;
      });
    }
  </script>

  <style>
    /* The plan's stance — the p6 product. Sits immediately before the vote chip
       it implies, so the derivation reads left to right. */
    .stance {
      display: inline-block; margin-right: 0.4rem; font-size: 0.78rem;
      color: var(--ink-2); white-space: nowrap; cursor: help;
    }
    /* Evidence tier. Only `explicit` is emphasised — the weaker tiers must not
       look like a verdict, so they stay grey and quiet. */
    .tier {
      display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.4rem;
      border-radius: 4px; font-size: 0.7rem; font-weight: 600; white-space: nowrap;
      vertical-align: middle; cursor: help; background: #ecebe6; color: #5d5a52;
    }
    .tier[data-tier='explicit'] { background: #d8e8d2; color: #2f5326; }
    .tag {
      display: inline-block; margin-left: 0.4rem; padding: 0.05rem 0.4rem;
      border-radius: 4px; font-size: 0.7rem; font-weight: 600; white-space: nowrap;
      vertical-align: middle; cursor: help;
    }
    .tag.own { background: #eceae2; color: #55524a; }
    .tag.override { background: #f3e2c7; color: #7a4b12; }
    .omvarld { background: #eef3f8; border-radius: 6px; padding: 0.5rem 0.8rem; font-size: 0.88rem; }
    .summary { font-size: 1.05rem; line-height: 1.6; color: var(--ink-2); max-width: 46rem; margin: 0.55rem 0 0.2rem; }
    .atstake { font-size: 0.95rem; line-height: 1.55; color: var(--ink-2); max-width: 46rem; margin: 0.4rem 0 0.2rem; padding: 0.5rem 0.8rem; background: #eef3f8; border-radius: 6px; }
    .chip.topic { background: #e5efdb; color: #3f5a2a; font-weight: 600; }
    /* casemeta brief — the contested axis, then the Ja and Nej substance side by side */
    .brief { max-width: 46rem; }
    .brief-decision { font-size: 0.98rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 0.8rem; }
    .brief-side { margin-bottom: 0.7rem; border-left: 4px solid var(--muted); }
    .brief-side[data-side='Ja'] { border-left-color: #2f7d4f; }
    .brief-side[data-side='Nej'] { border-left-color: #a8452f; }
    .brief-head { margin: 0 0 0.5rem; font-weight: 600; font-size: 0.92rem; }
    .brief-head .votechip { min-width: 4.2rem; text-align: center; margin-right: 0.5rem; }
    .brief-body { margin: 0; font-size: 0.94rem; line-height: 1.55; color: var(--ink-2); }
    .brief-alt + .brief-alt { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--rule, #e3e3e3); }
    .brief-altlabel { margin: 0 0 0.2rem; font-size: 0.85rem; font-weight: 600; }
    .briefnote { font-size: 0.78rem; font-style: italic; margin: 0.3rem 0 0; }
    .mtnote { font-size: 0.8rem; font-style: italic; }
    .qtrans { display: block; margin-top: 0.25rem; font-size: 0.92em; color: var(--muted); font-style: italic; }
    details.original { margin-top: 0.5rem; font-size: 0.88rem; }
    details.original summary { color: var(--muted); cursor: pointer; }
    .mismatchbox blockquote {
      margin: 0.6rem 0; padding: 0.6rem 0.9rem; background: #fbfaf5;
      border-radius: 6px; font-family: Georgia, serif; font-size: 1.02rem;
    }
    .mismatchbox .src { font-size: 0.82rem; margin-left: 0.4rem; font-family: inherit; }
    .mm-head { display: flex; justify-content: space-between; gap: 0.8rem; flex-wrap: wrap; margin: 0; }
    .mm-note { font-size: 0.8rem; margin: 0.2rem 0 0; }
    .srclist { margin: 0.2rem 0; padding-left: 1.2rem; }
    .srclist li { margin: 0.25rem 0; }
    .meanings p { margin: 0.45rem 0; }
    .meanings .votechip { min-width: 4.2rem; text-align: center; margin-right: 0.5rem; }
    .sharebox label { display: block; margin-bottom: 0.9rem; font-size: 0.86rem; color: var(--muted); }
    .sharebox label > span:first-child { display: block; margin-bottom: 0.25rem; }
    .sharebox .row { display: flex; gap: 0.5rem; }
    .sharebox input[type='text'], .sharebox textarea { flex: 1; font-size: 0.84rem; font-family: ui-monospace, Menlo, monospace; }
    .sharebox textarea { resize: vertical; }
  </style>
</Base>
