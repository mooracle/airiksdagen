---
// One corpus document, formatted for reading — and read back the other way.
//
// The source .txt is PDF/HTML-extracted and is never edited: it is the exact byte
// sequence the AI agents read, and `aidag verify simulate` checks every citation
// quote against it. All cleanup is render-time, in lib/doctext.ts — see the header
// there for what is repaired and what is deliberately left alone.
//
// TWO SOURCES OF STRUCTURE
// ------------------------
// The 23 cited party documents ship a block file (roles and reading order taken
// from the PDF's own font metrics, by `aidag extract-corpus`) and render from it.
// The other 17 — 16 budgetmotioner and Tidöavtalet — have none, and renderDoc()
// falls back to formatCorpusDoc(), which guesses structure back from line
// lengths. That branch stays until the budgetmotion parser lands; deleting it
// would regress those 17 to a ragged wall.
//
// Citation deep-links (#:~:text=) keep working across this change: quoteFragment()
// in lib/data.ts collapses each quote to single-spaced words and drops invisible
// characters, the browser's text-fragment matcher normalises whitespace too, and
// doctext.groupBlocks() rejoins the paragraphs the extraction split at a column
// or page break — a fragment cannot match across two <p> elements, and 56 of
// full-v4's anchors quote across such a split.
//
// THE ANNOTATION LAYER
// --------------------
// Citations run one way — a case page points into this document. The anchor
// index (`aidag build-anchors`) points back, so a cited line can show the votes
// that leaned on it and whether they then followed the party's own plan. Two
// pieces here: a sticky chapter rail built from the h1/h2 blocks, and one margin
// panel per cited block (CiteNote.astro). Only the aggregates are built into the
// page; the per-decision rows are fetched from public/data/anchors/ when a panel
// is opened, because `valmanifest-2022-sd` alone carries 9,007 of them.
//
// The 17 documents without blocks have no anchors either, so nothing below
// changes what they render — they stay byte-identical to the pre-annotation
// build, which is checked in site/tests/corpus.test.mjs.
import Base from '../layouts/Base.astro';
import BlockText from '../components/BlockText.astro';
import CiteNote from '../components/CiteNote.astro';
import {
  getMeta,
  getCorpusDoc,
  getCorpusBlocks,
  getCorpusAnchors,
  getCorpusLexicon,
} from '../lib/data';
import { renderDoc, docTitle, type RenderGroup } from '../lib/doctext';
import { chapters, citedLines, type CitedLine } from '../lib/anchors';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();
const sv = lang === 'sv';

const blocks = getCorpusBlocks(slug);
const doc = renderDoc(getCorpusDoc(slug), blocks, { lexicon: getCorpusLexicon() });
const title = docTitle(slug, {
  sv,
  partyName: (code) => meta.parties[code.toUpperCase()]?.name ?? code.toUpperCase(),
});

const anchors = getCorpusAnchors(slug);

// The document's own dimensions, for the strip under the title.
//
// The citation total used to live only inside the rail, which meant the three
// documents that cannot build one — `partiprogram-mp-2013`, whose 50 headings
// are undecodable display type, and the two manifestos that set no headings at
// all — published 268, 186 and 136 cited lines while stating none of it. The
// numbers belong to the document, not to its navigation.
const words = doc.groups.reduce(
  (n, g) => n + g.parts.reduce((m, p) => m + (p.text ? p.text.split(/\s+/).length : 0), 0),
  0,
);
const nfmt = (n: number) => n.toLocaleString(sv ? 'sv-SE' : 'en-GB');
const facts = [
  blocks?.pages ? { n: nfmt(blocks.pages), label: sv ? 'sidor' : 'pages' } : null,
  words ? { n: `${Math.round(words / 1000)}k`, label: sv ? 'ord' : 'words' } : null,
  anchors
    ? { n: nfmt(Object.keys(anchors.blocks).length), label: sv ? 'citerade rader' : 'cited lines' }
    : null,
  anchors
    ? { n: nfmt(anchors.totals.decisions.n), label: sv ? 'voteringar' : 'votes', strong: true }
    : null,
].filter((f): f is { n: string; label: string; strong?: boolean } => f !== null);
// Three chapters is where a rail starts being navigation rather than decoration;
// below that (valmanifest-2022-c has no headings at all) the caveat it carries
// moves above the document instead.
const rail = chapters(doc.groups, anchors);
const hasRail = rail.length >= 3;
const notesFor = (g: RenderGroup): CitedLine[] => citedLines(g, anchors);

// Consecutive bullets (and consecutive table-of-contents entries) become one list
// instead of N sibling elements. Only the 17 fallback documents still reach the
// `toc` branch — renderDoc() drops those blocks on the block path, where the rail
// below is the same navigation built from the same headings.
type Run = { role: RenderGroup['role']; groups: RenderGroup[] };
const runs: Run[] = [];
for (const g of doc.groups) {
  const last = runs[runs.length - 1];
  if (last && last.role === g.role && (g.role === 'bullet' || g.role === 'toc')) {
    last.groups.push(g);
  } else {
    runs.push({ role: g.role, groups: [g] });
  }
}
// The bullet glyph is NOT stripped. Agents cite verbatim spans and some quotes
// begin with "• ", so removing it would stop those citations' #:~:text= links from
// resolving (caught by two real failures in the deep-link regression check). The
// list is rendered without its own marker instead, so the source character stands
// in for it and the text on the page stays byte-faithful. A block that carries the
// glyph without being roled `bullet` (a bold lead-in, a small-print list) gets the
// same hanging indent through `.hang`.
const BULLET_GLYPH = /^[•▪◦·]/;
const hangs = (g: RenderGroup) => g.role !== 'bullet' && BULLET_GLYPH.test(g.parts[0].text);
// A group is one block unless the extraction split a paragraph; then each block
// keeps its own id on a span, so a citation anchor can still address the line.
const anchorId = (g: RenderGroup) => (g.parts.length === 1 ? g.parts[0].id ?? undefined : undefined);
// The element comes from the group's leading role, the weight from each block's
// own role — so a rejoined paragraph is styled by its parts (see BlockText), not
// wholesale by whichever block happened to start it.
function pClass(g: RenderGroup): string | undefined {
  const cls: string[] = [];
  if (g.parts.length === 1 && (g.role === 'label' || g.role === 'caption')) cls.push(g.role);
  if (hangs(g)) cls.push('hang');
  return cls.length ? cls.join(' ') : undefined;
}

// The fetched half, and the strings its rows need. One request per document,
// shared by every panel on the page.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const refsUrl = `${base}/data/anchors/${slug}.json`;
// One file for the whole corpus, so it is already cached by the second document
// page a reader opens. Fetched with the refs, not before them.
const titlesUrl = `${base}/data/anchors/cases.json`;
const caseBase = localePath(lang, '/fall/');
const TR = {
  loading: t('doc.cite.loading'),
  error: t('doc.cite.error'),
  verdict: {
    kept: t('doc.cite.kept'),
    diverged: t('doc.cite.diverged'),
    avstar: t('doc.cite.avstar'),
    franvarande: t('doc.cite.franvarande'),
  },
  tier: {
    explicit: t('tier.explicitShort'),
    extrapolated: t('tier.extrapolatedShort'),
    off_axis: t('tier.off_axisShort'),
  },
};
---

<Base lang={lang} title={title} description={`${title} ${t('meta.desc.documentSuffix')}`} path={`/dokument/${slug}/`} ogType="article">
  <p class="muted">
    {/* /parti/#dokument, not /om/#dokument: the corpus index moved to the parties
        page and /om/ kept only a one-line pointer to it, so this "← Party
        documents" was landing the reader on the methodology page instead of the
        list they came from. */}
    <a href={`${localePath(lang, '/parti/')}#dokument`}>
      ← {sv ? 'Partidokument' : 'Party documents'}
    </a>
  </p>
  <h1>{title}</h1>

  {doc.provenance && (
    <p class="prov">
      <span>{doc.provenance.title}</span>
      {doc.provenance.note && <> · <span>{doc.provenance.note}</span></>}
      {doc.provenance.href && (
        <> · <a href={doc.provenance.href} rel="nofollow noopener">
          {doc.provenance.hrefLabel === 'källa' ? (sv ? 'källa' : 'source') : doc.provenance.hrefLabel}
        </a></>
      )}
    </p>
  )}

  {facts.length > 0 && (
    <p class="facts">
      {facts.map((f) => (
        <span class:list={['fact', f.strong && 'lead']}>
          <b>{f.n}</b> {f.label}
        </span>
      ))}
    </p>
  )}

  {/* The reading contract, and it has to name everything the page changes. The
      wording is untouched, which is the claim that matters — but "oförändrad"
      full stop stopped being true when the rendering began dropping the printed
      contents list and undoing the source's all-capital headings. Both are
      typography; saying so is cheaper than letting a reader find one and wonder
      what else moved. */}
  <p class="muted note">
    {sv
      ? doc.stats.source === 'blocks'
        ? 'Texten är maskinextraherad ur källdokumentet och visas med återställda radbrytningar. Ordalydelsen är oförändrad; dokumentets egen innehållsförteckning utelämnas (menyn till vänster ersätter den) och rubriker satta med versaler återges med gemener.'
        : 'Texten är maskinextraherad ur källdokumentet och visas med återställda radbrytningar; ordalydelsen är oförändrad.'
      : doc.stats.source === 'blocks'
        ? 'Machine-extracted from the source document and shown with its line wrapping undone. The wording is unchanged; the document’s own table of contents is left out (the chapter list replaces it) and headings set in full capitals are shown in sentence case. This is the Swedish text the AI agents read, and what the citation links on the case pages point into.'
        : 'Machine-extracted from the source document and shown with its line wrapping undone; the wording is unchanged. This is the Swedish text the AI agents read, and what the citation links on the case pages point into.'}
  </p>

  {/* The caveat the rail carries. A document with citations but too few chapters
      for a rail still has to state it — it is the reading instruction for every
      gold segment on the page, not a footnote to the navigation. */}
  {anchors && !hasRail && <p class="muted note ownplan">{t('doc.rail.ownPlan')}</p>}

  {/* Said once for the whole page rather than inside each of up to 510 panels. */}
  {anchors && <noscript><p class="muted note">{t('doc.cite.noscript')}</p></noscript>}

  {(() => {
    const article = (
      <article class="doc">
        {runs.map((run) => {
          const g = run.groups[0];
          if (run.role === 'bullet')
            return (
              <ul class="marked">
                {run.groups.map((b) => {
                  const cited = notesFor(b);
                  // Uncited items keep the markup they had before the annotation
                  // layer: no wrapper, no extra element. Only a cited one becomes
                  // a two-column row.
                  if (!cited.length) return <li id={anchorId(b)}><BlockText group={b} /></li>;
                  return (
                    <li id={anchorId(b)} class="line">
                      <div class="t"><BlockText group={b} /></div>
                      <div class="notes">
                        {cited.map((line) => <CiteNote lang={lang} line={line} />)}
                      </div>
                    </li>
                  );
                })}
              </ul>
            );
          if (run.role === 'toc')
            return (
              <ul class="toc">
                {run.groups.map((b) => (
                  <li id={anchorId(b)}>
                    <BlockText group={b} />
                    {notesFor(b).map((line) => <CiteNote lang={lang} line={line} />)}
                  </li>
                ))}
              </ul>
            );

          // Everything else is one element, optionally with its margin panels
          // beside it. `.line` is the two-column wrapper; without citations the
          // element stays a direct child of .doc exactly as it was.
          const cited = notesFor(g);
          const el =
            run.role === 'h1' ? <h2 id={anchorId(g)}><BlockText group={g} /></h2> :
            run.role === 'h2' ? <h3 id={anchorId(g)}><BlockText group={g} /></h3> :
            run.role === 'h3' ? <h4 id={anchorId(g)}><BlockText group={g} /></h4> :
            run.role === 'unreadable' ? (
              <p class="unreadable" id={anchorId(g)} title={sv
                ? 'Rubrik satt i ett dekorativt teckensnitt som inte kunde avkodas ur PDF:en'
                : 'Heading set in a decorative font that could not be decoded from the PDF'}>
                {sv ? '[oläsbar rubrik i källdokumentet]' : '[unreadable heading in the source document]'}
              </p>
            ) : <p class={pClass(g)} id={anchorId(g)}><BlockText group={g} /></p>;
          if (!cited.length) return el;
          return (
            <div class="line">
              {el}
              <div class="notes">
                {cited.map((line) => <CiteNote lang={lang} line={line} />)}
              </div>
            </div>
          );
        })}
      </article>
    );
    // The 17 documents without blocks have no rail and no panels, so they keep
    // the bare <article> they have always rendered — no wrapper, no grid.
    if (!hasRail && !anchors) return article;
    return (
      <div
        class:list={['docwrap', hasRail && 'withrail']}
        data-refs-url={anchors ? refsUrl : undefined}
        data-titles-url={anchors ? titlesUrl : undefined}
        data-lang={anchors ? lang : undefined}
        data-case-base={anchors ? caseBase : undefined}
        data-labels={anchors ? JSON.stringify(TR) : undefined}
      >
        {hasRail && (
          <nav class="rail" aria-label={t('doc.rail.title')}>
            <p class="rtitle">{t('doc.rail.title')}</p>
            {anchors && (
              <p class="rtotal">{t('doc.rail.decisions').replace('{n}', String(anchors.totals.decisions.n))}</p>
            )}
            <ol data-chapters>
              {rail.map((c) => (
                <li class={`lvl${c.level}`} data-for={c.id}>
                  <a href={`#${c.id}`}>{c.text}</a>
                  {c.lines > 0 && (
                    <span class="rn" title={t('doc.rail.linesTip')}>{c.lines}</span>
                  )}
                </li>
              ))}
            </ol>
            {anchors && (
              <>
                <p class="rlegend">
                  <span class="key"><i class="sw kept" /> {t('doc.cite.kept')}</span>
                  <span class="key"><i class="sw diverged" /> {t('doc.cite.diverged')}</span>
                </p>
                {/* The panels' tier chips carry no tooltip of their own — the
                    vocabulary is explained here once instead of 510 times. */}
                <p class="rlegend tierkey">
                  <span class="lbl">{t('tier.label')}</span>
                  <span title={t('tier.explicitTip')}>{t('tier.explicitShort')}</span>
                  <span title={t('tier.extrapolatedTip')}>{t('tier.extrapolatedShort')}</span>
                  <span title={t('tier.off_axisTip')}>{t('tier.off_axisShort')}</span>
                </p>
                <p class="rnote">{t('doc.rail.ownPlan')}</p>
              </>
            )}
          </nav>
        )}
        {article}
      </div>
    );
  })()}

  {hasRail && (
    <script>
      // "You are here" in the chapter rail. `partiprogram-kd-2015` is 30,000
      // words over 171 pages under 59 chapter entries, and without this the rail
      // is a list of places you might go with no indication of where you are.
      //
      // Progressive enhancement in both directions: with no JS the rail is
      // exactly what it was, and the active class only ever adds emphasis — it
      // never hides an entry, so a failure here cannot cost the reader a link.
      //
      // Position is read off the last heading to have passed under the sticky
      // site header, not off an IntersectionObserver: "which chapter am I in" is
      // a question about the heading ABOVE the viewport, and a chapter longer
      // than the screen has no heading intersecting it at all.
      const rail = document.querySelector<HTMLElement>('.rail [data-chapters]');
      if (rail) {
        const items = [...rail.querySelectorAll<HTMLElement>('li[data-for]')];
        const marks = items
          .map((li) => ({ li, el: document.getElementById(li.dataset.for!) }))
          .filter((m): m is { li: HTMLElement; el: HTMLElement } => m.el !== null);
        const HEADER = 96; // the sticky header, plus a little breathing room
        let current: HTMLElement | null = null;
        const sync = () => {
          let found: HTMLElement | null = null;
          for (const m of marks) {
            if (m.el.getBoundingClientRect().top <= HEADER) found = m.li;
            else break; // marks are in document order
          }
          // Before the first chapter, keep the first entry lit rather than
          // nothing: the reader is in the document's opening, which belongs to
          // that chapter for counting purposes too (see anchors.chapters `lead`).
          found ??= marks[0]?.li ?? null;
          if (found === current) return;
          current?.classList.remove('here');
          found?.classList.add('here');
          current = found;
          // Keep the lit entry visible when the rail scrolls on its own. Guarded
          // on overflow, or `scrollIntoView` on a rail that fits would scroll the
          // PAGE to it and fight the reader for control of the scroll position.
          if (found && rail.scrollHeight > rail.clientHeight + 4) {
            const r = found.getBoundingClientRect();
            const box = rail.getBoundingClientRect();
            if (r.top < box.top || r.bottom > box.bottom) {
              found.scrollIntoView({ block: 'nearest' });
            }
          }
        };
        let queued = false;
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(() => {
            queued = false;
            sync();
          });
        };
        addEventListener('scroll', onScroll, { passive: true });
        addEventListener('resize', onScroll, { passive: true });
        sync();
      }
    </script>
  )}

  {anchors && (
    <script>
      // The ref rows behind the ratio bars: one fetch per document, on the first
      // panel a reader opens, shared by all of them. Nothing is fetched if none
      // is opened — which is the usual case, and the reason the rows are not in
      // the page to begin with.
      //
      // Bundled rather than `is:inline` so the row building can live in
      // lib/anchors.ts, where it is tested against the committed payload. What
      // is left here is DOM wiring: the config comes off the wrapper's data
      // attributes, which is also why this file needs no define:vars.
      import { caseTitle, refRows } from '../lib/anchors';

      const root = document.querySelector<HTMLElement>('[data-refs-url]');
      if (root) {
        const url = root.dataset.refsUrl!;
        const titlesUrl = root.dataset.titlesUrl!;
        const lang = root.dataset.lang!;
        const caseBase = root.dataset.caseBase!;
        const tr = JSON.parse(root.dataset.labels!);
        const get = (u: string) =>
          fetch(u).then((r) => {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
          });
        let pending: Promise<any> | null = null;
        // Both halves in one round trip, and the titles never fail the panel:
        // the rows are the finding, the titles are how they are labelled, so a
        // titles fetch that 404s degrades to the dates this used to show rather
        // than taking the list down with it.
        const payload = () =>
          (pending ??= Promise.all([get(url), get(titlesUrl).catch(() => null)]).catch((err) => {
            pending = null; // a later open may succeed
            throw err;
          }));

        const draw = (
          host: HTMLElement,
          rows: ReturnType<typeof refRows>,
          titles: Parameters<typeof caseTitle>[0],
        ) => {
          const list = document.createElement('ul');
          for (const r of rows) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `${caseBase}${r.votering_id}/`;
            // What the vote was about, which is the question the panel is
            // answering — "why is this division attached to this sentence". The
            // date moves down to the meta line beside the committee, where it is
            // context rather than the only thing said.
            const title = caseTitle(titles, r.votering_id, lang);
            a.textContent = title || r.datum || r.votering_id;
            const v = document.createElement('span');
            v.className = `v ${r.verdict}`;
            v.textContent = tr.verdict[r.verdict] ?? r.verdict;
            const m = document.createElement('span');
            m.className = 'meta';
            m.textContent = [title ? r.datum : null, r.utskott, r.tier ? tr.tier[r.tier] : null]
              .filter(Boolean)
              .join(' · ');
            li.append(a, v, m);
            list.appendChild(li);
          }
          host.replaceChildren(list);
        };

        for (const el of document.querySelectorAll<HTMLDetailsElement>('details.cnote')) {
          el.addEventListener('toggle', async () => {
            const host = el.querySelector<HTMLElement>('[data-refs]');
            if (!el.open || !host || host.dataset.state === 'done') return;
            host.dataset.state = 'done';
            host.textContent = tr.loading;
            try {
              const [refs, titles] = await payload();
              draw(host, refRows(refs, el.dataset.block!), titles);
            } catch {
              host.dataset.state = 'failed';
              host.textContent = tr.error;
            }
          });
        }
      }
    </script>
  )}

  <style>
    .prov {
      font-size: 0.85rem;
      color: var(--muted, #555);
      margin: -0.25rem 0 0.5rem;
    }
    /* What this document is, in four numbers. Sits above the reading note rather
       than in the rail, because three documents cannot build a rail and were
       publishing hundreds of cited lines without ever saying so. */
    .facts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 1.1rem;
      margin: 0 0 0.9rem;
      font-size: 0.85rem;
      color: var(--muted);
    }
    .facts b { font-variant-numeric: tabular-nums; color: var(--ink-2); font-weight: 700; }
    /* The vote count is the one a reader came for; the rest is provenance. */
    .facts .lead b { color: var(--accent-ink); }
    .note {
      font-size: 0.85rem;
      font-style: italic;
      margin-bottom: 1.25rem;
    }
    .ownplan { max-width: 68ch; }
    /* The rail is navigation for a 172-page document, so it stays in view; the
       document keeps the full remaining width and caps its own measure. */
    .docwrap { display: grid; gap: 1.25rem; grid-template-columns: minmax(0, 1fr); }
    .rail {
      font-size: 0.85rem;
      background: var(--panel-2);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 0.8rem 0.9rem;
      /* Above the document on a narrow screen, so it is a cost paid before any
         reading starts: kept short, and worth its height only because the script
         scrolls it to the chapter the reader is actually in. `overscroll-behavior`
         stops a flick inside it from carrying on into the page. */
      max-height: 11rem;
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .rail .rtitle {
      margin: 0;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .rail .rtotal { margin: 0.15rem 0 0.5rem; color: var(--ink-2); }
    .rail ol { list-style: none; margin: 0; padding: 0; }
    .rail li {
      display: flex;
      gap: 0.4rem;
      align-items: baseline;
      justify-content: space-between;
      padding: 0.12rem 0;
    }
    .rail li.lvl2 { padding-left: 0.7rem; font-size: 0.95em; }
    .rail a { color: var(--ink-2); text-decoration: none; }
    .rail a:hover { color: var(--accent-ink); text-decoration: underline; }
    /* The chapter the reader is in. A left edge plus weight rather than a fill:
       the entries already carry a right-hand count, and a filled row at 59
       entries reads as a selected item in a menu instead of a position. */
    .rail li.here {
      margin-left: -0.9rem;
      padding-left: calc(0.9rem - 3px);
      border-left: 3px solid var(--accent);
      background: var(--accent-wash);
    }
    .rail li.here a { color: var(--accent-ink); font-weight: 600; }
    .rail li.lvl2.here { padding-left: calc(1.6rem - 3px); }
    .rail .rn {
      font-variant-numeric: tabular-nums;
      font-size: 0.75rem;
      color: var(--muted);
      cursor: help;
    }
    .rail .rlegend {
      margin: 0.7rem 0 0;
      padding-top: 0.6rem;
      border-top: 1px solid var(--line);
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      font-size: 0.78rem;
      color: var(--muted);
    }
    .rail .key { display: inline-flex; align-items: center; gap: 0.3rem; }
    .rail .sw { width: 0.85rem; height: 7px; border-radius: 999px; display: inline-block; }
    .rail .sw.kept { background: var(--accent); }
    .rail .sw.diverged { background: var(--gold-deep); }
    .rail .tierkey { border-top: 0; padding-top: 0; margin-top: 0.35rem; gap: 0.35rem; }
    .rail .tierkey span[title] { cursor: help; text-decoration: underline dotted; }
    .rail .tierkey .lbl { text-decoration: none; }
    .rail .rnote { margin: 0.5rem 0 0; font-size: 0.78rem; color: var(--muted); }
    .doc {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 1.5rem clamp(1.5rem, 4vw, 2.75rem);
      font-size: 1rem;
      line-height: 1.7;
      /* Long-form prose: cap the measure for readability, but let the box fill
         the column so the page layout is unchanged. */
      overflow-wrap: break-word;
    }
    .doc > * {
      max-width: 68ch;
    }
    /* Arriving at a line, from the rail or from a case page's citation link.
       The browser highlights a `#:~:text=` match itself but nothing marks a
       plain `#b0095`, so a rail click used to land in the middle of 30,000 words
       of prose with no indication of where it had put you. Kept subtle and
       persistent rather than a flash: the reader may look away and back, and an
       animation that has finished cannot be replayed by re-clicking the same
       anchor. */
    .doc :target,
    .doc .line:has(:target) {
      background: var(--accent-wash);
      box-shadow: -0.6rem 0 0 var(--accent-wash), 0.6rem 0 0 var(--accent-wash);
      border-radius: 2px;
    }
    /* A rejoined paragraph addresses its blocks by inner <span>; highlight the
       paragraph it sits in rather than a ragged fragment of one. */
    .doc p:has(> span:target),
    .doc li:has(> span:target) { background: var(--accent-wash); }
    .doc span:target { background: none; box-shadow: none; }
    .doc > :first-child { margin-top: 0; }
    .doc > :last-child { margin-bottom: 0; }
    .doc p { margin: 0 0 1em; }
    .doc h2 {
      font-size: 1.25rem;
      margin: 2rem 0 0.6rem;
      padding-bottom: 0.25rem;
      border-bottom: 1px solid var(--line);
    }
    .doc h3 {
      font-size: 1.05rem;
      margin: 1.6rem 0 0.4rem;
    }
    .doc h4 {
      font-size: 1rem;
      margin: 1.3rem 0 0.35rem;
    }
    /* A minor bold cluster at or below body size: KD's back-cover topic labels,
       its 237 marginal glossary terms, a bold lead-in to a list item. Set apart
       from the prose without competing with a real heading. */
    .doc p.label {
      font-weight: 600;
      margin: 1.2rem 0 0.4rem;
    }
    /* Chart axes, figure sources, print credits — present in the document, but
       not what it argues. */
    .doc p.caption {
      font-size: 0.85rem;
      color: var(--muted, #555);
      margin: 0 0 0.8em;
    }
    .doc ul { margin: 0 0 1em; padding-left: 1.4rem; }
    .doc li { margin: 0 0 0.35em; }
    /* The source's own bullet character is kept in the text, so suppress the
       list's marker and hang the indent on it instead. */
    .doc ul.marked {
      list-style: none;
      padding-left: 0;
    }
    .doc ul.marked li,
    .doc p.hang {
      padding-left: 1.3rem;
      text-indent: -1.3rem;
    }
    /* A table of contents is navigation, not prose — keep it compact and quiet
       so it never competes with the body text. */
    .doc ul.toc {
      list-style: none;
      padding-left: 0;
      font-size: 0.9rem;
      color: var(--muted, #555);
      columns: 2;
      column-gap: 2rem;
    }
    .doc ul.toc li { margin: 0 0 0.2em; break-inside: avoid; }
    .unreadable {
      font-size: 0.85rem;
      color: var(--muted, #777);
      font-style: italic;
    }
    /* A cited line and its panels. Stacked by default; side by side once there
       is room for both, which is where the annotation stops interrupting the
       reading and becomes a margin note. */
    .doc .notes { margin: 0 0 1em; }
    .doc > ul.marked { max-width: none; }
    .doc > ul.marked > li:not(.line) { max-width: 68ch; }

    /* CiteNote's own styles live here, as :global rules. A scoped <style> in the
       component would put a `data-astro-cid` attribute on each of its dozen
       elements, and those elements are rendered 510 times on one page. */
    /* Cancel the hanging indent. `li.line` carries `text-indent: -1.3rem` for
       the document's own bullet, and text-indent inherits — so below the 1080px
       grid (phones included) every first line in the panel, title and verdict
       alike, shifted left and was clipped by `.refs ul`'s scroll container:
       "AI-ansiktsigenkänning…" rendered as "ansiktsigenkänning…". The panel is
       not part of the bullet, so it resets unconditionally rather than inside a
       media query. */
    .doc :global(.cnote) {
      font-size: 0.8rem;
      line-height: 1.45;
      color: var(--ink-2);
      border-left: 2px solid var(--line);
      padding-left: 0.6rem;
      text-indent: 0;
    }
    .doc :global(.cnote + .cnote) { margin-top: 0.5rem; }
    .doc :global(.cnote > summary) {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      flex-wrap: wrap;
      cursor: pointer;
      list-style: none;
      color: var(--muted);
    }
    .doc :global(.cnote > summary::-webkit-details-marker) { display: none; }
    .doc :global(.cnote > summary:hover) { color: var(--accent-ink); }
    .doc :global(.cnote .n) {
      font-variant-numeric: tabular-nums;
      font-weight: 700;
      color: var(--ink-2);
    }
    /* The gap axis. Blue = the vote followed the party's own plan, gold = it did
       not; neither is a "good" colour, which is the point. */
    .doc :global(.cnote .bar) {
      display: flex;
      flex: 1 1 3.5rem;
      min-width: 3.5rem;
      max-width: 8rem;
      height: 7px;
      border-radius: 999px;
      overflow: hidden;
      background: var(--line-soft);
    }
    .doc :global(.seg.kept) { background: var(--accent); }
    .doc :global(.seg.diverged) { background: var(--gold-deep); }
    .doc :global(.seg.avstar) { background: var(--line); }
    .doc :global(.seg.franvarande) { background: var(--franvarande); }
    .doc :global(.cnote .flag) {
      font-size: 0.7rem;
      padding: 0.05rem 0.4rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--panel-2);
      color: var(--muted);
      cursor: help;
    }
    .doc :global(.cnote .body) { margin-top: 0.45rem; }
    .doc :global(.cnote .tally) { margin: 0; }
    .doc :global(.cnote .tally b) { font-variant-numeric: tabular-nums; color: var(--ink); }
    .doc :global(.cnote .tally b.kept) { color: var(--accent-ink); }
    .doc :global(.cnote .tally b.diverged) { color: var(--gold-deep); }
    .doc :global(.cnote .tiers) {
      margin: 0.35rem 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    .doc :global(.cnote .chip) {
      font-size: 0.72rem;
      padding: 0.05rem 0.4rem;
      border-radius: 999px;
      background: var(--accent-wash);
      color: var(--accent-ink);
    }
    .doc :global(.cnote .weak) { margin: 0.35rem 0 0; color: var(--muted); }
    .doc :global(.cnote .refs) { margin-top: 0.4rem; }
    /* Long lists stay inside the panel rather than pushing the document down —
       one line of partiprogram-kd-2015 is cited by 371 decisions. */
    .doc :global(.cnote .refs ul) {
      list-style: none;
      margin: 0;
      padding: 0;
      max-height: 15rem;
      overflow-y: auto;
    }
    .doc :global(.cnote .refs li) {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
      padding: 0.25rem 0;
      border-top: 1px solid var(--line-soft);
    }
    /* The case title takes the row and the verdict sits under it. A title is a
       sentence, not a date — left inline it wraps around the verdict chip and
       the two read as one run-on line. */
    .doc :global(.cnote .refs li > a) {
      flex: 1 0 100%;
      line-height: 1.35;
    }
    .doc :global(.cnote .refs .v) { font-weight: 600; }
    .doc :global(.cnote .refs .v.kept) { color: var(--accent-ink); }
    .doc :global(.cnote .refs .v.diverged) { color: var(--gold-deep); }
    .doc :global(.cnote .refs .v.avstar),
    .doc :global(.cnote .refs .v.franvarande) { color: var(--muted); }
    .doc :global(.cnote .refs .meta) { color: var(--muted); }
    @media (min-width: 1080px) {
      .docwrap.withrail { grid-template-columns: 15rem minmax(0, 1fr); gap: 1.75rem; }
      /* Clear of the site header, which is itself sticky at 78px (the same
         offset Base.astro gives :target, so a rail link lands below it too). */
      .rail { position: sticky; top: 5.5rem; align-self: start; max-height: calc(100vh - 7rem); }
      .doc > .line,
      .doc > ul.marked > li.line {
        max-width: none;
        display: grid;
        grid-template-columns: minmax(0, 68ch) minmax(0, 1fr);
        column-gap: 1.5rem;
        align-items: start;
      }
      .doc > ul.marked > li.line { padding-left: 0; text-indent: 0; }
      .doc > ul.marked > li.line > .t { padding-left: 1.3rem; text-indent: -1.3rem; }
      .doc .notes { margin: 0.15rem 0 0; }
    }
    @media (max-width: 640px) {
      .doc { padding: 1.15rem; font-size: 0.97rem; }
      .doc ul.toc { columns: 1; }
    }
  </style>
</Base>
