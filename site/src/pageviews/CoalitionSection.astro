---
import PartyBadge from '../components/PartyBadge.astro';
import { getMeta, getAggregate } from '../lib/data';
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const meta = getMeta();

interface Bucket { den: number; num: number; rate: number | null }
interface PartyRow {
  n: number;
  bloc: string;
  coalition_baseline: number;
  programme_accuracy: number;
  programme_lift: number;
  authored_reservation_n: number;
  override: Record<'strict' | 'loose', Record<'all' | 'authored' | 'not_authored', Bucket>>;
}
interface OverrideCase {
  votering_id: string; datum: string; rubrik: string; utskott: string; parti: string;
  ai_rost: string; actual: string; confidence: string; coverage: string;
  strict: boolean; authored_reservation: boolean; motivering: string;
  citations: { document: string; quote: string; princip?: string; svag?: boolean }[];
}
const coalition = getAggregate<{
  n_decisions: number;
  per_party: Record<string, PartyRow>;
  override_cases: OverrideCase[];
}>('coalition');


// Ordered by how much the programme adds: coalition-explained parties first.
const parties = coalition
  ? meta.hemicycle_order
      .filter((p) => coalition.per_party[p])
      .sort((a, b) => coalition.per_party[a].programme_lift - coalition.per_party[b].programme_lift)
  : [];
const cases = coalition?.override_cases ?? [];
const pct = (v: number | null) => (v == null ? '–' : `${(v * 100).toFixed(0)}%`);
const cell = (b: Bucket) => (b.den === 0 ? '–' : `${b.num}/${b.den}`);
---

<h2 id="koalition" class="cosec">{t('coalition.title')}</h2>
  <p class="muted">{t('coalition.intro')}</p>

  {!coalition ? (
    <div class="card"><p class="muted">–</p></div>
  ) : (
    <>
      <h3>{t('coalition.tableTitle')}</h3>
      <div class="card" style="overflow-x:auto">
        <table class="compare nums">
          <thead>
            <tr>
              <th></th>
              <th>{t('coalition.baseline')}</th>
              <th>{t('coalition.programme')}</th>
              <th>{t('coalition.lift')}</th>
              <th></th>
              <th>n</th>
            </tr>
          </thead>
          <tbody>
            {parties.map((p) => {
              const s = coalition.per_party[p];
              const lift = s.programme_lift;
              // Bar is scaled against the largest lift on the page.
              const width = Math.max(0, lift) * 100 * 4;
              return (
                <tr>
                  <td>
                    <PartyBadge code={p} parties={meta.parties} label="none" />
                  </td>
                  <td>{pct(s.coalition_baseline)}</td>
                  <td>{pct(s.programme_accuracy)}</td>
                  <td class={lift > 0.02 ? 'lift pos' : 'lift zero'}>
                    {lift >= 0 ? '+' : '−'}{Math.abs(lift * 100).toFixed(1)} pp
                  </td>
                  <td class="barcell">
                    <span class="bar" style={`width:${width}%;background:${meta.parties[p]?.color}`} />
                  </td>
                  <td class="muted">{s.n}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="muted note">{t('coalition.baselineNote')}</p>
        <p class="muted note"><strong>M · KD · L —</strong> {t('coalition.govNote')}</p>
      </div>

      <h3>{t('coalition.overrideTitle')}</h3>
      <p class="muted">{t('coalition.overrideIntro')}</p>
      <div class="card" style="overflow-x:auto">
        <table class="compare nums">
          <thead>
            <tr>
              <th></th>
              <th colspan="2">{t('coalition.ownResCol')}</th>
              <th colspan="2">{t('coalition.notOwnCol')}</th>
            </tr>
            <tr class="sub">
              <th></th>
              <th>{t('coalition.strict')}</th>
              <th>{t('coalition.loose')}</th>
              <th>{t('coalition.strict')}</th>
              <th>{t('coalition.loose')}</th>
            </tr>
          </thead>
          <tbody>
            {parties.filter((p) => coalition.per_party[p].override.loose.all.den > 0).map((p) => {
              const o = coalition.per_party[p].override;
              return (
                <tr>
                  <td>
                    <PartyBadge code={p} parties={meta.parties} label="none" />
                  </td>
                  <td class="zero">{cell(o.strict.authored)} <span class="muted">{pct(o.strict.authored.rate)}</span></td>
                  <td class="zero">{cell(o.loose.authored)} <span class="muted">{pct(o.loose.authored.rate)}</span></td>
                  <td class="hot"><strong>{cell(o.strict.not_authored)}</strong> <span class="muted">{pct(o.strict.not_authored.rate)}</span></td>
                  <td class="hot">{cell(o.loose.not_authored)} <span class="muted">{pct(o.loose.not_authored.rate)}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p class="muted note">{t('coalition.authoredZero')}</p>
      </div>

      {/* The 471 individual votes used to be listed here, and were 98% of the
          page (~151 screens). They now live on each party's own page, where the
          reader already has that party's context and only sees its own subset —
          the table above links straight through. */}
      <h3>{t('coalition.casesTitle')} <span class="muted">({cases.length})</span></h3>
      <p class="muted">{t('coalition.casesByParty')}</p>
      <div class="card">
        <ul class="ovlinks">
          {parties
            .map((p) => ({ code: p, n: cases.filter((c) => c.parti === p).length }))
            .filter((x) => x.n > 0)
            .sort((a, b) => b.n - a.n)
            .map((x) => (
              <li>
                <a href={localePath(lang, `/parti/${x.code.toLowerCase()}/`)}>
                  <PartyBadge code={x.code} parties={meta.parties} label="name" />
                </a>
                <span class="muted">{x.n}</span>
              </li>
            ))}
        </ul>
      </div>

      <h3>{t('coalition.caveatTitle')}</h3>
      <div class="card caveat">
        <p>{t('coalition.caveat')}</p>
      </div>
    </>
  )}

  <style>
    .nums td, .nums th { font-variant-numeric: tabular-nums; }
    .nums thead tr.sub th { font-weight: 400; font-size: 0.8rem; color: var(--muted); }
    .note { font-size: 0.83rem; }
    .lift.pos { color: #1d6b3a; font-weight: 600; }
    .lift.zero { color: var(--muted); }
    .barcell { width: 40%; }
    .bar { display: block; height: 9px; border-radius: 4px; min-width: 1px; }
    .zero { color: var(--muted); }
    .hot { background: #fdf5e8; }
    .small { font-size: 0.8rem; }
    /* where the individual votes went: one row per party, count on the right */
    .ovlinks { list-style: none; margin: 0; padding: 0; }
    .ovlinks li {
      display: flex; align-items: center; justify-content: space-between; gap: 0.8rem;
      padding: 0.5rem 0; border-bottom: 1px solid var(--line-soft);
    }
    .ovlinks li:last-child { border-bottom: 0; }
    .ovlinks a { text-decoration: none; }
    .ovlinks a:hover { text-decoration: underline; }
    .ovlinks .muted { font-variant-numeric: tabular-nums; }
    .caveat p { margin: 0; }
  </style>
