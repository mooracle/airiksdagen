---
/**
 * Embeddable widget, Swedish: <iframe src=".../embed/{id}/"> (long) or
 * ".../embed/{id}/?v=short" (short). See pageviews/EmbedCard.astro.
 * A URL fragment like #S highlights that party's row (CSS :target).
 */
import EmbedCard from '../../pageviews/EmbedCard.astro';
import { getCase, listCaseIds } from '../../lib/data';

export async function getStaticPaths() {
  return listCaseIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
---

<EmbedCard lang="sv" caseData={getCase(id!)} />
