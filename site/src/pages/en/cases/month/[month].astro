---
import MonthPage from '../../../../pageviews/MonthPage.astro';
import { listCaseMonths } from '../../../../lib/data';

export function getStaticPaths() {
  return listCaseMonths().map((month) => ({ params: { month } }));
}

const { month } = Astro.params;
---

<MonthPage lang="en" month={month!} />
