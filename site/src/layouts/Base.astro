---
import { useTranslations, localePath, languages, metaDescription, type Lang } from '../i18n/ui';
import { siteLastmod } from '../lib/lastmod';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** CANONICAL (Swedish) path without base/locale prefix — localePath
   * translates slugs, so the switcher and hreflang always pair correctly */
  path?: string;
  /** 'article' for the one-subject pages (a case, a source document); the
   * landing/index pages are 'website'. Previously every page claimed
   * 'article', which mislabels the home page and the listings. */
  ogType?: 'website' | 'article';
  /** Page-specific schema.org properties (`@type` and up). Boilerplate every
   * page shares — context, publisher, canonical @id, language, dates — is
   * filled in below, and anything passed here wins over it. */
  jsonLd?: Record<string, unknown> | null;
}

const { lang, title, description, path = '/', ogType = 'website', jsonLd = null } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${t('site.title')}` : `${t('site.title')} — ${t('site.tagline')}`;
// Normalise centrally: pages may pass a full lede, so collapse and clip it to a
// snippet length here rather than trusting every caller to keep it short.
const desc = metaDescription([description, t('site.tagline')]) ?? t('site.tagline');

// SEO: absolute canonical + hreflang alternates for both language versions.
const site = (Astro.site?.toString() ?? 'https://airiksdagen.se/').replace(/\/$/, '');
const urlSv = `${site}${localePath('sv', path)}`;
const urlEn = `${site}${localePath('en', path)}`;
const canonical = lang === 'sv' ? urlSv : urlEn;

// Structured data. The publisher/organisation is the project itself: the
// analysis on these pages is machine-generated, so naming a human author would
// be a false claim. Dates come from the same build-time stamp as the sitemap's
// <lastmod>, and are dropped together with it when it can't be established.
const lastmod = siteLastmod();
const publisher = {
  '@type': 'Organization',
  name: t('site.title'),
  url: `${site}/`,
  logo: { '@type': 'ImageObject', url: `${site}/logo.svg` },
};
const graph = jsonLd && {
  '@context': 'https://schema.org',
  inLanguage: lang === 'sv' ? 'sv-SE' : 'en',
  isPartOf: { '@type': 'WebSite', name: t('site.title'), url: `${site}/` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  author: publisher,
  publisher,
  image: `${site}/og-image.png`,
  ...(lastmod ? { datePublished: lastmod, dateModified: lastmod } : {}),
  ...jsonLd,
};
// JSON.stringify leaves `<` intact, so a "</script>" inside any case text would
// close the block early and spill the rest into the document as markup.
const graphJson = graph && JSON.stringify(graph).replace(/</g, '\\u003c');

// active nav: mark the link whose section contains the current URL, so the
// gold underline tracks where you are (Home matches only exactly).
const cur = Astro.url.pathname.replace(/\/+$/, '') || '/';
function navCurrent(canonicalPath: string): 'page' | undefined {
  const target = localePath(lang, canonicalPath).replace(/\/+$/, '') || '/';
  const active = canonicalPath === '/' ? cur === target : cur === target || cur.startsWith(target + '/');
  return active ? 'page' : undefined;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sv" href={urlSv} />
    <link rel="alternate" hreflang="en" href={urlEn} />
    <link rel="alternate" hreflang="x-default" href={urlSv} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t('site.title')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'sv' ? 'sv_SE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'sv' ? 'en_US' : 'sv_SE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="#14202b" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/site.webmanifest`} />
    {graphJson && <script type="application/ld+json" is:inline set:html={graphJson} />}
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href={localePath(lang, '/')}>
          {/* The mark is the 349-seat chamber, one dot per seat, in party order
              (scripts/gen_brand_assets.mjs). Transparent and background-agnostic:
              its palette is the party hues remapped into a luminance band that
              clears 3:1 on both ink and white, so it needs no plate behind it
              here. Referenced as a file, not inlined — 349 circles would add
              ~14KB to every one of the 2,500+ case pages. */}
          <img class="brand-mark" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logomark.svg`}
               alt="" width="100" height="52" aria-hidden="true" /> {t('site.title')}
        </a>
        <div class="links">
          <a href={localePath(lang, '/fall/')} aria-current={navCurrent('/fall/')}>{t('nav.cases')}</a>
          <a href={localePath(lang, '/analys/')} aria-current={navCurrent('/analys/')}>{t('nav.analysis')}</a>
          {/* Koalition folded into Parties — same question, one entry. */}
          <a href={localePath(lang, '/parti/')} aria-current={navCurrent('/parti/')}>{t('nav.parties')}</a>
          <a href={localePath(lang, '/om/')} aria-current={navCurrent('/om/')}>{t('nav.about')}</a>
          <div class="langswitch" role="group" aria-label={t('nav.langLabel')}>
            {(['sv', 'en'] as Lang[]).map((l) => (
              l === lang ? (
                <span aria-current="true" title={languages[l]}>{l.toUpperCase()}</span>
              ) : (
                /* hreflang (not lang) marks the TARGET language: the accessible
                   name below is written in the CURRENT page's language, so lang
                   here would make a screen reader mispronounce it. */
                <a
                  href={localePath(l, path)}
                  hreflang={l}
                  rel="alternate"
                  aria-label={`${t('nav.langSwitch')} ${languages[l]}`}
                  title={languages[l]}
                >{l.toUpperCase()}</a>
              )
            ))}
          </div>
        </div>
      </nav>
    </header>
    {/* Full-bleed band above the measure-constrained column. A named slot rather
        than a `100vw` margin trick inside <main>: 100vw includes the scrollbar,
        so that approach hands you a horizontal scrollbar on every page that
        scrolls vertically. */}
    <slot name="hero" />
    <main>
      <slot />
    </main>
    <footer>
      <div class="foot">
        <div>
          <strong>{t('site.title')}</strong>
          <p>{t('footer.about')}</p>
        </div>
        <div>
          <strong>{t('footer.sources')}</strong>
          <p>
            {t('case.source')} · <a href="https://snd.se/sv/vivill">SND Vivill</a> ·
            Riksbanken · SCB · Wikipedia (CC BY-SA)
          </p>
        </div>
        <div>
          <strong>{t('footer.open')}</strong>
          <p>{t('footer.license')} <a href="https://github.com/mooracle/airiksdagen">GitHub</a></p>
          <p class="builtby">{t('footer.builtby')} <a href="https://mooracle.io">mooracle.io</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    /* neutrals — warm editorial paper, one deep ink for chrome + text */
    --paper: #f6f4ee;
    --panel: #ffffff;
    --panel-2: #faf8f2;      /* raised/alt surface: table hover, insets */
    --ink: #14202b;
    --ink-2: #3d4a56;
    /* 4.66:1 on --paper, 5.13:1 on --panel. Was #6c7883, which measured 4.10:1
       on paper — under AA. `.muted` carries body-size explanatory prose all over
       the site (chart notes, ledes, table footnotes), so it has to clear 4.5. */
    --muted: #646f7a;
    --line: #e5e1d6;
    --line-soft: #efece3;    /* lighter hairline for inner rows */
    /* brand: editorial blue + civic gold (ties in the gold logomark) */
    --accent: #175d92;
    --accent-ink: #103f61;
    --accent-wash: #eaf1f7;
    /* One gold, shared with the generated brand assets (GOLD in
       scripts/gen_brand_assets.mjs). The chrome rules were #e3ad39 while the
       logomark was #f2c744 — near enough to look like a printing error where the
       two met at the header edge. Gold is now purely chrome (rules, the language
       pill, the active-nav underline) since the mark carries party colours, so
       the deeper editorial value wins over the brighter one. */
    --gold: #e3ad39;
    --gold-soft: #f6e9c8;
    /* gold is a fill, never legible as text on paper (1.85:1). This is the same
       hue taken down until it clears AA for the small uppercase .eyebrow —
       4.77:1 on paper, 5.25:1 on a white panel. */
    --gold-deep: #8f6412;
    /* vote semantics (kept in sync with VOTE_COLORS in lib/hemicycle.ts) */
    --ja: #2f7d43;
    --nej: #c0322c;
    --avstar: #dc9a1c;
    --franvarande: #cbc6bc;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 18px;
    --shadow-sm: 0 1px 2px rgb(20 32 43 / 0.05);
    --shadow: 0 1px 2px rgb(20 32 43 / 0.05), 0 10px 28px -12px rgb(20 32 43 / 0.14);
    --shadow-lg: 0 1px 2px rgb(20 32 43 / 0.06), 0 24px 60px -22px rgb(20 32 43 / 0.28);
    /* type: one display serif for headings and figures, system sans for prose */
    --display: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia,
               'Times New Roman', serif;
    /* Page gutter — shared by the header, the hero band, main and the footer so
       every left edge on the site lines up. Widened from 1120px: tables, the
       co-voting matrix and the time-series charts all wanted more room. */
    --measure: 1280px;
    /* Reading measure for running text. Prose is NOT allowed to use the full
       page width — at 1280px a paragraph runs to ~150 characters a line, roughly
       twice a comfortable measure, and the eye loses its place on the return
       sweep. Components (tables, figures, charts, stat grids) opt out and take
       the whole gutter. */
    --text: 72ch;
    /* on the ink band: text tiers that hold 4.5:1+ against --ink */
    --on-ink: #eef2f5;
    --on-ink-2: #b9c5cf;
    --on-ink-3: #8d9aa6;
    --rule-ink: #2c3b49;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    /* warm vertical wash rather than one flat fill, so long pages have some
       depth behind the panels instead of reading as a single grey sheet */
    background: var(--paper) linear-gradient(180deg, #fbf9f4 0%, var(--paper) 34rem);
    background-attachment: fixed;
    color: var(--ink);
    line-height: 1.65;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3, .brand {
    font-family: var(--display);
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  h1 { font-size: clamp(2rem, 4.6vw, 2.9rem); line-height: 1.1; margin: 0.5rem 0 1rem; font-weight: 700; }
  h2 { font-size: clamp(1.5rem, 2.4vw, 1.8rem); margin: 3rem 0 1rem; font-weight: 700; line-height: 1.2; }
  h3 { font-size: 1.16rem; margin: 1.8rem 0 0.5rem; font-weight: 700; }
  p { margin: 0.7rem 0; }

  /* ── section structure ────────────────────────────────────────────────
     Pages used to be a flat run of h2 + card, h2 + card, with nothing to mark
     where one subject ended and the next began. An h2 now carries a hairline
     and can take an .eyebrow kicker above it. */
  .eyebrow {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.11em; color: var(--gold-deep);
    margin: 2.8rem 0 0.15rem; display: flex; align-items: center; gap: 0.55rem;
  }
  .eyebrow::after {
    content: ''; flex: 1; height: 1px; background: var(--line);
  }
  .eyebrow + h2 { margin-top: 0.1rem; }
  h2.rule { padding-bottom: 0.55rem; border-bottom: 2px solid var(--ink); }
  .lede { font-size: 1.14rem; line-height: 1.6; color: var(--ink-2); max-width: 60ch; }

  /* ── stat display ─────────────────────────────────────────────────────
     The headline figures were set as bold spans inside running text, which
     made the most important number on the site look like an emphasised word. */
  .stat { display: flex; flex-direction: column; gap: 0.1rem; }
  .stat .num {
    font-family: var(--display); font-weight: 700; line-height: 0.92;
    font-size: clamp(2.6rem, 6vw, 4rem); letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums; font-feature-settings: 'tnum';
  }
  .stat .lbl { font-size: 0.97rem; color: var(--ink-2); max-width: 34ch; }
  .stat .meta {
    font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }
  /* Tiles sit left at a fixed width rather than each stretching to an equal share
     of the page — two tiles on a 1280px gutter otherwise spread a two-digit
     number across half a screen.
     Flex, not `grid` + `width: fit-content`: fit-content resolves the container
     to its minimum, which starves `auto-fit` into placing a single column. */
  .statgrid {
    display: flex; flex-wrap: wrap; gap: 1px; background: var(--line);
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    width: fit-content; max-width: 100%;
  }
  .statgrid > * { background: var(--panel); padding: 1.1rem 1.25rem; flex: 0 0 auto; min-width: 11rem; }
  .statgrid .num { font-size: clamp(1.7rem, 3vw, 2.2rem); }
  .statgrid .lbl { font-size: 0.85rem; }

  /* proportional stacked bar — for parts of a whole that were previously just
     three numbers separated by spaces */
  .tierbar { display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: var(--line); }
  .tierbar > span { display: block; height: 100%; }
  .tierkeys {
    display: flex; flex-wrap: wrap; gap: 0.25rem 1.1rem; margin: 0.6rem 0 0;
    font-size: 0.8rem; list-style: none; padding: 0;
  }
  .tierkeys li { display: flex; align-items: baseline; gap: 0.4rem; }
  .tierkeys .sw { width: 0.62em; height: 0.62em; border-radius: 2px; flex: none; transform: translateY(-0.05em); }
  .tierkeys b { font-variant-numeric: tabular-nums; }

  /* ── figures ──────────────────────────────────────────────────────────
     A chart is a figure with a caption, not a bare div. */
  figure.fig { margin: 0; }
  figure.fig > figcaption {
    font-size: 0.84rem; color: var(--muted); margin-top: 0.7rem;
    padding-top: 0.6rem; border-top: 1px solid var(--line-soft);
  }
  /* trailing explanatory line under a table or figure */
  .note { font-size: 0.84rem; color: var(--muted); }
  a {
    color: var(--accent); text-underline-offset: 2px;
    text-decoration-color: color-mix(in srgb, currentColor 32%, transparent);
  }
  a:hover { color: var(--accent-ink); text-decoration-color: currentColor; }
  :focus-visible { outline: 2.5px solid var(--accent); outline-offset: 2px; border-radius: 3px; }

  header {
    background: var(--ink);
    position: sticky; top: 0; z-index: 20;
    border-bottom: 2px solid var(--gold);
    box-shadow: 0 8px 22px -18px rgb(0 0 0 / 0.75);
  }
  header nav {
    max-width: 1120px; margin: 0 auto; padding: 0.7rem 1.3rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  header nav .brand {
    font-weight: 700; font-size: 1.24rem; color: #fff; text-decoration: none;
    display: inline-flex; align-items: center; letter-spacing: -0.015em;
  }
  /* Taller than the old glyph mark: the chamber is a wide, detailed drawing and
     needs the height to stay readable rather than becoming a coloured smear. */
  header nav .brand-mark { height: 1.4em; width: auto; vertical-align: -0.2em; margin-right: 0.4em; }
  header nav .links { display: flex; gap: 1.15rem; flex-wrap: wrap; align-items: center; }
  header nav .links a {
    color: #c2ccd3; text-decoration: none; font-size: 0.94rem; position: relative;
    padding: 0.15rem 0; transition: color 0.15s ease;
  }
  header nav .links a:hover { color: #fff; }
  header nav .links a[aria-current] { color: #fff; }
  header nav .links a[aria-current]::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -0.18rem;
    height: 2px; border-radius: 2px; background: var(--gold);
  }
  /* Language switcher: a segmented control showing BOTH languages with the
     current one marked, rather than a lone link to "the other" one — which
     never revealed what you were currently reading. */
  /* Scoped under .links deliberately: `nav .links a` (0,1,2) outranks a plain
     `nav .langswitch > *` (0,1,1), so the link half alone inherited the nav's
     0.94rem font and zero side padding while the current half kept these —
     the two segments rendered at different sizes. Two classes wins the cascade
     for both children, so the control is styled as one unit. */
  header nav .links .langswitch {
    display: inline-flex; align-items: stretch; margin-left: 0.25rem;
    border: 1px solid #45535e; border-radius: 6px; overflow: hidden;
    font-weight: 600; letter-spacing: 0.03em;
  }
  header nav .links .langswitch > * {
    display: flex; align-items: center; padding: 0.18rem 0.62rem;
    font-size: 0.78rem; line-height: 1.5; text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  header nav .links .langswitch > * + * { border-left: 1px solid #45535e; }
  /* current language: filled, not a link */
  header nav .links .langswitch > [aria-current] { background: var(--gold); color: #2b2205; cursor: default; }
  /* the other language: a real link, so it is crawlable and obviously clickable */
  header nav .links .langswitch > a { color: #c2ccd3; }
  header nav .links .langswitch > a:hover { background: #263340; color: #fff; }
  header nav .links .langswitch > a:focus-visible { outline: 2.5px solid var(--gold); outline-offset: -3px; }
  /* the nav's active-page underline must not bleed into the switcher */
  header nav .links .langswitch > a[aria-current]::after { content: none; }

  main { max-width: var(--measure); margin: 0 auto; padding: 1.8rem 1.3rem 4.5rem; }

  /* ── measure ──────────────────────────────────────────────────────────
     Running text is capped at --text and stays flush left, so it shares its
     left edge with the full-width components below it. Everything structural —
     tables, figures, charts, stat grids, card grids — opts out and uses the
     whole gutter. Matching at any depth, so prose inside a section or a card is
     covered too, then narrowing the exceptions. */
  main :is(h1, h2, h3, h4, p, ul, ol, dl, blockquote, figcaption, .lede, .note) {
    max-width: var(--text);
  }
  /* table cells size to the table, never to a reading measure */
  main :is(td, th) :is(p, ul, ol, dl) { max-width: none; }
  /* these are laid-out rows that happen to use text tags, not prose. .eyebrow is
     here because its trailing hairline frames the whole section — stopping it at
     the reading measure left it short of the full-width table beneath it. */
  main :is(.eyebrow, .tierkeys, .ovlinks, .legend, .jump, .statgrid, .stat, .searchrow, .tiers) {
    max-width: none;
  }
  main :is(.statgrid, .stat, .legend, .tierkeys) :is(p, ul, ol) { max-width: none; }
  /* opt-out hook for one-off wide blocks */
  main .wide { max-width: none; }
  /* a hero band already supplies the opening space */
  body:has(.masthead) main { padding-top: 0.4rem; }

  /* ── masthead ─────────────────────────────────────────────────────────
     The dark opening band. Every page previously began with an unadorned h1 on
     paper, so the site had no front door and the chamber motif — the whole
     identity of the project — appeared nowhere except a 20px nav glyph. */
  .masthead {
    position: relative; overflow: hidden;
    background: var(--ink);
    color: var(--on-ink);
    border-bottom: 1px solid var(--rule-ink);
  }
  /* The chamber as a watermark: a wide, shallow dome rising from the bottom edge.
     Anchored to the band's own bottom and mostly clipped, so what shows is a
     horizon rather than a floating cut-off arc. */
  .masthead .mh-mark {
    position: absolute; left: 50%; bottom: -58%;
    width: min(78%, 1000px); height: auto;
    transform: translateX(-32%);
    opacity: 0.2; pointer-events: none; user-select: none;
  }
  .mh-wrap {
    position: relative; z-index: 1;
    max-width: var(--measure); margin: 0 auto; padding: 2.9rem 1.3rem 3.1rem;
    display: grid; gap: 2rem 3rem; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: start;
  }
  .masthead h1 { color: #fff; margin: 0.3rem 0 0.9rem; max-width: 24ch; }
  .masthead .eyebrow { color: var(--gold); margin: 0; }
  .masthead .eyebrow::after { background: var(--rule-ink); }
  .masthead .lede { color: var(--on-ink-2); font-size: 1.06rem; max-width: 52ch; }
  .masthead .disclaimer {
    margin: 1.2rem 0 0; font-size: 0.87rem; color: var(--on-ink-3);
    border-left: 2px solid var(--avstar); padding-left: 0.85rem; max-width: 60ch;
  }
  /* headline figure, sat on the ink rather than in a white box */
  .mh-stat {
    border: 1px solid var(--rule-ink); border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.035); padding: 1.4rem 1.5rem;
    backdrop-filter: blur(2px);
  }
  .mh-stat .num { color: #fff; }
  .mh-stat .lbl { color: var(--on-ink-2); }
  .mh-stat .meta { color: var(--on-ink-3); }
  .mh-stat .tierbar { background: var(--rule-ink); margin-top: 1.2rem; }
  .mh-stat .tierkeys { color: var(--on-ink-2); }
  .mh-stat hr { border: 0; border-top: 1px solid var(--rule-ink); margin: 1.2rem 0; }
  @media (max-width: 860px) {
    .mh-wrap { grid-template-columns: 1fr; padding-top: 2.1rem; }
    .masthead .mh-mark { width: 130%; bottom: -34%; transform: translateX(-50%); opacity: 0.16; }
  }

  footer { background: var(--ink); color: #b7c1c9; margin-top: 3rem; border-top: 2px solid var(--gold); }
  footer a { color: #dbe4ea; }
  footer .builtby { margin-top: 0.4rem; font-size: 0.85em; opacity: 0.75; }
  .foot {
    max-width: 1120px; margin: 0 auto; padding: 2.4rem 1.3rem;
