---
import { useTranslations, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** path without locale prefix, used for the language switcher */
  path?: string;
}

const { lang, title, description, path = '/' } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${t('site.title')}` : `${t('site.title')} — ${t('site.tagline')}`;
const otherLang: Lang = lang === 'sv' ? 'en' : 'sv';
const desc = description ?? t('site.tagline');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href={localePath(lang, '/')}>
          <span class="brand-mark">■</span> {t('site.title')}
        </a>
        <div class="links">
          <a href={localePath(lang, lang === 'sv' ? '/fall/' : '/cases/')}>{t('nav.cases')}</a>
          <a href={localePath(lang, '/parti/')}>{t('nav.parties')}</a>
          <a href={localePath(lang, '/dokument/')}>{t('nav.documents')}</a>
          <a href={localePath(lang, lang === 'sv' ? '/metod/' : '/methodology/')}>{t('nav.method')}</a>
          <a href={localePath(lang, '/data/')}>{t('nav.data')}</a>
          <a class="lang" href={localePath(otherLang, path)}>{otherLang.toUpperCase()}</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="foot">
        <div>
          <strong>{t('site.title')}</strong>
          <p>{t('footer.about')}</p>
        </div>
        <div>
          <strong>{t('footer.sources')}</strong>
          <p>
            {t('case.source')} · <a href="https://snd.se/sv/vivill">SND Vivill</a> ·
            Riksbanken · SCB · Wikipedia (CC BY-SA)
          </p>
        </div>
        <div>
          <strong>{t('footer.open')}</strong>
          <p>{t('footer.license')} <a href="https://github.com/OWNER/aidag">GitHub</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f6f1;
    --panel: #ffffff;
    --ink: #17222c;
    --ink-2: #45525e;
    --muted: #6e7a85;
    --line: #e2dfd6;
    --accent: #1c5d99;
    --accent-ink: #12405f;
    --ja: #2e7d32;
    --nej: #c62828;
    --avstar: #e8a013;
    --franvarande: #c8c4ba;
    --radius: 10px;
    --shadow: 0 1px 2px rgb(23 34 44 / 0.05), 0 4px 14px rgb(23 34 44 / 0.05);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--paper);
    color: var(--ink);
    line-height: 1.6;
    font-size: 16px;
  }
  h1, h2, h3, .brand {
    font-family: Georgia, 'Times New Roman', serif;
    letter-spacing: -0.01em;
  }
  h1 { font-size: clamp(1.7rem, 4vw, 2.4rem); line-height: 1.2; margin: 0.6rem 0 1rem; }
  h2 { font-size: 1.35rem; margin: 2.2rem 0 0.8rem; }
  a { color: var(--accent); text-underline-offset: 2px; }
  a:hover { color: var(--accent-ink); }

  header {
    background: var(--ink);
    position: sticky; top: 0; z-index: 20;
  }
  nav {
    max-width: 1100px; margin: 0 auto; padding: 0.65rem 1.2rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
  }
  nav .brand {
    font-weight: 700; font-size: 1.2rem; color: #fff; text-decoration: none;
  }
  nav .brand-mark { color: #f2c744; font-size: 0.8em; }
  nav .links { display: flex; gap: 1.1rem; flex-wrap: wrap; align-items: center; }
  nav .links a {
    color: #cfd8df; text-decoration: none; font-size: 0.94rem;
  }
  nav .links a:hover { color: #fff; }
  nav .lang {
    border: 1px solid #46545f; border-radius: 5px; padding: 0.05rem 0.5rem; font-size: 0.8rem;
  }

  main { max-width: 1100px; margin: 0 auto; padding: 1.6rem 1.2rem 4rem; }

  footer { background: var(--ink); color: #b9c3cb; margin-top: 2rem; }
  footer a { color: #dbe4ea; }
  .foot {
    max-width: 1100px; margin: 0 auto; padding: 2rem 1.2rem;
    display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    font-size: 0.86rem;
  }
  .foot strong { color: #fff; display: block; margin-bottom: 0.3rem; }
  .foot p { margin: 0; }

  .muted { color: var(--muted); }
  .card {
    background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 1.1rem 1.3rem; margin: 0.8rem 0; box-shadow: var(--shadow);
  }
  .chip {
    display: inline-block; background: #edeae1; color: var(--ink-2);
    border-radius: 999px; padding: 0.08rem 0.65rem; font-size: 0.78rem; font-weight: 600;
    margin-right: 0.35rem;
  }

  table.compare { width: 100%; border-collapse: collapse; font-size: 0.93rem; }
  table.compare th {
    text-align: left; padding: 0.5rem 0.65rem; border-bottom: 2px solid var(--line);
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted);
  }
  table.compare td { text-align: left; padding: 0.5rem 0.65rem; border-bottom: 1px solid var(--line); }
  table.compare tr:hover td { background: #fbfaf6; }
  table.compare td, .stat-num { font-variant-numeric: tabular-nums; }

  .votechip {
    display: inline-block; padding: 0.06rem 0.6rem; border-radius: 999px;
    font-size: 0.82rem; font-weight: 700; color: #fff; white-space: nowrap;
  }
  .votechip[data-v='Ja'] { background: var(--ja); }
  .votechip[data-v='Nej'] { background: var(--nej); }
  .votechip[data-v='Avstår'] { background: var(--avstar); color: #3a2c00; }
  .votechip[data-v='Frånvarande'] { background: var(--franvarande); color: #4b4941; }

  .partydot { display: inline-block; width: 0.7em; height: 0.7em; border-radius: 50%; margin-right: 0.35em; }
  .match { color: var(--ja); font-weight: 700; }
  .mismatch { color: var(--nej); font-weight: 700; }
  .grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }

  .statbar { display: flex; align-items: center; gap: 0.6rem; margin: 0.35rem 0; }
  .statbar .bar { flex: 1; height: 10px; background: #eceae2; border-radius: 5px; overflow: hidden; }
  .statbar .bar > div { height: 100%; border-radius: 5px; }

  .btn {
    display: inline-block; padding: 0.5rem 1.1rem; border: none; border-radius: 7px;
    background: var(--accent); color: #fff; font-size: 0.95rem; cursor: pointer;
    text-decoration: none;
  }
  .btn:hover { background: var(--accent-ink); color: #fff; }
  .btn.ghost { background: transparent; border: 1px solid var(--line); color: var(--ink-2); }
  .btn.ghost:hover { border-color: var(--accent); color: var(--accent); }

  code { background: #eeece4; padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.88em; }
  input[type='search'], input[type='text'], select, textarea {
    font: inherit; padding: 0.5rem 0.7rem; border: 1px solid var(--line);
    border-radius: 7px; background: #fff; color: var(--ink);
  }
  :target { scroll-margin-top: 70px; }
  details.card > summary { cursor: pointer; }
</style>
