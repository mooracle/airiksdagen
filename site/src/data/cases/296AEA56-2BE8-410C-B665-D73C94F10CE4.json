typ": "mot", "label": "Motion 2023/24:1040", "titel": "Bättre arbetsmiljö", "undertitel": "av Carina Ödebrink och Azra Muranovic (båda S)"}, {"dok_id": "HB02123", "typ": "mot", "label": "Motion 2023/24:123", "titel": "Sverige och EU:s arbetstidsdirektiv", "undertitel": "av Eric Palmqvist (SD)"}, {"dok_id": "HB021252", "typ": "mot", "label": "Motion 2023/24:1252", "titel": "Lagstiftning för distansarbete", "undertitel": "av Martina Johansson m.fl. (C)"}, {"dok_id": "HB021310", "typ": "mot", "label": "Motion 2023/24:1310", "titel": "Stärkt tillträdesrätt för skyddsombud", "undertitel": "av Hanna Westerén (S)"}, {"dok_id": "HB021328", "typ": "mot", "label": "Motion 2023/24:1328", "titel": "Utrikes föddas upplevelse av sin arbetsmiljö", "undertitel": "av Jamal El-Haj (S)"}, {"dok_id": "HB021519", "typ": "mot", "label": "Motion 2023/24:1519", "titel": "En grön klimathandlingsplan för Sverige", "undertitel": "av Elin Söderberg m.fl. (MP)"}, {"dok_id": "HB021559", "typ": "mot", "label": "Motion 2023/24:1559", "titel": "Ordning och reda i upphandlingar", "undertitel": "av Johan Andersson m.fl. (S)"}, {"dok_id": "HB021776", "typ": "mot", "label": "Motion 2023/24:1776", "titel": "Klädbidrag till personal inom förskola", "undertitel": "av Michael Rubbestad (SD)"}, {"dok_id": "HB021842", "typ": "mot", "label": "Motion 2023/24:1842", "titel": "Regionala skyddsombuds tillträde till arbetsplatser", "undertitel": "av Adnan Dibrani och Lars Mejern Larsson (båda S)"}, {"dok_id": "HB022010", "typ": "mot", "label": "Motion 2023/24:2010", "titel": "Företagshälsovård för alla arbetstagare", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB022019", "typ": "mot", "label": "Motion 2023/24:2019", "titel": "Stärkandet av rehabiliteringsansvaret för företagaren", "undertitel": "av Sanna Backeskog m.fl. (S)"}, {"dok_id": "HB022041", "typ": "mot", "label": "Motion 2023/24:2041", "titel": "Arbetsskor till omsorgs- och förskolepersonal", "undertitel": "av Sanna Backeskog (S)"}, {"dok_id": "HB022043", "typ": "mot", "label": "Motion 2023/24:2043", "titel": "Krafttag mot arbetslivskriminaliteten", "undertitel": "av Kristoffer Lindberg m.fl. (S)"}, {"dok_id": "HB022339", "typ": "mot", "label": "Motion 2023/24:2339", "titel": "En fungerande sjukförsäkring", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HB022356", "typ": "mot", "label": "Motion 2023/24:2356", "titel": "Stärkande av skyddsombudens roll", "undertitel": "av Marianne Fundahn m.fl. (S)"}, {"dok_id": "HB022359", "typ": "mot", "label": "Motion 2023/24:2359", "titel": "Ett arbetsliv fritt från våld", "undertitel": "av Heléne Björklund m.fl. (S)"}, {"dok_id": "HB022368", "typ": "mot", "label": "Motion 2023/24:2368", "titel": "Sanktionsavgifter vid arbetsmiljöbrott", "undertitel": "av Johan Andersson m.fl. (S)"}, {"dok_id": "HB022369", "typ": "mot", "label": "Motion 2023/24:2369", "titel": "Arbetsmiljöutbildning", "undertitel": "av Johan Andersson m.fl. (S)"}, {"dok_id": "HB022382", "typ": "mot", "label": "Motion 2023/24:2382", "titel": "Sanktionsavgifter för arbetsgivare som inte följer arbetsmiljöföreskrifter", "undertitel": "av Jessica Rodén m.fl. (S)"}, {"dok_id": "HB02239", "typ": "mot", "label": "Motion 2023/24:239", "titel": "Arbetsmiljö och arbetsmarknad för nattarbetare", "undertitel": "av Fredrik Lindahl (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01AU8.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01AU8.html", "votering_url": "https://data.riksdagen.se/votering/296AEA56-2BE8-410C-B665-D73C94F10CE4/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01AU8/", "meta": {"type": "motion", "policy_area": "labor", "subject": {"sv": "Utökad tillträdesrätt för regionala skyddsombud", "en": "Extended access rights for regional safety representatives"}, "at_stake": {"sv": "Beslutet påverkar hur väl arbetsmiljöproblem kan upptäckas och åtgärdas på arbetsplatser som saknar en egen skyddsorganisation, särskilt inom branscher med rörliga arbetsplatser, hög personalomsättning och mycket bemanningspersonal.", "en": "The decision affects how well workplace safety problems can be detected and addressed at workplaces that lack their own safety organisation, particularly in industries with mobile worksites, high staff turnover and heavy use of temporary agency workers."}, "subtopics": ["skyddsombud", "arbetsmiljö", "kollektivavtal", "arbetsplatsinspektion", "facklig representation"], "parties_involved": ["S", "V"], "decision": {"sv": "Frågan gäller om regionala skyddsombud ska få en lagstadgad rätt att besöka alla arbetsplatser med kollektivavtal, eller om tillträdesrätten även fortsättningsvis ska bygga på nuvarande medlemskrav och branschvisa överenskommelser.", "en": "The question is whether regional safety representatives should get a statutory right to access all workplaces with collective agreements, or whether access should continue to rest on the current membership requirement and industry-level agreements."}, "ja": {"sv": "Utskottet anser inte att lagen bör ändras och hänvisar till möjligheten för arbetsmarknadens parter att sluta branschvisa kollektivavtal om tillträdesrätt, som redan skett inom byggbranschen, och avslår därför motionerna.", "en": "The committee does not consider that the law should be changed and instead points to the possibility for labour-market parties to conclude industry-level collective agreements on access rights, as already done in the construction industry, and therefore rejects the motions."}, "nej": [{"alt_id": "res-30", "sv": "Reservationen (S, V) anser att regionala skyddsombud bör få tillträdesrätt till alla arbetsplatser med kollektivavtal genom lagändring, eftersom nuvarande medlemskrav skapar praktiska problem särskilt i branscher med rörliga eller tillfälliga arbetsplatser och stor personalomsättning, och vill dessutom att Arbetsmiljöverket ska kunna utdöma sanktioner mot arbetsgivare som hindrar skyddsombud från att delta i planering och riskbedömning.", "en": "The reservation (S, V) argues that regional safety representatives should be given statutory access rights to all workplaces with collective agreements, since the current membership requirement creates practical problems especially in industries with mobile or temporary worksites and high staff turnover, and also wants the Work Environment Authority to be able to impose sanctions on employers that prevent safety representatives from taking part in planning and risk assessment."}]}}