xt": "Riksdagen avslår motion \n\n2023/24:2483 av Catarina Deremar m.fl. (C) yrkande 18.", "notis": "Riksdagen sa nej till cirka 70 förslag i motioner om idrott och friluftsliv som inkommit under den allmänna motionstiden 2023.\nMotionerna handlar bland annat om idrott i utsatta områden, stärkt antidopningsarbete, idrottsanläggningar och planer för friluftsliv.\nRiksdagen hänvisar exempelvis till pågående arbete och att förslagen till viss del redan är tillgodosedda.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motion \n\n2023/24:2483 av Catarina Deremar m.fl. (C) yrkande 18.", "source_partier": []}, {"alt_id": "res-13", "text": "Reservation 13", "source_partier": ["C", "MP"], "substance": {"sv": "Motförslaget vill genomföra fler insatser och metodutveckling för att ge alla barn och unga tillgång till kultur, idrott och civilsamhälle.", "en": "The counter-proposal wants to implement more initiatives and method development to ensure all children and young people have access to culture, sports, and civil society."}}], "actual": {"KD": {"position": "Ja", "n_ja": 17, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 21, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "S": {"position": "Ja", "n_ja": 92, "n_nej": 0, "n_avstar": 0, "n_franvarande": 14, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Ja", "n_ja": 63, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}, "L": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 59, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Nej", "n_ja": 0, "n_nej": 16, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": true}, "C": 