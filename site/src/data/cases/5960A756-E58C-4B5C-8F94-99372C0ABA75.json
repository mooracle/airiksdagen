, "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Unni Björnerfors", "Stockholms kommun"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB021016", "typ": "mot", "label": "Motion 2023/24:1016", "titel": "Motorsport och motorhobby", "undertitel": "av Josef Fransson (SD)"}, {"dok_id": "HB021071", "typ": "mot", "label": "Motion 2023/24:1071", "titel": "Idrott för alla", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HB021347", "typ": "mot", "label": "Motion 2023/24:1347", "titel": "Idrott för alla", "undertitel": "av Lars Isacsson (S)"}, {"dok_id": "HB021665", "typ": "mot", "label": "Motion 2023/24:1665", "titel": "Omställning av padelhallar till idrottshallar", "undertitel": "av Anders Ygeman (S)"}, {"dok_id": "HB021875", "typ": "mot", "label": "Motion 2023/24:1875", "titel": "Ett rörelserikt samhälle - åtgärder för att främja fysisk aktivitet", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB021876", "typ": "mot", "label": "Motion 2023/24:1876", "titel": "Idrottspolitiska frågor", "undertitel": "av Amanda Lind och Jacob Risberg (båda MP)"}, {"dok_id": "HB021884", "typ": "mot", "label": "Motion 2023/24:1884", "titel": "Levla upp spelpolitiken", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB022067", "typ": "mot", "label": "Motion 2023/24:2067", "titel": "ANDTS och missbruks- och beroendevård", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HB022119", "typ": "mot", "label": "Motion 2023/24:2119", "titel": "Samverkan mot osunda kroppsideal", "undertitel": "av Saila Quicklund (M)"}, {"dok_id": "HB022125", "typ": "mot", "label": "Motion 2023/24:2125", "titel": "Åtgärder mot hälsofarliga kosttillskott", "undertitel": "av Saila Quicklund (M)"}, {"dok_id": "HB022144", "typ": "mot", "label": "Motion 2023/24:2144", "titel": "Behovet av idrott för nyanlända", "undertitel": "av Saila Quicklund (M)"}, {"dok_id": "HB022446", "typ": "mot", "label": "Motion 2023/24:2446", "titel": "Politik för det samiska folket", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB022483", "typ": "mot", "label": "Motion 2023/24:2483", "titel": "Kultur, civilsamhälle, idrott och medier i hela landet", "undertitel": "av Catarina Deremar m.fl. (C)"}, {"dok_id": "HB022506", "typ": "mot", "label": "Motion 2023/24:2506", "titel": "Stark idrottsrörelse i hela landet", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HB022617", "typ": "mot", "label": "Motion 2023/24:2617", "titel": "Utgiftsområde 9 Hälsovård, sjukvård och social omsorg", "undertitel": "av Fredrik Lundh Sammeli m.fl. (S)"}, {"dok_id": "HB022669", "typ": "mot", "label": "Motion 2023/24:2669", "titel": "Rättspolitik", "undertitel": "av Märta Stenevi m.fl. (MP)"}, {"dok_id": "HB022686", "typ": "mot", "label": "Motion 2023/24:2686", "titel": "Utgiftsområde 17 Kultur, medier, trossamfund och fritid", "undertitel": "av Lawen Redar m.fl. (S)"}, {"dok_id": "HB022691", "typ": "mot", "label": "Motion 2023/24:2691", "titel": "En tydlig väg till integration", "undertitel": "av Märta Stenevi m.fl. (MP)"}, {"dok_id": "HB022736", "typ": "mot", "label": "Motion 2023/24:2736", "titel": "E-sport och spelande i Sverige", "undertitel": "av Rickard Nordin (C)"}, {"dok_id": "HB02348", "typ": "mot", "label": "Motion 2023/24:348", "titel": "Framtidens e-sport", "undertitel": "av Michael Rubbestad m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01KrU6.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01KrU6.html", "votering_url": "https://data.riksdagen.se/votering/5960A756-E58C-4B5C-8F94-99372C0ABA75/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01KrU6/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Långsiktigt stöd till civilsamhällets friluftssatsningar", "en": "Long-term support for civil-society outdoor recreation efforts"}, "at_stake": {"sv": "Idrotts- och friluftsföreningar, särskilt i glesbygd och socioekonomiskt utsatta områden, spelar en viktig roll som mötesplats för barn, unga, nyanlända och äldre. Frågan gäller om deras långsiktiga förutsättningar – bland annat tillgång till spår, anläggningar och trygg belysning – ska utredas särskilt eller hanteras inom ramen för befintligt arbete.", "en": "Sport and outdoor associations, especially in rural and socioeconomically disadvantaged areas, play an important role as meeting places for children, young people, newcomers and older people. The question is whether their long-term conditions — including access to trails, facilities and safe lighting — should be specifically reviewed or handled within existing work."}, "subtopics": ["friluftsliv", "civilsamhälle", "folkhälsa", "landsbygd", "jämställdhet"], "parties_involved": ["C", "MP"], "decision": {"sv": "Motionen krävde att regeringen kartlägger civilsamhällets förutsättningar att långsiktigt bidra till friluftsliv och folkhälsa i hela landet, medan utskottet ansåg att pågående satsningar för att bredda deltagandet i idrott och rörelse redan svarar mot behovet.", "en": "The motion called for the government to map civil society's ability to contribute long-term to outdoor recreation and public health nationwide, while the committee held that ongoing initiatives to broaden participation in sport and physical activity already address the need."}, "ja": {"sv": "Utskottet hänvisar till sitt arbete med att bredda deltagandet i idrott och rörelse i stort, bland annat satsningen på ett fritidskort för barn och unga och idrottsrörelsens eget pågående förändringsarbete med sänkta trösklar, och ser mot den bakgrunden inte skäl att göra en särskild kartläggning av det civila samhällets långsiktiga förutsättningar inom friluftslivet. Utskottet avstyrker därför motionen.", "en": "The committee points to its work on broadening participation in sport and physical activity generally, including the investment in a leisure-time grant for children and young people and the sports movement's own ongoing reform work to lower barriers, and against that background sees no reason for a specific mapping of civil society's long-term conditions in outdoor recreation. The committee therefore rejects the motion."}, "nej": [{"alt_id": "res-13", "sv": "Reservanterna (C, MP) vill att regeringen kartlägger det civila samhällets förutsättningar att långsiktigt bidra till satsningar som gynnar friluftsliv och folkhälsa i hela landet, med särskilt fokus på idrotts- och friluftsföreningar i glesbygd och socioekonomiskt utsatta områden som behöver resurser för att fungera som mötesplats för bland annat barn, unga, nyanlända och äldre. Reservanterna lyfter också fram bättre tillgång till lokala spontanidrottsytor, utegym, stigar och spår samt trygg belysning som en jämställdhetsfråga.", "en": "The reserving parties (C, MP) want the government to map civil society's ability to contribute long-term to initiatives that benefit outdoor recreation and public health nationwide, with particular focus on sport and outdoor associations in rural and socioeconomically disadvantaged areas that need resources to serve as meeting places for children, young people, newcomers and older people, among others. They also highlight better access to local informal sports areas, outdoor gyms, trails and tracks, as well as safe lighting, as a gender-equality issue."}]}}