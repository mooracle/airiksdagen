1"]}, "votering_id": "A1C97D8D-AB4C-40EC-8115-2B8BE4B63205", "rm": "2022/23", "beteckning": "UbU3", "punkt": 1, "dok_id": "HA01UbU3", "datum": "2023-02-23", "utskott": "UbU", "rubrik": "Villkor för studiemedel", "dok_titel": "Studiestöd", "sammanfattning": "Utbildningsutskottet föreslår att riksdagen säger nej till ett trettiotal förslag i motioner från den allmänna motionstiden 2022 om studiestöd. Detta med hänvisning till gällande bestämmelser, pågående arbete och vidtagna åtgärder.\nMotionerna handlar bland annat om villkoren inom studiestödssystemet, studiemedel för omställning och vidareutbildning, fribeloppet, studielån vid sjukskrivning och för personer med funktionsnedsättning och avskrivning av studielån.", "forslag_text": "Riksdagen avslår motionerna \n\n2022/23:489 av Peter Hedberg och Anna-Belle Strömberg (båda S), \n\n2022/23:560 av Markus Wiechel (SD) yrkandena 1-3, \n\n2022/23:884 av Muharrem Demirok m.fl. (C) yrkandena 79 och 81, \n\n2022/23:1339 av Amalia Rud Pedersen och Adrian Magnusson (båda S) yrkande 2, \n\n2022/23:1480 av Adnan Dibrani (S), \n\n2022/23:1673 av Annie Lööf m.fl. (C) yrkande 13 och \n\n2022/23:2219 av Åsa Westlund m.fl. (S) yrkande 2.", "notis": "Riksdagen sa nej till ett trettiotal förslag i motioner från den allmänna motionstiden 2022 om studiestöd. Detta med hänvisning till gällande bestämmelser, pågående arbete och vidtagna åtgärder.\nMotionerna handlar bland annat om villkoren inom studiestödssystemet, studiemedel för omställning och vidareutbildning, fribeloppet, studielån vid sjukskrivning och för personer med funktionsnedsättning och avskrivning av studielån.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motionerna \n\n2022/23:489 av Peter Hedberg och Anna-Belle Strömberg (båda S), \n\n2022/23:560 av Markus Wiechel (SD) yrkandena 1-3, \n\n2022/23:884 av Muharrem Demirok m.fl. (C) yrkandena 79 och 81, \n\n2022/23:1339 av Amalia Rud Pedersen och Adrian Magnusson (båda S) yrkande 2, \n\n2022/23:1480 av Adnan Dibrani (S), \n\n2022/23:1673 av Annie Lööf m.fl. (C) yrkande 13 och \n\n2022/23:2219 av Åsa Westlund m.fl. (S) yrkande 2.", "source_partier": []}, {"alt_id": "res-1", "text": "Reservation 1", "source_partier": ["S"]}], "actual": {"L": {"position": "Ja", "n_ja": 12, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "C": {"position": "Avstår", "n_ja": 0, "n_nej": 0, "n_avstar": 20, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "S": {"position": "Nej", "n_ja": 0, "n_nej": 93, "n_avstar": 0, "n_franvarande": 14, "cohesion": 1.0, "authored_reservation": true}, "SD": {"position": "Ja", "n_ja": 63, "n_nej": 0, "n_avstar": 0, "n_franvarande": 10, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 20, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Ja", "n_ja": 13, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 59, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}, "KD": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}}, "ai": {"C": {"rost": "Avstår", "confidence": "low", "coverage": "explicit", "motivering": "Centerpartiet har en egen, tydlig linje om villkoren i studiemedelssystemet: ett mer flexibelt system och avskaffat fribelopp för lånedelen. Partiets egna yrkanden avslås av utskottet, samtidigt som motförslaget inte motsvarar C:s linje. Då varken utskottsförslaget eller motförslaget är partiets egen ståndpunkt bör C avstå.", "citations": [{"document": "budgetmotion", "quote": "ett mer flexibelt studiemedelssystem, som premierar studenter som avslutar sina studier före utsatt tid men också är anpassat för de med lägre studietakt", "princip": "flexibelt studiemedelssystem"}, {"document": "budgetmotion", "quote": "I denna budgetmotion föreslås att det så kallade fribeloppet avskaffas för lånedelen av studiemedel.", "princip": "avskaffat fribelopp på lånedelen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["osäkert om C:s egen reservation utgör motförslaget"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "KD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Partiets åtagande är ett överblickbart och långsiktigt hållbart studiestöd där försörjningskostnaden delas mellan den enskilde och det offentliga. Motionernas krav på generellt förändrade villkor i studiemedlet saknar stöd i dokumenten och skulle urholka systemets hållbarhet. Därför Ja till utskottets avslag.", "citations": [{"document": "partiprogram", "quote": "Studiestödssystemet ska\nvara överblickbart och långsiktigt hållbart.", "princip": "hållbart studiestödssystem"}, {"document": "partiprogram", "quote": "Kostnaderna för\nförsörjningen under studietiden ska delas mellan den", "princip": "delad studiefinansiering"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Liberalernas linje är ett studiemedelssystem med tydliga drivkrafter till examen i normal studietakt och breda villkor för alla oavsett bakgrund, inte de generella uppmjukningar som C och S föreslår. Gällande regler och pågående arbete räcker. Därför bifalls utskottets avslag.", "citations": [{"document": "partiprogram", "quote": "Det ska finnas drivkrafter för studenter att tillgodogöra sig en examen med normal eller högre studietakt,", "princip": "drivkrafter till examen"}, {"document": "partiprogram", "quote": "Studiemedelssystemet ska skapa förutsättningar för alla oavsett ekonomisk bakgrund att studera på akademisk", "princip": "studiemedel för alla"}, {"document": "valmanifest", "quote": "Återupprätta arbetslinjen.", "princip": "arbetslinjen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "high", "coverage": "inferred", "motivering": "Moderaterna kräver att alla nya reformer finansieras eller ryms inom överskottsmålet; generösare villkor i studiemedelssystemet enligt C- och S-motionerna är inte ett åtagande i partiets dokument. Resurser till högre utbildning ska i stället styras mot kvalitet och genomströmning. Ja till utskottets förslag att avslå motionerna.", "citations": [{"document": "valmanifest", "quote": "Alla nya löften och reformer – som till exempel våra inkomstskattesänkningar – behöver finansieras eller rymmas inom överskottsmålet.", "princip": "reformer ska finansieras"}, {"document": "valmanifest", "quote": "Arbeta för ett resursfördelningssystem till högskolan så att akademisk kvalitet, genomströmning samt etablering på arbetsmarknaden premieras i högre utsträckning", "princip": "kvalitet styr resurser"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "Valmanifestet lovar höjt studiestöd och bättre trygghetssystem för studenter, och budgetmotionen pekar på studenternas mycket små marginaler i inflationstider. Utskottet avslår motionerna om villkoren i studiestödssystemet. Därför Nej.", "citations": [{"document": "valmanifest", "quote": "höja studiestödet och förbättra studenters a-kassa och sjukförsäkring", "princip": "höjt studiestöd"}, {"document": "budgetmotion", "quote": "Studenter är en grupp med mycket små ekonomiska marginaler", "princip": "studenters ekonomiska trygghet"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": "loose"}, "S": {"rost": "Nej", "confidence": "medium", "coverage": "inferred", "motivering": "I lågkonjunkturen är utbildningssystemet och det livslånga lärandet avgörande, och studiefinansieringen ska avpassas för att människor växlar mellan arbete och studier. Utskottet avslår partiets eget yrkande om villkoren i studiemedelssystemet. Därför Nej.", "citations": [{"document": "budgetmotion", "quote": "När lågkonjunkturen slår mot Sverige och mot svensk ekonomi är utbildningssystemet och det livslånga lärandet avgörande.", "princip": "utbildning i lågkonjunktur"}, {"document": "partiprogram", "quote": "Utbildningssektorn och studiefinansieringssystemet måste avpassas för", "princip": "anpassad studiefinansiering"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "C:s och S:s yrkanden vill ändra studiemedlens villkor. SD:s dokument saknar åtaganden om dessa villkor och betonar utbildning efter arbetsmarknadens behov samt återhållsamhet med offentliga utgifter. Utskottets avslag med hänvisning till pågående arbete strider inte mot planen. SD röstar Ja.", "citations": [{"document": "valmanifest", "quote": "Utbilda efter de behov som finns på arbetsmarknaden", "princip": "utbildning efter arbetsmarknadens behov"}, {"document": "valmanifest", "quote": "Skala bort onödiga utgifter i det offentliga", "princip": "återhållsamhet med utgifter"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["tunn_dokumenttackning"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "V:s dokument kräver förbättrade studiemedelsvillkor: större bidragsdel och mindre lån, på sikt ett renodlat studiebidrag, samt att den ekonomiska risken flyttas tillbaka från individen till staten – V motsatte sig uttryckligen den höjda studielåneräntan 2023. Att avslå alla krav på förändrade villkor inom studiemedelssystemet strider mot detta. Därför Nej.", "citations": [{"document": "budgetmotion", "quote": "Vänsterpartiet anser vidare att en större del av studiemedlet bör utgöras av studiebidrag, och att andelen lån bör minska.", "princip": "mer bidrag, mindre lån"}, {"document": "budgetmotion", "quote": "Vänsterpartiet är emot denna utveckling och röstade emot den förändring som genomförs 2023.", "princip": "mot ökad ekonomisk risk för studenter"}, {"document": "valmanifest", "quote": "Vänsterpartiet vill värna universitetens oberoende och finansiering och höja studiestödet så att fler kan välja att vidareutbilda sig.", "princip": "höjt studiestöd"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens partitillhörighet okänd"], "model": "claude-opus-4-8", "en": null, "program_override": "loose"}}, "probe": null, "seats": [["V", "Frånvarande", "Ali Esbati", "Stockholms kommun"], ["V", "Ja", "Andrea Andersson Tay", "Stockholms län"], ["V", "Ja", "Birger Lahti", "Norrbottens län"], ["V", "Ja", "Ciczie Weidby", "Jönköpings län"], ["V", "Ja", "Daniel Riazat", "Stockholms län"], ["V", "Ja", "Frida Tånghag", "Göteborgs kommun"], ["V", "Ja", "Gudrun Nordborg", "Västerbottens län"], ["V", "Ja", "Hanna Gunnarsson", "Skåne läns södra"], ["V", "Ja", "Håkan Svenneling", "Värmlands län"], ["V", "Ja", "Ida Gabrielsson", "Stockholms kommun"], ["V", "Frånvarande", "Ilona Szatmári Waldau", "Uppsala län"], ["V", "Ja", "Isabell Mixter", "Västernorrlands län"], ["V", "Frånvarande", "Jessica Wetterling", "Västra Götalands läns västra"], ["V", "Ja", "Kajsa Fredholm", "Dalarnas län"], ["V", "Ja", "Karin Rågsjö", "Stockholms kommun"], ["V", "Ja", "Linda W Snecker", "Östergötlands län"], ["V", "Ja", "Lorena Delgado Varas", "Stockholms kommun"], ["V", "Frånvarande", "Lotta Johnsson Fornarve", "Södermanlands län"], ["V", "Ja", "Maj Karlsson", "Göteborgs kommun"], ["V", "Ja", "Malcolm Momodou Jallow", "Malmö kommun"], ["V", "Ja", "Nadja Awad", "Örebro län"], ["V", "Ja", "Nooshi Dadgost