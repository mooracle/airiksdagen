, "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pontus Andersson", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Frånvarande", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HA021226", "typ": "mot", "label": "Motion 2022/23:1226", "titel": "Vissa kulturpolitiska frågor", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HA021471", "typ": "mot", "label": "Motion 2022/23:1471", "titel": "Barns och ungas tillgång till kultur", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HA021473", "typ": "mot", "label": "Motion 2022/23:1473", "titel": "En lagstadgad kulturskola", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HA021521", "typ": "mot", "label": "Motion 2022/23:1521", "titel": "Tillkännagivande av mottagare av litteraturpriset till Astrid Lindgrens minne (Alma) i Astrid Lindgrens stad Vimmerby", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HA021522", "typ": "mot", "label": "Motion 2022/23:1522", "titel": "Inrättande av en nationell Astrid Lindgren-dag", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HA021673", "typ": "mot", "label": "Motion 2022/23:1673", "titel": "Jämställdhet för hållbar utveckling", "undertitel": "av Annie Lööf m.fl. (C)"}, {"dok_id": "HA022014", "typ": "mot", "label": "Motion 2022/23:2014", "titel": "Kunskapslyft för barns rättigheter", "undertitel": "av Fredrik Lundh Sammeli m.fl. (S)"}, {"dok_id": "HA022054", "typ": "mot", "label": "Motion 2022/23:2054", "titel": "Utgiftsområde 17 Kultur, medier, trossamfund, fritid", "undertitel": "av Lawen Redar m.fl. (S)"}, {"dok_id": "HA02381", "typ": "mot", "label": "Motion 2022/23:381", "titel": "Nollvision mot mobbning", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HA02429", "typ": "mot", "label": "Motion 2022/23:429", "titel": "Semester på landet en möjlighet för alla", "undertitel": "av Staffan Eklöf (SD)"}, {"dok_id": "HA02689", "typ": "mot", "label": "Motion 2022/23:689", "titel": "Nationellt inflytanderåd för barn och unga", "undertitel": "av Markus Selin (S)"}, {"dok_id": "HA02861", "typ": "mot", "label": "Motion 2022/23:861", "titel": "Ett fritt och brett kulturliv i hela landet", "undertitel": "av Catarina Deremar m.fl. (C)"}, {"dok_id": "HA02864", "typ": "mot", "label": "Motion 2022/23:864", "titel": "När barn blir brottsoffer", "undertitel": "av Ulrika Liljeberg m.fl. (C)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01KrU3.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01KrU3.html", "votering_url": "https://data.riksdagen.se/votering/92FA74E0-0FB5-478C-9875-338C633D86C5/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01KrU3/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Insatser mot hot, kränkningar och sexuell utsatthet för barn och unga på internet", "en": "Measures against threats, abuse and sexual exploitation of children and young people online"}, "at_stake": {"sv": "Hur staten agerar mot hot, kränkningar och sexualbrott riktade mot barn och unga på nätet påverkar både ungas trygghet online och vilket stöd de ideella organisationer som arbetar med frågan kan få.", "en": "How the state responds to threats, abuse and sexual offenses targeting children and young people online affects both young people's online safety and the support available to the civil society organizations that work on the issue."}, "subtopics": ["barn och unga", "internet", "sexualbrott", "nätmobbning", "civilsamhällesstöd"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om riksdagen genom ett tillkännagivande bör kräva nya, riktade åtgärder mot hot, kränkningar och sexuell utsatthet som drabbar barn och unga på internet, till exempel ökat stöd till ideella organisationer, eller om pågående insatser på området ska följas utan ett sådant uttalande.", "en": "The question is whether the Riksdag should, through a formal statement, call for new, targeted measures against threats, abuse and sexual exploitation affecting children and young people online, such as increased support for civil society organizations, or whether ongoing efforts in the area should simply be monitored without such a statement."}, "ja": {"sv": "Utskottet understryker att det är oacceptabelt att mobbning, hot, trakasserier och andra kränkningar ökar på internet, men konstaterar att olika insatser redan pågår på området, finner därför inte skäl till tillkännagivanden och avser i stället att fortsätta följa frågan noga, och avstyrker motionerna.", "en": "The committee stresses that it is unacceptable for bullying, threats, harassment and other abuse to be increasing online, but notes that various efforts are already under way in the area, therefore finds no reason for a formal statement and instead intends to continue following the issue closely, and rejects the motions."}, "nej": [{"alt_id": "res-11", "sv": "Reservanten anser att sociala medier och spelmiljöer riskerar att vara en otrygg plats, särskilt för flickor, och att det behövs stärkta insatser mot sexualbrott, pornografi och annan utsatthet riktad mot barn och unga på internet, bland annat ökat stöd till ideella organisationer och statlig medverkan till en bred dialog om ett bättre umgängesklimat på nätet.", "en": "The reservation holds that social media and gaming environments risk being an unsafe place, especially for girls, and that stronger measures are needed against sexual offenses, pornography and other exploitation targeting children and young people online, including increased support for civil society organizations and state involvement in a broad dialogue about a better online social climate."}]}}