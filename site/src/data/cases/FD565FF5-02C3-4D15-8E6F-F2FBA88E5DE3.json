, "Stockholms län"], ["SD", "Ja", "Linda Lindberg", "Skåne läns västra"], ["SD", "Ja", "Ludvig Aspling", "Stockholms län"], ["SD", "Ja", "Magnus Persson", "Skåne läns norra och östra"], ["SD", "Ja", "Markus Wiechel", "Västra Götalands läns norra"], ["SD", "Ja", "Martin Kinnunen", "Stockholms län"], ["SD", "Ja", "Martin Westmont", "Stockholms kommun"], ["SD", "Ja", "Matheus Enholm", "Västra Götalands läns norra"], ["SD", "Ja", "Mats Arkhem", "Stockholms län"], ["SD", "Ja", "Mats Nordberg", "Dalarnas län"], ["SD", "Ja", "Mattias Bäckström Johansson", "Kalmar län"], ["SD", "Ja", "Mattias Eriksson Falk", "Södermanlands län"], ["SD", "Ja", "Mattias Karlsson", "Kronobergs län"], ["SD", "Ja", "Michael Rubbestad", "Örebro län"], ["SD", "Ja", "Mikael Eskilandersson", "Skåne läns norra och östra"], ["SD", "Ja", "Mona Olin", "Kalmar län"], ["SD", "Ja", "Nima Gholam Ali Pour", "Malmö kommun"], ["SD", "Ja", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Ja", "Patrick Reslow", "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Frånvarande", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pontus Andersson", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Frånvarande", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "H9024755", "typ": "mot", "label": "Motion 2021/22:4755", "titel": "med anledning av prop. 2021/22:242 En förstärkt spelreglering", "undertitel": "av Vasiliki Tsouplaki m.fl. (V)"}, {"dok_id": "H9024758", "typ": "mot", "label": "Motion 2021/22:4758", "titel": "med anledning av prop. 2021/22:242 En förstärkt spelreglering", "undertitel": "av Catarina Deremar m.fl. (C)"}, {"dok_id": "H9024759", "typ": "mot", "label": "Motion 2021/22:4759", "titel": "med anledning av prop. 2021/22:242 En förstärkt spelreglering", "undertitel": "av Kristina Axén Olin m.fl. (M)"}, {"dok_id": "H9024760", "typ": "mot", "label": "Motion 2021/22:4760", "titel": "med anledning av prop. 2021/22:242 En förstärkt spelreglering", "undertitel": "av Roland Utbult m.fl. (KD)"}, {"dok_id": "H9024761", "typ": "mot", "label": "Motion 2021/22:4761", "titel": "med anledning av prop. 2021/22:242 En förstärkt spelreglering", "undertitel": "av Jonas Andersson i Linghem m.fl. (SD)"}, {"dok_id": "HA0212", "typ": "mot", "label": "Motion 2022/23:12", "titel": "med anledning av prop. 2021/22:242 En förstärkt spelreglering", "undertitel": "av Jonas Andersson m.fl. (SD)"}, {"dok_id": "H903242", "typ": "prop", "label": "Proposition 2021/22:242", "titel": "En förstärkt spelreglering", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01KrU2.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01KrU2.html", "votering_url": "https://data.riksdagen.se/votering/FD565FF5-02C3-4D15-8E6F-F2FBA88E5DE3/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01KrU2/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Krav på särskild måttfullhet vid marknadsföring av spel", "en": "Requirement for special moderation in gambling marketing"}, "at_stake": {"sv": "Ett skärpt krav skulle begränsa var och hur spelreklam får synas - till exempel utomhus och i tv - i syfte att skydda barn, unga och personer med spelproblem från att spel om pengar normaliseras.", "en": "A stricter requirement would limit where and how gambling advertising can appear - for example outdoors and on TV - aimed at protecting children, young people and people with gambling problems from having gambling for money normalised."}, "subtopics": ["måttfullhet", "spelreklam", "alkoholreklam", "konsumentskydd", "barn och unga"], "parties_involved": ["V"], "decision": {"sv": "Frågan gäller om regeringen ska återkomma med ett förslag om särskild måttfullhet vid marknadsföring av spel, motsvarande det striktare krav som gäller för alkoholreklam, eller om nuvarande måttfullhetskrav ska bestå oförändrat.", "en": "The question is whether the government should bring forward a proposal for a requirement of special moderation in gambling marketing, matching the stricter standard that applies to alcohol advertising, or whether the current moderation requirement should remain unchanged."}, "ja": {"sv": "Utskottet avstyrker kravet på en särskild måttfullhet för spelreklam och håller fast vid att den närmare innebörden av det befintliga måttfullhetskravet bör utvecklas genom praxis snarare än genom ett nytt, skärpt regelverk.", "en": "The committee rejects the call for a requirement of special moderation in gambling advertising and maintains that the precise meaning of the existing moderation requirement should continue to develop through case-law practice rather than through a new, stricter set of rules."}, "nej": [{"alt_id": "res-12", "sv": "Reservationen (V) vill att regeringen återkommer med ett förslag om särskild måttfullhet vid marknadsföring av spel, likt det som gäller för alkoholreklam. Skälet är att spelreklam - inte minst från nätkasinon - ökat kraftigt samtidigt som spelproblemen inom just den spelformen vuxit, att barn i dag möter spelreklam på stan, vid busshållplatsen och i tv-sänd sport, och att detta normaliserar spel om pengar och sänker tröskeln för unga att börja spela.", "en": "The reservation (V) calls for the government to bring forward a proposal for a requirement of special moderation in gambling marketing, similar to what applies to alcohol advertising. The reasoning is that gambling advertising - not least from online casinos - has increased sharply while gambling problems linked to that form of gambling have grown, that children today encounter gambling ads on the street, at bus stops and during televised sport, and that this normalises gambling for money and lowers the threshold for young people to start gambling."}]}}