, "Robert Stenkvist", "Stockholms län"], ["SD", "Nej", "Roger Hedlund", "Gävleborgs län"], ["SD", "Frånvarande", "Runar Filper", "Värmlands län"], ["SD", "Nej", "Sara Gille", "Dalarnas län"], ["SD", "Nej", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Nej", "Staffan Eklöf", "Jönköpings län"], ["SD", "Nej", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Nej", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Nej", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Nej", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Nej", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021029", "typ": "mot", "label": "Motion 2024/25:1029", "titel": "Kvalitet i äldrevården", "undertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HC021364", "typ": "mot", "label": "Motion 2024/25:1364", "titel": "Folkhälsan i fokus", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021365", "typ": "mot", "label": "Motion 2024/25:1365", "titel": "God vård och omsorg för äldre", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021412", "typ": "mot", "label": "Motion 2024/25:1412", "titel": "Jämställdhet och diskriminering", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021527", "typ": "mot", "label": "Motion 2024/25:1527", "titel": "Skydds- och tvångsåtgärder inom vården och omsorgen för äldre personer", "undertitel": "av Peder Björk och Malin Larsson (båda S)"}, {"dok_id": "HC021635", "typ": "mot", "label": "Motion 2024/25:1635", "titel": "Språkkrav i välfärden", "undertitel": "av Lawen Redar (S)"}, {"dok_id": "HC02183", "typ": "mot", "label": "Motion 2024/25:183", "titel": "Förbättrade måltider för äldre i det offentliga", "undertitel": "av Catarina Deremar (C)"}, {"dok_id": "HC021851", "typ": "mot", "label": "Motion 2024/25:1851", "titel": "Lagen om valfrihetssystem (LOV) inom välfärdsområdet", "undertitel": "av Jessica Rodén och Petter Löberg (båda S)"}, {"dok_id": "HC022224", "typ": "mot", "label": "Motion 2024/25:2224", "titel": "Språkkrav inom vård och äldreomsorg", "undertitel": "av Johanna Rantsi (M)"}, {"dok_id": "HC022234", "typ": "mot", "label": "Motion 2024/25:2234", "titel": "Utdrag ur belastningsregister för personer som arbetar med äldre", "undertitel": "av Johanna Rantsi (M)"}, {"dok_id": "HC022358", "typ": "mot", "label": "Motion 2024/25:2358", "titel": "Svenska språket inom äldreomsorgen", "undertitel": "av Peter Hultqvist (S)"}, {"dok_id": "HC022392", "typ": "mot", "label": "Motion 2024/25:2392", "titel": "Kognitiva sjukdomar som leder till demens", "undertitel": "av Mats Sander (M)"}, {"dok_id": "HC022395", "typ": "mot", "label": "Motion 2024/25:2395", "titel": "Heltäckande registerutdrag för personal inom offentlig verksamhet", "undertitel": "av Caroline Högström (M)"}, {"dok_id": "HC022493", "typ": "mot", "label": "Motion 2024/25:2493", "titel": "Bemanning i verksamheter nära medborgarna", "undertitel": "av Gunilla Svantorp m.fl. (S)"}, {"dok_id": "HC022515", "typ": "mot", "label": "Motion 2024/25:2515", "titel": "Lagen om valfrihetssystem", "undertitel": "av Markus Kallifatides m.fl. (S)"}, {"dok_id": "HC022553", "typ": "mot", "label": "Motion 2024/25:2553", "titel": "Språktest för arbete i omsorg och äldreomsorg", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HC022675", "typ": "mot", "label": "Motion 2024/25:2675", "titel": "Möjlighet att anställa kommunala läkare", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HC022701", "typ": "mot", "label": "Motion 2024/25:2701", "titel": "Pilotprojekt - seniorhälsa", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HC022772", "typ": "mot", "label": "Motion 2024/25:2772", "titel": "Språkkrav för vissa jobb inom omsorgen", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HC022774", "typ": "mot", "label": "Motion 2024/25:2774", "titel": "Äldres möjligheter att få bo kvar i sin hemkommun", "undertitel": "av Sten Bergheden (M)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01SoU21.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01SoU21.html", "votering_url": "https://data.riksdagen.se/votering/BD9F39CF-5ACD-4E0D-84D7-2245F0388990/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01SoU21/", "meta": {"type": "motion", "policy_area": "health", "subject": {"sv": "Nationellt ansvar för palliativ vård inom äldreomsorgen", "en": "National responsibility for palliative care in elderly care"}, "at_stake": {"sv": "Många äldre inom äldreomsorgen har palliativa vårdbehov, och kvaliteten och tillgången till sådan vård kan i dag skilja sig åt mellan regioner och kommuner. Frågan handlar om huruvida staten bör ta ett tydligare nationellt ansvar för att alla, oavsett bostadsort eller diagnos, får tillgång till kunskapsbaserad, personcentrerad palliativ vård i livets slutskede.", "en": "Many older people in elderly care have palliative care needs, and the quality and availability of such care can currently vary between regions and municipalities. The question is whether the state should take clearer national responsibility so that everyone, regardless of where they live or their diagnosis, has access to knowledge-based, person-centred palliative care at the end of life."}, "subtopics": ["äldreomsorg", "palliativ vård", "hälso- och sjukvård", "kommunal vård", "likvärdig vård"], "parties_involved": ["SD"], "decision": {"sv": "Motionen krävde att regeringen ser över hur ett nationellt ansvar för palliativ vård inom äldreomsorgen kan införas så att vården blir likvärdig oavsett bostadsort, medan utskottet ansåg att en pågående statlig utredning om stärkt medicinsk kompetens i den kommunala hälso- och sjukvården redan omfattar frågan och att inget eget initiativ behövdes.", "en": "The motion called for the government to review how national responsibility for palliative care in elderly care could be introduced so that care becomes equally available regardless of where a person lives, while the committee held that an ongoing government inquiry into strengthened medical competence in municipal health care already covers the issue and that no separate initiative was needed."}, "ja": {"sv": "Utskottet noterar att en pågående statlig utredning om stärkt medicinsk kompetens i den kommunala hälso- och sjukvården redan föreslår åtgärder för att göra rutinerna för inskrivning i palliativ vård tydligare i avtalen mellan regioner och kommuner, och vill avvakta regeringens fortsatta beredning av frågan i stället för att riksdagen tar ett eget initiativ.", "en": "The committee notes that an ongoing government inquiry into strengthened medical competence in municipal health care already proposes measures to clarify the procedures for admission to palliative care in agreements between regions and municipalities, and prefers to await the government's continued processing of the matter rather than have parliament take its own initiative."}, "nej": [{"alt_id": "res-8", "sv": "Reservanten (SD) framhåller att palliativ vård ska lindra och främja livskvaliteten för obotligt sjuka genom att beakta fysiska, psykiska, sociala och existentiella behov samt stödja närstående, och att vården ska vara tillgänglig för alla oavsett bostadsort eller diagnos. Reservanten vill att regeringen ser över hur ett nationellt ansvar för palliativ vård kan införas, med verktyg och kunskapsstöd som gör det möjligt att integrera personcentrerad palliativ vård i äldreomsorgen.", "en": "The reserving party (SD) stresses that palliative care should relieve suffering and promote quality of life for the terminally ill by taking physical, psychological, social, and existential needs into account and supporting relatives, and that such care should be available to everyone regardless of where they live or their diagnosis. The party wants the government to review how national responsibility for palliative care could be introduced, with tools and knowledge support that make it possible to integrate person-centred palliative care into elderly care."}]}}