riksdagen.se/dokument/HA01FiU26.html", "votering_url": "https://data.riksdagen.se/votering/5F1CC1C6-76B8-4E8A-870C-F9C55B5F08BE/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01FiU26/", "meta": {"type": "motion", "policy_area": "finance", "subject": {"sv": "Förslaget handlar om att avslå motioner om det kommunalekonomiska utjämningssystemet.", "en": "The proposal concerns rejecting motions on the municipal fiscal equalization system."}, "at_stake": {"sv": "Omröstningen avgör huruvida riksdagen förändrar det kommunalekonomiska utjämningssystemet, vilket är avgörande för resurstilldelning mellan kommuner. Ett ändrat system skulle påverka välfärdsservice i hela landet, särskilt i glesbygd och mindre kommuner.", "en": "The vote determines whether parliament modifies the municipal fiscal equalization system, which is critical for resource distribution among municipalities. Changes would affect welfare services across the country, particularly in rural areas and smaller municipalities."}, "subtopics": ["kommunalpolitik", "ekonomi", "välfärd", "utjämning"], "parties_involved": ["S"]}}