["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Frånvarande", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021000", "typ": "mot", "label": "Motion 2025/26:1000", "titel": "Konsekvenser av massflyktsdirektivets upphörande", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HD021004", "typ": "mot", "label": "Motion 2025/26:1004", "titel": "Skydd för kristna i världen", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HD021032", "typ": "mot", "label": "Motion 2025/26:1032", "titel": "En långsiktigt hållbar invandringspolitik för tillväxt, välfärd och sammanhållning", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HD021064", "typ": "mot", "label": "Motion 2025/26:1064", "titel": "Ett slutligt avskaffande av EBO", "undertitel": "av Lawen Redar (S)"}, {"dok_id": "HD021182", "typ": "mot", "label": "Motion 2025/26:1182", "titel": "Avskaffande av EBO", "undertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HD021215", "typ": "mot", "label": "Motion 2025/26:1215", "titel": "Avskaffande av EBO-lagen", "undertitel": "av Eva Lindh m.fl. (S)"}, {"dok_id": "HD02126", "typ": "mot", "label": "Motion 2025/26:126", "titel": "Frivillig lojalitetsförklaring för nya naturaliserade medborgare", "undertitel": "av Rashid Farivar och Staffan Eklöf (båda SD)"}, {"dok_id": "HD021277", "typ": "mot", "label": "Motion 2025/26:1277", "titel": "Sexualbrott", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HD02137", "typ": "mot", "label": "Motion 2025/26:137", "titel": "Pushfaktorer för invandrare att frivilligt lämna Sverige", "undertitel": "av Josef Fransson (SD)"}, {"dok_id": "HD021452", "typ": "mot", "label": "Motion 2025/26:1452", "titel": "Kortare väntetider för att kunna få jobb i Sverige", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD021465", "typ": "mot", "label": "Motion 2025/26:1465", "titel": "Rättssäkerhet för barn som växer upp i Sverige", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HD021520", "typ": "mot", "label": "Motion 2025/26:1520", "titel": "Utvärdering och förtydligande av religionsfrihetens gränser för att motverka normkollisioner och värna det öppna samhället", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HD021555", "typ": "mot", "label": "Motion 2025/26:1555", "titel": "Obligatoriskt PCR-prov där samhället så kräver", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021642", "typ": "mot", "label": "Motion 2025/26:1642", "titel": "Medborgarskapsceremoni och lojalitetsförklaring", "undertitel": "av Stefan Olsson (M)"}, {"dok_id": "HD021664", "typ": "mot", "label": "Motion 2025/26:1664", "titel": "Säkerställ verkställighet av utvisningsbeslut", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HD021697", "typ": "mot", "label": "Motion 2025/26:1697", "titel": "En sanningskommission om migrationspolitiken", "undertitel": "av Staffan Eklöf (SD)"}, {"dok_id": "HD021750", "typ": "mot", "label": "Motion 2025/26:1750", "titel": "Förändring av svensk och europeisk asylpolitik", "undertitel": "av Jan Ericson och Boriana Åberg (båda M)"}, {"dok_id": "HD021751", "typ": "mot", "label": "Motion 2025/26:1751", "titel": "Automatisk utvisning av utländska brottslingar", "undertitel": "av Boriana Åberg (M)"}, {"dok_id": "HD021752", "typ": "mot", "label": "Motion 2025/26:1752", "titel": "Reformering av flyktingkonventionen", "undertitel": "av Boriana Åberg (M)"}, {"dok_id": "HD02198", "typ": "mot", "label": "Motion 2025/26:198", "titel": "EU:s migrationspolitik", "undertitel": "av Tony Haddou m.fl. (V)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01SfU16.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01SfU16.html", "votering_url": "https://data.riksdagen.se/votering/89C30C2A-6C32-49D0-B0F8-3F35C76EB2FF/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01SfU16/", "meta": {"type": "motion", "policy_area": "migration", "subject": {"sv": "Uppehållstillstånd av humanitära skäl vid särskilt ömmande omständigheter", "en": "Residence permits on humanitarian grounds in exceptionally distressing circumstances"}, "at_stake": {"sv": "Beslutet påverkar möjligheterna för barn och familjer i svåra humanitära situationer att få stanna i Sverige. En vidgad rätt skulle ge fler barn skydd på humanitär grund, medan oförändrade regler innebär fortsatt högre krav för att beviljas uppehållstillstånd av det skälet.", "en": "The decision affects the chances for children and families in difficult humanitarian situations to remain in Sweden. A broadened right would give more children protection on humanitarian grounds, while unchanged rules mean continued higher requirements for being granted a residence permit on that basis."}, "subtopics": ["migrationspolitik", "uppehållstillstånd", "humanitära skäl", "ensamkommande barn", "asylrätt"], "parties_involved": ["V", "C", "MP"], "decision": {"sv": "Frågan gäller om möjligheterna att bevilja uppehållstillstånd av humanitära skäl vid särskilt ömmande omständigheter, särskilt för barn, ska vidgas igen efter 2023 års åtstramning, eller om nuvarande striktare regler ska ligga fast.", "en": "The question is whether the possibility of granting residence permits on humanitarian grounds in exceptionally distressing circumstances, particularly for children, should be broadened again after the 2023 tightening, or whether the current stricter rules should remain in place."}, "ja": {"sv": "Utskottet anser att den asylrelaterade invandringen behöver fortsätta minska till hållbara nivåer och att fokus i migrationspolitiken ska skifta mot högkvalificerad arbetskraftsinvandring. Utskottet är därför inte berett att ställa sig bakom yrkanden om permanent uppehållstillstånd till ensamkommande, regularisering eller en översyn av lagstiftningen, och avstyrker motionerna.", "en": "The committee considers that asylum-related immigration needs to continue decreasing to sustainable levels and that the focus of migration policy should shift toward highly qualified labour immigration. The committee is therefore not prepared to support proposals for permanent residence permits for unaccompanied minors, regularisation, or a review of the legislation, and rejects the motions."}, "nej": [{"alt_id": "res-9", "sv": "Reservationen (V, C, MP) vill återgå till lagstiftningen som gällde före den 1 december 2023, då kraven för uppehållstillstånd av humanitära skäl var lägre, med lägre krav för barn än för vuxna så att barn ska kunna beviljas uppehållstillstånd vid särskilt ömmande omständigheter. Skälet är att Sverige bör föra en mänsklig och välkomnande flyktingpolitik i linje med de konventioner landet skrivit under.", "en": "The reservation (V, C, MP) calls for a return to the legislation in force before 1 December 2023, when the requirements for humanitarian-grounds residence permits were lower, with lower requirements for children than for adults so that children can be granted a residence permit in exceptionally distressing circumstances. The reasoning is that Sweden should pursue a humane and welcoming refugee policy in line with the conventions it has signed."}]}}