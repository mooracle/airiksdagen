p": "mot", "label": "Motion 2025/26:1962", "titel": "Möjlighet att vräka illegala migranter", "undertitel": "av Nima Gholam Ali Pour (SD)"}, {"dok_id": "HD022516", "typ": "mot", "label": "Motion 2025/26:2516", "titel": "Stärkt egendomsskydd för bostadsrätter", "undertitel": "av Kjell Jansson (M)"}, {"dok_id": "HD022650", "typ": "mot", "label": "Motion 2025/26:2650", "titel": "Ökad insyn på hyresbostadsmarknaden", "undertitel": "av Patrik Karlson (L)"}, {"dok_id": "HD022727", "typ": "mot", "label": "Motion 2025/26:2727", "titel": "Åtgärder för en ökad möjlighet till en egen bostad", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022731", "typ": "mot", "label": "Motion 2025/26:2731", "titel": "Obligatorisk hemförsäkring", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022775", "typ": "mot", "label": "Motion 2025/26:2775", "titel": "Hyresrätt och allmännytta", "undertitel": "av Malcolm Momodou Jallow m.fl. (V)"}, {"dok_id": "HD022821", "typ": "mot", "label": "Motion 2025/26:2821", "titel": "Bostadspolitik, planering och byggande", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HD023056", "typ": "mot", "label": "Motion 2025/26:3056", "titel": "Våld i nära relation ny grund för förverkande av hyresrätt", "undertitel": "av Cecilia Gustafsson (M)"}, {"dok_id": "HD023184", "typ": "mot", "label": "Motion 2025/26:3184", "titel": "Bostäder och samhällsbyggnad", "undertitel": "av Alireza Akhondi m.fl. (C)"}, {"dok_id": "HD023185", "typ": "mot", "label": "Motion 2025/26:3185", "titel": "Livskraft och framtidstro på Sveriges landsbygder", "undertitel": "av Elisabeth Thand Ringqvist m.fl. (C)"}, {"dok_id": "HD023252", "typ": "mot", "label": "Motion 2025/26:3252", "titel": "Avskaffande av hyresförhandlingsavgiften", "undertitel": "av Camilla Brunsberg (M)"}, {"dok_id": "HD023305", "typ": "mot", "label": "Motion 2025/26:3305", "titel": "Dolda hyresavgifter", "undertitel": "av Gustaf Göthberg och Marie-Louise Hänel Sandström (båda M)"}, {"dok_id": "HD023317", "typ": "mot", "label": "Motion 2025/26:3317", "titel": "Mer cirkularitet i byggbranschen - reformera bruksvärdessystemet", "undertitel": "av Janine Alm Ericson m.fl. (MP)"}, {"dok_id": "HD023369", "typ": "mot", "label": "Motion 2025/26:3369", "titel": "En översyn av lagstiftningen om delningsboenden", "undertitel": "av Amanda Palmstierna m.fl. (MP)"}, {"dok_id": "HD023545", "typ": "mot", "label": "Motion 2025/26:3545", "titel": "Åtgärder för en bättre bostadsförsörjning", "undertitel": "av Amanda Palmstierna m.fl. (MP)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01CU14.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01CU14.html", "votering_url": "https://data.riksdagen.se/votering/46CFAD85-23A4-4D1A-8BEC-34D1743DBFE2/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01CU14/", "meta": {"type": "motion", "policy_area": "civil", "subject": {"sv": "Hyressättning av bostadslägenheter", "en": "Rent-setting for residential apartments"}, "at_stake": {"sv": "Utfallet påverkar hur hyror bestäms och kan påverka både incitamenten att bygga fler hyresrätter och hyresgästers skydd mot höga eller snabbt stigande hyror.", "en": "The outcome affects how rents are set and can influence both the incentives to build more rental housing and tenants' protection against high or rapidly rising rents."}, "subtopics": ["hyresrätt", "hyressättning", "bruksvärde", "nyproduktion", "bostadsmarknad"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om det grundläggande systemet för hyressättning av bostadslägenheter ska ändras - bland annat genom att införa fri hyressättning vid nyproduktion - eller om nuvarande system med kollektiva förhandlingar och bruksvärde ska behållas oförändrat.", "en": "The question is whether the basic system for setting rents on residential apartments should be changed - including by introducing free rent-setting for newly built housing - or whether the current system of collective negotiation and use value should remain unchanged."}, "ja": {"sv": "Utskottet är inte berett att föreslå några ändringar av det grundläggande hyressättningssystemet, vare sig större eller mindre, och avstyrker samtliga motionsyrkanden i frågan.", "en": "The Committee is not prepared to propose any changes to the basic rent-setting system, whether major or minor, and rejects all the motions on the matter."}, "nej": [{"alt_id": "res-3", "sv": "Regeringen bör snarast lägga fram ett lagförslag om fri hyressättning vid nyproduktion, med hänvisning till en tidigare utredning, för att korta bostadsköerna och öka byggandet av hyresrätter.", "en": "The government should promptly present a legislative proposal for free rent-setting on newly built housing, based on an earlier inquiry, in order to shorten housing queues and increase the construction of rental homes."}]}}