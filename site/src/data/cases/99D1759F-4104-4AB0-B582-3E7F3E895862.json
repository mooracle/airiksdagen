"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Frånvarande", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Frånvarande", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021323", "typ": "mot", "label": "Motion 2024/25:1323", "titel": "Värnande av folkrätten", "undertitel": "av Jacob Risberg m.fl. (MP)"}, {"dok_id": "HC021431", "typ": "mot", "label": "Motion 2024/25:1431", "titel": "Vissa Asienfrågor", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021435", "typ": "mot", "label": "Motion 2024/25:1435", "titel": "Stöd till utsatta grupper", "undertitel": "av Rasmus Giertz m.fl. (SD)"}, {"dok_id": "HC021438", "typ": "mot", "label": "Motion 2024/25:1438", "titel": "Internationella relationer och mänskliga rättigheter", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021441", "typ": "mot", "label": "Motion 2024/25:1441", "titel": "Ekocid som krigsbrott", "undertitel": "av Yasmine Eriksson m.fl. (SD)"}, {"dok_id": "HC021471", "typ": "mot", "label": "Motion 2024/25:1471", "titel": "Europarådet", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC02167", "typ": "mot", "label": "Motion 2024/25:167", "titel": "Skydd för kristna i världen", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HC02169", "typ": "mot", "label": "Motion 2024/25:169", "titel": "Stopp för hädelselagar och dödsstraff för konvertiter", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HC021729", "typ": "mot", "label": "Motion 2024/25:1729", "titel": "Situationen för religiösa minoriteter i Indien", "undertitel": "av Roland Utbult (KD)"}, {"dok_id": "HC021788", "typ": "mot", "label": "Motion 2024/25:1788", "titel": "Initiativ från Sverige till ekocidlagstiftning", "undertitel": "av Magnus Manhammar m.fl. (S)"}, {"dok_id": "HC022181", "typ": "mot", "label": "Motion 2024/25:2181", "titel": "Frigivning av Dawit Isaak och försvar av det fria ordet", "undertitel": "av Helén Pettersson och Fredrik Lundh Sammeli (båda S)"}, {"dok_id": "HC022520", "typ": "mot", "label": "Motion 2024/25:2520", "titel": "Stöd för Tibets folk", "undertitel": "av Maria Stockhaus m.fl. (M)"}, {"dok_id": "HC022625", "typ": "mot", "label": "Motion 2024/25:2625", "titel": "En grön feministisk utvecklings- och biståndspolitik", "undertitel": "av Janine Alm Ericson m.fl. (MP)"}, {"dok_id": "HC022954", "typ": "mot", "label": "Motion 2024/25:2954", "titel": "En folkrörelse för klimatet", "undertitel": "av Muharrem Demirok m.fl. (C)"}, {"dok_id": "HC02301", "typ": "mot", "label": "Motion 2024/25:301", "titel": "Erkännande av holodomor som folkmord", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HC023020", "typ": "mot", "label": "Motion 2024/25:3020", "titel": "Israels ockupation av Palestina", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HC023061", "typ": "mot", "label": "Motion 2024/25:3061", "titel": "Inkludering av ekocid i Romstadgan", "undertitel": "av Rebecka Le Moine m.fl. (MP)"}, {"dok_id": "HC023106", "typ": "mot", "label": "Motion 2024/25:3106", "titel": "Utgiftsområde 7 Internationellt bistånd", "undertitel": "av Morgan Johansson m.fl. (S)"}, {"dok_id": "HC023107", "typ": "mot", "label": "Motion 2024/25:3107", "titel": "Internationell samverkan", "undertitel": "av Morgan Johansson m.fl. (S)"}, {"dok_id": "HC023162", "typ": "mot", "label": "Motion 2024/25:3162", "titel": "Internationellt samarbete i en utmanande tid", "undertitel": "av Kerstin Lundgren m.fl. (C)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01UU14.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01UU14.html", "votering_url": "https://data.riksdagen.se/votering/99D1759F-4104-4AB0-B582-3E7F3E895862/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01UU14/", "meta": {"type": "motion", "policy_area": "foreign", "subject": {"sv": "Sveriges hållning i folkrättsfrågor och stöd till Internationella brottmålsdomstolen", "en": "Sweden's stance on international law and support for the International Criminal Court"}, "at_stake": {"sv": "Hur pådrivande Sverige är i folkrättsfrågor påverkar stödet till internationella domstolar som utsätts för yttre påtryckningar, och graden av ansvarsutkrävande för personer som misstänks för grova brott mot folkrätten i pågående konflikter.", "en": "How assertive Sweden is on international-law issues affects support for international courts facing external pressure, and the degree of accountability for individuals suspected of grave violations of international law in ongoing conflicts."}, "subtopics": ["folkrätt", "Internationella brottmålsdomstolen", "mänskliga rättigheter", "sanktioner", "ansvarsutkrävande", "Romstadgan"], "parties_involved": ["V"], "decision": {"sv": "Frågan gäller om Sveriges nuvarande breda hållning i folkrättsfrågor och stödet till Internationella brottmålsdomstolens oberoende är tillräcklig, eller om Sverige bör inta en mer pådrivande linje, bland annat genom att kritisera svensk vapenhandel och kräva mer resurser och utredning av misstänkta folkmordsbrott.", "en": "The question is whether Sweden's current broad stance on international law and support for the International Criminal Court's independence is sufficient, or whether Sweden should take a more assertive line, including by criticizing Swedish arms trade and demanding more resources and investigation of suspected genocide."}, "ja": {"sv": "Utskottet vidhåller att folkrätten är en hörnsten i utrikespolitiken, värnar de internationella domstolarnas oberoende och integritet, beklagar djupt de amerikanska sanktionerna mot Internationella brottmålsdomstolen och stödjer att EU:s blockerande stadga aktiveras när tillräckligt brett medlemsstöd finns, men anser inte att det är riksdagens uppgift att tillsätta en parlamentarisk kommitté om erkännande av folkmord, och avstyrker därför motionerna.", "en": "The committee maintains that international law is a cornerstone of foreign policy, upholds the independence and integrity of international courts, deeply regrets the US sanctions against the International Criminal Court, and supports activating the EU's blocking statute once sufficiently broad member-state support exists, but does not consider it parliament's task to set up a parliamentary committee on genocide recognition, and therefore rejects the motions."}, "nej": [{"alt_id": "res-2", "sv": "Reservationen (V) vill att Sverige tar en fastare linje och pekar på att regeringens fortsatta vapenhandel med Israel under ett pågående folkmord i Gaza motsäger Sveriges folkrättsliga åtaganden, och kräver bland annat mer resurser till ICC och ICJ, utredning av individer som misstänks för medverkan till folkmord, fördömande av USA:s sanktioner mot ICC samt att EU aktiverar blockeringsstadgan.", "en": "The reservation (V) wants Sweden to take a firmer line, arguing that the government's continued arms trade with Israel amid an ongoing genocide in Gaza contradicts Sweden's international-law commitments, and calls for more resources for the ICC and ICJ, investigation of individuals suspected of complicity in genocide, condemnation of US sanctions against the ICC, and for the EU to activate its blocking statute."}]}}