}, {"dok_id": "HB021175", "typ": "mot", "label": "Motion 2023/24:1175", "titel": "Folkhögskolans frihet och framtid", "undertitel": "av Johanna Haraldsson m.fl. (S)"}, {"dok_id": "HB021186", "typ": "mot", "label": "Motion 2023/24:1186", "titel": "Studieförbundens, folkhögskolornas och Folkbildningsrådets brister i fråga om att leva upp till ställda krav", "undertitel": "av Ann-Sofie Alm (M)"}, {"dok_id": "HB021297", "typ": "mot", "label": "Motion 2023/24:1297", "titel": "En väg till stärkt demokrati, integration och individuell utveckling", "undertitel": "av Anna Wallentheim och Hanna Westerén (båda S)"}, {"dok_id": "HB021359", "typ": "mot", "label": "Motion 2023/24:1359", "titel": "Högre utbildning för hela landet", "undertitel": "av Lars Isacsson m.fl. (S)"}, {"dok_id": "HB021488", "typ": "mot", "label": "Motion 2023/24:1488", "titel": "Offentliga satsningar på musik", "undertitel": "av Mirja Räihä och Per-Arne Håkansson (båda S)"}, {"dok_id": "HB021590", "typ": "mot", "label": "Motion 2023/24:1590", "titel": "Folkhögskolornas betydelse för personer med funktionsnedsättning", "undertitel": "av Karin Sundin (S)"}, {"dok_id": "HB021863", "typ": "mot", "label": "Motion 2023/24:1863", "titel": "Säkerställande av folkhögskolornas uppdrag och finansiering", "undertitel": "av Heléne Björklund m.fl. (S)"}, {"dok_id": "HB021885", "typ": "mot", "label": "Motion 2023/24:1885", "titel": "Kulturpolitiska frågor", "undertitel": "av Amanda Lind och Jacob Risberg (båda MP)"}, {"dok_id": "HB022020", "typ": "mot", "label": "Motion 2023/24:2020", "titel": "Kompetensförsörjning i den gröna industriella omvandlingen", "undertitel": "av Isak From m.fl. (S)"}, {"dok_id": "HB022061", "typ": "mot", "label": "Motion 2023/24:2061", "titel": "Folkbildningen är grundläggande för demokratin", "undertitel": "av Linus Sköld m.fl. (S)"}, {"dok_id": "HB022457", "typ": "mot", "label": "Motion 2023/24:2457", "titel": "Livskraft och framtidstro i Sveriges landsbygder", "undertitel": "av Muharrem Demirok m.fl. (C)"}, {"dok_id": "HB022482", "typ": "mot", "label": "Motion 2023/24:2482", "titel": "En skola för livsresor", "undertitel": "av Muharrem Demirok m.fl. (C)"}, {"dok_id": "HB022483", "typ": "mot", "label": "Motion 2023/24:2483", "titel": "Kultur, civilsamhälle, idrott och medier i hela landet", "undertitel": "av Catarina Deremar m.fl. (C)"}, {"dok_id": "HB022531", "typ": "mot", "label": "Motion 2023/24:2531", "titel": "Slopat skattefinansierat stöd och utökad granskning av trossamfund", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HB022536", "typ": "mot", "label": "Motion 2023/24:2536", "titel": "Satsning på Stockholms skärgård", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HB02254", "typ": "mot", "label": "Motion 2023/24:254", "titel": "En konkurrenskraftig och säker taxibransch i Sverige", "undertitel": "av Serkan Köse (S)"}, {"dok_id": "HB022691", "typ": "mot", "label": "Motion 2023/24:2691", "titel": "En tydlig väg till integration", "undertitel": "av Märta Stenevi m.fl. (MP)"}, {"dok_id": "HB022705", "typ": "mot", "label": "Motion 2023/24:2705", "titel": "Ett rikare liv för äldre", "undertitel": "av Ulrika Westerlund m.fl. (MP)"}, {"dok_id": "HB02347", "typ": "mot", "label": "Motion 2023/24:347", "titel": "Folkbildningsfrågor", "undertitel": "av Jonas Andersson m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01KrU4.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01KrU4.html", "votering_url": "https://data.riksdagen.se/votering/1D62F67E-53D0-4DF7-B884-800F087C3719/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01KrU4/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Värna folkbildningens frihet och oberoende", "en": "Safeguarding the freedom and independence of popular education (folkbildning)"}, "at_stake": {"sv": "Beslutet rör hur stark den formella garantin ska vara för att folkbildningen - folkhögskolor och studieförbund - får verka fritt och oberoende av politisk styrning, vilket har betydelse för alla som söker sig till folkbildningen för nya kunskaper eller en nystart i livet.", "en": "The decision concerns how strong a formal guarantee there should be that popular education - folk high schools and study associations - can operate freely and independently of political control, which matters to everyone who turns to popular education for new knowledge or a fresh start in life."}, "subtopics": ["folkbildning", "armlängds avstånd", "folkhögskolor", "studieförbund", "civilsamhälle"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om riksdagen ska göra ett särskilt uttalande till regeringen om att värna folkbildningens frihet och principen om armlängds avstånd, eller om utskottet anser att detta redan är tillräckligt tillgodosett.", "en": "The question is whether the Riksdag should issue a specific statement to the government on safeguarding the freedom of popular education and the arm's-length principle, or whether the committee considers this already sufficiently addressed."}, "ja": {"sv": "Utskottet delar motionärernas uppfattning om vikten av armlängds avstånd och frihet i folkbildningen, men anser att motionsyrkandena redan till viss del är tillgodosedda och avstyrker dem därför.", "en": "The committee shares the motions' view on the importance of the arm's-length principle and freedom in popular education, but considers the demands already partly met and therefore recommends rejecting them."}, "nej": [{"alt_id": "res-1", "sv": "Reservanten (C) vill att riksdagen uppmanar regeringen att värna den fria bildningen och principen om armlängds avstånd mellan politiken och folkbildningen, som reservanten menar bara kan finnas i en demokrati och inte kan ersättas av offentligt arrangerad utbildning eller kultur.", "en": "The reserving party (C) wants the Riksdag to call on the government to safeguard free popular education and the arm's-length principle between politics and popular education, which the reserving party argues can only exist in a democracy and cannot be replaced by publicly arranged education or culture."}]}}