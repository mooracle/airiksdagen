er den allmänna motionstiden 2024. Fyra förslag inkom i följdmotioner till en proposition från regeringen.\nRiksdagen hänvisar till planerade och redan vidtagna åtgärder samt till pågående arbete.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motionerna \n\n2024/25:252 av Hans Eklind (KD), \n\n2024/25:540 av Yasmine Bladelius (S), \n\n2024/25:971 av Cecilia Rönn (L), \n\n2024/25:990 av Rickard Nordin (C) yrkandena 2 och 5, \n\n2024/25:1428 av Thomas Morell m.fl. (SD) yrkandena 6-9, \n\n2024/25:1552 av Jörgen Grubb (SD), \n\n2024/25:2107 av Lars Beckman (M), \n\n2024/25:2947 av Ulrika Heie m.fl. (C) yrkande 42 och \n\n2024/25:3063 av Linus Lakso m.fl. (MP) yrkande 8.", "source_partier": []}, {"alt_id": "res-11", "text": "Reservation 11", "source_partier": ["SD"]}], "actual": {"M": {"position": "Ja", "n_ja": 60, "n_nej": 0, "n_avstar": 0, "n_franvarande": 8, "cohesion": 1.0, "authored_reservation": false}, "KD": {"position": "Ja", "n_ja": 17, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Avstår", "n_ja": 0, "n_nej": 0, "n_avstar": 16, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Avstår", "n_ja": 0, "n_nej": 0, "n_avstar": 21, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Nej", "n_ja": 0, "n_nej": 62, "n_avstar": 0, "n_franvarande": 10, "cohesion": 1.0, "authored_reservation": true}, "L": {"position": "Ja", "n_ja": 15, "n_nej": 0, "n_avstar": 0, "n_franvarande": 1, "cohesion": 1.0, "authored_reservation": false}, "C": {"position": "Avstår", "n_ja": 0, "n_nej": 0, "n_avstar": 20, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "S": {"position": "Ja", "n_ja": 93, "n_nej": 0, "n_avstar": 0, "n_franvarande": 13, "cohesion": 1.0, "authored_reservation": false}}, "ai": {}, "probe": null, "seats": [["V", "Avstår", "Andrea Andersson Tay", "Stockholms län"], ["V", "Avstår", "Andrea