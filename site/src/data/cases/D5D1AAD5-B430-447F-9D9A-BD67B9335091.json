]}, {"alt_id": "res-1", "text": "Reservation 1", "source_partier": ["SD"]}], "actual": {"KD": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 59, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Ja", "n_ja": 13, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 18, "n_nej": 0, "n_avstar": 0, "n_franvarande": 6, "cohesion": 1.0, "authored_reservation": false}, "C": {"position": "Avstår", "n_ja": 0, "n_nej": 0, "n_avstar": 21, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Nej", "n_ja": 0, "n_nej": 63, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": true}, "L": {"position": "Ja", "n_ja": 11, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}, "S": {"position": "Ja", "n_ja": 93, "n_nej": 0, "n_avstar": 0, "n_franvarande": 14, "cohesion": 1.0, "authored_reservation": false}}, "ai": {"C": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "Centerpartiet försvarar den akademiska friheten och fria lärosäten där politiken håller armlängds avstånd. C:s egna yrkanden om styrning och akademisk frihet avslås; motförslaget bär partiets linje. Därför bör C rösta Nej.", "citations": [{"document": "valmanifest", "quote": "Politiken ska bidra till goda förutsättningar men hålla armlängds avstånd.", "princip": "akademisk frihet"}, {"document": "partiprogram", "quote": "Högre utbildning och fria lärosäten ska självständigt kunna bedriva högkvalitativ forskning och utbildning.", "princip": "fria lärosäten"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["osäkert vems reservation 1 är"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "KD": {"rost": "Ja", "confidence": "high", "coverage": "explicit", "motivering": "KD värnar lärosätenas självbestämmande och akademiska frihet gentemot staten, men står bakom regeringsmajoriteten som avslår motionerna med hänvisning till pågående arbete. Dokumenten ger inget skäl att stödja reservationen. Ja.", "citations": [{"document": "partiprogram", "quote": "högskolor ska åtnjuta stort mått av självbestämmande i förhållande till staten.", "princip": "lärosätenas självbestämmande"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["citat_blockerat"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "Utskottet avslår C- och SD-motioner om styrning och akademisk frihet med hänvisning till pågående arbete. Liberalerna värnar lärosätenas oberoende och individuell akademisk frihet inom regeringens linje och röstar med majoriteten. Därför Ja.", "citations": [{"document": "partiprogram", "quote": "Individuell akademisk frihet ska vara en bärande princip för all offentlig verksamhet inom forskning och högre utbildning.", "princip": "akademisk frihet"}, {"document": "valmanifest", "quote": "Den akademiska friheten ska ges skydd i grundlagen.", "princip": "grundlagsskydd akademisk frihet"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["osaker-reservation"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "Moderaterna vill värna den fria forskningen från politiska pekpinnar, vilket drivs via regeringen. Utskottet avslår motionerna om styrning och akademisk frihet med hänvisning till pågående arbete.", "citations": [{"document": "valmanifest", "quote": "Värna den fria forskningen från politiska pekpinnar", "princip": "fri forskning"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["governing-party-committee-line"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Avstår", "confidence": "low", "coverage": "inferred", "motivering": "MP värnar den akademiska friheten men har ingen egen motion i voteringen, och reservationens (C/SD) inriktning är oklar och motsvarar inte tydligt MP:s linje. Ingen egen position i propositionsparet. Avstår.", "citations": [{"document": "partiprogram", "quote": "Den akademiska friheten ska värnas", "princip": "akademisk frihet"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["ingen MP-motion", "reservationens partihemvist oklar (SD-risk)"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "Reservationen bygger på C/SD-motioner om högskolans styrning och partiet är inte motpart. Partiet bör stödja utskottets förslag och avslå motförslaget.", "citations": [{"document": "valmanifest", "quote": "Det ska finns en starkare koppling mellan de utbildningar som erbjuds och de behov av personal som finns i samhället.", "princip": "statligt ansvar för högskolan"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens innehåll osäkert (akademisk frihet)"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "Styrning och akademisk frihet är en SD-profilfråga; på punkten finns en SD-motion (Reslow) och reservationen bär partiets linje om minskad politisk styrning och stärkt akademisk självständighet. SD stödjer sitt motförslag framför utskottets avslag.", "citations": [{"document": "valmanifest", "quote": "Den politiska styrningen av högre utbildning ska minska och akademins självständighet öka.", "princip": "minska politisk styrning"}, {"document": "valmanifest", "quote": "Slå vakt om den högre akademins självständighet", "princip": "akademisk självständighet"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens partihärkomst inferred"