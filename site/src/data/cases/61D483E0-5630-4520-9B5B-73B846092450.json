], ["SD", "Ja", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Ja", "Patrick Reslow", "Malmö kommun"], ["SD", "Frånvarande", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Frånvarande", "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC023111", "typ": "mot", "label": "Motion 2024/25:3111", "titel": "Utgiftsområde 4 Rättsväsendet", "undertitel": "av Teresa Carvalho m.fl. (S)"}, {"dok_id": "HC023326", "typ": "mot", "label": "Motion 2024/25:3326", "titel": "med anledning av prop. 2024/25:89 En förebyggande socialtjänstlag - för ökade rättigheter, skyldigheter och möjligheter", "undertitel": "av Fredrik Lundh Sammeli m.fl. (S)"}, {"dok_id": "HC023337", "typ": "mot", "label": "Motion 2024/25:3337", "titel": "med anledning av prop. 2024/25:89 En förebyggande socialtjänstlag - för ökade rättigheter, skyldigheter och möjligheter", "undertitel": "av Maj Karlsson m.fl. (V)"}, {"dok_id": "HC023339", "typ": "mot", "label": "Motion 2024/25:3339", "titel": "med anledning av prop. 2024/25:89 En förebyggande socialtjänstlag - för ökade rättigheter, skyldigheter och möjligheter", "undertitel": "av Nils Seye Larsen m.fl. (MP)"}, {"dok_id": "HC023341", "typ": "mot", "label": "Motion 2024/25:3341", "titel": "med anledning av prop. 2024/25:89 En förebyggande socialtjänstlag - för ökade rättigheter, skyldigheter och möjligheter", "undertitel": "av Martina Johansson m.fl. (C)"}, {"dok_id": "HC0389", "typ": "prop", "label": "Proposition 2024/25:89", "titel": "En förebyggande socialtjänstlag - för ökade rättigheter, skyldigheter och möjligheter", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01SoU23.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01SoU23.html", "votering_url": "https://data.riksdagen.se/votering/61D483E0-5630-4520-9B5B-73B846092450/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01SoU23/", "meta": {"type": "motion", "policy_area": "health", "subject": {"sv": "Barnets åsikter och barnets bästa i den nya socialtjänstlagen", "en": "The child's views and the best interests of the child in the new Social Services Act"}, "at_stake": {"sv": "Beslutet påverkar hur mycket vikt barns egna åsikter och barnets bästa ska ges i socialtjänstens beslut, bland annat vid ekonomiskt bistånd, och om det ska krävas standardiserade riskbedömningar innan kontakt med anhöriga vid misstanke om våld, vilket särskilt berör barn i ekonomiskt utsatta familjer och barn i våldsutsatta hem.", "en": "The decision affects how much weight children's own views and the best interests of the child must be given in social-services decisions, including on financial assistance, and whether standardised risk assessments should be required before contact with relatives in cases of suspected violence, which particularly concerns children in financially disadvantaged families and children in homes affected by violence."}, "subtopics": ["barnets bästa", "barnets åsikter", "socialtjänstlagen", "ekonomiskt bistånd", "riskbedömning vid våld"], "parties_involved": ["MP"], "decision": {"sv": "Voteringen gäller om den nya socialtjänstlagen ska behålla dagens krav på att klarlägga ett barns inställning på annat sätt när barnet inte själv uttrycker sina åsikter och utvidga kravet på att barnets bästa ska vara avgörande till alla beslut som rör barn, eller om lagen ska utformas enligt regeringens förslag där barnets bästa är ett ska-krav enbart vid vård- och behandlingsinsatser.", "en": "The vote concerns whether the new Social Services Act should retain today's requirement to clarify a child's views by other means when the child does not express them, and extend the requirement that the child's best interests be decisive to all decisions concerning children, or whether the law should follow the government's proposal, under which the child's best interests are a mandatory requirement only for care and treatment measures."}, "ja": {"sv": "Utskottet står bakom regeringens förslag, där kravet på att i övrigt klarlägga ett barns inställning inte förs över till den nya lagen och där barnets bästa görs till ett ska-krav enbart vid beslut om vård- och behandlingsinsatser, och avstyrker motionen om en bredare tillämpning och krav på standardiserade riskbedömningar.", "en": "The committee backs the government's proposal, under which the requirement to otherwise clarify a child's views is not carried over into the new law and the child's best interests become a mandatory requirement only for decisions on care and treatment measures, and opposes the motion calling for broader application and a requirement for standardised risk assessments."}, "nej": [{"alt_id": "res-18", "sv": "Reservationen anser att kravet på att klarlägga ett barns inställning på annat sätt bör behållas, att barnets bästa ska vara avgörande i alla beslut som rör barn, inklusive ekonomiskt bistånd, eftersom barn i ekonomiskt utsatta familjer annars drabbas hårt, och att socialtjänsten ska tillämpa standardiserade riskbedömningsmetoder innan kontakt med anhöriga vid misstanke om våld, så att tvångsumgänge med en våldsam förälder kan undvikas.", "en": "The reservation argues that the requirement to clarify a child's views by other means should be retained, that the child's best interests should be decisive in all decisions concerning children, including financial assistance, since children in financially disadvantaged families are otherwise hit hard, and that social services should apply standardised risk-assessment methods before contact with relatives where violence is suspected, so that forced contact with a violent parent can be avoided."}]}}