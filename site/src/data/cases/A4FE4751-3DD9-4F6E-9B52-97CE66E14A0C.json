["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Frånvarande", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021141", "typ": "mot", "label": "Motion 2025/26:1141", "titel": "Mer solenergi", "undertitel": "av Martina Johansson (C)"}, {"dok_id": "HD021253", "typ": "mot", "label": "Motion 2025/26:1253", "titel": "Rättvisare avgifter för tung trafik på svenska vägar", "undertitel": "av Denis Begic (S)"}, {"dok_id": "HD02133", "typ": "mot", "label": "Motion 2025/26:133", "titel": "Befrielse av fordonsskatt för familjer med tre barn", "undertitel": "av Josef Fransson (SD)"}, {"dok_id": "HD02154", "typ": "mot", "label": "Motion 2025/26:154", "titel": "Sänkt fordonsskatt på dieseldrivna personbilar och lätta lastbilar", "undertitel": "av Eric Palmqvist (SD)"}, {"dok_id": "HD021842", "typ": "mot", "label": "Motion 2025/26:1842", "titel": "Förtydligande av punktskatten på bekämpningsmedel", "undertitel": "av Monica Haider (S)"}, {"dok_id": "HD021859", "typ": "mot", "label": "Motion 2025/26:1859", "titel": "Hänsyn till medicinska behov i omställningen av fordonsflottan", "undertitel": "av Hanna Westerén (S)"}, {"dok_id": "HD021872", "typ": "mot", "label": "Motion 2025/26:1872", "titel": "Rättvisa villkor för energikooperativ", "undertitel": "av Tomas Kronståhl m.fl. (S)"}, {"dok_id": "HD02189", "typ": "mot", "label": "Motion 2025/26:189", "titel": "Antibiotikaskatt för att förebygga antibiotikaresistens", "undertitel": "av Annika Hirvonen m.fl. (MP)"}, {"dok_id": "HD02194", "typ": "mot", "label": "Motion 2025/26:194", "titel": "Avskaffande av malus i fordonsskatten", "undertitel": "av Rashid Farivar m.fl. (SD)"}, {"dok_id": "HD021997", "typ": "mot", "label": "Motion 2025/26:1997", "titel": "Borttagen skatt på bekämpningsmedel", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022065", "typ": "mot", "label": "Motion 2025/26:2065", "titel": "Införande av en ny Lidingöregel", "undertitel": "av Kerstin Lundgren och Anna Lasses (båda C)"}, {"dok_id": "HD022146", "typ": "mot", "label": "Motion 2025/26:2146", "titel": "Översyn och utvärdering av kemikalieskatten", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022191", "typ": "mot", "label": "Motion 2025/26:2191", "titel": "Återbetalning av fordonsskatt", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022425", "typ": "mot", "label": "Motion 2025/26:2425", "titel": "Beskattning av snus", "undertitel": "av Oliver Rosengren (M)"}, {"dok_id": "HD022466", "typ": "mot", "label": "Motion 2025/26:2466", "titel": "Ett fritt och konkurrenskraftigt jordbruk", "undertitel": "av John E Weinerhall (M)"}, {"dok_id": "HD022683", "typ": "mot", "label": "Motion 2025/26:2683", "titel": "Producentavgift på sockersötad dryck", "undertitel": "av Magnus Manhammar och Mats Wiking (båda S)"}, {"dok_id": "HD022699", "typ": "mot", "label": "Motion 2025/26:2699", "titel": "Sockersötade dryckers påverkan på folkhälsan", "undertitel": "av Per-Arne Håkansson (S)"}, {"dok_id": "HD022780", "typ": "mot", "label": "Motion 2025/26:2780", "titel": "Transporteffektivt och hållbart samhälle", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HD022783", "typ": "mot", "label": "Motion 2025/26:2783", "titel": "Ett rättvist skattesystem", "undertitel": "av Ilona Szatmári Waldau m.fl. (V)"}, {"dok_id": "HD022784", "typ": "mot", "label": "Motion 2025/26:2784", "titel": "Biologisk mångfald", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01SkU16.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01SkU16.html", "votering_url": "https://data.riksdagen.se/votering/A4FE4751-3DD9-4F6E-9B52-97CE66E14A0C/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01SkU16/", "meta": {"type": "motion", "policy_area": "tax", "subject": {"sv": "Översyn eller avskaffande av kemikalieskatten", "en": "Reviewing or abolishing the chemicals tax"}, "at_stake": {"sv": "Beslutet påverkar företag som importerar, tar emot eller tillverkar skattepliktig elektronik samt konsumenter, och har betydelse för om skatten bidrar till minskad förekomst av farliga ämnen i hemmiljön och för möjligheten att styra mot mer hållbar konsumtion och återbruk.", "en": "The decision affects companies that import, receive or manufacture taxable electronics, as well as consumers, and matters for whether the tax helps reduce hazardous substances in the home and for the ability to steer toward more sustainable consumption and reuse."}, "subtopics": ["kemikalieskatt", "punktskatt", "elektronik", "hållbar konsumtion", "flamskyddsmedel"], "parties_involved": ["S", "V"], "decision": {"sv": "Frågan gäller om kemikalieskatten, bland annat på elektronik, ska utvärderas, ändras eller avskaffas, eller om nuvarande utformning ska behållas i sin nuvarande form.", "en": "The question is whether the chemicals tax, including on electronics, should be evaluated, revised or abolished, or whether its current design should be retained as is."}, "ja": {"sv": "Utskottet konstaterar att Skatteverket och Kemikalieinspektionen redan har utvärderat kemikalieskattens effekter och att detta lett till ett enklare avdragssystem och tydligare regler för begagnade varor, vilket utskottet välkomnat och tillstyrkt. Utskottet har därefter upprepade gånger avstyrkt motionsyrkanden om att utvärdera, utreda, revidera eller avskaffa kemikalieskatten, eller om att styra andra skatter mot hållbar konsumtion, och ser ingen anledning att ändra sin inställning, varför motionerna avstyrks.", "en": "The committee notes that the Swedish Tax Agency and the Chemicals Agency have already evaluated the effects of the chemicals tax, leading to a simpler deduction system and clearer rules for used goods, which the committee has welcomed and endorsed. The committee has since repeatedly rejected motions calling for the tax to be evaluated, investigated, revised or abolished, or for other taxes to be steered toward sustainable consumption, and sees no reason to change its position, so the motions are rejected."}, "nej": [{"alt_id": "res-23", "sv": "S och V vill se över utformningen av kemikalieskatten på elektronik för att säkerställa att den leder till önskvärda effekter. Skälet är att skatten funnits sedan 2017 för att minska förekomsten av farliga ämnen som flamskyddsmedel i vitvaror och elektronik, men att en utvärdering av Skatteverket och Kemikalieinspektionen visar att skatten varken fått avsedda miljöeffekter eller varit kostnadseffektiv.", "en": "S and V want the design of the chemicals tax on electronics to be reviewed to ensure it produces the desired effects. The reasoning is that the tax has existed since 2017 to reduce the presence of hazardous substances, such as flame retardants, in white goods and electronics, but an evaluation by the Swedish Tax Agency and the Chemicals Agency shows the tax has achieved neither its intended environmental effects nor cost-effectiveness."}]}}