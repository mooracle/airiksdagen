id": "HB021050", "typ": "mot", "label": "Motion 2023/24:1050", "titel": "Systematiska mätningar av narkotika", "undertitel": "av Roland Utbult (KD)"}, {"dok_id": "HB021107", "typ": "mot", "label": "Motion 2023/24:1107", "titel": "Avskaffande av Systembolagets monopol", "undertitel": "av Boriana Åberg (M)"}, {"dok_id": "HB021193", "typ": "mot", "label": "Motion 2023/24:1193", "titel": "Åtgärder för att minska rökning", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HB021240", "typ": "mot", "label": "Motion 2023/24:1240", "titel": "Företag inom besöksnäringen", "undertitel": "av Martina Johansson (C)"}, {"dok_id": "HB021260", "typ": "mot", "label": "Motion 2023/24:1260", "titel": "Modernisering av alkohollagen och slopande av sambandet mellan alkoholtillstånd och mat", "undertitel": "av Anders Ådahl (C)"}, {"dok_id": "HB021272", "typ": "mot", "label": "Motion 2023/24:1272", "titel": "Slopat matkrav för alkoholservering", "undertitel": "av Carl Nordblom (M)"}, {"dok_id": "HB021277", "typ": "mot", "label": "Motion 2023/24:1277", "titel": "Slopat tillstånd för provsmakning av gårdsproducerade alkoholhaltiga drycker", "undertitel": "av Carl Nordblom (M)"}, {"dok_id": "HB021283", "typ": "mot", "label": "Motion 2023/24:1283", "titel": "Ett förbud mot lustgasanvändning och skärpta begränsningar av försäljningen av lustgas", "undertitel": "av Rose-Marie Carlsson m.fl. (S)"}, {"dok_id": "HB021291", "typ": "mot", "label": "Motion 2023/24:1291", "titel": "Kriminalisering av fler substanser", "undertitel": "av Hanna Westerén (S)"}, {"dok_id": "HB02136", "typ": "mot", "label": "Motion 2023/24:136", "titel": "Förbud mot tillverkning och försäljning av cigaretter i Sverige", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HB021438", "typ": "mot", "label": "Motion 2023/24:1438", "titel": "En utbildning, ett tillstånd - giltigt i hela landet", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HB021605", "typ": "mot", "label": "Motion 2023/24:1605", "titel": "Utvärder