nat till gällande regler och att arbete redan pågår i många av de frågor som förslagen handlar om.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motionerna \n\n2025/26:972 av Andreas Lennkvist Manriquez m.fl. (V) yrkande 9, \n\n2025/26:1898 av Mattias Jonsson och Dzenan Cisija (båda S), \n\n2025/26:3181 av Alireza Akhondi m.fl. (C) yrkande 17 och \n\n2025/26:3649 av Joakim Järrebring m.fl. (S) yrkande 13.", "source_partier": []}, {"alt_id": "res-8", "text": "Reservation 8", "source_partier": ["S", "V", "C"]}], "actual": {"L": {"position": "Ja", "n_ja": 13, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 60, "n_nej": 0, "n_avstar": 0, "n_franvarande": 8, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Nej", "n_ja": 0, "n_nej": 18, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": true}, "C": {"position": "Nej", "n_ja": 0, "n_nej": 21, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": true}, "KD": {"position": "Ja", "n_ja": 17, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "S": {"position": "Nej", "n_ja": 0, "n_nej": 93, "n_avstar": 0, "n_franvarande": 13, "cohesion": 1.0, "authored_reservation": true}, "MP": {"position": "Ja", "n_ja": 16, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Ja", "n_ja": 62, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}}, "ai": {}, "probe": null, "seats": [["V", "Nej", "Andrea Andersson Tay", "Stockholms län"], ["V", "Nej", "Andreas Lennkvist Manriquez", "Stockholms kommun"], ["V", "Nej", "Birger Lahti", "Norrbottens län"], ["V", "Nej", "Ciczie Weidby", "Jönköpings län"], ["V", "Nej", "Gudrun Nordborg", "Västerbottens län"], ["V", "Nej", "Hanna Gunnarsson", "Skåne läns södra"], ["V", "Nej", "Håkan Svenne