nds läns västra"]], "references": [{"dok_id": "HA021059", "typ": "mot", "label": "Motion 2022/23:1059", "titel": "Trygga jobb", "undertitel": "av Denis Begic (S)"}, {"dok_id": "HA021121", "typ": "mot", "label": "Motion 2022/23:1121", "titel": "Fler företag, fler jobb och stärkt konkurrenskraft i hela landet", "undertitel": "av Elisabeth Thand Ringqvist m.fl. (C)"}, {"dok_id": "HA021224", "typ": "mot", "label": "Motion 2022/23:1224", "titel": "Idrottspolitiska frågor", "undertitel": "av Vasiliki Tsouplaki m.fl. (V)"}, {"dok_id": "HA021406", "typ": "mot", "label": "Motion 2022/23:1406", "titel": "Reformer för ökad tillväxt i Stockholmsregionen", "undertitel": "av Josefin Malmqvist m.fl. (M)"}, {"dok_id": "HA021470", "typ": "mot", "label": "Motion 2022/23:1470", "titel": "Civilsamhällets långsiktiga förutsättningar", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HA022095", "typ": "mot", "label": "Motion 2022/23:2095", "titel": "Friluftspolitisk motion", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HA022192", "typ": "mot", "label": "Motion 2022/23:2192", "titel": "Skatter för företagande och tillväxt i hela landet", "undertitel": "av Helena Lindahl m.fl. (C)"}, {"dok_id": "HA02965", "typ": "mot", "label": "Motion 2022/23:965", "titel": "Bättre villkor för småföretag", "undertitel": "av Tobias Andersson m.fl. (SD)"}, {"dok_id": "HA02978", "typ": "mot", "label": "Motion 2022/23:978", "titel": "Friluftsliv för folkhälsa", "undertitel": "av Angelika Bengtsson m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01SfU10.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01SfU10.html", "votering_url": "https://data.riksdagen.se/votering/70EE89C9-B5D3-498B-BD07-465227737E83/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01SfU10/", "meta": {"type": "motion", "policy_area": "migration", "subject": {"sv": "Nedsättning av socialavgifter för småföretag", "en": "Reduction of social security contributions for small businesses"}, "at_stake": {"sv": "Frågan påverkar företagens kostnader för att anställa, särskilt i glesbygd, och avvägningen mellan lägre skattetryck för företag och finansieringen av de sociala trygghetssystemen.", "en": "The issue affects businesses' costs of hiring, especially in sparsely populated areas, and the trade-off between a lower tax burden for businesses and funding of the social security systems."}, "subtopics": ["socialavgifter", "småföretag", "arbetsgivaravgifter", "regionalt stöd", "skattetryck"], "parties_involved": ["C"], "decision": {"sv": "Voteringen gäller om arbetsgivaravgifterna bör sänkas ytterligare för småföretag utöver befintligt regionalt stöd och FoU-avdrag, eller om nuvarande nedsättningar är tillräckliga.", "en": "The vote concerns whether employer contributions should be reduced further for small businesses beyond existing regional support and the R&D deduction, or whether current reductions are sufficient."}, "ja": {"sv": "Utskottet avslår motionerna och anser att befintliga stödinsatser - regionalt stöd, växa-stödet och det aviserade förstärkta FoU-avdraget - redan tillgodoser behovet, utan ytterligare nedsättningar för småföretag.", "en": "The committee rejects the motions and considers that existing support measures - regional support, the growth support, and the announced strengthened R&D deduction - already address the need, without further reductions for small businesses."}, "nej": [{"alt_id": "res-2", "sv": "C anser att sänkta arbetsgivaravgifter är centralt för att skapa utrymme för företag att anställa fler och bygga livskraftiga företag, och att ett lägre skattetryck långsiktigt stärker välfärden.", "en": "C argues that lower employer contributions are central to giving businesses room to hire more and build viable companies, and that a lower tax burden strengthens welfare in the long run."}]}}