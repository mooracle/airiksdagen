dok_id": "HA021252", "typ": "mot", "label": "Motion 2022/23:1252", "titel": "Inkludering av de vilda djuren i djurskyddslagen", "undertitel": "av Rebecka Le Moine m.fl. (MP)"}, {"dok_id": "HA021260", "typ": "mot", "label": "Motion 2022/23:1260", "titel": "Förbud mot hållande av elefanter, stora kattdjur och delfiner på djurparker", "undertitel": "av Rebecka Le Moine m.fl. (MP)"}, {"dok_id": "HA021293", "typ": "mot", "label": "Motion 2022/23:1293", "titel": "Minkarnas rätt till ett gott liv", "undertitel": "av Sanna Backeskog m.fl. (S)"}, {"dok_id": "HA021418", "typ": "mot", "label": "Motion 2022/23:1418", "titel": "Avlivning av djur enligt djurskyddslagen (2018:1192)", "undertitel": "av Michael Rubbestad (SD)"}, {"dok_id": "HA021646", "typ": "mot", "label": "Motion 2022/23:1646", "titel": "Ny djurskötarutbildning", "undertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HA021785", "typ": "mot", "label": "Motion 2022/23:1785", "titel": "Utfasning av djurförsök", "undertitel": "av Ulrika Heindorff (M)"}, {"dok_id": "HA021828", "typ": "mot", "label": "Motion 2022/23:1828", "titel": "Brist på veterinärer", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HA022072", "typ": "mot", "label": "Motion 2022/23:2072", "titel": "Utgiftsområde 23 Areella näringar, landsbygd och livsmedel", "undertitel": "av Anna-Caren Sätherberg m.fl. (S)"}, {"dok_id": "HA022143", "typ": "mot", "label": "Motion 2022/23:2143", "titel": "Videoövervakning vid slakt och straffansvar för slakteriägare", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HA022149", "typ": "mot", "label": "Motion 2022/23:2149", "titel": "Obedövad slakt", "undertitel": "av Markus Wiechel och Charlotte Quensel (båda SD)"}, {"dok_id": "HA022151", "typ": "mot", "label": "Motion 2022/23:2151", "titel": "Förbud av försäljning av foie gras", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HA022152", "typ": "mot", "label": "Motion 2022/23:2152", "titel": "Förbud mot koldioxidbedövning vid slakt", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HA02218", "typ": "mot", "label": "Motion 2022/23:218", "titel": "Sekretess inom djurskydd", "undertitel": "av Mikael Larsson (C)"}, {"dok_id": "HA02487", "typ": "mot", "label": "Motion 2022/23:487", "titel": "Utredning av hundaveln i Sverige", "undertitel": "av Anna-Belle Strömberg och Peter Hedberg (båda S)"}, {"dok_id": "HA02503", "typ": "mot", "label": "Motion 2022/23:503", "titel": "Skärpta krav på kycklingindustrin", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HA02518", "typ": "mot", "label": "Motion 2022/23:518", "titel": "Djurbalk och djurskyddsmyndighet", "undertitel": "av Markus Wiechel (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01MJU9.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01MJU9.html", "votering_url": "https://data.riksdagen.se/votering/6942970B-86B9-4656-BCAC-E1804D215897/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01MJU9/", "meta": {"type": "motion", "policy_area": "environment", "subject": {"sv": "Förbud mot minkhållning och pälsdjursuppfödning", "en": "Ban on mink and fur-animal farming"}, "at_stake": {"sv": "Beslutet handlar om huruvida minkar även fortsättningsvis ska få hållas för sin päls i Sverige, eller om näringen bör avvecklas med hänvisning till djurens begränsade möjligheter att bete sig naturligt i bur. Det påverkar både djurens välfärd och de företag som i dag bedriver pälsdjursuppfödning.", "en": "The decision concerns whether mink may continue to be farmed for their fur, or whether the industry should be phased out given the animals' limited ability to behave naturally in cages. It affects both animal welfare and the businesses currently engaged in fur farming."}, "subtopics": ["minkhållning", "pälsdjursuppfödning", "djurskydd", "djurvälfärd"], "parties_involved": ["V"], "decision": {"sv": "Frågan gäller om riksdagen ska verka för ett förbud mot pälsdjursuppfödning av mink, eller om nuvarande djurskyddsregler bedöms tillräckliga för att hantera djurens välfärd i minknäringen.", "en": "The question is whether parliament should push for a ban on mink and fur-animal farming, or whether current animal-welfare rules are seen as sufficient to address the welfare of animals in the fur industry."}, "ja": {"sv": "Utskottet avslår motionerna om ett förbud mot minkhållning och pälsdjursuppfödning och finner inte skäl för riksdagen att ta ett sådant initiativ, i linje med bedömningen att djurskyddslagens krav på djurens miljö och välfärd gäller oavsett djurslag.", "en": "The committee rejects the motions calling for a ban on mink and fur-animal farming and does not find grounds for parliament to take such an initiative, in line with the view that the animal welfare law's requirements on the animals' environment and welfare apply regardless of species."}, "nej": [{"alt_id": "res-16", "sv": "V vill att pälsdjursuppfödningen av mink avvecklas, med hänvisning till att minkar hålls i burar utan möjlighet att simma, springa eller bete sig naturligt, att inspektioner visat brister i djurhållningen och att en tydlig majoritet av allmänheten är emot att djur föds upp i bur för sin päls.", "en": "V wants mink fur farming phased out, pointing to mink being kept in cages without the ability to swim, run, or behave naturally, inspections that have found shortcomings in husbandry, and a clear majority of the public opposing farming animals in cages for their fur."}]}}