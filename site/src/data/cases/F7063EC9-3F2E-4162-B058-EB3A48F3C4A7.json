dok_id": "HB021106", "typ": "mot", "label": "Motion 2023/24:1106", "titel": "Tydliggörande av bestämmelser för återkallande av vapenlicens", "undertitel": "av Crister Carlsson och Malin Höglund (båda M)"}, {"dok_id": "HB021168", "typ": "mot", "label": "Motion 2023/24:1168", "titel": "Ansvarig myndighet för inspektion av landets skjutbanor", "undertitel": "av Katarina Tolgfors och Marléne Lund Kopparklint (båda M)"}, {"dok_id": "HB021279", "typ": "mot", "label": "Motion 2023/24:1279", "titel": "Uppdaterad vapenlag", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HB02143", "typ": "mot", "label": "Motion 2023/24:143", "titel": "Fler vapen i vapengarderoben", "undertitel": "av Mathias Bengtsson (KD)"}, {"dok_id": "HB021557", "typ": "mot", "label": "Motion 2023/24:1557", "titel": "Vapenlicens och digital teknik", "undertitel": "av Johan Löfstrand m.fl. (S)"}, {"dok_id": "HB021686", "typ": "mot", "label": "Motion 2023/24:1686", "titel": "Förvaring av vapen på annan adress än folkbokföringsadressen", "undertitel": "av Eric Westroth (SD)"}, {"dok_id": "HB02185", "typ": "mot", "label": "Motion 2023/24:185", "titel": "Licens på enhandsvapen för eftersök och jakt", "undertitel": "av Magnus Persson (SD)"}, {"dok_id": "HB022168", "typ": "mot", "label": "Motion 2023/24:2168", "titel": "Förvaring av vapen i annans vapenskåp", "undertitel": "av Helena Storckenfeldt (M)"}, {"dok_id": "HB022255", "typ": "mot", "label": "Motion 2023/24:2255", "titel": "Värnande av gamla historiska vapensamlingar", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HB022322", "typ": "mot", "label": "Motion 2023/24:2322", "titel": "En starkare polisorganisation", "undertitel": "av Gudrun Nordborg m.fl. (V)"}, {"dok_id": "HB022479", "typ": "mot", "label": "Motion 2023/24:2479", "titel": "Livskraftiga gröna och blå näringar", "undertitel": "av Daniel Bäckström m.fl. (C)"}, {"dok_id": "HB022640", "typ": "mot", "label": "Motion 2023/24:2640", "titel": "Utgiftsområde 4 Rättsväsendet", "undertitel": "av Ardalan Shekarabi m.fl. (S)"}, {"dok_id": "HB022713", "typ": "mot", "label": "Motion 2023/24:2713", "titel": "Förändring av reglerna om licensplikt för vapenmagasin", "undertitel": "av Helena Vilhelmsson (C)"}, {"dok_id": "HB02762", "typ": "mot", "label": "Motion 2023/24:762", "titel": "Jakt på egen hand från det år man fyller 16 år", "undertitel": "av Lars Beckman (M)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01JuU14.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01JuU14.html", "votering_url": "https://data.riksdagen.se/votering/F7063EC9-3F2E-4162-B058-EB3A48F3C4A7/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01JuU14/", "meta": {"type": "motion", "policy_area": "justice", "subject": {"sv": "Nya vapenamnestier för illegala vapen, ammunition och explosiva varor", "en": "New weapons amnesties for illegal firearms, ammunition and explosives"}, "at_stake": {"sv": "Beslutet rör möjligheten att anonymt lämna in illegala vapen och sprängämnen till polisen utan rättsliga påföljder, vilket kan minska mängden vapen som cirkulerar i kriminella kretsar och påverka anhörigas benägenhet att anmäla närstående med illegala vapen.", "en": "The decision concerns the option of anonymously handing in illegal firearms and explosives to the police without legal consequences, which can reduce the amount of weapons circulating in criminal circles and affect relatives' willingness to report family members who have illegal weapons."}, "subtopics": ["vapenamnesti", "illegala vapen", "gängkriminalitet", "explosiva varor", "vapenlagen"], "parties_involved": ["S", "V", "C", "MP"], "decision": {"sv": "Frågan gäller om regeringen ska ta initiativ till nya, återkommande vapenamnestier för illegala vapen, ammunition och explosiva varor, eller om utskottet inte ser skäl att nu ta något sådant initiativ.", "en": "The question is whether the government should launch new, recurring amnesties for illegal firearms, ammunition and explosives, or whether the committee sees no grounds to take such an initiative now."}, "ja": {"sv": "Utskottet är inte berett att ta något initiativ med anledning av det som anförs i motionerna om tidsbegränsade vapenamnestier, och avstyrker därför motionsyrkandena.", "en": "The committee is not prepared to take any initiative in response to what is raised in the motions about time-limited weapons amnesties, and therefore rejects the motions."}, "nej": [{"alt_id": "res-2", "sv": "Reservationen (S, V, C, MP) vill att regeringen tar initiativ till nya vapenamnestier för illegala vapen, ammunition och explosiva varor. Motiveringen är att återkommande amnestier kan minska mängden illegala vapen i samhället, särskilt sådana som cirkulerar i gängkriminella kretsar, att den senaste vapenamnestin 2018 gav in 12 000 vapen, och att anhöriga bör kunna få stöd så att de vågar anmäla närstående med illegala vapen.", "en": "The reservation (S, V, C, MP) wants the government to launch new amnesties for illegal firearms, ammunition and explosives. The reasoning is that recurring amnesties can reduce the amount of illegal weapons in society, particularly those circulating in criminal gang circles, that the most recent weapons amnesty in 2018 brought in 12,000 firearms, and that relatives should be able to get support so they feel able to report family members who have illegal weapons."}]}}