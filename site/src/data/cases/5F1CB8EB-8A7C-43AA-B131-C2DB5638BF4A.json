titel": "av Carita Boulwén (SD)"}, {"dok_id": "HC021321", "typ": "mot", "label": "Motion 2024/25:1321", "titel": "Politik för tornedalingar, kväner och lantalaiset", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021421", "typ": "mot", "label": "Motion 2024/25:1421", "titel": "Nationella minoriteter och urfolk i Sverige", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC02171", "typ": "mot", "label": "Motion 2024/25:171", "titel": "Tornedalingar som urfolk", "undertitel": "av Cecilia Engström och Magnus Oscarsson (båda KD)"}, {"dok_id": "HC021745", "typ": "mot", "label": "Motion 2024/25:1745", "titel": "Politik för minoriteter", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021746", "typ": "mot", "label": "Motion 2024/25:1746", "titel": "Politik för romer", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021747", "typ": "mot", "label": "Motion 2024/25:1747", "titel": "Politik för sverigefinländarna", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021754", "typ": "mot", "label": "Motion 2024/25:1754", "titel": "Politik för samer", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021932", "typ": "mot", "label": "Motion 2024/25:1932", "titel": "Språk och litteratur", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HC021935", "typ": "mot", "label": "Motion 2024/25:1935", "titel": "Åtgärder för de nationella minoriteterna och minoritetsspråken", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HC022372", "typ": "mot", "label": "Motion 2024/25:2372", "titel": "Älvdalska - ett eget språk", "undertitel": "av Malin Höglund (M)"}, {"dok_id": "HC022643", "typ": "mot", "label": "Motion 2024/25:2643", "titel": "En rättvis framtid: strategier för att bekämpa rasism och främja social rättvisa", "undertitel": "av Leila Ali Elmi m.fl. (MP)"}, {"dok_id": "HC023040", "typ": "mot", "label": "Motion 2024/25:3040", "titel": "Judiskt liv i Sverige", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC023110", "typ": "mot", "label": "Motion 2024/25:3110", "titel": "Utgiftsområde 17 Kultur, medier, trossamfund och fritid", "undertitel": "av Lawen Redar m.fl. (S)"}, {"dok_id": "HC023159", "typ": "mot", "label": "Motion 2024/25:3159", "titel": "Konstitution och demokrati", "undertitel": "av Malin Björk m.fl. (C)"}, {"dok_id": "HC023193", "typ": "mot", "label": "Motion 2024/25:3193", "titel": "Utgiftsområde 1 Rikets styrelse", "undertitel": "av Ida Karkiainen m.fl. (S)"}, {"dok_id": "HC0261", "typ": "mot", "label": "Motion 2024/25:61", "titel": "Åtgärder för att motverka den muslimska antisemitismen", "undertitel": "av Nima Gholam Ali Pour (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01KU28.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01KU28.html", "votering_url": "https://data.riksdagen.se/votering/5F1CB8EB-8A7C-43AA-B131-C2DB5638BF4A/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01KU28/", "meta": {"type": "motion", "policy_area": "constitution", "subject": {"sv": "Erkännande av teckenspråk som nationellt minoritetsspråk", "en": "Recognition of sign language as a national minority language"}, "at_stake": {"sv": "Ett erkännande skulle ge teckenspråket samma starkare rättsliga skydd som övriga minoritetsspråk, exempelvis kring undervisning och omsorg, och beslutet påverkar därmed dövas språkliga rättigheter och tillgång till stöd.", "en": "Recognition would give sign language the same stronger legal protection as the other minority languages, for example around education and care, so the decision affects deaf people's language rights and access to support."}, "subtopics": ["teckenspråk", "minoritetsspråk", "språklagen", "dövas rättigheter"], "parties_involved": ["SD", "V"], "decision": {"sv": "Frågan gäller om svenskt teckenspråk ska erkännas som ett nationellt minoritetsspråk med samma skydd som de fem befintliga minoritetsspråken, eller om det även fortsatt ska regleras enbart genom språklagens mer begränsade skydd.", "en": "The question is whether Swedish sign language should be recognized as a national minority language with the same protection as the five existing minority languages, or whether it should continue to be governed solely by the more limited protection in the Language Act."}, "ja": {"sv": "Utskottet vidhåller att teckenspråket inte faller inom ramen för minoritetsspråkskonventionens syfte med dess koppling till urbefolkningar och andra nationella minoriteter, men framhåller att det allmänna enligt språklagen ändå har ett ansvar för att skydda och främja teckenspråket.", "en": "The committee maintains that sign language falls outside the purpose of the minority-languages convention, given its link to indigenous peoples and other national minorities, but stresses that public bodies nonetheless have a responsibility under the Language Act to protect and promote sign language."}, "nej": [{"alt_id": "res-30", "sv": "Reservanterna vill att svenskt teckenspråk erkänns som ett nationellt minoritetsspråk, med hänvisning till att det är ett fullvärdigt, historiskt förankrat eget språk som redan jämställs med minoritetsspråken i språklagen men saknar det mer omfattande skyddet i lagen om nationella minoriteter och minoritetsspråk, t.ex. kring barn- och äldreomsorg och modersmålsundervisning.", "en": "The reservation wants Swedish sign language to be recognized as a national minority language, arguing that it is a fully-fledged, historically established language in its own right that is already treated on par with the minority languages under the Language Act but lacks the more extensive protection under the law on national minorities and minority languages, for instance regarding child and elderly care and mother-tongue instruction."}]}}