_id": "HD021366", "typ": "mot", "label": "Motion 2025/26:1366", "titel": "Översyn av lagstiftningen om fastighetsägares ansvar vid parkeringsövervakning", "undertitel": "av Dzenan Cisija (S)"}, {"dok_id": "HD02140", "typ": "mot", "label": "Motion 2025/26:140", "titel": "Stänkskydd på personbilar", "undertitel": "av Angelica Lundberg (SD)"}, {"dok_id": "HD02146", "typ": "mot", "label": "Motion 2025/26:146", "titel": "Parkering mot färdriktningen", "undertitel": "av Eric Palmqvist och Mattias Eriksson Falk (båda SD)"}, {"dok_id": "HD021496", "typ": "mot", "label": "Motion 2025/26:1496", "titel": "Obligatorisk prisangivelse för el vid tankstationer", "undertitel": "av Eric Westroth (SD)"}, {"dok_id": "HD02155", "typ": "mot", "label": "Motion 2025/26:155", "titel": "Besiktningsgaranti", "undertitel": "av Eric Palmqvist (SD)"}, {"dok_id": "HD021565", "typ": "mot", "label": "Motion 2025/26:1565", "titel": "Åtgärder för att stoppa högljudda fordon och streetracing", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HD02170", "typ": "mot", "label": "Motion 2025/26:170", "titel": "Flytt av fordon", "undertitel": "av Per Söderlund m.fl. (SD)"}, {"dok_id": "HD021797", "typ": "mot", "label": "Motion 2025/26:1797", "titel": "Förbättrad mobilitet för alla som är beroende av bilen", "undertitel": "av Magnus Jacobsson m.fl. (KD)"}, {"dok_id": "HD021933", "typ": "mot", "label": "Motion 2025/26:1933", "titel": "Centrala register för arbetsmaskiner och båtar", "undertitel": "av Marie Nicholson (M)"}, {"dok_id": "HD02196", "typ": "mot", "label": "Motion 2025/26:196", "titel": "Krav på transparens och ansvar för fordonstillverkare samt en teknikneutral definition av miljöbil", "undertitel": "av Rashid Farivar (SD)"}, {"dok_id": "HD02223", "typ": "mot", "label": "Motion 2025/26:223", "titel": "Motorcyklar i kollektivtrafikfält på statliga vägar", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HD022431", "typ": "mot", "label": "Motion 2025/26:2431", "titel": "Åtgärder för att fö