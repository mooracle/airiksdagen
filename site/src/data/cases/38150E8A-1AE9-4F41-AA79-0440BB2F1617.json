 ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021066", "typ": "mot", "label": "Motion 2024/25:1066", "titel": "Vård i rättan tid", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HC021069", "typ": "mot", "label": "Motion 2024/25:1069", "titel": "Trygg vård för studenter oavsett studieort", "undertitel": "av Magnus Berntsson (KD)"}, {"dok_id": "HC021095", "typ": "mot", "label": "Motion 2024/25:1095", "titel": "Riktlinjer för specialistvård och behandling för sexualbrottsutsatta", "undertitel": "av Marléne Lund Kopparklint och Jan Ericson (båda M)"}, {"dok_id": "HC021134", "typ": "mot", "label": "Motion 2024/25:1134", "titel": "Statligt ansvar för sjukvården", "undertitel": "av Christian Carlsson (KD)"}, {"dok_id": "HC021138", "typ": "mot", "label": "Motion 2024/25:1138", "titel": "Nationellt centrum för sexualbrottsutsatta", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC021155", "typ": "mot", "label": "Motion 2024/25:1155", "titel": "Utökad kommunal vård", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HC021205", "typ": "mot", "label": "Motion 2024/25:1205", "titel": "Utvärdering av den svenska missbrukspolitiken", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HC021275", "typ": "mot", "label": "Motion 2024/25:1275", "titel": "Offentlighetsprincipen", "undertitel": "av Mathias Tegnér (S)"}, {"dok_id": "HC021358", "typ": "mot", "label": "Motion 2024/25:1358", "titel": "Den könsbekräftande vården i Sverige", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021360", "typ": "mot", "label": "Motion 2024/25:1360", "titel": "En kvalitativ cancervård i framkant", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021362", "typ": "mot", "label": "Motion 2024/25:1362", "titel": "En stärkt psykisk hälsa i hela landet", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021363", "typ": "mot", "label": "Motion 2024/25:1363", "titel": "En tillgänglig sjukvård i världsklass", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021400", "typ": "mot", "label": "Motion 2024/25:1400", "titel": "En trygg familjepolitik med barnets bästa i fokus", "undertitel": "av Daniel Persson m.fl. (SD)"}, {"dok_id": "HC021402", "typ": "mot", "label": "Motion 2024/25:1402", "titel": "En mer flexibel och ändamålsenlig merkostnadsersättning samt ett välfungerande anhörigstöd", "undertitel": "av Daniel Persson m.fl. (SD)"}, {"dok_id": "HC021412", "typ": "mot", "label": "Motion 2024/25:1412", "titel": "Jämställdhet och diskriminering", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021578", "typ": "mot", "label": "Motion 2024/25:1578", "titel": "Utförsäljningen av välfärden", "undertitel": "av Björn Wiechel och Åsa Karlsson (båda S)"}, {"dok_id": "HC021590", "typ": "mot", "label": "Motion 2024/25:1590", "titel": "Utbyggd geriatrik för ett gott åldrande i hela landet", "undertitel": "av Ewa Pihl Krabbe och Per-Arne Håkansson (båda S)"}, {"dok_id": "HC021594", "typ": "mot", "label": "Motion 2024/25:1594", "titel": "Inkludering av viss vård som utförs av optiker i högkostnadsskyddet", "undertitel": "av Dan Hovskär (KD)"}, {"dok_id": "HC021601", "typ": "mot", "label": "Motion 2024/25:1601", "titel": "Psykisk ohälsa och diskriminering", "undertitel": "av Martina Johansson och Ulrika Heie (båda C)"}, {"dok_id": "HC021605", "typ": "mot", "label": "Motion 2024/25:1605", "titel": "Tydligt uppdrag för primärvården att förebygga ohälsa", "undertitel": "av Ulrika Heie (C)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01SoU16.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01SoU16.html", "votering_url": "https://data.riksdagen.se/votering/38150E8A-1AE9-4F41-AA79-0440BB2F1617/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01SoU16/", "meta": {"type": "motion", "policy_area": "health", "subject": {"sv": "Privatisering och lagen om valfrihetssystem (LOV) inom hälso- och sjukvården", "en": "Privatization and the Act on Freedom of Choice (LOV) in health care"}, "at_stake": {"sv": "Utfallet påverkar hur mycket kontroll regioner och kommuner har över privata vårdgivare och underleverantörer som får skattefinansiering, samt om öppenhet kring och kontroll av vaccinationer och etablering av vårdcentraler skärps. Det berör patienter, skattebetalare och privata och offentliga vårdaktörer.", "en": "The outcome affects how much control regions and municipalities have over private providers and subcontractors receiving public funding, and whether transparency and oversight of vaccinations and clinic establishment are tightened. It affects patients, taxpayers, and private and public care providers."}, "subtopics": ["hälso- och sjukvård", "privatisering", "LOV", "huvudmannaskap", "vårdval", "vaccinationer"], "parties_involved": ["S", "MP"], "decision": {"sv": "Frågan gäller om regionernas och kommunernas huvudmannaskap för hälso- och sjukvården, inklusive kontrollen över privata vårdgivare och lagen om valfrihetssystem (LOV), bör ses över och skärpas, eller om pågående utredningar och uppdrag är tillräckliga.", "en": "The question is whether the regions' and municipalities' responsibility for health care, including control over private providers and the Act on Freedom of Choice (LOV), should be reviewed and tightened, or whether ongoing inquiries and assignments are sufficient."}, "ja": {"sv": "Utskottet avstyrker motionerna med hänvisning till pågående arbete: Vårdansvarskommittén utreder frågor om statligt huvudmannaskap för hälso- och sjukvården, ett kunskapsunderlag om kostnaderna för valfrihetssystem har tagits fram, och pågående utredningar ska bland annat ta ställning till en uppgiftsskyldighet för privata vårdgivare och till om vaccinationsuppgifter kan läggas till i den nationella läkemedelslistan.", "en": "The committee rejects the motions, citing ongoing work: the Committee on Responsibility for Health Care is examining questions of state responsibility for health care, a knowledge base on the costs of the freedom-of-choice system has been produced, and ongoing inquiries are to consider, among other things, a reporting duty for private providers and whether vaccination data can be added to the national medicines list."}, "nej": [{"alt_id": "res-7", "sv": "Reservanterna (S, MP) anser att regionerna och kommunerna måste kunna behålla kontrollen över hälso- och sjukvårdssystemet som helhet, även vid anlitande av privata vårdföretag. Regeringen bör göra upp med marknadsmisslyckanden, se över lagen om valfrihetssystem (LOV) eftersom den låter privata vårdgivare och deras underleverantörer sälja skattefinansierad vård i hela landet utan att regionerna som betalar har beställt den, och skärpa kontrollen av privata vaccinationsaktörer samt införa offentlighetsprincipen i all skattefinansierad verksamhet.", "en": "The dissenters (S, MP) hold that regions and municipalities must be able to retain overall control of the health-care system even when contracting private providers. The government should address market failures, review the Act on Freedom of Choice (LOV) since it lets private providers and their subcontractors sell tax-funded care nationwide without being ordered by the paying regions, tighten oversight of private vaccination providers, and extend the principle of public access to all tax-funded activity."}]}}