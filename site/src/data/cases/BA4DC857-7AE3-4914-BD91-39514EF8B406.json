: [{"dok_id": "HC021042", "typ": "mot", "label": "Motion 2024/25:1042", "titel": "Kinas felaktiga tolkning av resolution 2758 och Taiwans representation i FN-systemet", "undertitel": "av Magnus Berntsson (KD)"}, {"dok_id": "HC021166", "typ": "mot", "label": "Motion 2024/25:1166", "titel": "Estonias last under förlisningsnatten", "undertitel": "av Mikael Oscarsson (KD)"}, {"dok_id": "HC021192", "typ": "mot", "label": "Motion 2024/25:1192", "titel": "Kinas ökande makt", "undertitel": "av Anne-Li Sjölund och Niels Paarup-Petersen (båda C)"}, {"dok_id": "HC021274", "typ": "mot", "label": "Motion 2024/25:1274", "titel": "Om behovet av en ny politik gentemot Taiwan", "undertitel": "av Mathias Tegnér m.fl. (S)"}, {"dok_id": "HC021323", "typ": "mot", "label": "Motion 2024/25:1323", "titel": "Värnande av folkrätten", "undertitel": "av Jacob Risberg m.fl. (MP)"}, {"dok_id": "HC021430", "typ": "mot", "label": "Motion 2024/25:1430", "titel": "Vissa frågor i Mellanöstern och Afrika", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021431", "typ": "mot", "label": "Motion 2024/25:1431", "titel": "Vissa Asienfrågor", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021433", "typ": "mot", "label": "Motion 2024/25:1433", "titel": "Säkerhetspolitik", "undertitel": "av Aron Emilsson m.fl. (SD)"}, {"dok_id": "HC021438", "typ": "mot", "label": "Motion 2024/25:1438", "titel": "Internationella relationer och mänskliga rättigheter", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021439", "typ": "mot", "label": "Motion 2024/25:1439", "titel": "Ett ökat svenskt internationellt inflytande", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021440", "typ": "mot", "label": "Motion 2024/25:1440", "titel": "En ny och skärpt Kinapolitik", "undertitel": "av Aron Emilsson m.fl. (SD)"}, {"dok_id": "HC021637", "typ": "mot", "label": "Motion 2024/25:1637", "titel": "Frigivande av Dawit Isaak", "undertitel": "av Lawen Redar (S)"}, {"dok_id": "HC021638", "typ": "mot", "label": "Motion 2024/25:1638", "titel": "Frigivande av Gui Minhai", "undertitel": "av Lawen Redar (S)"}, {"dok_id": "HC021712", "typ": "mot", "label": "Motion 2024/25:1712", "titel": "Solidaritet", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HC021723", "typ": "mot", "label": "Motion 2024/25:1723", "titel": "Ett land i förändring", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HC021730", "typ": "mot", "label": "Motion 2024/25:1730", "titel": "Utredning avseende Raoul Wallenbergs försvinnande", "undertitel": "av Magnus Oscarsson och Mikael Oscarsson (båda KD)"}, {"dok_id": "HC021732", "typ": "mot", "label": "Motion 2024/25:1732", "titel": "Ny utredning om Raoul Wallenbergs öde", "undertitel": "av Mikael Oscarsson (KD)"}, {"dok_id": "HC021738", "typ": "mot", "label": "Motion 2024/25:1738", "titel": "Frisläppande av Dawit Isaak", "undertitel": "av Magnus Oscarsson (KD)"}, {"dok_id": "HC021739", "typ": "mot", "label": "Motion 2024/25:1739", "titel": "Nya fynd kring Dag Hammarskjölds död", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HC021802", "typ": "mot", "label": "Motion 2024/25:1802", "titel": "Enprocentsmålet i biståndet", "undertitel": "av Annika Strandhäll (S)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01UU7.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01UU7.html", "votering_url": "https://data.riksdagen.se/votering/BA4DC857-7AE3-4914-BD91-39514EF8B406/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01UU7/", "meta": {"type": "motion", "policy_area": "foreign", "subject": {"sv": "Jämställdhetsintegrering inom utrikesförvaltningen", "en": "Gender mainstreaming within the foreign service"}, "at_stake": {"sv": "Beslutet påverkar hur systematiskt jämställdhet, kvinnors rättigheter och FN:s agenda för kvinnor, fred och säkerhet drivs inom utrikesförvaltningens säkerhets-, handels- och utvecklingsarbete, samt hur möjligt det är att i efterhand granska och utvärdera detta arbete.", "en": "The decision affects how systematically gender equality, women's rights and the UN's women, peace and security agenda are pursued across the foreign service's security, trade and development work, and how possible it is to subsequently review and evaluate that work."}, "subtopics": ["jämställdhet", "utrikespolitik", "kvinnor fred och säkerhet", "UD", "jämställdhetsintegrering", "SRHR"], "parties_involved": ["V"], "decision": {"sv": "Frågan gäller om riksdagen ska uppmana regeringen att ta fram en heltäckande, utvärderingsbar handlingsplan för jämställdhetsarbetet inom utrikesförvaltningens samtliga ansvarsområden, eller om den jämställdhetsintegrering och de beslut som redan finns på plats är tillräckliga.", "en": "The question is whether parliament should call on the government to produce a comprehensive, evaluable action plan for gender-equality work across all of the foreign service's areas of responsibility, or whether the gender mainstreaming and decisions already in place are sufficient."}, "ja": {"sv": "Utskottet framhåller att jämställdhet är ett kärnvärde i svensk utrikespolitik och att regeringen antagit en ny handlingsplan för FN:s agenda för kvinnor, fred och säkerhet, samt fattat beslut om att jämställdhetsintegrera Regeringskansliets verksamhet under kommande år genom bland annat budgetprocessen, myndighetsstyrningen och lagstiftningsprocessen. Man konstaterar att ansvaret för att driva jämställdhet ligger hos hela organisationen och dess enhetschefer snarare än hos ett enskilt sändebud, och avstyrker därmed motionerna.", "en": "The committee stresses that gender equality is a core value in Swedish foreign policy and that the government has adopted a new action plan for the UN's women, peace and security agenda, and decided to mainstream gender equality across the Government Offices' operations in the years ahead through, among other things, the budget process, agency governance and the legislative process. It notes that responsibility for advancing gender equality rests with the whole organisation and its heads of unit rather than with a single envoy, and therefore rejects the motions."}, "nej": [{"alt_id": "res-6", "sv": "Reservationen (V) menar att regeringens jämställdhetsambition inte stöds av tydliga analyser eller konkret integrering i strategier eller regleringsbrev, och att den inte omfattar UD:s samtliga ansvarsområden. Man vill att en heltäckande handlingsplan tas fram som omfattar säkerhet, handel och utveckling, redovisar resurs- och effektmål samt möjliggör uppföljning och utvärdering, och att samtliga myndigheter under UD samt alla ambassaduppdrag ges i uppdrag att integrera jämställdhetsarbetet.", "en": "The reservation (V) argues that the government's gender-equality ambition is not backed by clear analyses or concrete mainstreaming in strategies or appropriation directions, and that it does not cover all of the foreign ministry's areas of responsibility. It calls for a comprehensive action plan covering security, trade and development, setting out resource and outcome targets and enabling follow-up and evaluation, and for all agencies under the foreign ministry and all embassy assignments to be tasked with mainstreaming gender-equality work."}]}}