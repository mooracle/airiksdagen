d": "HC02108", "typ": "mot", "label": "Motion 2024/25:108", "titel": "Museum för varvs- och industrihistoria i Göteborg", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HC02109", "typ": "mot", "label": "Motion 2024/25:109", "titel": "Avveckling av Världskulturmuseet och inrättande av ett museum för runstenar", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HC02110", "typ": "mot", "label": "Motion 2024/25:110", "titel": "Bevarandeprogram för runstenar", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HC021201", "typ": "mot", "label": "Motion 2024/25:1201", "titel": "Finansiering av utgrävningar i Uppåkra", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HC021212", "typ": "mot", "label": "Motion 2024/25:1212", "titel": "Det kristna kulturarvet i Turkiet", "undertitel": "av Yusuf Aydin (KD)"}, {"dok_id": "HC021277", "typ": "mot", "label": "Motion 2024/25:1277", "titel": "Kyrkoantikvarisk ersättning", "undertitel": "av Mirja Räihä m.fl. (S)"}, {"dok_id": "HC021321", "typ": "mot", "label": "Motion 2024/25:1321", "titel": "Politik för tornedalingar, kväner och lantalaiset", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021337", "typ": "mot", "label": "Motion 2024/25:1337", "titel": "Kulturmiljöer", "undertitel": "av Runar Filper m.fl. (SD)"}, {"dok_id": "HC021347", "typ": "mot", "label": "Motion 2024/25:1347", "titel": "Arkitekturfrågor", "undertitel": "av Anna-Lena Hedberg m.fl. (SD)"}, {"dok_id": "HC02136", "typ": "mot", "label": "Motion 2024/25:136", "titel": "Åtgärder för att motverka antisemitism", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HC021370", "typ": "mot", "label": "Motion 2024/25:1370", "titel": "Skog, skogsbruk och ekonomi", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021373", "typ": "mot", "label": "Motion 2024/25:1373", "titel": "Livsmedel", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021384", "typ": "mot", "label": "Motion 2024/25:1384", "titel": "Konsumentpolitik", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HC021395", "typ": "mot", "label": "Motion 2024/25:1395", "titel": "Jordbruk - ökad konkurrenskraft utan förlust av biologisk mångfald", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021416", "typ": "mot", "label": "Motion 2024/25:1416", "titel": "Trossamfundsfrågor", "undertitel": "av Alexander Christiansson m.fl. (SD)"}, {"dok_id": "HC021417", "typ": "mot", "label": "Motion 2024/25:1417", "titel": "Svenskt kulturarv", "undertitel": "av Runar Filper m.fl. (SD)"}, {"dok_id": "HC021421", "typ": "mot", "label": "Motion 2024/25:1421", "titel": "Nationella minoriteter och urfolk i Sverige", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021422", "typ": "mot", "label": "Motion 2024/25:1422", "titel": "Museifrågor", "undertitel": "av Runar Filper m.fl. (SD)"}, {"dok_id": "HC021435", "typ": "mot", "label": "Motion 2024/25:1435", "titel": "Stöd till utsatta grupper", "undertitel": "av Rasmus Giertz m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01KrU5.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01KrU5.html", "votering_url": "https://data.riksdagen.se/votering/DB6793A2-2D57-400A-A4B0-4D02FF97568C/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01KrU5/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Museernas finansiering och breddade deltagande", "en": "Museum funding and broadening participation"}, "at_stake": {"sv": "Frågan gäller hur museer ska finansieras och drivas för att nå fler och bredare besöksgrupper — bland annat om fri entré räcker för att öka deltagandet eller om museerna aktivt måste arbeta för att locka besökare som normalt inte söker sig dit.", "en": "The question is how museums should be funded and run to reach wider and more varied visitor groups — including whether free admission alone is enough to boost participation, or whether museums must actively work to attract visitors who would not normally go there."}, "subtopics": ["museer", "kulturarv", "finansiering", "fri entré", "delaktighet"], "parties_involved": ["S"], "decision": {"sv": "Motionerna tog upp allt från Arbetets museums roll och breddad finansiering av museer till fri entré, medan utskottet ansåg att frågorna redan delvis är tillgodosedda genom pågående arbete och avser att fortsätta följa området.", "en": "The motions covered issues ranging from the role of the Museum of Work and broadened funding for museums to free admission, while the committee held that the issues are already partly addressed through ongoing work and said it intends to keep following the area."}, "ja": {"sv": "Utskottet konstaterar att Arbetets museum redan har ett särskilt ansvar för det rullande kulturarvet, delar uppfattningen att breddad finansiering för museer är angeläget att undersöka och avser att följa frågan, men finner yrkandena redan delvis tillgodosedda och avstyrker därför motionerna.", "en": "The committee notes that the Museum of Work already has a special responsibility for rolling-stock heritage, shares the view that broadened funding for museums is worth examining and intends to follow the issue, but finds the demands already partly met and therefore rejects the motions."}, "nej": [{"alt_id": "res-15", "sv": "Reservanterna (S) vill att museer med fri entré även får i uppdrag att aktivt arbeta för att bredda besöksdeltagandet över en längre tid, eftersom fri entré i sig inte löser frågan om att nå fler grupper än de museivana besökarna.", "en": "The reserving party (S) wants free-admission museums also given a mandate to actively work, over the long term, to broaden the range of visitors, since free admission alone does not solve the challenge of reaching groups beyond regular museum-goers."}]}}