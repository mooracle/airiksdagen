 ["SD", "Nej", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Nej", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Nej", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Nej", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Nej", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Nej", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HA021123", "typ": "mot", "label": "Motion 2022/23:1123", "titel": "Den svenska basindustrin", "undertitel": "av Elisabeth Thand Ringqvist m.fl. (C)"}, {"dok_id": "HA021235", "typ": "mot", "label": "Motion 2022/23:1235", "titel": "Omställning till förnybar energiförsörjning", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HA021253", "typ": "mot", "label": "Motion 2022/23:1253", "titel": "Värna Vättern", "undertitel": "av Rebecka Le Moine m.fl. (MP)"}, {"dok_id": "HA021257", "typ": "mot", "label": "Motion 2022/23:1257", "titel": "Förbud mot utvinning ur alunskiffer", "undertitel": "av Camilla Hansén m.fl. (MP)"}, {"dok_id": "HA021672", "typ": "mot", "label": "Motion 2022/23:1672", "titel": "En levande landsbygd för Sveriges bästa", "undertitel": "av Annie Lööf m.fl. (C)"}, {"dok_id": "HA021823", "typ": "mot", "label": "Motion 2022/23:1823", "titel": "Stärkt äganderätten i minerallagen", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HA022063", "typ": "mot", "label": "Motion 2022/23:2063", "titel": "Gruv- och mineralpolitik", "undertitel": "av Fredrik Olovsson m.fl. (S)"}, {"dok_id": "HA022098", "typ": "mot", "label": "Motion 2022/23:2098", "titel": "Politik för det samiska folket", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HA022263", "typ": "mot", "label": "Motion 2022/23:2263", "titel": "Höj mineralavgiften och skapa en \"mineralfond\"", "undertitel": "av Marielle Lahti m.fl. (MP)"}, {"dok_id": "HA02303", "typ": "mot", "label": "Motion 2022/23:303", "titel": "Uranbrytning i Sverige", "undertitel": "av John E Weinerhall och Viktor Wärnick (båda M)"}, {"dok_id": "HA02333", "typ": "mot", "label": "Motion 2022/23:333", "titel": "Förenklande för privatpersoner att vaska guld och leta mineral", "undertitel": "av Rickard Nordin (C)"}, {"dok_id": "HA02345", "typ": "mot", "label": "Motion 2022/23:345", "titel": "Ökad möjlighet att skydda geotermala tillgångar", "undertitel": "av Rickard Nordin (C)"}, {"dok_id": "HA02908", "typ": "mot", "label": "Motion 2022/23:908", "titel": "Biologisk mångfald", "undertitel": "av Stina Larsson m.fl. (C)"}, {"dok_id": "HA02936", "typ": "mot", "label": "Motion 2022/23:936", "titel": "Mineralpolitik för en stark gruvnäring", "undertitel": "av Tobias Andersson m.fl. (SD)"}, {"dok_id": "HA02937", "typ": "mot", "label": "Motion 2022/23:937", "titel": "Levande landsbygd", "undertitel": "av Eric Palmqvist m.fl. (SD)"}, {"dok_id": "HA02950", "typ": "mot", "label": "Motion 2022/23:950", "titel": "Effektivare tillståndsprocesser", "undertitel": "av Tobias Andersson m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01NU13.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01NU13.html", "votering_url": "https://data.riksdagen.se/votering/0122F210-3D9F-4449-9163-4D72A4949C82/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01NU13/", "meta": {"type": "motion", "policy_area": "business", "subject": {"sv": "Förbudet mot utvinning av uran", "en": "The ban on uranium extraction"}, "at_stake": {"sv": "Frågan gäller om gruvbolag ska kunna få tillstånd att bryta uran i Sverige. Det berör både etablerade och tänkbara gruvföretag samt utvinningen av sällsynta jordartsmetaller, som ofta finns tillsammans med uran.", "en": "At stake is whether mining companies should be able to obtain permits to mine uranium in Sweden. It affects both established and prospective mining firms, as well as the extraction of rare earth metals often found alongside uranium."}, "subtopics": ["uranbrytning", "gruvnäring", "kärnkraft", "miljöbalken", "mineralpolitik"], "parties_involved": ["SD"], "decision": {"sv": "Frågan gäller om det förbud som i dag gäller mot utvinning av uran ska finnas kvar, eller om regeringen ska få i uppdrag att åter göra det möjligt att ge tillstånd till uranbrytning.", "en": "The question is whether the current ban on uranium extraction should remain, or whether the government should be tasked with once again making uranium-mining permits possible."}, "ja": {"sv": "Utskottet avstyrker motionerna och står fast vid att utvinning av uran även fortsättningsvis inte ska tillåtas.", "en": "The committee rejects the motions and maintains that uranium extraction should continue to be prohibited."}, "nej": [{"alt_id": "res-6", "sv": "Reservanten (SD) vill att regeringen ska återkomma med förslag som gör det möjligt att ge tillstånd till brytning och anrikning av uran, bland annat för att undanröja osäkerhet för gruvföretag och underlätta utvinning av sällsynta jordartsmetaller som förekommer tillsammans med uran.", "en": "The reservation (SD) wants the government to bring forward proposals making it possible again to grant permits for mining and enriching uranium, partly to remove uncertainty for mining companies and to ease extraction of rare earth metals found alongside uranium."}]}}