dertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HC021078", "typ": "mot", "label": "Motion 2024/25:1078", "titel": "Uppföljning av riskbedömningar i vårdnadsmål och utvärdering av barnkonventionens införande", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC021128", "typ": "mot", "label": "Motion 2024/25:1128", "titel": "Rätten att själv bestämma över sin kvarlåtenskap", "undertitel": "av Alexandra Anstrell och Mats Green (båda M)"}, {"dok_id": "HC021198", "typ": "mot", "label": "Motion 2024/25:1198", "titel": "Separerande av vigsel och välsignelse", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HC021222", "typ": "mot", "label": "Motion 2024/25:1222", "titel": "Införande av registrering av testamenten och framtidsfullmakter", "undertitel": "av Ingemar Kihlström (KD)"}, {"dok_id": "HC021226", "typ": "mot", "label": "Motion 2024/25:1226", "titel": "Testamentsregister", "undertitel": "av Larry Söder (KD)"}, {"dok_id": "HC021299", "typ": "mot", "label": "Motion 2024/25:1299", "titel": "Vårdnadstvister och konsekvenser", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HC021334", "typ": "mot", "label": "Motion 2024/25:1334", "titel": "Alla barns rätt till ett tryggt familjeliv", "undertitel": "av Ulrika Westerlund m.fl. (MP)"}, {"dok_id": "HC021389", "typ": "mot", "label": "Motion 2024/25:1389", "titel": "Familjerätt", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HC021413", "typ": "mot", "label": "Motion 2024/25:1413", "titel": "Krafttag mot hedersrelaterat våld och förtryck", "undertitel": "av Sara Gille m.fl. (SD)"}, {"dok_id": "HC021414", "typ": "mot", "label": "Motion 2024/25:1414", "titel": "Mäns våld mot kvinnor och våld i nära relationer", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021516", "typ": "mot", "label": "Motion 2024/25:1516", "titel": "Situationen kring gode män och förvaltare", "undertitel": "av Peder Björk och Malin Larsson (båda S)"}, {"dok_id": "HC021522", "typ": "mot", "label": "Motion 2024/25:1522", "titel": "Registrering av testamenten", "undertitel": "av Peter Hedberg och Malin Larsson (båda S)"}, {"dok_id": "HC021618", "typ": "mot", "label": "Motion 2024/25:1618", "titel": "Ansvar för barn till föräldrar som förolyckas", "undertitel": "av Elisabeth Thand Ringqvist (C)"}, {"dok_id": "HC021657", "typ": "mot", "label": "Motion 2024/25:1657", "titel": "Kriminalisering av det ekonomiska våldet", "undertitel": "av Karin Sundin (S)"}, {"dok_id": "HC021865", "typ": "mot", "label": "Motion 2024/25:1865", "titel": "Ersättning till borgerliga vigselförrättare", "undertitel": "av Marianne Fundahn (S)"}, {"dok_id": "HC021903", "typ": "mot", "label": "Motion 2024/25:1903", "titel": "Åtgärder för att stoppa mäns våld mot kvinnor och barn", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HC022047", "typ": "mot", "label": "Motion 2024/25:2047", "titel": "Borgerlig vigselförrättare", "undertitel": "av Ann-Charlotte Hammar Johnsson och Mats Sander (båda M)"}, {"dok_id": "HC022048", "typ": "mot", "label": "Motion 2024/25:2048", "titel": "Bodelning som drar ut på tiden", "undertitel": "av Ann-Charlotte Hammar Johnsson (M)"}, {"dok_id": "HC022284", "typ": "mot", "label": "Motion 2024/25:2284", "titel": "Sänkning av åldersgränsen för omyndigas rätt att disponera egna tjänade pengar till 15 år", "undertitel": "av Mattias Eriksson Falk och Roger Hedlund (båda SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01CU7.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01CU7.html", "votering_url": "https://data.riksdagen.se/votering/2D5ED013-0E7C-401F-A79C-A11FAF5E0AD3/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01CU7/", "meta": {"type": "motion", "policy_area": "civil", "subject": {"sv": "En könsneutral och moderniserad föräldrabalk", "en": "A modernized, gender-neutral Children and Parents Code"}, "at_stake": {"sv": "Beslutet påverkar hur snabbt föräldrabalkens terminologi moderniseras för att bättre spegla dagens familjeformer, bland annat regnbågsfamiljer och andra familjer där föräldrarna inte är mor och far i traditionell mening. En snabbare reform skulle ge tydligare juridisk status åt fler föräldrar, medan en fördröjning innebär att nuvarande, mer begränsade begrepp gäller längre.", "en": "The decision affects how quickly the terminology of the Children and Parents Code is modernized to better reflect today's family forms, including same-sex families and other families where the parents are not a mother and father in the traditional sense. A faster reform would give clearer legal status to more parents, while a delay means the current, more limited terms remain in force longer."}, "subtopics": ["föräldrabalken", "könsneutral lagstiftning", "föräldraskap", "familjerätt", "lagstiftningsprocess"], "parties_involved": ["V", "C", "MP"], "decision": {"sv": "Frågan gäller om riksdagen nu ska uppmana regeringen att skyndsamt lägga fram ett lagförslag om en könsneutral föräldrabalk (där ”mor” och ”far” ersätts med ”förälder”), eller om frågan ska vänta tills regeringen på egen hand färdigställer sin beredning av den bakomliggande utredningen.", "en": "The question is whether Parliament should now call on the government to promptly bring forward legislation for a gender-neutral Children and Parents Code (replacing “mother” and “father” with “parent”), or whether the matter should wait until the government completes its own processing of the underlying inquiry."}, "ja": {"sv": "Utskottet avstyrker motionerna med hänvisning till att frågan om en könsneutral föräldrabalk redan omfattas av övervägandena i utredningen Alla tiders föräldraskap (SOU 2022:38), som alltjämt bereds i Regeringskansliet. Utskottet vill inte föregripa den pågående beredningen och avvaktar därför regeringens eget initiativ.", "en": "The committee rejects the motions, noting that the question of a gender-neutral Children and Parents Code is already covered by the considerations in the inquiry Alla tiders föräldraskap (SOU 2022:38), which is still being processed within the Government Offices. The committee does not want to pre-empt the ongoing process and instead awaits the government's own initiative."}, "nej": [{"alt_id": "res-39", "sv": "Reservationen (V, C, MP) vill att riksdagen tillkännager för regeringen att den snarast bör återkomma med en proposition om en könsneutral föräldrabalk, där termerna ”mor”, ”far” och ”förälder enligt 1 kap. 9 §” ersätts med det gemensamma begreppet ”förälder” och bestämmelser som reglerar samma situation förs samman. Skälet är att dagens fragmenterade reglering, med skilda paragrafer för i praktiken lika fall, gör lagstiftningen svåröverskådlig och att tiden nu är mogen att gå vidare med de angelägna förslagen.", "en": "The reservation (V, C, MP) calls for Parliament to instruct the government to bring forward, as soon as possible, a bill for a gender-neutral Children and Parents Code, replacing the terms “mother”, “father” and “parent under Chapter 1, Section 9” with the single term “parent” and consolidating provisions that regulate the same situation. The reason given is that today's fragmented regulation, with separate sections for cases that are in practice identical, makes the legislation hard to overview, and that the time has now come to proceed with these needed proposals."}]}}