r", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Timothy Tréville", "Västra Götalands läns västra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"]], "references": [{"dok_id": "HD021030", "typ": "mot", "label": "Motion 2025/26:1030", "titel": "Åtgärder för att stoppa folkmord mot civilbefolkningen i Gaza", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HD021042", "typ": "mot", "label": "Motion 2025/26:1042", "titel": "Gaza", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HD021363", "typ": "mot", "label": "Motion 2025/26:1363", "titel": "Hävande av ockupationen av Palestina", "undertitel": "av Dzenan Cisija m.fl. (S)"}, {"dok_id": "HD021814", "typ": "mot", "label": "Motion 2025/26:1814", "titel": "Folkmordskonventionen och den humanitära situationen i Gaza", "undertitel": "av Aylin Nouri (S)"}, {"dok_id": "HD022227", "typ": "mot", "label": "Motion 2025/26:2227", "titel": "Donation av inlösta vapen till Ukraina", "undertitel": "av Magnus Berntsson (KD)"}, {"dok_id": "HD022369", "typ": "mot", "label": "Motion 2025/26:2369", "titel": "Kina", "undertitel": "av Håkan Svenneling m.fl. (V)"}, {"dok_id": "HD022801", "typ": "mot", "label": "Motion 2025/26:2801", "titel": "Stärkt militärt samarbete och handel med Taiwan", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD023372", "typ": "mot", "label": "Motion 2025/26:3372", "titel": "Ett slut på ockupationen av Palestina", "undertitel": "av Jacob Risberg m.fl. (MP)"}, {"dok_id": "HD023407", "typ": "mot", "label": "Motion 2025/26:3407", "titel": "Exportkontroll, försvarsindustrins förutsättningar och reglering av autonoma vapen", "undertitel": "av Emma Berginger m.fl. (MP)"}, {"dok_id": "HD023411", "typ": "mot", "label": "Motion 2025/26:3411", "titel": "Kina - mänskliga rättigheter, miljö och geopolitik", "undertitel": "av Jacob Risberg m.fl. (MP)"}, {"dok_id": "HD023440", "typ": "mot", "label": "Motion 2025/26:3440", "titel": "Israels ockupation av Palestina", "undertitel": "av Håkan Svenneling m.fl. (V)"}, {"dok_id": "HD023725", "typ": "mot", "label": "Motion 2025/26:3725", "titel": "Palestina och Israel", "undertitel": "av Daniel Riazat (-)"}, {"dok_id": "HD02406", "typ": "mot", "label": "Motion 2025/26:406", "titel": "Vapenexport till Saudiarabien", "undertitel": "av Martin Ådahl (C)"}, {"dok_id": "HD024102", "typ": "mot", "label": "Motion 2025/26:4102", "titel": "med anledning av skr. 2025/26:114 Strategisk exportkontroll 2025 - krigsmateriel och produkter med dubbla användningsområden", "undertitel": "av Håkan Svenneling m.fl. (V)"}, {"dok_id": "HD024106", "typ": "mot", "label": "Motion 2025/26:4106", "titel": "med anledning av skr. 2025/26:114 Strategisk exportkontroll 2025 - krigsmateriel och produkter med dubbla användningsområden", "undertitel": "av Rasmus Giertz m.fl. (SD)"}, {"dok_id": "HD024115", "typ": "mot", "label": "Motion 2025/26:4115", "titel": "med anledning av skr. 2025/26:114 Strategisk exportkontroll 2025 - krigsmateriel och produkter med dubbla användningsområden", "undertitel": "av Jacob Risberg m.fl. (MP)"}, {"dok_id": "HD024122", "typ": "mot", "label": "Motion 2025/26:4122", "titel": "med anledning av skr. 2025/26:114 Strategisk exportkontroll 2025 - krigsmateriel och produkter med dubbla användningsområden", "undertitel": "av Malcolm Momodou Jallow m.fl. (-)"}, {"dok_id": "HD03114", "typ": "prop", "label": "Regeringens skrivelse 2025/26:114", "titel": "Strategisk exportkontroll 2025 - krigsmateriel och produkter med dubbla användningsområden", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01UU9.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01UU9.html", "votering_url": "https://data.riksdagen.se/votering/A60F1B81-790E-45C5-8B03-70B593118675/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01UU9/", "meta": {"type": "motion", "policy_area": "foreign", "subject": {"sv": "Tillämpningen av regelverket för export av krigsmateriel", "en": "Application of the regulatory framework for war-materiel exports"}, "at_stake": {"sv": "Hur regelverket tillämpas avgör om Sverige kan fortsätta exportera krigsmateriel till stater som anklagas för allvarliga brott mot internationell rätt, med konsekvenser för civila i konfliktdrabbade områden och för den svenska försvarsindustrin.", "en": "How the framework is applied determines whether Sweden can continue exporting war materiel to states accused of serious violations of international law, with consequences for civilians in conflict-affected areas and for the Swedish defence industry."}, "subtopics": ["krigsmateriel", "exporttillstånd", "mänskliga rättigheter", "folkmordskonventionen", "internationell rätt", "ISP"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om dagens tillämpning av exportkontrollens regelverk – en helhetsbedömning utifrån riktlinjer, ovillkorliga och villkorliga hinder samt myndighetsprövning – ger tillräckligt skydd mot vapenexport till stater som anklagas för allvarliga brott mot internationell rätt, eller om tillämpningen bör skärpas.", "en": "The question is whether the current application of the export-control framework – an overall assessment based on guidelines, absolute and conditional obstacles, and authority review – gives sufficient protection against arms exports to states accused of serious violations of international law, or whether it should be tightened."}, "ja": {"sv": "Utskottet konstaterar att den svenska tillståndsprövningen bygger på en helhetsbedömning utifrån regeringens riktlinjer, EU:s gemensamma ståndpunkt och FN:s vapenhandelsfördrag, med en självständig myndighetsprövning (ISP) och en uppdelning i ovillkorliga och villkorliga hinder där mänskliga rättigheter och mottagarstatens demokratiska status redan är centrala villkor, och avstyrker därför motionerna.", "en": "The Committee notes that Swedish licensing review rests on an overall assessment based on the government's guidelines, the EU common position, and the UN Arms Trade Treaty, with independent authority review (ISP) and a split between absolute and conditional obstacles where human rights and the recipient state's democratic status are already central criteria, and therefore rejects the motions."}, "nej": [{"alt_id": "res-3", "sv": "S anser att Sverige inte ska bedriva vapenexport med stater som bryter mot eller inte lever upp till sina skyldigheter enligt folkmordskonventionen, och pekar på att flera tunga internationella aktörer bedömer att agerandet i konflikten mellan Israel och Hamas uppfyller kriterierna för folkmord; Sverige bör därför agera mer kraftfullt och inte exportera materiel eller teknik som kan användas i strid med internationell rätt.", "en": "S believes Sweden should not conduct arms exports with states that violate or fail to live up to their obligations under the Genocide Convention, and points out that several major international actors assess that the conduct in the conflict between Israel and Hamas meets the criteria for genocide; Sweden should therefore act more forcefully and not export materiel or technology that can be used in violation of international law."}]}}