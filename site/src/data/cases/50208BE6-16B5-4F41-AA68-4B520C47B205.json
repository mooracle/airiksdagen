typ": "mot", "label": "Motion 2024/25:1346", "titel": "Bibliotek i tradition och förnyelse", "undertitel": "av Runar Filper m.fl. (SD)"}, {"dok_id": "HC021348", "typ": "mot", "label": "Motion 2024/25:1348", "titel": "Scenkonst", "undertitel": "av Anna-Lena Hedberg m.fl. (SD)"}, {"dok_id": "HC021417", "typ": "mot", "label": "Motion 2024/25:1417", "titel": "Svenskt kulturarv", "undertitel": "av Runar Filper m.fl. (SD)"}, {"dok_id": "HC021421", "typ": "mot", "label": "Motion 2024/25:1421", "titel": "Nationella minoriteter och urfolk i Sverige", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC02152", "typ": "mot", "label": "Motion 2024/25:152", "titel": "Offentliga satsningar på musik", "undertitel": "av Mirja Räihä och Per-Arne Håkansson (båda S)"}, {"dok_id": "HC021737", "typ": "mot", "label": "Motion 2024/25:1737", "titel": "Flytt av Sveriges ambassad i Israel", "undertitel": "av Mikael Oscarsson och Magnus Oscarsson (båda KD)"}, {"dok_id": "HC021745", "typ": "mot", "label": "Motion 2024/25:1745", "titel": "Politik för minoriteter", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021747", "typ": "mot", "label": "Motion 2024/25:1747", "titel": "Politik för sverigefinländarna", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021754", "typ": "mot", "label": "Motion 2024/25:1754", "titel": "Politik för samer", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HC021774", "typ": "mot", "label": "Motion 2024/25:1774", "titel": "Stärkt kulturpolitik - stärkt demokrati", "undertitel": "av Mats Berglund m.fl. (MP)"}, {"dok_id": "HC021932", "typ": "mot", "label": "Motion 2024/25:1932", "titel": "Språk och litteratur", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HC021935", "typ": "mot", "label": "Motion 2024/25:1935", "titel": "Åtgärder för de nationella minoriteterna och minoritetsspråken", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01KrU7.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01KrU7.html", "votering_url": "https://data.riksdagen.se/votering/50208BE6-16B5-4F41-AA68-4B520C47B205/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01KrU7/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Finansiering av bibliotek för nationella minoriteter", "en": "Funding for libraries serving national minorities"}, "at_stake": {"sv": "Stabil finansiering skulle ge resursbiblioteken för finska, jiddisch, meänkieli, romani chib och samiska bättre möjlighet till långsiktig planering och stöd till språkbärarna, medan en fortsatt tillfällig satsning innebär större osäkerhet för verksamheten.", "en": "Stable funding would give the resource libraries for Finnish, Yiddish, Meänkieli, Romani Chib and Sámi better scope for long-term planning and support to speakers, while continued temporary funding leaves the activity more uncertain."}, "subtopics": ["nationella minoriteter", "bibliotek", "minoritetsspråk", "kulturpolitik", "finansiering"], "parties_involved": ["V"], "decision": {"sv": "Frågan gäller om finansieringen av resursbiblioteken för de nationella minoritetsspråken ska permanentas och stabiliseras, eller om nuvarande tillfälliga satsning är tillräcklig.", "en": "The question is whether funding for the resource libraries serving national minority languages should be made permanent and stable, or whether the current temporary funding is sufficient."}, "ja": {"sv": "Utskottet välkomnar satsningen på nationella minoriteters bibliotek och den tillfälliga tilldelningen för 2025 och anser därför att motionerna om finansieringen kan avslås.", "en": "The committee welcomes the initiative for national minorities' libraries and the funding allocated for 2025, and therefore considers the motions on funding can be rejected."}, "nej": [{"alt_id": "res-9", "sv": "Reservanten anser att finansieringen av resursbiblioteken för de nationella minoritetsspråken i dag är otillräcklig och oklar, och vill att regeringen ser till att den blir permanent och stabil.", "en": "The reservation considers that funding for the resource libraries serving the national minority languages is currently inadequate and unclear, and wants the government to ensure it becomes permanent and stable."}]}}