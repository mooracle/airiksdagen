typ": "mot", "label": "Motion 2025/26:1158", "titel": "Stärkta rättigheter för barn enligt barnkonventionen", "undertitel": "av Serkan Köse (S)"}, {"dok_id": "HD021265", "typ": "mot", "label": "Motion 2025/26:1265", "titel": "Statens ansvar för drabbade av brister i den internationella adoptionsverksamheten", "undertitel": "av Louise Thunström m.fl. (S)"}, {"dok_id": "HD021276", "typ": "mot", "label": "Motion 2025/26:1276", "titel": "Reformer för ökad tillväxt i Stockholmsregionen", "undertitel": "av Josefin Malmqvist m.fl. (M)"}, {"dok_id": "HD021279", "typ": "mot", "label": "Motion 2025/26:1279", "titel": "Skärpta insatser mot bidragsfusk", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HD021280", "typ": "mot", "label": "Motion 2025/26:1280", "titel": "Stoppat stöd till de som vistas olagligt i landet", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HD021327", "typ": "mot", "label": "Motion 2025/26:1327", "titel": "Återförening mellan barn och föräldrar som förlorat kontakten efter vårdnadstvister", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HD021328", "typ": "mot", "label": "Motion 2025/26:1328", "titel": "Vårdnadstvister och konsekvenser", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HD021345", "typ": "mot", "label": "Motion 2025/26:1345", "titel": "Dagpenning i stället för försörjningsstöd", "undertitel": "av Hans Eklind och Lili André (båda KD)"}, {"dok_id": "HD021421", "typ": "mot", "label": "Motion 2025/26:1421", "titel": "Tillgång till internet inom riksnormen för försörjningsstöd", "undertitel": "av Åsa Karlsson (S)"}, {"dok_id": "HD021439", "typ": "mot", "label": "Motion 2025/26:1439", "titel": "Stöd till barn till föräldrar med missbruksproblematik", "undertitel": "av Patrik Lundqvist m.fl. (S)"}, {"dok_id": "HD021498", "typ": "mot", "label": "Motion 2025/26:1498", "titel": "Välfärdspengar", "undertitel": "av Eric Westroth (SD)"}, {"dok_id": "HD021531", "typ": "mot", "label": "Motion 2025/26:1531", "titel": "Stärkt samverkan mellan Kriminalvården och socialtjänsten", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HD021533", "typ": "mot", "label": "Motion 2025/26:1533", "titel": "Förstärkande av samhällskontraktet - krav på arbete eller självförsörjning för bidrag", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HD021833", "typ": "mot", "label": "Motion 2025/26:1833", "titel": "Jämlik rätt till anhörigstöd vid kris", "undertitel": "av Johanna Haraldsson (S)"}, {"dok_id": "HD021869", "typ": "mot", "label": "Motion 2025/26:1869", "titel": "Skydd av anställda inom vård, skola och socialtjänst", "undertitel": "av Caroline Högström (M)"}, {"dok_id": "HD022082", "typ": "mot", "label": "Motion 2025/26:2082", "titel": "En säkrare arbetsmiljö för socialtjänsten", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022367", "typ": "mot", "label": "Motion 2025/26:2367", "titel": "Åtgärder för att skydda utsatta socialsekreterares identitet", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022534", "typ": "mot", "label": "Motion 2025/26:2534", "titel": "Förbud för kommuner att överskrida riksnormen för ekonomiskt bistånd med mer än 10 procent", "undertitel": "av Mattias Eriksson Falk och Roger Hedlund (båda SD)"}, {"dok_id": "HD022658", "typ": "mot", "label": "Motion 2025/26:2658", "titel": "Socialt frikort för personer långt ifrån arbetsmarknaden", "undertitel": "av Helene Odenjung och Cecilia Rönn (båda L)"}, {"dok_id": "HD02268", "typ": "mot", "label": "Motion 2025/26:268", "titel": "Kredit för svenska medborgare som erhåller försörjningsstöd", "undertitel": "av Martin Westmont (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01SoU18.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01SoU18.html", "votering_url": "https://data.riksdagen.se/votering/592DA169-CAA4-4F56-8E84-F908871047A0/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01SoU18/", "meta": {"type": "motion", "policy_area": "health", "subject": {"sv": "Personalförsörjningen inom socialtjänsten under omställningen till den nya socialtjänstlagen", "en": "Staffing in social services during the transition to the new Social Services Act"}, "at_stake": {"sv": "Kommunernas socialtjänst genomgår en omställning mot mer förebyggande arbete, vilket kräver tillräcklig och kompetent personal; hur personalförsörjningen samordnas kan påverka både anställda inom socialtjänsten och de barn, vuxna och familjer som är beroende av stödet.", "en": "Municipal social services are undergoing a shift toward more preventive work, which requires sufficient and skilled staff; how staffing is coordinated can affect both social-service employees and the children, adults, and families who depend on the support."}, "subtopics": ["socialtjänst", "personalförsörjning", "kompetensförsörjning", "kommuner", "barnrätt"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om regeringen bör tillsätta en nationell samordnare för socialtjänstens personalförsörjning, eller om pågående statsbidrag och kompetenshöjande insatser är tillräckliga för att klara omställningen till den nya socialtjänstlagen.", "en": "The question is whether the government should appoint a national coordinator for staffing in social services, or whether existing government grants and skills-development efforts are sufficient to manage the transition to the new Social Services Act."}, "ja": {"sv": "Utskottet framhåller regeringens statsbidrag och kompetenshöjande insatser för socialtjänstens personal samt övriga pågående satsningar och anser mot den bakgrunden att det inte finns skäl att ta något initiativ till en särskild samordnarfunktion, varför motionsyrkandet avstyrks.", "en": "The committee highlights the government's grants and skills-development efforts for social-services staff along with other ongoing initiatives, and on that basis considers there is no reason to take action on a dedicated coordinator function, and therefore rejects the motion."}, "nej": [{"alt_id": "res-1", "sv": "Reservanten vill att regeringen tillsätter en nationell samordnare med uppdrag att fokusera särskilt på socialtjänstens personalförsörjning och personalens villkor, för att säkerställa en stabil bemanning.", "en": "The reservation wants the government to appoint a national coordinator tasked with focusing specifically on staffing in social services and staff conditions, in order to ensure stable staffing levels."}]}}