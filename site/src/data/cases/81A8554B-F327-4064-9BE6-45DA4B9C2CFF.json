ds läns södra"], ["SD", "Frånvarande", "Per Söderlund", "Örebro län"], ["SD", "Avstår", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Avstår", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Avstår", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Avstår", "Rasmus Giertz", "Dalarnas län"], ["SD", "Avstår", "Richard Jomshof", "Blekinge län"], ["SD", "Avstår", "Robert Stenkvist", "Stockholms län"], ["SD", "Avstår", "Roger Hedlund", "Gävleborgs län"], ["SD", "Avstår", "Runar Filper", "Värmlands län"], ["SD", "Avstår", "Sara Gille", "Dalarnas län"], ["SD", "Avstår", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Avstår", "Staffan Eklöf", "Jönköpings län"], ["SD", "Avstår", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Frånvarande", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Avstår", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Avstår", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Avstår", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021060", "typ": "mot", "label": "Motion 2024/25:1060", "titel": "Möjlighet för samtliga elever att driva ett UF-företag under sin gymnasietid", "undertitel": "av Christofer Bergenblock (C)"}, {"dok_id": "HC021130", "typ": "mot", "label": "Motion 2024/25:1130", "titel": "Det behövs mer privatekonomi", "undertitel": "av Alexandra Anstrell (M)"}, {"dok_id": "HC021132", "typ": "mot", "label": "Motion 2024/25:1132", "titel": "Idrottssveriges möjligheter att bedriva elitverksamhet för ungdomar", "undertitel": "av Alexandra Anstrell m.fl. (M)"}, {"dok_id": "HC021342", "typ": "mot", "label": "Motion 2024/25:1342", "titel": "Framtidens e-sport", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021381", "typ": "mot", "label": "Motion 2024/25:1381", "titel": "Överskuldsättning", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HC021395", "typ": "mot", "label": "Motion 2024/25:1395", "titel": "Jordbruk - ökad konkurrenskraft utan