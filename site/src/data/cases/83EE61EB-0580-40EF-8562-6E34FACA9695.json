e": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "Partiprogrammet stödjer att barn ska ha rätt till eget ombud, men frågan drivs inom den pågående socialtjänstlagsreformen. Partiet stödjer utskottets avslag framför en oppositionsreservation.", "citations": [{"document": "partiprogram", "quote": "När en hel familj behöver socialtjänstens stöd ska barn ha rätt till ett eget ombud.", "princip": "barns eget ombud"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["dokument stödjer sakinnehållet men pågående reform/regeringslinje ger Ja"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Moderaterna reformerar barn- och ungdomsvården genom regeringen, bl.a. utökad LVU och stärkt föräldraansvar. Utskottet avslår MP-, SD- och S-motioner med hänvisning till pågående arbete. M stödjer utskottet. Ja.", "citations": [{"document": "valmanifest", "quote": "Säkerställa att fler omhändertas enligt LVU", "princip": "stärkt LVU"}, {"document": "valmanifest", "quote": "Betona och förstärka föräldraansvaret", "princip": "stärkt föräldraansvar"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["regeringslinje"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "high", "coverage": "explicit", "motivering": "MP vill stärka barns rättstrygghet inom socialtjänsten. Utskottet avslår motionerna, inklusive MP:s egen (Ulrika Westerlund); reservation 22 driver stärkt stöd och ombud till barn. MP röstar Nej.", "citations": [{"document": "partiprogram", "quote": "Barnets rättstrygghet måste stärkas", "princip": "stärk barns rättstrygghet"}, {"document": "valmanifest", "quote": "skydda barn från att tvingas till umgänge med en våldsam förälder", "princip": "barnets bästa"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "S vill stärka socialtjänsten och barns rättigheter enligt barnkonventionen, och har egen motion om ombud och stödperson till barn. Den egna linjen (reservationen) bör stödjas framför avslag.", "citations": [{"document": "valmanifest", "quote": "Att socialtjänsten stärks är centralt för att fånga upp unga i tid.", "princip": "barns rätt och stöd"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens partihärkomst oklar"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Motionerna (MP, SD, S) rör ombud och stödperson för barn inom socialtjänsten. SD vill stärka förebyggande insatser och rättssäkerheten, men frågorna hanteras via regeringens pågående arbete och SD stödjer utskottets avslag. Rösten blir Ja.", "citations": [{"document": "valmanifest", "quote": "Att socialtjänstens förebyggande insatser ska öka för att tidigt fånga upp ungdomar på glid", "princip": "förebyggande socialtjänst"}, {"document": "valmanifest", "quote": "Öka kvalité och rättssäkerhet i utredningar om barn", "princip": "rättssäkra barnutredningar"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["SD-motion avslås"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "Vänsterpartiet sätter barnets bästa främst och vill stärka utsatta barns rättigheter och stöd inom socialtjänsten. Reservationen driver på för ombud och stödperson till placerade barn. Rösten blir Nej till avslaget.", "citations": [{"document": "partiprogram", "quote": "Vänsterpartiets politik ska utformas så att barnens bästa kommer i första rummet.", "princip": "barnets bästa"}, {"document": "budgetmotion", "quote": "Vänsterpartiet anser att socialtjänsten ska ha de resurser som krävs för att fullgöra