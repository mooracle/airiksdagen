, "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC0210", "typ": "mot", "label": "Motion 2024/25:10", "titel": "Försök inom medicinsk forskning", "undertitel": "av Josef Fransson (SD)"}, {"dok_id": "HC021007", "typ": "mot", "label": "Motion 2024/25:1007", "titel": "Flytt av Rymdstyrelsen till Västsverige", "undertitel": "av Rickard Nordin (C)"}, {"dok_id": "HC021096", "typ": "mot", "label": "Motion 2024/25:1096", "titel": "Stöd till forskningen om traumabehandling för sexualbrottsutsatta", "undertitel": "av Marléne Lund Kopparklint och Jan Ericson (båda M)"}, {"dok_id": "HC021103", "typ": "mot", "label": "Motion 2024/25:1103", "titel": "Bättre villkor för den forskande life science-industrin i Sverige", "undertitel": "av Helena Storckenfeldt och Gustaf Göthberg (båda M)"}, {"dok_id": "HC021313", "typ": "mot", "label": "Motion 2024/25:1313", "titel": "Minskande av PFAS i vår närmiljö", "undertitel": "av Katarina Luhr m.fl. (MP)"}, {"dok_id": "HC021360", "typ": "mot", "label": "Motion 2024/25:1360", "titel": "En kvalitativ cancervård i framkant", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021362", "typ": "mot", "label": "Motion 2024/25:1362", "titel": "En stärkt psykisk hälsa i hela landet", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021366", "typ": "mot", "label": "Motion 2024/25:1366", "titel": "Socialtjänsten", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021369", "typ": "mot", "label": "Motion 2024/25:1369", "titel": "Svenskt fiske och vattenbruk", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021372", "typ": "mot", "label": "Motion 2024/25:1372", "titel": "Marina miljöer och vattenvård", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021382", "typ": "mot", "label": "Motion 2024/25:1382", "titel": "Vattenförsörjning och vattenhantering", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HC021397", "typ": "mot", "label": "Motion 2024/25:1397", "titel": "Djurskydd", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021403", "typ": "mot", "label": "Motion 2024/25:1403", "titel": "En human sjukförsäkring med individen i centrum", "undertitel": "av Clara Aranda m.fl. (SD)"}, {"dok_id": "HC021412", "typ": "mot", "label": "Motion 2024/25:1412", "titel": "Jämställdhet och diskriminering", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021421", "typ": "mot", "label": "Motion 2024/25:1421", "titel": "Nationella minoriteter och urfolk i Sverige", "undertitel": "av Michael Rubbestad m.fl. (SD)"}, {"dok_id": "HC021436", "typ": "mot", "label": "Motion 2024/25:1436", "titel": "Rymdstrategi", "undertitel": "av Aron Emilsson m.fl. (SD)"}, {"dok_id": "HC021443", "typ": "mot", "label": "Motion 2024/25:1443", "titel": "Kvalitet och frihet för en högskola i världsklass", "undertitel": "av Patrick Reslow m.fl. (SD)"}, {"dok_id": "HC021445", "typ": "mot", "label": "Motion 2024/25:1445", "titel": "Forskning i världsklass", "undertitel": "av Patrick Reslow m.fl. (SD)"}, {"dok_id": "HC021451", "typ": "mot", "label": "Motion 2024/25:1451", "titel": "Svensk innovationskraft och immaterialrätt", "undertitel": "av Tobias Andersson m.fl. (SD)"}, {"dok_id": "HC021452", "typ": "mot", "label": "Motion 2024/25:1452", "titel": "Stärkande av life science-sektorn inom näringslivet", "undertitel": "av Tobias Andersson m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01UbU15.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01UbU15.html", "votering_url": "https://data.riksdagen.se/votering/1CE6B17E-A7E1-458C-8EC8-88BAE9463AD1/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01UbU15/", "meta": {"type": "motion", "policy_area": "education", "subject": {"sv": "Ett särskilt forskningspolitiskt delmål om jämställdhet", "en": "A dedicated research-policy sub-goal on gender equality"}, "at_stake": {"sv": "Om det särskilda delmålet tas bort minskar den specifika uppföljningen av jämställdhet inom forskning och högre utbildning, vilket kan påverka hur snabbt kvarstående skillnader mellan kvinnor och män åtgärdas. Berör forskare, lärosäten och Vetenskapsrådets fördelning av forskningsmedel.", "en": "If the dedicated sub-goal is removed, specific follow-up on gender equality in research and higher education is reduced, which can affect how quickly remaining differences between women and men are addressed. It affects researchers, institutions and the Swedish Research Council's distribution of research funding."}, "subtopics": ["jämställdhet", "forskningspolitik", "högskolelagen", "forskningsfinansiering", "delmål"], "parties_involved": ["S", "V", "C", "MP"], "decision": {"sv": "Frågan gäller om ett särskilt forskningspolitiskt delmål om ökad jämställdhet bör finnas kvar, eller om jämställdhet i högre utbildning och forskning i tillräcklig grad säkerställs genom befintlig reglering och myndighetsuppdrag.", "en": "The question is whether a dedicated research-policy sub-goal on increasing gender equality should be retained, or whether gender equality in higher education and research is sufficiently ensured through existing regulation and agency mandates."}, "ja": {"sv": "Utskottet påminner om att högskolor och universitet enligt högskolelagen alltid ska iaktta och främja jämställdhet, och att Vetenskapsrådet enligt sin instruktion ska integrera ett jämställdhetsperspektiv och främja jämställdhet vid fördelning av forskningsmedel. Utskottet anser därmed att frågan redan är tillgodosedd och avslår motionerna om ett fortsatt särskilt delmål.", "en": "The committee notes that under the Higher Education Act, universities and colleges must always observe and promote gender equality, and that the Swedish Research Council, under its instruction, must integrate a gender-equality perspective and promote equality when distributing research funding. The committee therefore considers the matter already addressed and rejects the motions calling for a continued dedicated sub-goal."}, "nej": [{"alt_id": "res-7", "sv": "Reservanten anser att jämställdheten i högre utbildning och forskning fortsatt har stora brister och att det forskningspolitiska delmålet om ökad jämställdhet därför bör gälla även framöver för att möta samhällsutmaningar och främja forskning i världsklass.", "en": "The reservation holds that significant gaps in gender equality in higher education and research remain, and that the research-policy sub-goal on increasing equality should therefore continue, in order to meet societal challenges and promote world-class research."}]}}