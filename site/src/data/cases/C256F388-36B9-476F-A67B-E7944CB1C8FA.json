, "references": [{"dok_id": "HB021007", "typ": "mot", "label": "Motion 2023/24:1007", "titel": "Differentiering av skolpengen", "undertitel": "av Gunilla Carlsson och Dzenan Cisija (båda S)"}, {"dok_id": "HB021027", "typ": "mot", "label": "Motion 2023/24:1027", "titel": "Kommunal vetorätt vid friskoleetableringar", "undertitel": "av Adrian Magnusson (S)"}, {"dok_id": "HB021046", "typ": "mot", "label": "Motion 2023/24:1046", "titel": "Vinststopp i skolan", "undertitel": "av Azra Muranovic m.fl. (S)"}, {"dok_id": "HB021049", "typ": "mot", "label": "Motion 2023/24:1049", "titel": "Pornografins skadeverkningar", "undertitel": "av Roland Utbult (KD)"}, {"dok_id": "HB021066", "typ": "mot", "label": "Motion 2023/24:1066", "titel": "Friskolors etableringsrätt", "undertitel": "av Tomas Eneroth (S)"}, {"dok_id": "HB021073", "typ": "mot", "label": "Motion 2023/24:1073", "titel": "Förbud mot religiösa friskolor", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HB021229", "typ": "mot", "label": "Motion 2023/24:1229", "titel": "Pedagogiska tjänster samt fjärrundervisning", "undertitel": "av Martina Johansson (C)"}, {"dok_id": "HB021316", "typ": "mot", "label": "Motion 2023/24:1316", "titel": "Skolfrukost", "undertitel": "av Malin Larsson och Peder Björk (båda S)"}, {"dok_id": "HB021476", "typ": "mot", "label": "Motion 2023/24:1476", "titel": "Hälsosam och kvalitetssäkrad skolmat", "undertitel": "av Markus Wiechel och Alexander Christiansson (båda SD)"}, {"dok_id": "HB021493", "typ": "mot", "label": "Motion 2023/24:1493", "titel": "Spetskompetens inom tech", "undertitel": "av Adnan Dibrani och Mattias Jonsson (båda S)"}, {"dok_id": "HB021551", "typ": "mot", "label": "Motion 2023/24:1551", "titel": "Elever med skyddad identitet", "undertitel": "av Åsa Eriksson och Eva Lindh (båda S)"}, {"dok_id": "HB021573", "typ": "mot", "label": "Motion 2023/24:1573", "titel": "Allmänt fritidshem och lovverksamhet för barn", "undertitel": "av Adnan Dibrani m.fl. (S)"}, {"dok_id": "HB021575", "typ": "mot", "label": "Motion 2023/24:1575", "titel": "Avgiftsfri skola och ökad jämlikhet", "undertitel": "av Mattias Vepsä (S)"}, {"dok_id": "HB021675", "typ": "mot", "label": "Motion 2023/24:1675", "titel": "Syskonförtur i kommunala skolor", "undertitel": "av Azadeh Rojhan och Alexandra Völker (båda S)"}, {"dok_id": "HB021892", "typ": "mot", "label": "Motion 2023/24:1892", "titel": "Sveriges kristna kulturarv", "undertitel": "av Julia Kronlid och Aron Emilsson (båda SD)"}, {"dok_id": "HB021896", "typ": "mot", "label": "Motion 2023/24:1896", "titel": "En helt avgiftsfri skola", "undertitel": "av Yasmine Bladelius (S)"}, {"dok_id": "HB021931", "typ": "mot", "label": "Motion 2023/24:1931", "titel": "Avgiftsfri skollunch på gymnasiet", "undertitel": "av Amalia Rud Pedersen och Dzenan Cisija (båda S)"}, {"dok_id": "HB021946", "typ": "mot", "label": "Motion 2023/24:1946", "titel": "Gratis skolfrukost", "undertitel": "av Yasmine Bladelius (S)"}, {"dok_id": "HB021985", "typ": "mot", "label": "Motion 2023/24:1985", "titel": "Skolskjuts till och från fritis för barn inom anpassad skola", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB022050", "typ": "mot", "label": "Motion 2023/24:2050", "titel": "Avskaffande av marknadsskolan", "undertitel": "av Kristoffer Lindberg m.fl. (S)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01UbU9.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01UbU9.html", "votering_url": "https://data.riksdagen.se/votering/C256F388-36B9-476F-A67B-E7944CB1C8FA/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01UbU9/", "meta": {"type": "motion", "policy_area": "education", "subject": {"sv": "Jämlik och likvärdig skola: läsårets längd och kartläggning av klasstorlekar", "en": "Equal and equitable schooling: length of the school year and mapping of class sizes"}, "at_stake": {"sv": "Beslutet påverkar om elever som halkar efter under det långa sommarlovet, särskilt de med bristande läsförmåga eller språkkunskaper, ska få särskild uppmärksamhet genom ett förändrat läsår, samt om mindre klasser – som i studier kopplats till bättre resultat och högre framtida inkomster – ska utredas som ett verktyg för en tryggare och mer likvärdig skola.", "en": "The decision affects whether pupils who fall behind during the long summer break, particularly those with weaker reading skills or language knowledge, should receive special attention through a changed school year, and whether smaller classes – linked in studies to better results and higher future incomes – should be investigated as a tool for a safer and more equitable school."}, "subtopics": ["likvärdighet", "läsår", "sommarlov", "klasstorlek", "skolresultat"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om staten aktivt ska verka för en jämlikare skola genom att ge Skolverket i uppdrag att se över läsårets längd och kartlägga klasstorlekar i grundskolan, eller om nuvarande system utan sådana uppdrag är tillräckligt för att säkerställa en likvärdig utbildning.", "en": "The question is whether the state should actively work towards a more equal school by tasking the National Agency for Education with reviewing the length of the school year and mapping class sizes in compulsory school, or whether the current system without such assignments is sufficient to ensure equitable education."}, "ja": {"sv": "Utskottet hänvisar till skollagens krav på att alla elever ska få den ledning och stimulans de behöver utifrån sina egna förutsättningar, och till läroplanernas skrivningar om att en likvärdig utbildning inte innebär att undervisningen ska se likadan ut överallt eller att resurserna ska fördelas lika. När det gäller klasstorlekars betydelse konstaterar utskottet att det inte finns någon reglering av detta och ser inga skäl att föreslå någon åtgärd i frågan.", "en": "The committee refers to the requirements in the Education Act that all pupils should receive the guidance and stimulation they need based on their own circumstances, and to wording in the curricula stating that equitable education does not mean teaching must look the same everywhere or that resources must be distributed equally. Regarding the significance of class size, the committee notes that there is no regulation on this and sees no reason to propose any action on the matter."}, "nej": [{"alt_id": "res-3", "sv": "Reservationen (C) vill se ett långsiktigt arbete för att förändra läsåret i grundskolan, eftersom Sverige har minst antal skoldagar i Norden och tre veckor längre sommarlov än till exempel Danmark – vilket enligt studier gör att elever, särskilt de med svag läsförmåga eller bristande språkkunskaper, tappar kunskaper. Skolverket bör få i uppdrag att utreda hur läsåret kan förändras, stegvis med hänsyn till lärarbristen. Reservationen vill också att Skolverket kartlägger klasstorlekar i grundskolan, eftersom studier visar att mindre klasser ger bättre resultat och en tryggare miljö.", "en": "The reservation (C) wants long-term work to change the school year in compulsory school, since Sweden has the fewest school days in the Nordics and a summer break three weeks longer than, for example, Denmark – which studies show causes pupils, especially those with weak reading skills or limited language knowledge, to lose learning. The National Agency for Education should be tasked with investigating how the school year could be changed, gradually given the teacher shortage. The reservation also wants the agency to map class sizes in compulsory school, since studies show smaller classes produce better results and a safer environment."}]}}