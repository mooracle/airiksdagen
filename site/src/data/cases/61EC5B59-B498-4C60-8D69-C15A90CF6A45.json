rride": null}, "KD": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "Dokumenten tar inte upp bilpooler specifikt men KD värnar tillgången till bil och generella medel framför riktade motionsförslag. C-, SD- och MP-motionerna avslås inom pågående arbete. Därför Ja.", "citations": [{"document": "valmanifest", "quote": "Vi ser den som bor utanför storstäderna och är beroende av sin bil.", "princip": "värna tillgång till bil"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["svag_dokumentgrund", "bilpooler_ej_i_dokumenten"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "Liberalerna för en teknikneutral transportpolitik där alla transportslag bär sina klimatkostnader, utan att särskilt lyfta fram bilpooler. Motionerna (C/SD/MP) avslås och partiet stödjer utskottsförslaget. Alltså Ja.", "citations": [{"document": "partiprogram", "quote": "alla transportslag måste stå för sina klimatkostnader.", "princip": "teknikneutral transportpolitik"}, {"document": "tidoavtalet", "quote": "strävar efter att hitta de mest kostnadseffektiva åtgärderna", "princip": "kostnadseffektivitet"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["Svag dokumenttäckning för just bilpooler"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "Frågan om bilpooler behandlas inte särskilt i Moderaternas dokument; partiets linje är marknadslösningar och inga nya skatter eller pålagor. Utskottet avslår motionerna med hänvisning till pågående arbete.", "citations": [{"document": "valmanifest", "quote": "Införa ett skattehöjarstopp under den kommande mandatperioden som innebär att de samlade skatterna inte höjs", "princip": "inga nya pålagor"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["governing-party-committee-line", "topic-not-in-documents"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "high", "coverage": "explicit", "motivering": "MP vill kraftigt sänka momsen på bilpooler och andra delningstjänster och underlätta att dela i stället för att äga bil; partiet har eget yrkande i ärendet. Att rösta Nej stödjer bilpooler.", "citations": [{"document": "valmanifest", "quote": "sänka momsen kraftigt på bilpooler och andra delningstjänster", "princip": "gynna bilpooler"}, {"document": "valmanifest", "quote": "Vi vill skapa en delningsekonomi", "princip": "delningsekonomi"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Ja", "confidence": "low", "coverage": "not_covered", "motivering": "Bilpooler tas inte upp i dokumenten. Utifrån pågående arbete och att frågan är perifer bör partiet stödja utskottet och avslå motförslaget.", "citations": [{"document": "valmanifest", "quote": "Det klimatpolitiska ramverket ska ligga fast.", "princip": "klimatramverk"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["ej täckt"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Ärendet gäller bilpooler där utskottet hänvisar till pågående arbete. SD anser att omställningen ska ske på marknadens villkor och prioriterar bilberoendes villkor snarare än styrande subventioner. Som samarbetsparti stöder SD utskottets avslag (Ja).", "citations": [{"document": "valmanifest", "quote": "En omställning av fordonsflottan behöver både av ekonomiska och ekologiska skäl få ta tid, och ske utifrån marknadens villkor.", "princip": "marknadens villkor"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationsagande-oklart"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering"