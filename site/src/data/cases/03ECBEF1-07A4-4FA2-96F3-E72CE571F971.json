ull}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "L vill begränsa industrifisket och gynna kustnära fiske, men fiskeripolitiken drivs i pågående arbete. Utskottet avslår oppositionens motioner om utflyttad trålgräns; L röstar Ja med utskottet.", "citations": [{"document": "partiprogram", "quote": "Regelverket ska gynna småskaligt och kustnära fiske", "princip": "kustnära fiske"}, {"document": "valmanifest", "quote": "industrifisket ska begränsas", "princip": "begränsat industrifiske"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["fiske-spänning: L vill begränsa trålfiske men avslår oppositionens motioner till förmån för pågående arbete"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "Voteringen avslår motioner om utflyttning av trålgränsen. Moderaterna vill själva flytta trålfiskegränsen från fyra till tolv nautiska mil och driver frågan genom regeringen, varför ytterligare bindande motioner avvisas. Utskottets avslag stöds, Ja.", "citations": [{"document": "valmanifest", "quote": "Stävja minskningen av sill-/strömmingsbestånden i Östersjön genom att flytta gränsen för trålfiske från fyra till tolv nautiska mil", "princip": "utflyttad trålgräns"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["mål_bereds_via_regeringen"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "high", "coverage": "explicit", "motivering": "MP lämnade egen motion (Bolund yrk 35) och vill omgående flytta ut trålgränsen till 12 nautiska mil. Partiet stödjer därför reservationen mot avslaget.", "citations": [{"document": "budgetmotion", "quote": "Trålgränsen för fisket måste omgående flyttas ut till 12", "princip": "utflyttad trålgräns"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "Punkten om utflyttning av trålgränsen drivs av C/SD/MP utan egen S-motion. S vill skydda biologisk mångfald men driver fiskefrågan via sin egen linje, inte dessa reservationer; står bakom utskottets avslag. Därför Ja.", "citations": [{"document": "partiprogram", "quote": "biologiska mångfalden måste skyddas.", "princip": "skydd av fiskbestånd"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["avslag_pa_annat_partis_motion"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "Ärendet gäller att flytta ut trålgränsen, där SD (Kinnunen, Wiechel) motionerat. SD vill prioritera havs- och vattenmiljön framför ett alltför intensivt fiske, vilket talar för att stödja reservationen framför utskottets avslag.", "citations": [{"document": "valmanifest", "quote": "Vår havs- och vattenmiljö måste prioriteras tydligare framför ett allt för intensivt fiske", "princip": "havsmiljö före intensivt fiske"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens partitillhörighet antagen SD"], "model": "claude-opus-4-8", "en": null, "program_override": "loose"}, "V": {"rost": "Nej", "confidence": "medium", "coverage": "inferred", "motivering": "V vill skydda den biologiska mångfalden och motverka överutnyttjande av naturresurser. Att flytta ut trålgränsen skyddar kustnära bestånd, vilket V bör stödja. Nej.", "citations": [{"document": "valmanifest", "quote": "Ett ständigt överutnyttjande av naturens resurser leder till kraftig utarmning av den biologiska mångfalden och växthusgasutsläpp.", "princip": "skydda marina bestånd"}, {"document": "budgetmotion", "quote": "En fungerande natur med rik biologisk mångfald och ett ekosystem i balans är grunden för liv på jorden och framtida välfärd.", "princip": "ekosystem i balans"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], 