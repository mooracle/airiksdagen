"SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021036", "typ": "mot", "label": "Motion 2025/26:1036", "titel": "Risker med Tiktok och kinesiskt statligt inflytande", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HD021231", "typ": "mot", "label": "Motion 2025/26:1231", "titel": "Begränsning av ungas tillgång till digital nätporr", "undertitel": "av Åsa Eriksson och Eva Lindh (båda S)"}, {"dok_id": "HD021310", "typ": "mot", "label": "Motion 2025/26:1310", "titel": "EU-standard för frivillig \"verified human\"-märkning på digitala plattformar", "undertitel": "av Dzenan Cisija (S)"}, {"dok_id": "HD021313", "typ": "mot", "label": "Motion 2025/26:1313", "titel": "Centrum för undersökande journalistik", "undertitel": "av Per-Arne Håkansson (S)"}, {"dok_id": "HD021413", "typ": "mot", "label": "Motion 2025/26:1413", "titel": "Begränsning av personuppgifter i digitala söktjänster", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD021433", "typ": "mot", "label": "Motion 2025/26:1433", "titel": "Sociala medier-plattformar och grundläggande demokratiska villkor", "undertitel": "av Markus Selin (S)"}, {"dok_id": "HD021434", "typ": "mot", "label": "Motion 2025/26:1434", "titel": "Störande ljudnivåer vid reklamavbrott i radio och tv", "undertitel": "av Markus Selin (S)"}, {"dok_id": "HD021435", "typ": "mot", "label": "Motion 2025/26:1435", "titel": "Anonyma konton på sociala medier", "undertitel": "av Markus Selin (S)"}, {"dok_id": "HD021501", "typ": "mot", "label": "Motion 2025/26:1501", "titel": "Åtgärder mot populism, desinformation och mediekoncentration för att stärka demokratin", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HD021558", "typ": "mot", "label": "Motion 2025/26:1558", "titel": "Skydd av personuppgifter", "undertitel": "av Yusuf Aydin (KD)"}, {"dok_id": "HD02219", "typ": "mot", "label": "Motion 2025/26:219", "titel": "Avskaffande av svenskt presstöd", "undertitel": "av Elsa Widding (-)"}, {"dok_id": "HD022624", "typ": "mot", "label": "Motion 2025/26:2624", "titel": "Stärkt arbete för att motverka spridning av våldsam pornografi - ett digitalt barnskydd", "undertitel": "av Helena Vilhelmsson (C)"}, {"dok_id": "HD022747", "typ": "mot", "label": "Motion 2025/26:2747", "titel": "Mäns våld mot kvinnor", "undertitel": "av Annika Strandhäll (S)"}, {"dok_id": "HD022790", "typ": "mot", "label": "Motion 2025/26:2790", "titel": "Konstitutionella frågor", "undertitel": "av Jessica Wetterling m.fl. (V)"}, {"dok_id": "HD022900", "typ": "mot", "label": "Motion 2025/26:2900", "titel": "Förstärkt skydd för enskilda individer", "undertitel": "av Lars Beckman (M)"}, {"dok_id": "HD022991", "typ": "mot", "label": "Motion 2025/26:2991", "titel": "Stärkta krav på åldersverifiering för porrsajter", "undertitel": "av Marléne Lund Kopparklint m.fl. (M)"}, {"dok_id": "HD023183", "typ": "mot", "label": "Motion 2025/26:3183", "titel": "Kultur, civilsamhälle och medier", "undertitel": "av Catarina Deremar m.fl. (C)"}, {"dok_id": "HD02323", "typ": "mot", "label": "Motion 2025/26:323", "titel": "En politik för studenter", "undertitel": "av Nadja Awad m.fl. (V)"}, {"dok_id": "HD023238", "typ": "mot", "label": "Motion 2025/26:3238", "titel": "Tryggare digital uppväxtmiljö - barns rättigheter online", "undertitel": "av Marléne Lund Kopparklint m.fl. (M)"}, {"dok_id": "HD023405", "typ": "mot", "label": "Motion 2025/26:3405", "titel": "Ökad civil försvarsförmåga och stärkt krisberedskap", "undertitel": "av Emma Berginger m.fl. (MP)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01KU18.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01KU18.html", "votering_url": "https://data.riksdagen.se/votering/AAA9F2C6-AB08-494D-8BCE-AD1E45AD1514/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01KU18/", "meta": {"type": "motion", "policy_area": "constitution", "subject": {"sv": "Grundlagsskydd för sökbara personuppgifter", "en": "Constitutional protection for searchable personal data"}, "at_stake": {"sv": "Vissa webbplatser publicerar känsliga personuppgifter om enskilda och är skyddade av grundlag genom utgivningsbevis, vilket gjort att uppgifterna kunnat användas av kriminella för att kartlägga individer. Frågan gäller hur avvägningen mellan personlig integritet och yttrandefrihet ska regleras och hur snabbt lagstiftningen ska ändras.", "en": "Certain websites publish sensitive personal data about individuals and are constitutionally protected through a certificate of publication, which has allowed the data to be used by criminals to track individuals. The question is how the balance between personal privacy and freedom of expression should be regulated and how quickly the legislation should be changed."}, "subtopics": ["personlig integritet", "grundlagsskydd", "söktjänster", "yttrandefrihet", "dataskydd", "EU"], "parties_involved": ["S", "V", "MP"], "decision": {"sv": "Reservanterna (S, V, MP) ville att regeringen skyndsamt lagstiftar för att begränsa grundlagsskyddet för söktjänster som gör känsliga personuppgifter sökbara, medan utskottet ansåg att frågan bäst avvaktar pågående utredningar, en rättsprövning i EU-domstolen och tillsyn hos Integritetsskyddsmyndigheten.", "en": "The reserving parties (S, V, MP) wanted the government to swiftly legislate to narrow the constitutional protection for search services that make sensitive personal data searchable, while the committee held that the matter should await ongoing inquiries, a legal case before the EU Court of Justice, and supervision by the Swedish Authority for Privacy Protection."}, "ja": {"sv": "Utskottet anser att det finns behov av ändringar för att uppnå ett ändamålsenligt integritetsskydd, men pekar på en nyligen avslutad utredning om grundlagsskyddet för söktjänster, en pågående utredning om bakgrundskontroller, en rättslig prövning i EU-domstolen och tillsyn hos Integritetsskyddsmyndigheten, och avstyrker därför motionerna i väntan på detta.", "en": "The committee believes there is a need for changes to achieve adequate privacy protection, but points to a recently completed inquiry into the constitutional protection of search services, an ongoing inquiry into background checks, a legal case pending before the EU Court of Justice, and supervision by the Swedish Authority for Privacy Protection, and therefore rejects the motions pending these processes."}, "nej": [{"alt_id": "res-4", "sv": "Reservanterna (S, V, MP) menar att söktjänster som publicerar känsliga personuppgifter i kommersiellt syfte utgör allvarliga integritetsintrång och har utnyttjats i kriminella syften, att Sverige fått EU-kritik för detta, och att regeringen skyndsamt bör vidta lagstiftningsåtgärder för att reglera avvägningen mellan personlig integritet och yttrandefrihet, i stället för att invänta ytterligare utredning.", "en": "The reserving parties (S, V, MP) argue that search services that publish sensitive personal data for commercial purposes constitute serious privacy violations and have been exploited for criminal purposes, that Sweden has faced EU criticism over this, and that the government should swiftly take legislative action to regulate the balance between personal privacy and freedom of expression, rather than waiting for further inquiry."}]}}