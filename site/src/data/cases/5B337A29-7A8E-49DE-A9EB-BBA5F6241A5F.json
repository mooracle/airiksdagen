ering_url": "https://data.riksdagen.se/votering/5B337A29-7A8E-49DE-A9EB-BBA5F6241A5F/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01FiU26/", "meta": {"type": "motion", "policy_area": "finance", "subject": {"sv": "Det kommunalekonomiska utjämningssystemet och riktade statsbidrag för kommuner och regioner.", "en": "The municipal economic equalization system and targeted grants to municipalities and regions."}, "at_stake": {"sv": "Systemet för hur staten fördelar ekonomiska medel till kommuner påverkar möjligheterna för välfärdstjänster överallt i landet. Utjämningssystemets utformning avgör fördelningen mellan rika och fattiga kommuner och thereby möjligheten till jämlik välfärd.", "en": "The system for distributing state funds to municipalities affects the ability to provide welfare services throughout the country. The design of the equalization system determines the distribution between wealthy and disadvantaged municipalities and thus the possibility of equal welfare."}, "subtopics": ["kommunekonomi", "statsbidrag", "välfärd", "jämlikhet", "utjämning"], "parties_involved": ["C"]}}