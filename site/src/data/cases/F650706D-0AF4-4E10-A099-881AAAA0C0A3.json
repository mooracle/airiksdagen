 "motivering": "Centerpartiet prioriterar att främja företagande och minska regelbördan och är småföretagens främsta röst. En reservation för mer företagsfrämjande åtgärder ligger i linje med detta. Därför Nej.", "citations": [{"document": "valmanifest", "quote": "Därför kommer Centerpartiet alltid att vara småföretagens bästa vän i svensk politik.", "princip": "företagsfrämjande"}, {"document": "budgetmotion", "quote": "Att minska regelbördan för det svenska näringslivet är prioriterat för Centerpartiet.", "princip": "minskad regelbörda"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["blandade motionärer (bl.a. V); reservationens riktning osäker"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "KD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "KD vill sänka företagens administrativa kostnader och driver företagsfrämjande med generella medel. SD-, V-, M- och MP-motioner om särskilda åtgärder avslås inom pågående arbete. Därför Ja till utskottets avslag.", "citations": [{"document": "tidoavtalet", "quote": "Lägre administrativa kostnader för företagen.", "princip": "lägre regelbörda"}, {"document": "partiprogram", "quote": "Direkta företagssubventioner avvisas.", "princip": "generella medel"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Liberalerna vill stärka företagandet genom generella villkor och lägre kostnader, inte genom riktade särinsatser. Motionerna (SD/V/M/MP) om företagsfrämjande avslås därför och partiet stödjer utskottsförslaget samt det pågående arbetet. Alltså Ja.", "citations": [{"document": "partiprogram", "quote": "Det offentliga ska endast driva affärsverksamhet om det finns ett starkt samhällsintresse.", "princip": "generella villkor framför särstöd"}, {"document": "valmanifest", "quote": "Därför vill vi att det ska bli enklare och billigare att anställa genom att arbetsgivaravgifterna sänks för både småföretagare och för dem som vill anställa unga.", "princip": "lägre företagarkostnader"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Moderaterna främjar företagande genom mindre regelkrångel och lägre administrationskostnader, vilket drivs via regeringen. Utskottet avslår motionerna med hänvisning till pågående arbete.", "citations": [{"document": "valmanifest", "quote": "Ta bort en tredjedel av företagens administrationskostnader och en tredjedel av regelkrånglet", "princip": "minska regelkrångel"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["governing-party-committee-line"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "MP vill stötta små och hållbara företag, bland annat genom ett särskilt småföretagaravdrag, och har eget yrkande i ärendet. Att rösta Nej stödjer företagsfrämjande åtgärder i linje med dokumenten.", "citations": [{"document": "budgetmotion", "quote": "stötta Sveriges småföretagare genom ett särskilt avdrag", "princip": "stöd till småföretag"}, {"document": "partiprogram", "quote": "Steget från idé och innovation till prototyp", "princip": "främja företagande"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens exakta lydelse okänd"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Ja", "confidence": "low", "coverage": "not_covered", "motivering": "De blandade motionerna om företagsfrämjande tas inte upp specifikt i dokumenten. Utifrån närmast liggande princip och pågående arbete bör partiet avslå motförslaget.", "citations": [{"document": "valmanifest", "quote": "Vi vill satsa på grön teknik, digitalisering och utbildning", "princip": "företagsklimat"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["ej täckt"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Ärendet gäller företagsfrämjande åtgärder där utskottet hänvisar till pågående arbete. SD vill förenkla regler och avlasta småföretagens börda, vilket drivs via samarbetet. Som samarbetsparti stöder SD utskottets avslag (Ja).", "citations": [{"document": "valmanifest", "quote": "Verka för regelförenkling och avlasta småföretagens administrativa börda", "princip": "regelförenkling företag"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationsagande-oklart"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "Vänsterpartiet har egen motion (Delgado Varas) på området och betonar småföretagares villkor i konkurrens med storbolag samt löntagarnas ställning. En reservation i partiets riktning stöds framför avslaget. Därför Nej.", "citations": [{"document": "valmanifest", "quote": "Du som arbetar hårt inom ditt eget småföretag, i konkurrens med storbolag.", "princip": "småföretag mot storbolag"}, {"document": "valmanifest", "quote": "vill Vänsterpartiet ge löntagare och samhällskooperativ laglig rätt och offentligt finansiellt stöd att ta över verksamheter", "princip": "löntagarmakt"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens innehåll osäkert"], "model": "claude-opus-4-8", "en": null, "program_override": null}}, "probe": null, "seats": [["V", "Avstår", "Ali Esbati", "Stockholms kommun"], ["V", "Avstår", "Andrea Andersson Tay", "Stockholms län"], ["V", "Avstår", "Birger Lahti", "Norrbottens län"], ["V", "Avstår", "Ciczie Weidby", "Jönköpings län"], ["V", "Avstår", "Daniel Riazat", "Stockholms län"], ["V", "Avstår", "Frida Tånghag", "Göteborgs kommun"], ["V", "Avstår", "Gu