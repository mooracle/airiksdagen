ra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Frånvarande", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021083", "typ": "mot", "label": "Motion 2025/26:1083", "titel": "Ökad samhällskontroll av välfärden", "undertitel": "av Markus Kauppinen m.fl. (S)"}, {"dok_id": "HD021346", "typ": "mot", "label": "Motion 2025/26:1346", "titel": "Anpassbar skolplikt med hänsyn till barn med neuropsykiatriska funktionsnedsättningar", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HD021808", "typ": "mot", "label": "Motion 2025/26:1808", "titel": "Förbud mot vinstuttag i skolan", "undertitel": "av Aida Birinxhiku m.fl. (S)"}, {"dok_id": "HD021827", "typ": "mot", "label": "Motion 2025/26:1827", "titel": "Bindande krav på lärartäthet, klasstorlek och elevhälsovård", "undertitel": "av Aylin Nouri (S)"}, {"dok_id": "HD021857", "typ": "mot", "label": "Motion 2025/26:1857", "titel": "Förberedelser av unga för en digitaliserad värld", "undertitel": "av Denis Begic (S)"}, {"dok_id": "HD021863", "typ": "mot", "label": "Motion 2025/26:1863", "titel": "Veto vid utökning och nyetablering av friskolor", "undertitel": "av Kristoffer Lindberg m.fl. (S)"}, {"dok_id": "HD021905", "typ": "mot", "label": "Motion 2025/26:1905", "titel": "Skolskjuts till och från fritis för barn inom anpassad skola", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HD022171", "typ": "mot", "label": "Motion 2025/26:2171", "titel": "Regelverk för distansstudier i grundskolan", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022294", "typ": "mot", "label": "Motion 2025/26:2294", "titel": "Avgiftsfri skolfrukost i landets skolor", "undertitel": "av Linnéa Wickman m.fl. (S)"}, {"dok_id": "HD022337", "typ": "mot", "label": "Motion 2025/26:2337", "titel": "Stärkt rätt till skolskjuts till och från fritidshemmet för barn inom anpassad skola", "undertitel": "av Louise Thunström (S)"}, {"dok_id": "HD022455", "typ": "mot", "label": "Motion 2025/26:2455", "titel": "Skolplikt till 18 års ålder", "undertitel": "av Sofia Skönnbrink och Amalia Rud Stenlöf (båda S)"}, {"dok_id": "HD022456", "typ": "mot", "label": "Motion 2025/26:2456", "titel": "Etablering av fristående skolor", "undertitel": "av Sofia Skönnbrink m.fl. (S)"}, {"dok_id": "HD022472", "typ": "mot", "label": "Motion 2025/26:2472", "titel": "Förtydligande av begreppet inre organisation i skollagen", "undertitel": "av Charlotte Nordström (M)"}, {"dok_id": "HD022599", "typ": "mot", "label": "Motion 2025/26:2599", "titel": "Rätt till skolskjuts vid funktionsnedsättning eller allvarlig sjukdom", "undertitel": "av Mattias Eriksson Falk m.fl. (SD)"}, {"dok_id": "HD022660", "typ": "mot", "label": "Motion 2025/26:2660", "titel": "Ett modernt läsår med tre terminer", "undertitel": "av Louise Eklund (L)"}, {"dok_id": "HD022725", "typ": "mot", "label": "Motion 2025/26:2725", "titel": "Hälsosam och kvalitetssäkrad skolmat", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022736", "typ": "mot", "label": "Motion 2025/26:2736", "titel": "Förstärkt skolplikt", "undertitel": "av Lawen Redar (S)"}, {"dok_id": "HD022746", "typ": "mot", "label": "Motion 2025/26:2746", "titel": "Avgiftsbefriad och mer tillgänglig grundskola", "undertitel": "av Jonathan Svensson (S)"}, {"dok_id": "HD022787", "typ": "mot", "label": "Motion 2025/26:2787", "titel": "En politik för urfolket samer", "undertitel": "av Jessica Wetterling m.fl. (V)"}, {"dok_id": "HD022791", "typ": "mot", "label": "Motion 2025/26:2791", "titel": "En jämlik förskola, skola och vuxenutbildning för alla", "undertitel": "av Isabell Mixter m.fl. (V)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01UbU7.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01UbU7.html", "votering_url": "https://data.riksdagen.se/votering/5291E90E-0314-4327-AFB0-5BCA5AE79D28/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01UbU7/", "meta": {"type": "motion", "policy_area": "education", "subject": {"sv": "Statens ansvar för skolans resurser och resursfördelning", "en": "State responsibility for school funding and resource allocation"}, "at_stake": {"sv": "Beslutet påverkar hur jämnt resurser fördelas mellan skolor, särskilt små skolor och skolor i glesbygd, och om kommunerna får extra statligt stöd för att motverka att fristående skolor överkompenseras på bekostnad av den kommunala ekonomin.", "en": "The decision affects how evenly resources are distributed between schools, particularly small and rural schools, and whether municipalities receive extra state support to counter independent schools being overcompensated at the expense of municipal finances."}, "subtopics": ["skolpeng", "resursfördelning", "statligt huvudmannaskap", "friskolor", "likvärdighet", "kommuner"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om staten ska ta ett större ansvar för skolans finansiering genom bindande regler och ett nytt sektorsbidrag till kommunerna, eller om nuvarande ordning med kommunalt ansvar och pågående utredningar om skolpengssystemet ska gälla oförändrad.", "en": "The question is whether the state should take greater responsibility for school funding through binding rules and a new sector grant to municipalities, or whether the current arrangement of municipal responsibility and ongoing reviews of the school-voucher system should remain unchanged."}, "ja": {"sv": "Utskottet avvaktar den pågående beredningen av frågan om ett statligt huvudmannaskap för skolan och av delbetänkandet om ett nytt skolpengssystem, och påminner om att kommunerna redan enligt skollagen ansvarar för att fördela resurser efter elevernas behov, bland annat till små skolor och skolor i glesbygd. Utskottet avstyrker därför motionerna om ett statligt sektorsbidrag och bindande regler för lärartäthet och klasstorlek.", "en": "The committee is awaiting the ongoing review of state responsibility for schools and the interim report on a new school-voucher system, and notes that municipalities already have a statutory duty to allocate resources according to pupils' needs, including to small and rural schools. The committee therefore rejects the motions calling for a state sector grant and binding rules on teacher density and class size."}, "nej": [{"alt_id": "res-12", "sv": "Reservationen (S) anser att staten måste ta ett ökat ansvar för skolans finansiering, med bindande regler för lärartäthet, klasstorlek och elevhälsa samt ett nytt sektorsbidrag som ger kommunerna resurser att leva upp till högre krav. Skälet är att friskolor varje år överkompenseras för kostnader de inte har, vilket dränerar kommunernas ekonomi, och att varken förskolan eller gymnasieskolan omfattas av regeringens erkännande av problemet.", "en": "The reservation (S) argues that the state must take on greater responsibility for school funding, with binding rules on teacher density, class size and student health, and a new sector grant giving municipalities the resources to meet higher requirements. The reasoning is that independent schools are overcompensated for costs they do not have every year, draining municipal finances, and that neither preschool nor upper-secondary school is covered by the government's acknowledgment of the problem."}]}}