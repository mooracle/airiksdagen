id": "res-4", "text": "Reservation 4", "source_partier": ["MP"]}], "actual": {"S": {"position": "Avstår", "n_ja": 3, "n_nej": 0, "n_avstar": 88, "n_franvarande": 16, "cohesion": 0.967, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 59, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 20, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Ja", "n_ja": 61, "n_nej": 0, "n_avstar": 0, "n_franvarande": 11, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Nej", "n_ja": 0, "n_nej": 16, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": true}, "L": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "C": {"position": "Ja", "n_ja": 19, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}, "KD": {"position": "Ja", "n_ja": 16, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}}, "ai": {"C": {"rost": "Avstår", "confidence": "low", "coverage": "inferred", "motivering": "Centerpartiet prioriterar kompetensutveckling under hela livet och effektiv matchning, men driver en egen arbetsmarknadslinje som varken motsvarar utskottets avslag eller den valda S/MP-reservationen. Partiet markerar sin egen linje och avstår.", "citations": [{"document": "budgetmotion", "quote": "Därför behövs kompetensutveckling under hela livet, för att möjliggöra utveckling, omställning och trygghet.", "princip": "kompetensutveckling hela livet"}, {"document": "valmanifest", "quote": "Alla ska ha rätt till en effektiv matchningstjänst", "princip": "effektiv matchning"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationsforfattare-oviss"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "KD": {"rost": "Ja", "confidence": "high", "coverage": "inferred", "motivering": "KD som regeringsparti driver att kompetensförsörjningen ska stärkas och att fler kommer i arbete. Utskottet avslår oppositionens (MP/S) motioner med hänvisning till pågående arbete, vilket motsvarar regeringens linje. KD röstar Ja.", "citations": [{"document": "tidoavtalet", "quote": "kompetensförsörjningen ska stärkas.", "princip": "stärkt kompetensförsörjning"}, {"document": "tidoavtalet", "quote": "som kan står till arbetsmarknadens förfogande och anstränger sig för att få ett jobb", "princip": "ökat arbetsutbud"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["procedurell votering"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "high", "coverage": "explicit", "motivering": "L betonar det livslånga lärandet och att omskolning mitt i livet måste förbättras. Utskottet avslår oppositionsmotioner (MP, S) med hänvisning till pågående arbete. L backar regeringens linje och röstar Ja.", "citations": [{"document": "partiprogram", "quote": "vidareutbilda sig eller lära sig ett helt nytt yrke mitt i livet måste förbättras kraftigt.", "princip": "livslångt lärande"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["citat_blockerat"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Utskottet avslår motioner från MP och S om kompetensförsörjning och arbetsmarknadspolitik. M:s linje är en förenklad, effektivare jobbpolitik och en bidragsreform inom regeringens ram, inte oppositionens förslag. M röstar Ja till avslag.", "citations": [{"document": "tidoavtalet", "quote": "Den arbetsmarknadspolitiska insatsfloran bör förenklas, med färre, kostnadseffektiva", "princip": "effektivare jobbpolitik"}, {"document": "valmanifest", "quote": "Genomföra en stor bidragsreform för att bryta utanförskapet", "princip": "arbetslinjen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "MP vill se ett statligt finansierat kompetenslyft och kompetensutveckling för den gröna omställningen och kritiserar regeringens nedskärningar. Utskottets avslag på motionerna om kompetensförsörjning strider mot detta. MP bör stödja reservationen (Nej).", "citations": [{"document": "budgetmotion", "quote": "Ett statligt finansierat kompetenslyft riktat mot nyckelkompetenser på arbetsmarknaden", "princip": "kompetenslyft för omställning"}, {"document": "budgetmotion", "quote": "Det bekymrar oss att regeringen fortsätter att dra ner i arbetsmarknadspolitiken.", "princip": "mot nedskärningar"}], "omvarld": {"paverkar": true, "faktorer": [{"faktor": "Lågkonjunktur och stigande arbetslöshet", "effekt": "Stärker behovet av kompetenssatsningar som MP efterfrågar"}]}, "flags": ["reservationens-partihemvist-oklar"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Nej", "confidence": "high", "coverage": "explicit", "motivering": "Punkten avslår S egna yrkanden om kompetensförsörjning och kompetensutveckling. S vill driva en aktiv arbetsmarknadspolitik och satsa på vuxenutbildning för att möta lågkonjunkturen, vilket motsvarar den egna reservationen. Därför Nej till utskottets avslag.", "citations": [{"document": "budgetmotion", "quote": "Socialdemokraterna föreslår därför en rejäl satsning på 800 miljoner kronor för fler utbildningsplatser inom vuxenutbildningen nästa år.", "princip": "satsning på vuxenutbildning"}, {"document": "valmanifest", "quote": "En aktiv arbetsmarknadspolitik för fler jobb är särskilt viktig i ekonomiskt oroliga tider.", "princip": "aktiv arbetsmarknadspolitik"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "SD vill avveckla ineffektiva arbetsmarknads- och integrationsprogram och backar regeringens pågående arbete. Utskottet avslår oppositionsmotioner (MP, S) som vill utöka insatserna. SD:s linje ligger på utskottets sida, alltså Ja.", "citations": [{"document": "valmanifest", "quote": "Avskaffa ineffektiva arbetsmarknads- och integrationsprogram som är skapade för att dölja arbetslöshet", "princip": "avveckla ineffektiva program"}, {"document": "valmanifest", "quote": "Stoppa användandet av offentliga medel till låtsasjobb", "princip": "inga låtsasjobb"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "medium", "coverage": "inferred", "motivering": "V:s valmanifest kräver massiva satsningar på omställningsstöd, kompetensutveckling och utbildning, och budgeten vill ge Arbetsförmedlingen verktyg att anvisa fler arbetslösa till utbildning. Utskottet avslår reformförslagen; reservationen pekar mot mer kompetensinsatser. Därför Nej.", "citations": [{"document": "valmanifest", "quote": "massiva satsningar på omställningsstöd, kompetensutveckling och utbildning", "princip": "satsa på kompetensutveckling"}, {"document": "budgetmotion", "quote": "Ge Arbetsförmedlingen resurser och verktyg för att anvisa fler arbetslösa till utbildning", "princip": "utbildning för arbetslösa"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens-partitillhorighet-oklar"], "model": "claude-opus-4-8", "en": null, "program_override": null}}, "probe": null, "seats": [["V", "Frånvarande", "Ali Esbati", "Stockholms kommun"], ["V", "Ja", "Andrea Andersson Tay", "Stockholms län"], ["V", "Ja", "Birger Lahti", "Norrbottens län"], ["V", "Ja", "Ciczie Weidby", "Jönköpings län"], ["V", "Ja", "Daniel Riazat", "Stockholms län"], ["V", "Frånvarande", "Gudrun Nordborg", "Västerbottens län"], ["V", "Frånvarande", "Hanna Gunnarsson