län"], ["SD", "Nej", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Nej", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Nej", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Nej", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Nej", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HA021004", "typ": "mot", "label": "Motion 2022/23:1004", "titel": "Sverigedemokratisk insolvensrätt", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HA021014", "typ": "mot", "label": "Motion 2022/23:1014", "titel": "Ett konkurrenskraftigt svenskt väginfrastruktursystem", "undertitel": "av Thomas Morell m.fl. (SD)"}, {"dok_id": "HA021030", "typ": "mot", "label": "Motion 2022/23:1030", "titel": "Infrastruktur i Fyrbodal", "undertitel": "av Johan Hultberg (M)"}, {"dok_id": "HA021123", "typ": "mot", "label": "Motion 2022/23:1123", "titel": "Den svenska basindustrin", "undertitel": "av Elisabeth Thand Ringqvist m.fl. (C)"}, {"dok_id": "HA021138", "typ": "mot", "label": "Motion 2022/23:1138", "titel": "Motion om maxtak för personbilar", "undertitel": "av David Perez (SD)"}, {"dok_id": "HA021139", "typ": "mot", "label": "Motion 2022/23:1139", "titel": "Gemensam databas för besiktigade fordon inom EU", "undertitel": "av David Perez (SD)"}, {"dok_id": "HA021146", "typ": "mot", "label": "Motion 2022/23:1146", "titel": "Flytt av fordon", "undertitel": "av Per Söderlund m.fl. (SD)"}, {"dok_id": "HA021187", "typ": "mot", "label": "Motion 2022/23:1187", "titel": "Översyn av parkeringslagstiftningen", "undertitel": "av Hans Ekström (S)"}, {"dok_id": "HA021233", "typ": "mot", "label": "Motion 2022/23:1233", "titel": "Transporteffektivt och hållbart samhälle", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HA021254", "typ": "mot", "label": "Motion 2022/23:1254", "titel": "Matbudens användning av mopeder", "undertitel": "av Daniel Helldén (MP)"}, {"dok_id": "HA021263", "typ": "mot", "label": "Motion 2022/23:1263", "titel": "Nationellt register för parkeringstillstånd för personer med nedsatt rörelseförmåga", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HA021375", "typ": "mot", "label": "Motion 2022/23:1375", "titel": "Den demokratiska kontrollen över bilbesiktningen", "undertitel": "av Linnéa Wickman m.fl. (S)"}, {"dok_id": "HA021545", "typ": "mot", "label": "Motion 2022/23:1545", "titel": "Särskilda parkeringstillstånd efter behov", "undertitel": "av Linus Sköld m.fl. (S)"}, {"dok_id": "HA021610", "typ": "mot", "label": "Motion 2022/23:1610", "titel": "Parkeringsavgifter för elbilar", "undertitel": "av Niels Paarup-Petersen m.fl. (C)"}, {"dok_id": "HA021672", "typ": "mot", "label": "Motion 2022/23:1672", "titel": "En levande landsbygd för Sveriges bästa", "undertitel": "av Annie Lööf m.fl. (C)"}, {"dok_id": "HA021801", "typ": "mot", "label": "Motion 2022/23:1801", "titel": "Längre lastbilar", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HA02183", "typ": "mot", "label": "Motion 2022/23:183", "titel": "Vägrenarnas potential för den biologiska mångfalden", "undertitel": "av Daniel Helldén och Rebecka Le Moine (båda MP)"}, {"dok_id": "HA022073", "typ": "mot", "label": "Motion 2022/23:2073", "titel": "Utgiftsområde 20 Allmän miljö- och naturvård", "undertitel": "av Anna-Caren Sätherberg m.fl. (S)"}, {"dok_id": "HA022140", "typ": "mot", "label": "Motion 2022/23:2140", "titel": "Utgiftsområde 22 Kommunikationer", "undertitel": "av Gunilla Svantorp m.fl. (S)"}, {"dok_id": "HA022142", "typ": "mot", "label": "Motion 2022/23:2142", "titel": "Smidigare, miljövänligare och säkrare trafik", "undertitel": "av Markus Wiechel och Lars Andersson (båda SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01TU10.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01TU10.html", "votering_url": "https://data.riksdagen.se/votering/56F4FDAD-5CAE-401D-9EAA-53562AFF2C48/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01TU10/", "meta": {"type": "motion", "policy_area": "transport", "subject": {"sv": "Kommunernas rätt att införa miljözoner och begränsa biltrafik", "en": "Municipalities' right to introduce environmental zones and restrict car traffic"}, "at_stake": {"sv": "Beslutet påverkar hur mycket kommuner själva kan begränsa biltrafiken av klimat- och miljöskäl, och hur det påverkar näringsliv och privatpersoner, till exempel pendlare och varutransporter, som är beroende av att köra in i städerna.", "en": "The decision affects how much municipalities themselves can restrict car traffic for climate and environmental reasons, and how that affects businesses and private individuals, such as commuters and goods transport, who depend on driving into cities."}, "subtopics": ["miljözoner", "biltrafik", "kommunalt självstyre", "klimatmål", "transportsektorn"], "parties_involved": ["SD"], "decision": {"sv": "Frågan gäller om staten bör begränsa kommunernas möjlighet att införa miljözoner och andra begränsningar av biltrafiken, eller om det även fortsättningsvis ska vara en kommunal befogenhet att besluta om sådana åtgärder som styrmedel för klimatmålen.", "en": "The question is whether the state should limit municipalities' ability to introduce environmental zones and other restrictions on car traffic, or whether it should continue to be a municipal power to decide on such measures as a policy instrument for the climate targets."}, "ja": {"sv": "Utskottet avstyrker motionerna. Utskottet konstaterar att införandet av miljözoner i tätorter är en kommunal befogenhet, där kommunen behöver göra avvägningar mellan nyttan och konsekvenserna för invånarna, med möjlighet att göra undantag för vissa typer av transporter. Utskottet ser därför inte skäl att föreslå ändringar i denna ordning.", "en": "The committee rejects the motions. The committee notes that introducing environmental zones in urban areas is a municipal responsibility, where the municipality needs to weigh the benefits against the consequences for residents, with the possibility of making exceptions for certain types of transport. The committee therefore does not see reason to propose changes to this arrangement."}, "nej": [{"alt_id": "res-8", "sv": "Reservationen (SD) vill utreda möjligheten att stifta nationella lagar mot att kommuner på ett skadligt sätt begränsar biltrafiken lokalt, med hänvisning till exempelvis planerade bilbegränsningar i Stockholms innerstad som reservanten menar drabbar både näringsliv och privatpersoner som pendlar in till staden.", "en": "The reservation (SD) wants an inquiry into the possibility of enacting national laws against municipalities harmfully restricting car traffic locally, citing as an example planned car restrictions in central Stockholm which the reservation argues would harm both businesses and private individuals who commute into the city."}]}}