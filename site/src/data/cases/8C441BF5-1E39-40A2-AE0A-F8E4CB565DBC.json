r", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Frånvarande", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HA022", "typ": "mot", "label": "Motion 2022/23:2", "titel": "med anledning av prop. 2021/22:260 Ökad kontroll i hälso- och sjukvården", "undertitel": "av Karin Rågsjö m.fl. (V)"}, {"dok_id": "HA025", "typ": "mot", "label": "Motion 2022/23:5", "titel": "med anledning av prop. 2021/22:260 Ökad kontroll i hälso- och sjukvården", "undertitel": "av Camilla Waltersson Grönvall m.fl. (M, SD, KD, L)"}, {"dok_id": "HA028", "typ": "mot", "label": "Motion 2022/23:8", "titel": "med anledning av prop. 2021/22:260 Ökad kontroll i hälso- och sjukvården", "undertitel": "av Anders W Jonsson (C)"}, {"dok_id": "H903260", "typ": "prop", "label": "Proposition 2021/22:260", "titel": "Ökad kontroll i hälso- och sjukvården", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01SoU5.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01SoU5.html", "votering_url": "https://data.riksdagen.se/votering/8C441BF5-1E39-40A2-AE0A-F8E4CB565DBC/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01SoU5/", "meta": {"type": "motion", "policy_area": "health", "subject": {"sv": "Primärvårdens grunduppdrag och hälso- och sjukvårdslagens tillämpning.", "en": "Primary care's core mandate and application of the healthcare law."}, "at_stake": {"sv": "Riksdagens avslag på regeringens förslag innebär att regionala vårdavtal med privata vårdgivare inte kräver säkerställande av hur andra uppdrag påverkar vården. Rehabilitering blir en del av primärvårdens grunduppdrag från 1 januari 2024, och Inspektionen för vård och omsorg får tvingande befogenheter från 1 juli 2023.", "en": "Parliament's rejection of the government proposal means regional healthcare contracts with private providers are not required to ensure how other assignments affect care. Rehabilitation becomes part of primary care's core mandate from January 1, 2024, and the Health and Care Inspectorate gains enforcement authority from July 1, 2023."}, "subtopics": ["sjukvård", "primärvård", "rehabilitering", "lagstiftning"], "parties_involved": ["V"]}}