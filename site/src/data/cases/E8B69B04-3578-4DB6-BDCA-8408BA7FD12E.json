rrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HA021222", "typ": "mot", "label": "Motion 2022/23:1222", "titel": "Gammelskog för kvalitetsvirke", "undertitel": "av Aron Emilsson (SD)"}, {"dok_id": "HA021246", "typ": "mot", "label": "Motion 2022/23:1246", "titel": "Hållbart skogsbruk för biologisk mångfald och klimatet", "undertitel": "av Kajsa Fredholm m.fl. (V)"}, {"dok_id": "HA021672", "typ": "mot", "label": "Motion 2022/23:1672", "titel": "En levande landsbygd för Sveriges bästa", "undertitel": "av Annie Lööf m.fl. (C)"}, {"dok_id": "HA021867", "typ": "mot", "label": "Motion 2022/23:1867", "titel": "Möjlighet till ökad kemisk bekämpning av granbarkborren", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HA021902", "typ": "mot", "label": "Motion 2022/23:1902", "titel": "Skogsnäringen i Skåne", "undertitel": "av Ann-Charlotte Hammar Johnsson m.fl. (M)"}, {"dok_id": "HA021948", "typ": "mot", "label": "Motion 2022/23:1948", "titel": "Bättre bekämpning av granbarkborren i reservaten", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HA022000", "typ": "mot", "label": "Motion 2022/23:2000", "titel": "Ökad produktion i skogen", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HA022072", "typ": "mot", "label": "Motion 2022/23:2072", "titel": "Utgiftsområde 23 Areella näringar, landsbygd och livsmedel", "undertitel": "av Anna-Caren Sätherberg m.fl. (S)"}, {"dok_id": "HA022095", "typ": "mot", "label": "Motion 2022/23:2095", "titel": "Friluftspolitisk motion", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HA02211", "typ": "mot", "label": "Motion 2022/23:211", "titel": "Avverkningsanmälan och dess offentlighet", "undertitel": "av Mikael Larsson (C)"}, {"dok_id": "HA022110", "typ": "mot", "label": "Motion 2022/23:2110", "titel": "En kraftfull naturpolitik för starka ekosystem, biologisk mångfald och ökad klimatnytta", "undertitel": "av Per Bolund m.fl. (MP)"}, {"dok_id": "HA022175", "typ": "mot", "label": "Motion 2022/23:2175", "titel": "En klimatpolitik som står upp för Parisavtalet", "undertitel": "av Per Bolund m.fl. (MP)"}, {"dok_id": "HA022190", "typ": "mot", "label": "Motion 2022/23:2190", "titel": "Ledarskap för klimat och grön omställning", "undertitel": "av Annie Lööf m.fl. (C)"}, {"dok_id": "HA02444", "typ": "mot", "label": "Motion 2022/23:444", "titel": "Östergötlands skogsägare", "undertitel": "av John Widegren m.fl. (M)"}, {"dok_id": "HA02467", "typ": "mot", "label": "Motion 2022/23:467", "titel": "Säkerställande av den svenska skogsproduktionen", "undertitel": "av Isak From och Monica Haider (båda S)"}, {"dok_id": "HA02649", "typ": "mot", "label": "Motion 2022/23:649", "titel": "Statligt utredningsansvar gällande förekomster av arter i skogen", "undertitel": "av Helena Lindahl m.fl. (C)"}, {"dok_id": "HA02854", "typ": "mot", "label": "Motion 2022/23:854", "titel": "Skog och bioekonomi", "undertitel": "av Daniel Bäckström m.fl. (C)"}, {"dok_id": "HA02907", "typ": "mot", "label": "Motion 2022/23:907", "titel": "Cirkulär ekonomi och kemikalier", "undertitel": "av Stina Larsson m.fl. (C)"}, {"dok_id": "HA02937", "typ": "mot", "label": "Motion 2022/23:937", "titel": "Levande landsbygd", "undertitel": "av Eric Palmqvist m.fl. (SD)"}, {"dok_id": "HA02972", "typ": "mot", "label": "Motion 2022/23:972", "titel": "Skogspolitik med helhetssyn", "undertitel": "av Martin Kinnunen m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01MJU15.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01MJU15.html", "votering_url": "https://data.riksdagen.se/votering/E8B69B04-3578-4DB6-BDCA-8408BA7FD12E/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01MJU15/", "meta": {"type": "motion", "policy_area": "environment", "subject": {"sv": "Skogsbrukets bidrag till bioekonomin", "en": "Forestry's contribution to the bioeconomy"}, "at_stake": {"sv": "Skogsbaserad biomassa väntas efterfrågas alltmer i omställningen till en cirkulär ekonomi, vilket berör både skogsägare, skogsnäringen och de klimat- och miljömål som ställs mot varandra i hur skogen brukas.", "en": "Demand for forest-based biomass is expected to grow with the shift to a circular economy, which affects forest owners, the forestry industry, and the climate and environmental goals that must be weighed against each other in how the forest is used."}, "subtopics": ["skogsbruk", "bioekonomi", "klimatmål", "biomassa", "skogsprogram"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om skogens bidrag till en växande bioekonomi ska lyftas fram som ett eget mål, utöver det arbete som redan pågår med ett nationellt mål för hållbar tillväxt i skogen.", "en": "The question is whether the forest's contribution to a growing bioeconomy should be highlighted as a separate goal, beyond the work already under way on a national target for sustainable forest growth."}, "ja": {"sv": "Utskottet anser att arbetet med ett nationellt mål för ökad hållbar tillväxt i skogen, tillsammans med det nationella skogsprogrammet och principen om frihet under ansvar, redan värnar skogsbrukets roll i bioekonomin och avstyrker därför ett särskilt uttalande i frågan.", "en": "The committee considers that the work on a national target for increased sustainable forest growth, together with the national forest program and the principle of freedom under responsibility, already safeguards forestry's role in the bioeconomy, and therefore rejects a separate statement on the matter."}, "nej": [{"alt_id": "res-4", "sv": "Reservanten vill att ett aktivt, klimatsmart och miljömässigt hållbart skogsbruk som skapar jobb och hållbar tillväxt i hela landet uttryckligen värnas som grunden för en växande bioekonomi.", "en": "The reservation wants active, climate-smart and environmentally sustainable forestry that creates jobs and sustainable growth throughout the country to be explicitly safeguarded as the foundation of a growing bioeconomy."}]}}