, "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Frånvarande", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Frånvarande", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021054", "typ": "mot", "label": "Motion 2024/25:1054", "titel": "Omvandling av IB-elevers poäng till meritvärde", "undertitel": "av Louise Meijer (M)"}, {"dok_id": "HC021245", "typ": "mot", "label": "Motion 2024/25:1245", "titel": "Decentraliserade lärmiljöer för högre utbildning", "undertitel": "av Jonathan Svensson (S)"}, {"dok_id": "HC021276", "typ": "mot", "label": "Motion 2024/25:1276", "titel": "Bättre bemötande av hbtqi-personer", "undertitel": "av Daniel Vencu Velasquez Castro (S)"}, {"dok_id": "HC021288", "typ": "mot", "label": "Motion 2024/25:1288", "titel": "Teckenspråk", "undertitel": "av Carita Boulwén (SD)"}, {"dok_id": "HC021348", "typ": "mot", "label": "Motion 2024/25:1348", "titel": "Scenkonst", "undertitel": "av Anna-Lena Hedberg m.fl. (SD)"}, {"dok_id": "HC021366", "typ": "mot", "label": "Motion 2024/25:1366", "titel": "Socialtjänsten", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021430", "typ": "mot", "label": "Motion 2024/25:1430", "titel": "Vissa frågor i Mellanöstern och Afrika", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HC021443", "typ": "mot", "label": "Motion 2024/25:1443", "titel": "Kvalitet och frihet för en högskola i världsklass", "undertitel": "av Patrick Reslow m.fl. (SD)"}, {"dok_id": "HC021448", "typ": "mot", "label": "Motion 2024/25:1448", "titel": "En förskola i världsklass", "undertitel": "av Patrick Reslow m.fl. (SD)"}, {"dok_id": "HC021467", "typ": "mot", "label": "Motion 2024/25:1467", "titel": "En framtidsinriktad it-politik", "undertitel": "av Tobias Andersson m.fl. (SD)"}, {"dok_id": "HC021540", "typ": "mot", "label": "Motion 2024/25:1540", "titel": "Våld och sexuella övergrepp mot barn med funktionsnedsättningar", "undertitel": "av Marléne Lund Kopparklint m.fl. (M)"}, {"dok_id": "HC021632", "typ": "mot", "label": "Motion 2024/25:1632", "titel": "Statlig kontroll över validering", "undertitel": "av Lawen Redar (S)"}, {"dok_id": "HC021684", "typ": "mot", "label": "Motion 2024/25:1684", "titel": "Ett jämlikt tandvårdssystem och behovet av fler tandläkare", "undertitel": "av Carina Ödebrink m.fl. (S)"}, {"dok_id": "HC021699", "typ": "mot", "label": "Motion 2024/25:1699", "titel": "Prioritering av kvinnors hälsa inom medicinsk forskning och vård", "undertitel": "av Azra Muranovic m.fl. (S)"}, {"dok_id": "HC021733", "typ": "mot", "label": "Motion 2024/25:1733", "titel": "Tydligare ramverk för att identifiera antisemitism", "undertitel": "av Mathias Bengtsson (KD)"}, {"dok_id": "HC021813", "typ": "mot", "label": "Motion 2024/25:1813", "titel": "Jämlik utbildning över hela landet för ett starkt Sverige", "undertitel": "av Patrik Lundqvist m.fl. (S)"}, {"dok_id": "HC021846", "typ": "mot", "label": "Motion 2024/25:1846", "titel": "Brytande av social snedrekrytering", "undertitel": "av Amalia Rud Stenlöf och Johan Büser (båda S)"}, {"dok_id": "HC021862", "typ": "mot", "label": "Motion 2024/25:1862", "titel": "Ersättningsbeloppen för de konstnärliga högskolorna", "undertitel": "av Kristina Axén Olin och Emma Ahlström Köster (båda M)"}, {"dok_id": "HC021883", "typ": "mot", "label": "Motion 2024/25:1883", "titel": "Utvecklande av resurstilldelningssystemet för högre utbildning", "undertitel": "av Johan Hultberg (M)"}, {"dok_id": "HC021886", "typ": "mot", "label": "Motion 2024/25:1886", "titel": "Högre utbildning i Dalsland och hela landet", "undertitel": "av Johan Hultberg (M)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01UbU14.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01UbU14.html", "votering_url": "https://data.riksdagen.se/votering/194E10D7-7446-4E31-B283-20718CD20295/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01UbU14/", "meta": {"type": "motion", "policy_area": "education", "subject": {"sv": "Styrning av högskolornas utbildningsutbud och arbetsmarknadsanknytning", "en": "Governance of higher education institutions' programme offerings and labour-market links"}, "at_stake": {"sv": "Ett tillkännagivande skulle kunna påverka hur högskolornas utbildningsutbud utformas i förhållande till arbetsmarknadens behov och den regionala samverkan, vilket berör både studenter och arbetsgivare. Utan ett sådant beslut fortsätter frågan att hanteras inom befintlig reglering och pågående regeringsutredningar.", "en": "A parliamentary statement could shape how higher education institutions design their programme offerings in relation to labour-market needs and regional cooperation, affecting both students and employers. Without such a decision, the issue continues to be handled under existing regulation and ongoing government reviews."}, "subtopics": ["högskolestyrning", "utbildningsutbud", "arbetsmarknadsanknytning", "resursfördelning", "AI i högre utbildning"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om riksdagen bör vidta särskilda åtgärder för att stärka högskolornas arbetsmarknadsanknytning och regionala samverkan, eller om nuvarande reglering och pågående utredningar är tillräckliga.", "en": "The question is whether parliament should take specific action to strengthen higher education institutions' links to the labour market and regional cooperation, or whether the current regulatory framework and ongoing government reviews are sufficient."}, "ja": {"sv": "Utskottet anser inte att det behövs några särskilda åtgärder för att styra högskolornas utbildningsutbud, arbetsmarknadsanknytning eller resursfördelning, eftersom lärosätena redan har ett stort självbestämmande inom gällande reglering och regeringen har aviserat flera utredningar på området.", "en": "The committee does not consider special measures needed to steer higher education institutions' programme offerings, labour-market links or resource allocation, since institutions already have considerable self-determination under current regulation and the government has announced several reviews in the area."}, "nej": [{"alt_id": "res-2", "sv": "Reservanten vill att riksdagen ska verka för att stärka högskolornas arbetsmarknadsanknytning och regionala samverkan, med motiveringen att tillgång till högre utbildning av god kvalitet i hela landet ökar människors möjligheter till jobb och trygghet och gynnar näringsliv och välfärd, samtidigt som utbildningarna behöver anpassas till en alltmer rörlig arbetsmarknad.", "en": "The reservation wants parliament to work to strengthen higher education institutions' links to the labour market and regional cooperation, arguing that access to good-quality higher education throughout the country increases people's job opportunities and security and benefits business and welfare, while study programmes need to be adapted to an increasingly mobile labour market."}]}}