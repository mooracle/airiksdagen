nerfors", "Stockholms kommun"], ["SD", "Nej", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Nej", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB0210", "typ": "mot", "label": "Motion 2023/24:10", "titel": "Borttagande av fribeloppet för studiemedel", "undertitel": "av Nima Gholam Ali Pour (SD)"}, {"dok_id": "HB021087", "typ": "mot", "label": "Motion 2023/24:1087", "titel": "Möjligheten att ta CSN-lån för den som omskolar sig till yrkeschaufför", "undertitel": "av Adnan Dibrani (S)"}, {"dok_id": "HB021126", "typ": "mot", "label": "Motion 2023/24:1126", "titel": "Avskaffande av fribeloppet", "undertitel": "av Helena Storckenfeldt (M)"}, {"dok_id": "HB021421", "typ": "mot", "label": "Motion 2023/24:1421", "titel": "Koppling av studiemedel till avklarade poäng", "undertitel": "av Ann-Sofie Lifvenhage och Ann-Charlotte Hammar Johnsson (båda M)"}, {"dok_id": "HB021503", "typ": "mot", "label": "Motion 2023/24:1503", "titel": "Reformering av inackorderingsbidraget", "undertitel": "av Fredrik Lundh Sammeli (S)"}, {"dok_id": "HB021593", "typ": "mot", "label": "Motion 2023/24:1593", "titel": "CSN, folkbildning och rätten att få mer tid på sig", "undertitel": "av Gunilla Svantorp (S)"}, {"dok_id": "HB02177", "typ": "mot", "label": "Motion 2023/24:177", "titel": "Ändrade regler för studiestöd", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HB021846", "typ": "mot", "label": "Motion 2023/24:1846", "titel": "En grön och rättvis omställning i Västsverige", "undertitel": "av Joakim Järrebring m.fl. (S)"}, {"dok_id": "HB021932", "typ": "mot", "label": "Motion 2023/24:1932", "titel": "Bostadssituationen för studenter", "undertitel": "av Amalia Rud Pedersen och Adrian Magnusson (båda S)"}, {"dok_id": "HB022070", "typ": "mot", "label": "Motion 2023/24:2070", "titel": "En stark tandvård med välmående personal", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HB022077", "typ": "mot", "label": "Motion 2023/24:2077", "titel": "En tillgänglig sjukvård i världsklass", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HB022097", "typ": "mot", "label": "Motion 2023/24:2097", "titel": "Möjlighet till avskrivning av studielån vid tjänstgöring på landsbygden inom samhällsviktiga verksamheter", "undertitel": "av Mattias Eriksson Falk och Roger Hedlund (båda SD)"}, {"dok_id": "HB022439", "typ": "mot", "label": "Motion 2023/24:2439", "titel": "Slopat fribelopp", "undertitel": "av Patrik Jönsson (SD)"}, {"dok_id": "HB022454", "typ": "mot", "label": "Motion 2023/24:2454", "titel": "Utbildning och forskning - för en stark kunskapsnation", "undertitel": "av Anders Ådahl m.fl. (C)"}, {"dok_id": "HB022457", "typ": "mot", "label": "Motion 2023/24:2457", "titel": "Livskraft och framtidstro i Sveriges landsbygder", "undertitel": "av Muharrem Demirok m.fl. (C)"}, {"dok_id": "HB022569", "typ": "mot", "label": "Motion 2023/24:2569", "titel": "Förlängt körkortslån", "undertitel": "av Niklas Sigvardsson m.fl. (S)"}, {"dok_id": "HB022684", "typ": "mot", "label": "Motion 2023/24:2684", "titel": "Utgiftsområde 15 Studiestöd", "undertitel": "av Åsa Westlund m.fl. (S)"}, {"dok_id": "HB022705", "typ": "mot", "label": "Motion 2023/24:2705", "titel": "Ett rikare liv för äldre", "undertitel": "av Ulrika Westerlund m.fl. (MP)"}, {"dok_id": "HB02442", "typ": "mot", "label": "Motion 2023/24:442", "titel": "Studenter, doktorander och forskare", "undertitel": "av Lorena Delgado Varas m.fl. (V)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01UbU7.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01UbU7.html", "votering_url": "https://data.riksdagen.se/votering/813CB046-FF65-4EE9-9F26-E9FD2F5AD8B7/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01UbU7/", "meta": {"type": "motion", "policy_area": "education", "subject": {"sv": "Avskrivning av studielån", "en": "Write-off of student loans"}, "at_stake": {"sv": "Beslutet berör nyutexaminerade som väger in var i landet de bosätter sig, och regioner som har svårt att rekrytera yrkesgrupper som tandläkare, samtidigt som det väcker frågor om rättvisa mellan olika låntagare i studiestödssystemet.", "en": "The decision affects recent graduates weighing where in the country to settle, and regions struggling to recruit professionals such as dentists, while also raising questions of fairness between different borrowers in the student loan system."}, "subtopics": ["studielån", "avskrivning av studieskulder", "glesbygd", "tandläkarbrist", "kompetensförsörjning"], "parties_involved": ["SD"], "decision": {"sv": "Frågan gäller om studielån bör kunna skrivas av för den som tar arbete i en viss del av landet eller utbildar sig till ett visst bristyrke, till exempel tandläkare i glesbygd, eller om nuvarande regelverk utan avskrivningsmöjlighet bör vara oförändrat.", "en": "The question is whether student loans should be eligible for write-off for those who take work in a particular part of the country or train for a particular shortage occupation, such as dentists in rural areas, or whether the current framework without a write-off option should remain unchanged."}, "ja": {"sv": "Utskottet konstaterar att det inom gällande regelverk inte finns någon möjlighet att få studielån avskrivna för den som tar arbete i en viss del av landet eller utbildar sig till ett visst yrke, och hänvisar till att avskrivning för vissa yrkesgrupper skulle kunna uppfattas som orättvist av andra låntagare och vara svårt att använda som regionalpolitiskt instrument. Utskottet står fast vid denna bedömning och avstyrker motionerna om avskrivning av studielån.", "en": "The committee notes that under current rules there is no possibility of having student loans written off for those who take work in a particular part of the country or train for a particular profession, and points out that write-offs for certain professional groups could be seen as unfair by other borrowers and would be difficult to use as a regional-policy instrument. The committee stands by this assessment and rejects the motions on writing off student loans."}, "nej": [{"alt_id": "res-5", "sv": "Reservanten vill att regeringen utreder möjligheterna att reducera studieskulder för tandläkare som väljer att arbeta i lands- och glesbygden, med hänvisning till ett amerikanskt system där till exempel läkare som förbinder sig att arbeta på landsbygden ett antal år som bonus får sina studieskulder reducerade, och menar att ett motsvarande system bör övervägas för tandläkare i svensk lands- och glesbygd.", "en": "The reservation wants the government to investigate reducing study debt for dentists who choose to work in rural and sparsely populated areas, pointing to a US system where, for example, doctors who commit to working in rural areas for a number of years get their study debt reduced as a bonus, and arguing that a similar system should be considered for dentists in Swedish rural and sparsely populated areas."}]}}