 "Ja", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Frånvarande", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021094", "typ": "mot", "label": "Motion 2025/26:1094", "titel": "Sänkt rösträttsålder till 16 år", "undertitel": "av Martina Johansson (C)"}, {"dok_id": "HD021177", "typ": "mot", "label": "Motion 2025/26:1177", "titel": "Valkretsnamn", "undertitel": "av Ulrika Heie och Mikael Larsson (båda C)"}, {"dok_id": "HD02139", "typ": "mot", "label": "Motion 2025/26:139", "titel": "Harmonisering av småpartispärren till kommunfullmäktige", "undertitel": "av Nima Gholam Ali Pour (SD)"}, {"dok_id": "HD021592", "typ": "mot", "label": "Motion 2025/26:1592", "titel": "Försöksverksamhet med rösträtt från 16 års ålder i kommunala val", "undertitel": "av Jonathan Svensson (S)"}, {"dok_id": "HD021619", "typ": "mot", "label": "Motion 2025/26:1619", "titel": "Rösträtt för 16-åringar", "undertitel": "av Jan Riise m.fl. (MP)"}, {"dok_id": "HD021643", "typ": "mot", "label": "Motion 2025/26:1643", "titel": "Skaraborgs valkrets", "undertitel": "av Charlotte Nordström (M)"}, {"dok_id": "HD021679", "typ": "mot", "label": "Motion 2025/26:1679", "titel": "Inför skilda valdagar i Sverige", "undertitel": "av Mikael Damsgaard (M)"}, {"dok_id": "HD021690", "typ": "mot", "label": "Motion 2025/26:1690", "titel": "Rösta utan kö", "undertitel": "av Margareta Cederfelt (M)"}, {"dok_id": "HD021724", "typ": "mot", "label": "Motion 2025/26:1724", "titel": "Svenskt medborgarskap för att få rösta i kommun- och regionval", "undertitel": "av Crister Carlsson m.fl. (M)"}, {"dok_id": "HD021764", "typ": "mot", "label": "Motion 2025/26:1764", "titel": "Rösträttens koppling till medborgarskap", "undertitel": "av Jan Ericson (M)"}, {"dok_id": "HD022034", "typ": "mot", "label": "Motion 2025/26:2034", "titel": "Digitalt valdeltagande", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022063", "typ": "mot", "label": "Motion 2025/26:2063", "titel": "Rösträtt i kommunval från 16 år", "undertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HD022162", "typ": "mot", "label": "Motion 2025/26:2162", "titel": "Skaraborgs valkrets", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022331", "typ": "mot", "label": "Motion 2025/26:2331", "titel": "Försöksverksamhet för sänkt rösträttsålder till 16 år", "undertitel": "av Arber Gashi (S)"}, {"dok_id": "HD022540", "typ": "mot", "label": "Motion 2025/26:2540", "titel": "Fyllnadsval för att förhindra tomma stolar i kommun- och regionfullmäktige", "undertitel": "av Mattias Eriksson Falk och Roger Hedlund (båda SD)"}, {"dok_id": "HD022589", "typ": "mot", "label": "Motion 2025/26:2589", "titel": "Ändrad spärrnivå vid val till kommunfullmäktige", "undertitel": "av Mattias Eriksson Falk och Roger Hedlund (båda SD)"}, {"dok_id": "HD022826", "typ": "mot", "label": "Motion 2025/26:2826", "titel": "Lättläst demokratisatsning", "undertitel": "av Ulrika Heie (C)"}, {"dok_id": "HD023077", "typ": "mot", "label": "Motion 2025/26:3077", "titel": "Den svenska diasporan", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HD02308", "typ": "mot", "label": "Motion 2025/26:308", "titel": "En samlad ungdomspolitik", "undertitel": "av Vasiliki Tsouplaki m.fl. (V)"}, {"dok_id": "HD023087", "typ": "mot", "label": "Motion 2025/26:3087", "titel": "Skilda valdagar", "undertitel": "av Markus Wiechel (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01KU27.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01KU27.html", "votering_url": "https://data.riksdagen.se/votering/46545BEC-A18F-4CBA-869C-A6648B786E1E/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01KU27/", "meta": {"type": "motion", "policy_area": "constitution", "subject": {"sv": "Handlingsplan för ökat valdeltagande", "en": "Action plan to boost voter turnout"}, "at_stake": {"sv": "Valdeltagandet sjönk något i både riksdagsvalet 2022 och EU-parlamentsvalet, vilket väcker frågor om demokratins legitimitet och vilka grupper som röstar minst. Utfallet påverkar hur mycket riktade insatser som görs inför framtida val, särskilt mot grupper med lägre valdeltagande.", "en": "Turnout dipped slightly in both the 2022 parliamentary election and the European Parliament election, raising questions about democratic legitimacy and which groups vote least. The outcome affects how much targeted effort goes into future elections, especially toward groups with lower turnout."}, "subtopics": ["valdeltagande", "demokrati", "riksdagsval", "handlingsplan"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om riksdagen ska ge regeringen i uppdrag att ta fram en särskild handlingsplan för att öka valdeltagandet, eller om pågående informationsinsatser är tillräckliga.", "en": "The question is whether parliament should instruct the government to draw up a dedicated action plan to raise voter turnout, or whether ongoing information efforts are enough."}, "ja": {"sv": "Utskottet avslår kravet på en handlingsplan. Det pekar på att regeringen redan gör riktade valdeltagandeinsatser inför 2026 års val, och att ett högt valdeltagande visserligen är viktigt för legitimiteten men att inget ytterligare riksdagsinitiativ behövs.", "en": "The committee rejects the call for an action plan. It points out that the government is already running targeted turnout initiatives ahead of the 2026 elections, and that while high turnout matters for legitimacy, no further parliamentary initiative is needed."}, "nej": [{"alt_id": "res-2", "sv": "Reservationen (res-2) vill att regeringen tar fram en handlingsplan för ökat valdeltagande. Den motiverar kravet med att valdeltagandet sjönk vid både riksdagsvalet 2022 och EU-valet, och att dagens insatser inte räcker, bland annat för att unga sällan möter partiernas ungdomsförbund i skolan.", "en": "The reservation (res-2) calls for the government to draw up an action plan to increase voter turnout. It argues that turnout fell in both the 2022 parliamentary election and the EU election, and that current efforts are insufficient, partly because young people rarely get to meet party youth organizations in school."}]}}