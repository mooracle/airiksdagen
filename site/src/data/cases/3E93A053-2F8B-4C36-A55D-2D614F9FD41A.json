södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Frånvarande", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Frånvarande", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021088", "typ": "mot", "label": "Motion 2025/26:1088", "titel": "Stärkt arbete mot skattefusk och skatteflykt", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HD021281", "typ": "mot", "label": "Motion 2025/26:1281", "titel": "Redovisning av vad skattepengarna går till", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HD021537", "typ": "mot", "label": "Motion 2025/26:1537", "titel": "En fungerande arbetsmarknad i hela Öresundsområdet", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HD021657", "typ": "mot", "label": "Motion 2025/26:1657", "titel": "Stopp för svartjobb", "undertitel": "av Margareta Cederfelt (M)"}, {"dok_id": "HD021677", "typ": "mot", "label": "Motion 2025/26:1677", "titel": "Översyn av kravet på personalliggare", "undertitel": "av Charlotte Nordström (M)"}, {"dok_id": "HD021753", "typ": "mot", "label": "Motion 2025/26:1753", "titel": "Verka för att fler arbetsgivare redovisar arbetsgivaravgifterna på lönebeskedet", "undertitel": "av Jan Ericson (M)"}, {"dok_id": "HD021755", "typ": "mot", "label": "Motion 2025/26:1755", "titel": "Redovisa arbetsgivaravgifterna på slutskattsedeln", "undertitel": "av Jan Ericson m.fl. (M)"}, {"dok_id": "HD021756", "typ": "mot", "label": "Motion 2025/26:1756", "titel": "Samarbete och en samlad strategi mot identitetsfusk", "undertitel": "av Jan Ericson (M)"}, {"dok_id": "HD02177", "typ": "mot", "label": "Motion 2025/26:177", "titel": "Skatteflykt", "undertitel": "av Ilona Szatmári Waldau m.fl. (V)"}, {"dok_id": "HD021835", "typ": "mot", "label": "Motion 2025/26:1835", "titel": "Reformerad F-skatt för en sjyst arbetsmarknad", "undertitel": "av Johanna Haraldsson m.fl. (S)"}, {"dok_id": "HD021879", "typ": "mot", "label": "Motion 2025/26:1879", "titel": "Inkludera ansökan om bostadstillägg för pensionärer i deklarationen", "undertitel": "av Laila Naraghi (S)"}, {"dok_id": "HD021972", "typ": "mot", "label": "Motion 2025/26:1972", "titel": "Samling av trängselavgifter", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021973", "typ": "mot", "label": "Motion 2025/26:1973", "titel": "Möjlighet för extra frivillig skatteinbetalning", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021975", "typ": "mot", "label": "Motion 2025/26:1975", "titel": "Sekretess av folkbokföring för poliser", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021976", "typ": "mot", "label": "Motion 2025/26:1976", "titel": "Synliggörande av skatter, moms och avgifter", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021994", "typ": "mot", "label": "Motion 2025/26:1994", "titel": "Trängselavgiften måste upp i minst 100 kronor innan räkning", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD021995", "typ": "mot", "label": "Motion 2025/26:1995", "titel": "Frivilliga skatteinbetalningar", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD021998", "typ": "mot", "label": "Motion 2025/26:1998", "titel": "Separering av avgifter till socialförsäkringar från skatter", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022126", "typ": "mot", "label": "Motion 2025/26:2126", "titel": "Likabehandling för belopp under 100 kronor på skattekontot", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022141", "typ": "mot", "label": "Motion 2025/26:2141", "titel": "Översyn av kravet på personalliggare i mindre företag", "undertitel": "av Sten Bergheden (M)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01SkU14.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01SkU14.html", "votering_url": "https://data.riksdagen.se/votering/3E93A053-2F8B-4C36-A55D-2D614F9FD41A/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01SkU14/", "meta": {"type": "motion", "policy_area": "tax", "subject": {"sv": "Skydd för personer med skyddade personuppgifter", "en": "Protection for people with protected personal data"}, "at_stake": {"sv": "Över 27 000 personer i Sverige lever med skyddade personuppgifter, många av dem våldsutsatta kvinnor och barn vars säkerhet kan äventyras om myndigheter av misstag röjer var de bor. Utfallet påverkar hur starkt samhällets stöd och sekretesskydd blir för denna grupp.", "en": "More than 27,000 people in Sweden live with protected personal data, many of them women and children who have fled violence and whose safety can be endangered if authorities inadvertently reveal their whereabouts. The outcome shapes how strong the support and confidentiality protections are for this group."}, "subtopics": ["skyddade personuppgifter", "våld i nära relationer", "myndighetssamverkan", "vårdnadstvister", "sekretesskydd"], "parties_involved": ["MP"], "decision": {"sv": "Frågan gäller om nuvarande och pågående initiativ för dataskydd och sekretess är tillräckliga, eller om riksdagen bör rikta ett tillkännagivande om ett bredare stöd- och regelverk för våldsutsatta som lever med skyddade personuppgifter, inklusive skärpta vårdnadsregler.", "en": "At issue is whether ongoing data-protection and confidentiality initiatives are enough, or whether parliament should call for a broader support and legal framework — including stricter custody rules — for people who live with protected personal data because of domestic violence."}, "ja": {"sv": "Utskottet konstaterar att arbete redan pågår för att stärka skyddet för personer med skyddade personuppgifter, bl.a. genom förslag om skärpt sekretess vid myndigheters posthantering och ett kommande, mer flexibelt dataskydd hos Skatteverket, Tullverket och Kronofogdemyndigheten, och avstyrker därför motionerna.", "en": "The committee notes that work is already under way to strengthen protection for people with protected personal data — including proposals for tighter confidentiality in authorities' mail handling and a forthcoming, more flexible data-protection framework at the Tax Agency, Customs and the Enforcement Authority — and therefore rejects the motions."}, "nej": [{"alt_id": "res-25", "sv": "Reservanten (MP) vill att samhällets stöd till våldsutsatta som lever med skyddade personuppgifter stärks kraftigt, bl.a. genom att Jämställdhetsmyndigheten får i uppdrag att kartlägga risken för våld efter en relations slut, att delad vårdnad och umgänge inte ska beviljas när våld förekommit, och att en utredning tillsätts om skadestånd när personuppgifter röjts, eftersom nuvarande rutiner alltför ofta sviktar.", "en": "The reserving party wants society's support for domestic-violence survivors living with protected personal data substantially strengthened — including tasking the Gender Equality Agency with mapping the risk of post-separation violence, barring shared custody and contact where violence has occurred, and setting up an inquiry into compensation when personal data is exposed — arguing that current routines too often fail."}]}}