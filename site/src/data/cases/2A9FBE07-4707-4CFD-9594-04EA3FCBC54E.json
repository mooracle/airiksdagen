"Motion 2023/24:1358", "titel": "En kommunpolitik för hela landet", "undertitel": "av Lars Isacsson m.fl. (S)"}, {"dok_id": "HB021586", "typ": "mot", "label": "Motion 2023/24:1586", "titel": "Gränsöverskridande statistik", "undertitel": "av Gunilla Svantorp (S)"}, {"dok_id": "HB021709", "typ": "mot", "label": "Motion 2023/24:1709", "titel": "Statens fastigheter utomlands", "undertitel": "av Teresa Carvalho och Hans Ekström (båda S)"}, {"dok_id": "HB021832", "typ": "mot", "label": "Motion 2023/24:1832", "titel": "Kronobergs slottsruin", "undertitel": "av Tomas Eneroth och Monica Haider (båda S)"}, {"dok_id": "HB021874", "typ": "mot", "label": "Motion 2023/24:1874", "titel": "Statliga jobb och statlig service i hela landet", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB021885", "typ": "mot", "label": "Motion 2023/24:1885", "titel": "Kulturpolitiska frågor", "undertitel": "av Amanda Lind och Jacob Risberg (båda MP)"}, {"dok_id": "HB022107", "typ": "mot", "label": "Motion 2023/24:2107", "titel": "Statens företag", "undertitel": "av Jesper Skalberg Karlsson och Louise Meijer (båda M)"}, {"dok_id": "HB022258", "typ": "mot", "label": "Motion 2023/24:2258", "titel": "Minskning och effektivisering av den svenska byråkratin", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HB022414", "typ": "mot", "label": "Motion 2023/24:2414", "titel": "Statens myndigheter som drivkraft för flygets klimatomställning", "undertitel": "av Helena Gellerman (L)"}, {"dok_id": "HB022454", "typ": "mot", "label": "Motion 2023/24:2454", "titel": "Utbildning och forskning - för en stark kunskapsnation", "undertitel": "av Anders Ådahl m.fl. (C)"}, {"dok_id": "HB022455", "typ": "mot", "label": "Motion 2023/24:2455", "titel": "Digitalisering för hela Sverige", "undertitel": "av Niels Paarup-Petersen m.fl. (C)"}, {"dok_id": "HB022468", "typ": "mot", "label": "Motion 2023/24:2468", "titel": "Nya fastighetsmodeller hos Statens fastighetsverk för att bevara vårt kulturarv", "undertitel": "av