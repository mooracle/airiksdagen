erride": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "Utskottet avslår C-, V- och MP-yrkanden om olika former för skydd av skog med hänvisning till pågående arbete. Liberalerna vill värna skogsbruket samtidigt som gammelskogar ges skydd, i linje med regeringens balanserade hållning. Därför Ja.", "citations": [{"document": "valmanifest", "quote": "Allemansrätten och det svenska skogsbruket ska värnas", "princip": "varna skogsbruket"}, {"document": "partiprogram", "quote": "De återstående gammelskogarna ska ges starkare skydd.", "princip": "skydd gammelskog"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["osaker-reservation"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "explicit", "motivering": "Moderaterna vill att formellt skydd av skog ska ske genom frivillighet och värnar äganderätten. Utskottet avslår C-, V- och MP-motionerna om olika former för skydd av skog.", "citations": [{"document": "valmanifest", "quote": "Stärka skogsägarnas äganderätt genom att formellt skydd av skog ska ske genom frivillighet", "princip": "frivilligt skydd"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["governing-party-committee-line"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "medium", "coverage": "explicit", "motivering": "MP vill skydda särskilt värdefull skog och 30 procent av naturen. Bolunds MP-motion avslås, och reservation 13 för starkare skogsskydd bär partiets linje. Nej.", "citations": [{"document": "partiprogram", "quote": "Särskilt värdefull skog ska skyddas från avverkning.", "princip": "skydda värdefull skog"}, {"document": "valmanifest", "quote": "skydda 30 procent av Sveriges natur", "princip": "skydda 30 % av naturen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"ros