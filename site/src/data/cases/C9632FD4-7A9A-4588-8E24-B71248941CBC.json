], ["SD", "Ja", "Mattias Eriksson Falk", "Södermanlands län"], ["SD", "Ja", "Mattias Karlsson", "Kronobergs län"], ["SD", "Frånvarande", "Michael Rubbestad", "Örebro län"], ["SD", "Ja", "Mikael Eskilandersson", "Skåne läns norra och östra"], ["SD", "Ja", "Mona Olin", "Kalmar län"], ["SD", "Frånvarande", "Nima Gholam Ali Pour", "Malmö kommun"], ["SD", "Ja", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Ja", "Patrick Reslow", "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Frånvarande", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC02101", "typ": "mot", "label": "Motion 2024/25:101", "titel": "Stopp för högljudda fordon och street racing", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HC021062", "typ": "mot", "label": "Motion 2024/25:1062", "titel": "Skyltning längs med allmänna vägar", "undertitel": "av Christofer Bergenblock (C)"}, {"dok_id": "HC021092", "typ": "mot", "label": "Motion 2024/25:1092", "titel": "Djur i bussfil", "undertitel": "av Alexandra Anstrell (M)"}, {"dok_id": "HC021108", "typ": "mot", "label": "Motion 2024/25:1108", "titel": "Anpassade nummerplåtar till veteranbilar", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC021116", "typ": "mot", "label": "Motion 2024/25:1116", "titel": "Undantag för äldre fordon vid registrering", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC021117", "typ": "mot", "label": "Motion 2024/25:1117", "titel": "Återinförande av krav på stänkskydd på personbilar", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC02112", "typ": "mot", "label": "Motion 2024/25:112", "titel": "Tillåtande av klampning och borttransport av fordon vid felparkering", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HC02115", "typ": "mot", "label": "Motion 2024/25:115", "titel": "Utökade krav på transparens och ansvar för fordonstillverkare samt en teknikneutral definition av miljöbil", "undertitel": "av Rashid Farivar (SD)"}, {"dok_id": "HC0212", "typ": "mot", "label": "Motion 2024/25:12", "titel": "Motorsport och motorhobby", "undertitel": "av Josef Fransson (SD)"}, {"dok_id": "HC021286", "typ": "mot", "label": "Motion 2024/25:1286", "titel": "Ökat skydd av personuppgifter", "undertitel": "av Carita Boulwén (SD)"}, {"dok_id": "HC021385", "typ": "mot", "label": "Motion 2024/25:1385", "titel": "Insolvensrätt, bilmålvakter, olagliga bosättningar och övrigt", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HC021425", "typ": "mot", "label": "Motion 2024/25:1425", "titel": "En konkurrenskraftig svensk sjöfart", "undertitel": "av Thomas Morell m.fl. (SD)"}, {"dok_id": "HC021528", "typ": "mot", "label": "Motion 2024/25:1528", "titel": "Övergivna fordon", "undertitel": "av Malin Larsson och Peder Björk (båda S)"}, {"dok_id": "HC021530", "typ": "mot", "label": "Motion 2024/25:1530", "titel": "Raggarkultur och veteranbilar", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC021563", "typ": "mot", "label": "Motion 2024/25:1563", "titel": "Snöröjning av enskilda vägar", "undertitel": "av Helena Lindahl och Daniel Bäckström (båda C)"}, {"dok_id": "HC021568", "typ": "mot", "label": "Motion 2024/25:1568", "titel": "Information om vilka fordon en person äger", "undertitel": "av Daniel Bäckström (C)"}, {"dok_id": "HC021689", "typ": "mot", "label": "Motion 2024/25:1689", "titel": "Reglering av parkeringslagstiftningen", "undertitel": "av Hans Ekström (S)"}, {"dok_id": "HC021772", "typ": "mot", "label": "Motion 2024/25:1772", "titel": "Ett utsläppsfritt och transporteffektivt samhälle", "undertitel": "av Linus Lakso m.fl. (MP)"}, {"dok_id": "HC021854", "typ": "mot", "label": "Motion 2024/25:1854", "titel": "Lägre parkeringsavgift för utsläppsfria fordon", "undertitel": "av Kristina Axén Olin m.fl. (M)"}, {"dok_id": "HC022056", "typ": "mot", "label": "Motion 2024/25:2056", "titel": "För ett tryggare Malmö och Sverige", "undertitel": "av Niels Paarup-Petersen (C)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01TU11.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01TU11.html", "votering_url": "https://data.riksdagen.se/votering/C9632FD4-7A9A-4588-8E24-B71248941CBC/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01TU11/", "meta": {"type": "motion", "policy_area": "transport", "subject": {"sv": "Utbyggnad av laddinfrastruktur för elfordon", "en": "Expansion of charging infrastructure for electric vehicles"}, "at_stake": {"sv": "Tillgången till laddinfrastruktur med rätt effekt, på rätt plats och till rimligt pris är avgörande för att fler ska välja elfordon, särskilt för de som saknar egen laddmöjlighet hemma och för dem som reser längre sträckor. Takten i utbyggnaden påverkar också Sveriges fordonsindustri och möjligheten att nå klimatmålen för transportsektorn.", "en": "Access to charging infrastructure with the right power, in the right location and at a reasonable price is crucial for more people to choose electric vehicles, particularly those without their own charging option at home and those travelling longer distances. The pace of the expansion also affects Sweden's vehicle industry and the prospects of reaching the transport sector's climate targets."}, "subtopics": ["laddinfrastruktur", "elektrifiering", "elfordon", "klimatpolitik", "transportsektorn"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om riksdagen nu ska rikta nya krav om snabbare och mer samordnad utbyggnad av laddinfrastruktur - inklusive gemensam information om laddplatser mellan olika aktörer - eller om det pågående arbetet med statligt stöd, uppdrag till myndigheter och en utredning om elektrifierade transporter räcker för att driva utbyggnaden framåt.", "en": "The question is whether parliament should now issue new demands for a faster and more coordinated expansion of charging infrastructure - including shared information on charging locations across different operators - or whether the ongoing work involving government support, assignments to agencies, and an inquiry into electrified transport is sufficient to drive the expansion forward."}, "ja": {"sv": "Utskottet avstyrker motionerna om laddinfrastruktur. Skälet är att utskottet redan ser positivt på det omfattande stöd som finns för utbyggnaden, på de uppdrag som getts till berörda myndigheter för att göra stödgivningen effektivare, och på att en utredning om elektrifierade transporter nyligen lämnat sitt slutbetänkande och nu är ute på remiss, vilket utskottet vill följa vidare innan nya krav ställs.", "en": "The committee rejects the motions on charging infrastructure. The reason is that the committee already views favourably the extensive support available for the expansion, the assignments given to relevant agencies to make that support more effective, and the fact that an inquiry into electrified transport recently delivered its final report and is now out for consultation, which the committee wants to follow further before new demands are imposed."}, "nej": [{"alt_id": "res-5", "sv": "Reservationen (S) vill bygga ut laddinfrastrukturen i tillräcklig omfattning och takt över hela landet, och samordna information om laddplatser mellan olika aktörer, bland annat genom roaming, för att underlätta för elbilsägare som reser. Skälet är att en snabb och samhällsekonomiskt effektiv elektrifiering krävs för klimatmålen och för att Sveriges fordonsindustri ska hänga med i utvecklingen, och att bristande utbyggnad eller information annars riskerar att bli ett hinder.", "en": "The reservation (S) calls for expanding charging infrastructure sufficiently and quickly across the whole country, and for coordinating information about charging locations across different operators, including through roaming, to make things easier for electric-vehicle owners who travel. The reasoning is that fast, cost-effective electrification is needed to meet the climate targets and for Sweden's vehicle industry to keep pace with developments, and that insufficient expansion or information otherwise risks becoming a barrier."}]}}