D", "Frånvarande", "Mattias Karlsson", "Kronobergs län"], ["SD", "Avstår", "Michael Rubbestad", "Örebro län"], ["SD", "Avstår", "Mikael Eskilandersson", "Skåne läns norra och östra"], ["SD", "Avstår", "Mona Olin", "Kalmar län"], ["SD", "Avstår", "Nima Gholam Ali Pour", "Malmö kommun"], ["SD", "Avstår", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Avstår", "Patrick Reslow", "Malmö kommun"], ["SD", "Avstår", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Avstår", "Per Söderlund", "Örebro län"], ["SD", "Avstår", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Avstår", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Avstår", "Rasmus Giertz", "Dalarnas län"], ["SD", "Avstår", "Richard Jomshof", "Blekinge län"], ["SD", "Avstår", "Robert Stenkvist", "Stockholms län"], ["SD", "Avstår", "Roger Hedlund", "Gävleborgs län"], ["SD", "Avstår", "Runar Filper", "Värmlands län"], ["SD", "Avstår", "Sara Gille", "Dalarnas län"], ["SD", "Avstår", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Avstår", "Staffan Eklöf", "Jönköpings län"], ["SD", "Avstår", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Avstår", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Avstår", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Avstår", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021067", "typ": "mot", "label": "Motion 2024/25:1067", "titel": "Ny stiftelselag för små resurser och förnyade ändamål", "undertitel": "av Magnus Berntsson (KD)"}, {"dok_id": "HC021188", "typ": "mot", "label": "Motion 2024/25:1188", "titel": "Förändring av bokföringslagen", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HC021390", "typ": "mot", "label": "Motion 2024/25:1390", "titel": "Associationsrätt", "undertitel": "av Mikael Eskilandersson m.fl. (SD)"}, {"dok_id": "HC021470", "typ": "mot", "label": "Motion 2024/25:1470", "titel": "Brott mot företagare", "undertitel": "av Tobias Andersson m.fl. (SD)"}, {"dok_id": "HC022339", "typ": "mot", "label": "Motion 2024/25:2339", "titel": "Höjt krav på aktiekapital", "undertitel": "av Lars Isacsson (S)"}, {"dok_id": "HC022541", "typ": "mot", "label": "Motion 2024/25:2541", "titel": "Skydd för företagshemligheter", "undertitel": "av Boriana Åberg (M)"}, {"dok_id": "HC022613", "typ": "mot", "label": "Motion 2024/25:2613", "titel": "En grön klimathandlingsplan för Sverige 2025", "undertitel": "av Elin Söderberg m.fl. (MP)"}, {"dok_id": "HC023094", "typ": "mot", "label": "Motion 2024/25:3094", "titel": "Benefit corporation", "undertitel": "av Markus Wiechel och Alexander Christiansson (båda SD)"}, {"dok_id": "HC023111", "typ": "mot", "label": "Motion 2024/25:3111", "titel": "Utgiftsområde 4 Rättsväsendet", "undertitel": "av Teresa Carvalho m.fl. (S)"}, {"dok_id": "HC023164", "typ": "mot", "label": "Motion 2024/25:3164", "titel": "Rättspolitik", "undertitel": "av Ulrika Liljeberg m.fl. (C)"}, {"dok_id": "HC023190", "typ": "mot", "label": "Motion 2024/25:3190", "titel": "Skattepolitik", "undertitel": "av Niklas Karlsson m.fl. (S)"}, {"dok_id": "HC023196", "typ": "mot", "label": "Motion 2024/25:3196", "titel": "Finansiell stabilitet, finansmarknadsfrågor och betalningssystemet", "undertitel": "av Mikael Damberg m.fl. (S)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01CU11.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01CU11.html", "votering_url": "https://data.riksdagen.se/votering/D8D821AE-138D-48A8-A60F-B2CA891303A1/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01CU11/", "meta": {"type": "motion", "policy_area": "civil", "subject": {"sv": "Krav på aktiekapital och tvångslikvidation vid kapitalbrist", "en": "Minimum share capital requirements and forced liquidation for capital deficiency"}, "at_stake": {"sv": "Beslutet påverkar hur snabbt och på vilket sätt kraven på aktiebolag skärps för att motverka att företag används för brottslig verksamhet, vilket har betydelse för brottsbekämpningen och för seriösa småföretagare som kan påverkas av högre kapitalkrav.", "en": "The decision affects how quickly and in what way requirements on limited companies are tightened to counter the use of companies for criminal activity, which matters for law enforcement and for legitimate small business owners who may be affected by higher capital requirements."}, "subtopics": ["aktiekapital", "tvångslikvidation", "ekonomisk brottslighet", "aktiebolag", "brottsverktyg"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om riksdagen genom ett tillkännagivande ska uppmana regeringen att skyndsamt höja kravet på minsta aktiekapital i aktiebolag, som ett sätt att försvåra för kriminella att använda bolag som brottsverktyg, eller om riksdagen i stället ska avvakta den pågående beredningen av frågan om tvångslikvidation vid kapitalbrist inom Regeringskansliet.", "en": "The question is whether the Riksdag should, through a formal statement, call on the government to promptly raise the minimum share-capital requirement for limited companies, as a way to make it harder for criminals to use companies as tools for crime, or whether the Riksdag should instead await the ongoing preparatory work on forced liquidation for capital deficiency within the Government Offices."}, "ja": {"sv": "Utskottet konstaterar att förslaget om tvångslikvidation av aktiebolag på grund av kapitalbrist redan bereds inom Regeringskansliet och anser att riksdagen inte bör föregripa resultatet av den pågående beredningen, varför motionsyrkandena avstyrks.", "en": "The committee notes that the proposal on forced liquidation of limited companies due to capital deficiency is already being prepared within the Government Offices and considers that the Riksdag should not pre-empt the outcome of that ongoing work, and rejects the motions."}, "nej": [{"alt_id": "res-2", "sv": "Reservanten anser att ytterligare åtgärder behövs för att försvåra för gängkriminella att använda företag som brottsverktyg, bland annat genom att höja kravet på minsta aktiekapital, och att regeringen bör ta nödvändiga initiativ och återkomma till riksdagen med lagförslag.", "en": "The reservation holds that further measures are needed to make it harder for organised criminals to use companies as tools for crime, including by raising the minimum share-capital requirement, and that the government should take the necessary initiatives and bring legislative proposals to the Riksdag."}]}}