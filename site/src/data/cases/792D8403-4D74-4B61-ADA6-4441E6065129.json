 "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021324", "typ": "mot", "label": "Motion 2025/26:1324", "titel": "Grisars rätt till ett värdigt liv", "undertitel": "av Sanna Backeskog (S)"}, {"dok_id": "HD021457", "typ": "mot", "label": "Motion 2025/26:1457", "titel": "Rimliga veterinärkostnader för landets djurägare", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD021909", "typ": "mot", "label": "Motion 2025/26:1909", "titel": "Ändring i zoonosförordningen (1999:660) för en rättvis ersättning för slaktkyckling- och avelsproduktion", "undertitel": "av Laila Naraghi (S)"}, {"dok_id": "HD021957", "typ": "mot", "label": "Motion 2025/26:1957", "titel": "Kostnader och rättssäkerhet i samband med omhändertagande av djur", "undertitel": "av Jan Ericson (M)"}, {"dok_id": "HD022066", "typ": "mot", "label": "Motion 2025/26:2066", "titel": "Ny djurskötarutbildning", "undertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HD022259", "typ": "mot", "label": "Motion 2025/26:2259", "titel": "Brist på veterinärer", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022268", "typ": "mot", "label": "Motion 2025/26:2268", "titel": "Offentligt tack till jägare och frivilliga i arbetet med svinpesten", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022403", "typ": "mot", "label": "Motion 2025/26:2403", "titel": "Nationell journalföring för djur", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022467", "typ": "mot", "label": "Motion 2025/26:2467", "titel": "Förbud mot särskilt farliga hundraser", "undertitel": "av Fredrik Kärrholm (M)"}, {"dok_id": "HD022642", "typ": "mot", "label": "Motion 2025/26:2642", "titel": "Små slakterier", "undertitel": "av Anders W Jonsson (C)"}, {"dok_id": "HD022833", "typ": "mot", "label": "Motion 2025/26:2833", "titel": "Jord, skog, jakt", "undertitel": "av Helena Lindahl m.fl. (C)"}, {"dok_id": "HD022848", "typ": "mot", "label": "Motion 2025/26:2848", "titel": "Licenskrav för innehav av vissa hundraser", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022850", "typ": "mot", "label": "Motion 2025/26:2850", "titel": "En moderniserad hantering av tamdjur", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022853", "typ": "mot", "label": "Motion 2025/26:2853", "titel": "Förbud mot vilda djur på cirkus och valar i fångenskap", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022855", "typ": "mot", "label": "Motion 2025/26:2855", "titel": "Antibiotikaresistens", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HD022883", "typ": "mot", "label": "Motion 2025/26:2883", "titel": "Djurfri forskning och ansvarsfull antibiotikaanvändning", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HD022986", "typ": "mot", "label": "Motion 2025/26:2986", "titel": "Svart handel med kattungar - samkörning med Skatteverket", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HD023142", "typ": "mot", "label": "Motion 2025/26:3142", "titel": "Reformer för en stärkt hästnäring i Sverige", "undertitel": "av Patrik Karlson (L)"}, {"dok_id": "HD023264", "typ": "mot", "label": "Motion 2025/26:3264", "titel": "Fler veterinärer i Sverige", "undertitel": "av Alexandra Anstrell (M)"}, {"dok_id": "HD023367", "typ": "mot", "label": "Motion 2025/26:3367", "titel": "Idrott och rörelse för alla", "undertitel": "av Mats Berglund m.fl. (MP)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01MJU9.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01MJU9.html", "votering_url": "https://data.riksdagen.se/votering/792D8403-4D74-4B61-ADA6-4441E6065129/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01MJU9/", "meta": {"type": "motion", "policy_area": "environment", "subject": {"sv": "Forskning om smärtfria bedövningsmetoder vid slakt", "en": "Research into painless slaughter-stunning methods"}, "at_stake": {"sv": "Utfallet rör vilka bedövningsmetoder som används vid slakt av fisk, grisar och fåglar i Sverige, och om djur som slaktas i dag utsätts för onödig smärta och stress som skulle kunna minskas genom ny forskning.", "en": "The outcome concerns which stunning methods are used when slaughtering fish, pigs and birds in Sweden, and whether animals slaughtered today are subjected to unnecessary pain and stress that new research could help reduce."}, "subtopics": ["djurskydd", "slakt", "bedövning", "djurvälfärd", "forskning"], "parties_involved": ["S", "V", "MP"], "decision": {"sv": "Frågan gäller om regeringen bör ges i uppdrag att utreda förutsättningarna för mer forskning om smärtfria bedövningsmetoder vid slakt, eller om nuvarande metoder och regelverk för bedövning redan är tillräckliga.", "en": "The question is whether the government should be tasked with investigating the prospects for more research into painless slaughter-stunning methods, or whether current stunning methods and regulations are already adequate."}, "ja": {"sv": "Utskottet avslår motionen och ser inte skäl att nu ta ett särskilt initiativ för riktad forskning om smärtfria bedövningsmetoder vid slakt.", "en": "The committee rejects the motion and sees no reason to take a special initiative now for dedicated research into painless slaughter-stunning methods."}, "nej": [{"alt_id": "res-8", "sv": "Reservationen (S, V, MP) vill se över förutsättningarna för mer forskning om smärtfria bedövningsmetoder vid slakt, med hänvisning till att vanliga metoder som koldioxidbedövning av fiskar och grisar samt elbadsbedövning av fåglar innebär smärta och stress för djuren, i strid med djurskyddslagstiftningens princip om skydd mot onödigt lidande.", "en": "The reservation (S, V, MP) wants the prospects for more research into painless slaughter-stunning methods reviewed, arguing that common methods such as carbon-dioxide stunning of fish and pigs and electric-water-bath stunning of birds cause pain and stress for the animals, contrary to animal welfare legislation's principle of protecting animals from unnecessary suffering."}]}}