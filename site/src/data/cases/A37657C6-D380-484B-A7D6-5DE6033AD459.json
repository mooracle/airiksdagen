"Frånvarande", "Roger Hedlund", "Gävleborgs län"], ["SD", "Nej", "Runar Filper", "Värmlands län"], ["SD", "Nej", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Nej", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Nej", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Nej", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Nej", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Nej", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HA021266", "typ": "mot", "label": "Motion 2022/23:1266", "titel": "Förtroendevaldas närvaro och arvodessystemet", "undertitel": "av Markus Wiechel och Alexander Christiansson (båda SD)"}, {"dok_id": "HA022061", "typ": "mot", "label": "Motion 2022/23:2061", "titel": "Utgiftsområde 9 Hälsovård, sjukvård och social omsorg", "undertitel": "av Fredrik Lundh Sammeli m.fl. (S)"}, {"dok_id": "HA022225", "typ": "mot", "label": "Motion 2022/23:2225", "titel": "Regelverk för kommunala konkurser", "undertitel": "av Eric Palmqvist (SD)"}, {"dok_id": "HA022245", "typ": "mot", "label": "Motion 2022/23:2245", "titel": "En uppdaterad kommunallag i Sverige", "undertitel": "av Mattias Eriksson Falk (SD)"}, {"dok_id": "HA022246", "typ": "mot", "label": "Motion 2022/23:2246", "titel": "Ändringar i kommunallagen för bättre protokollföring", "undertitel": "av Mattias Eriksson Falk (SD)"}, {"dok_id": "HA02260", "typ": "mot", "label": "Motion 2022/23:260", "titel": "Politiska vildar", "undertitel": "av Mattias Ottosson (S)"}, {"dok_id": "HA0235", "typ": "mot", "label": "Motion 2022/23:35", "titel": "Tid för en ny kommunreform", "undertitel": "av Rasmus Ling (MP)"}, {"dok_id": "HA02873", "typ": "mot", "label": "Motion 2022/23:873", "titel": "Fyllnadsval i lagen om proportionellt valsätt", "undertitel": "av Michael Rubbestad (SD)"}, {"dok_id": "HA02878", "typ": "mot", "label": "Motion 2022/23:878", "titel": "Ansvarsfrihet och anmärkning i kommunallagen", "undertitel": "av Michael Rubbestad (SD)"}, {"dok_id": "HA02890", "typ": "mot", "label": "Motion 2022/23:890", "titel": "Talartid i fullmäktige enligt kommunallagen", "undertitel": "av Michael Rubbestad (SD)"}, {"dok_id": "HA02962", "typ": "mot", "label": "Motion 2022/23:962", "titel": "Några valfrågor", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HA02963", "typ": "mot", "label": "Motion 2022/23:963", "titel": "Några kommunala frågor", "undertitel": "av Matheus Enholm m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HA01KU29.json", "fulltext_url": "https://data.riksdagen.se/dokument/HA01KU29.html", "votering_url": "https://data.riksdagen.se/votering/A37657C6-D380-484B-A7D6-5DE6033AD459/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01KU29/", "meta": {"type": "motion", "policy_area": "constitution", "subject": {"sv": "Partiernas inflytande vid byte av partitillhörighet i kommun och region", "en": "Party influence when a local politician changes party affiliation"}, "at_stake": {"sv": "Frågan gäller vad som ska hända när en förtroendevald i kommun eller region byter parti eller blir politisk vilde. Det påverkar hur mandat och uppdrag knyts till partierna och hur väljarnas röst representeras i fullmäktige efter ett partibyte.", "en": "At stake is what happens when a locally elected official changes party or becomes an independent. It affects how mandates and posts are tied to parties and how voters' choices remain represented in the council after a party switch."}, "subtopics": ["kommunalpolitik", "partibyte", "förtroendevalda", "lokal demokrati", "mandat"], "parties_involved": ["SD"], "decision": {"sv": "Frågan gäller om partierna ska få ökat inflytande att entlediga förtroendevalda som byter partitillhörighet från uppdrag i nämnder, styrelser, bolag och stiftelser, eller om nuvarande ordning ska bestå.", "en": "The question is whether parties should gain greater power to remove elected representatives who change party affiliation from posts on boards, companies and foundations, or whether the current arrangement should remain."}, "ja": {"sv": "Utskottet avstyrker motionerna. Utskottet hänvisar till sina tidigare ställningstaganden och är inte berett att ta något initiativ till ökat partiinflytande när en förtroendevald byter partitillhörighet.", "en": "The committee rejects the motions. It refers to its earlier positions and is not prepared to take the initiative for greater party influence when an elected official changes party affiliation."}, "nej": [{"alt_id": "res-3", "sv": "Reservanten (SD) vill utreda hur mandaten tydligare kan knytas till partierna, så att politiska vildar ska kunna bli av med sina uppdrag i nämnder, styrelser, bolag och stiftelser där partiet är representerat.", "en": "The reservation (SD) wants an inquiry into how mandates can be more clearly tied to parties, so that political independents can lose their posts on boards, companies and foundations where the party is represented."}]}}