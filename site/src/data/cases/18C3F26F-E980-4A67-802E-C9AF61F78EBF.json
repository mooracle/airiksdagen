program_override": null}, "KD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "KD:s regeringsunderlag driver förenklade tillståndsprocesser via egen utredning och värnar äganderätten. Utskottet avslår motionerna om mineralersättning med hänvisning till pågående arbete. KD följer utskottslinjen och röstar Ja.", "citations": [{"document": "tidoavtalet", "quote": "En utredning tillsätts för att förenkla och förkorta miljötillståndsprövningen enligt miljöbalken", "princip": "förenklade tillståndsprocesser"}, {"document": "partiprogram", "quote": "är en kränkning av äganderätten och bör", "princip": "värna äganderätten"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Ersättningsfrågor vid mineralutvinning bereds inom regeringens arbete med tillståndsprocesser. L värnar äganderätten men stödjer utskottets avslag på övriga motioner i stället för att backa enskilda reservationer. Ja.", "citations": [{"document": "partiprogram", "quote": "Lagar och regler ska slå vakt om äganderätt", "princip": "äganderätt"}, {"document": "tidoavtalet", "quote": "Antalet myndigheter som för statens talan i tillståndsärenden bör begränsas.", "princip": "förenklade tillståndsprocesser"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Mineralersättning och äganderätt hanteras inom M:s egen politik för ansvarsfull utvinning och kortade tillståndsprocesser. Utskottet avslår motionerna med hänvisning till pågående arbete, och M stödjer regeringsunderlagets linje. Därför Ja.", "citations": [{"document": "valmanifest", "quote": "Våra rika mineraltillgångar ska kunna utvinnas ansvarsfullt och långsiktigt hållbart.", "princip": "ansvarsfull mineralutvinning"}, {"document": "partiprogram", "quote": "Äganderätten och näringsfriheten ska ha ett starkt skydd i", "princip": "stark äganderätt"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Avstår", "confidence": "low", "coverage": "inferred", "motivering": "MP:s egen motion om mineralersättning avslås, men motförslaget bygger främst på SD:s och C:s markägar- och exploateringsperspektiv. MP:s linje är i stället att miljöhänsyn väger tyngre än kortsiktiga exploateringsintressen och att samers rättigheter stärks – en position som varken utskottsförslaget eller reservationen fångar. MP avstår därför.", "citations": [{"document": "partiprogram", "quote": "Miljöhänsyn ska väga tyngre än", "princip": "miljöhänsyn väger tyngre"}, {"document": "valmanifest", "quote": "stärka nationella minoriteters och urfolket samernas rättigheter", "princip": "stärkta samiska rättigheter"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens innehåll okänt", "egen MP-linje skiljer sig från både förslag"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Ja", "confidence": "low", "coverage": "not_covered", "motivering": "Mineralersättning och äganderätt drivs i SD:s, C:s och MP:s yrkanden utan tydligt stöd i S egna dokument. Partiets mineralpolitiska linje förs på egna punkter; här stöds utskottets avslag (Ja).", "citations": [{"document": "partiprogram", "quote": "Alla har ett gemensamt intresse av att hela landet kan leva och utvecklas.", "princip": "hela landet ska leva"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["svag dokumenttäckning", "reservationens partihärkomst osäker"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "SD:s eget yrkande om mineralersättning avslås. SD vill att intäkter från råvaruutvinning i högre grad kommer lokalbygden till del och att hela landet får del av välståndet; reservationen driver högre ersättning. Därför Nej.", "citations": [{"document": "valmanifest", "quote": "hur intäkter från råvaruutvinning och industri sällan kommer lokalbygden till del", "princip": "utvinning ska gagna lokalbygden"}, {"document": "valmanifest", "quote": "Regionalisera fastighetsskatten från industri- och elproduktionsanläggningar", "princip": "intäkter till regionen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens partitillhörighet osäker (SD eller C)"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "Vänsterpartiets valmanifest slår fast att mer av naturresursernas värden måste stanna kvar där de utvinns och produceras. En reservation om höjd eller förändrad mineralersättning till lokalsamhälle och markägare ligger i linje med detta. Partiet bör rösta Nej till avslaget. Dokumenten berör dock frågan endast principiellt.", "citations": [{"document": "valmanifest", "quote": "Mer av naturresursernas värden måste stanna kvar där de utvinns och produceras.", "princip": "naturresursvärden stannar lokalt"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens_partihärkomst_oviss", "dokument_tyst_om_mineralpolitik"], "model": "claude-opus-4-8", "en": null, "program_override": null}}, "probe": null, "seats": [["V", "Nej", "Ali Esbati", "Stockholms kommun"], ["V", "Nej", "Andrea Andersson Tay", "Stockholms län"], ["V", "Nej", "Birger Lahti", "Norrbottens län"], ["V", "Nej", "Ciczie Weidby", "Jönköpings län"], ["V", "Frånvarande", "Daniel Riazat", "Stockholms län"], ["V", "Nej", "Frida Tånghag", "Göteborgs kommun"], ["V", "Nej", "Gudrun Nordborg", "Västerbottens län"], ["V", "Nej", "Hanna Gunnarsson", "Skåne läns södra"], ["V", "Nej", "Håkan Svenneling", "Värmlands län"], ["V", "Nej", "Ida Gabrielsson", "Stockholms kommun"], ["V",