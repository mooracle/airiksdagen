], ["SD", "Ja", "Mattias Karlsson", "Kronobergs län"], ["SD", "Ja", "Michael Rubbestad", "Örebro län"], ["SD", "Ja", "Mikael Eskilandersson", "Skåne läns norra och östra"], ["SD", "Ja", "Mona Olin", "Kalmar län"], ["SD", "Ja", "Nima Gholam Ali Pour", "Malmö kommun"], ["SD", "Frånvarande", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Ja", "Patrick Reslow", "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Frånvarande", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB021736", "typ": "mot", "label": "Motion 2023/24:1736", "titel": "med anledning av prop. 2023/24:12 Effektivare verktyg vid inre utlänningskontroll", "undertitel": "av Jonny Cato m.fl. (C)"}, {"dok_id": "HB02649", "typ": "mot", "label": "Motion 2023/24:649", "titel": "med anledning av prop. 2023/24:12 Effektivare verktyg vid inre utlänningskontroll", "undertitel": "av Tony Haddou m.fl. (V)"}, {"dok_id": "HB0312", "typ": "prop", "label": "Proposition 2023/24:12", "titel": "Effektivare verktyg vid inre utlänningskontroll", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01SfU6.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01SfU6.html", "votering_url": "https://data.riksdagen.se/votering/8BED0FF0-C542-46CE-9E39-E6293C76C7FF/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01SfU6/", "meta": {"type": "motion", "policy_area": "migration", "subject": {"sv": "Uppföljning av de nya befogenheterna vid inre utlänningskontroll", "en": "Follow-up of the new powers for internal immigration checks"}, "at_stake": {"sv": "En uppföljning skulle visa om de nya befogenheterna faktiskt bidrar till fler klarlagda identiteter och om åtgärderna är proportionerliga, vilket är särskilt viktigt för barn som berörs av kontrollerna.", "en": "A follow-up would show whether the new powers actually help clarify more identities and whether the measures are proportionate, which is especially important for children affected by the checks."}, "subtopics": ["uppföljning", "inre utlänningskontroll", "barnperspektiv", "proportionalitet", "polisens befogenheter"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om riksdagen ska uppmana regeringen att inom ett år följa upp de nya befogenheterna vid inre utlänningskontroll, inklusive ur ett barnperspektiv, eller om ingen sådan uppmaning behövs.", "en": "The question is whether parliament should call on the government to follow up the new powers for internal immigration checks within a year, including from a child's perspective, or whether no such formal request is needed."}, "ja": {"sv": "Utskottet bedömer att de nya befogenheterna är avgränsade och förenade med krav på dokumentation av besluten, och ser därför inte skäl för riksdagen att särskilt uppmana regeringen till en uppföljning inom en bestämd tid.", "en": "The committee considers that the new powers are limited in scope and subject to documentation requirements for the decisions taken, and therefore sees no reason for parliament to specifically call on the government to carry out a follow-up within a set time."}, "nej": [{"alt_id": "res-2", "sv": "Reservanten (C) anser att en uppföljning av de utökade befogenheterna bör göras inom ett år, inklusive ur ett barnperspektiv, för att säkerställa att åtgärderna är proportionerliga och faktiskt leder till att fler identiteter klarläggs.", "en": "The reservation (C) considers that a follow-up of the expanded powers should be carried out within a year, including from a child's perspective, to ensure the measures are proportionate and actually lead to more identities being clarified."}]}}