, "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Unni Björnerfors", "Stockholms kommun"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB021094", "typ": "mot", "label": "Motion 2023/24:1094", "titel": "Djur inom livsmedelsindustrin", "undertitel": "av Markus Wiechel och Victoria Tiblom (båda SD)"}, {"dok_id": "HB021101", "typ": "mot", "label": "Motion 2023/24:1101", "titel": "Fiskbestånden i Östersjön", "undertitel": "av John E Weinerhall (M)"}, {"dok_id": "HB021139", "typ": "mot", "label": "Motion 2023/24:1139", "titel": "Det industriella trålfisket i Östersjön", "undertitel": "av Kjell Jansson och Fredrik Ahlstedt (båda M)"}, {"dok_id": "HB021264", "typ": "mot", "label": "Motion 2023/24:1264", "titel": "Möjliggörande av stöd från EU till miljömotorer i fiskebåtar", "undertitel": "av Roland Utbult (KD)"}, {"dok_id": "HB021308", "typ": "mot", "label": "Motion 2023/24:1308", "titel": "Flytt av trålgränsen", "undertitel": "av Tomas Eneroth och Hanna Westerén (båda S)"}, {"dok_id": "HB021403", "typ": "mot", "label": "Motion 2023/24:1403", "titel": "Kvotfiske av den blåfenade tonfisken", "undertitel": "av Ann-Sofie Alm (M)"}, {"dok_id": "HB021459", "typ": "mot", "label": "Motion 2023/24:1459", "titel": "En levande och välmående skärgård", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HB021496", "typ": "mot", "label": "Motion 2023/24:1496", "titel": "Stärkt småskaligt och hållbart fiske", "undertitel": "av Linnéa Wickman m.fl. (S)"}, {"dok_id": "HB02166", "typ": "mot", "label": "Motion 2023/24:166", "titel": "Bevarandet av ålfiske", "undertitel": "av Björn Söder m.fl. (SD)"}, {"dok_id": "HB021873", "typ": "mot", "label": "Motion 2023/24:1873", "titel": "För havets och människans framtid", "undertitel": "av Emma Nohrén m.fl. (MP)"}, {"dok_id": "HB021920", "typ": "mot", "label": "Motion 2023/24:1920", "titel": "Ett system med fisketillsyningspersoner även längs med kusterna", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB021924", "typ": "mot", "label": "Motion 2023/24:1924", "titel": "Förbud mot bottentrålning för att skapa förutsättningar för friska och levande hav", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB021955", "typ": "mot", "label": "Motion 2023/24:1955", "titel": "Ekosystembaserad havsförvaltning", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB022209", "typ": "mot", "label": "Motion 2023/24:2209", "titel": "Levande fiske i Skåne", "undertitel": "av Ann-Charlotte Hammar Johnsson m.fl. (M)"}, {"dok_id": "HB022479", "typ": "mot", "label": "Motion 2023/24:2479", "titel": "Livskraftiga gröna och blå näringar", "undertitel": "av Daniel Bäckström m.fl. (C)"}, {"dok_id": "HB022487", "typ": "mot", "label": "Motion 2023/24:2487", "titel": "Förbättring av förhållandena för det kustnära fisket", "undertitel": "av Catarina Deremar och Anne-Li Sjölund (båda C)"}, {"dok_id": "HB02253", "typ": "mot", "label": "Motion 2023/24:253", "titel": "Långsiktigt hållbart fiske av strömming", "undertitel": "av Peder Björk och Anna-Belle Strömberg (båda S)"}, {"dok_id": "HB022536", "typ": "mot", "label": "Motion 2023/24:2536", "titel": "Satsning på Stockholms skärgård", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HB022540", "typ": "mot", "label": "Motion 2023/24:2540", "titel": "Bevarande av ålfisket som ett nationellt kulturarv", "undertitel": "av Lars Johnsson m.fl. (M)"}, {"dok_id": "HB022628", "typ": "mot", "label": "Motion 2023/24:2628", "titel": "Utgiftsområde 23 Areella näringar, landsbygd och livsmedel", "undertitel": "av Anna-Caren Sätherberg m.fl. (S)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01MJU10.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01MJU10.html", "votering_url": "https://data.riksdagen.se/votering/2360C1CE-3CD1-4709-8213-A7AC9A122506/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01MJU10/", "meta": {"type": "motion", "policy_area": "environment", "subject": {"sv": "Regelverk för vattenbruk och strandskydd", "en": "Regulatory framework for aquaculture and shoreline protection"}, "at_stake": {"sv": "Frågan gäller hur lätt eller svårt det ska vara att starta och driva vattenbruksverksamhet i Sverige. Det berör vattenbruksföretagare, landsbygdens sysselsättning och möjligheten att öka svensk livsmedelsproduktion, men också skyddet av stränder och kustmiljöer.", "en": "The question concerns how easy or difficult it should be to start and run aquaculture operations in Sweden. It affects aquaculture businesses, rural employment and the potential to increase Swedish food production, but also the protection of shorelines and coastal environments."}, "subtopics": ["vattenbruk", "strandskydd", "tillståndsprocesser", "landsbygdsnäring", "regelförenkling"], "parties_involved": ["C"], "decision": {"sv": "Riksdagen tar ställning till om regelverket för vattenbruk, inklusive strandskyddsreglerna, bör förenklas och göras mer gynnsamt för näringen, eller om nuvarande reglering ska ligga fast.", "en": "Parliament decides whether the regulatory framework for aquaculture, including shoreline protection rules, should be simplified and made more favourable to the industry, or whether current regulation should remain unchanged."}, "ja": {"sv": "Utskottet avslår motionsyrkandena om vattenbruk och pekar på att arbetet med att utveckla regelverket för näringen sker inom ramen för pågående processer, som utskottet inte vill föregripa.", "en": "The committee rejects the motions on aquaculture and points out that work to develop the industry's regulatory framework is taking place within ongoing processes, which the committee does not want to pre-empt."}, "nej": [{"alt_id": "res-15", "sv": "Centerpartiet vill anpassa regelverket bättre efter vattenbruksnäringens förutsättningar och undanta alla former av gårdsbaserat vattenbruk och gårdsbaserad fisketurism från strandskyddsreglerna, som man menar i onödan gör det dyrt, osäkert och komplicerat att starta vattenbruk i Sverige.", "en": "The Centre Party wants to better adapt the regulatory framework to the conditions of the aquaculture industry and exempt all forms of farm-based aquaculture and farm-based fishing tourism from the shoreline protection rules, which it argues unnecessarily make it expensive, uncertain and complicated to start aquaculture in Sweden."}]}}