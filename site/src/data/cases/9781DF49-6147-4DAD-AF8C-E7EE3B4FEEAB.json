ok_id": "HB021147", "typ": "mot", "label": "Motion 2023/24:1147", "titel": "Möjlighet att förvara och visa vissa kulturarvsföremål i deras hemort", "undertitel": "av Staffan Eklöf (SD)"}, {"dok_id": "HB021352", "typ": "mot", "label": "Motion 2023/24:1352", "titel": "Bevarande av minnet av varvsindustrin", "undertitel": "av Niklas Karlsson (S)"}, {"dok_id": "HB021371", "typ": "mot", "label": "Motion 2023/24:1371", "titel": "Minskade arkeologikostnader för kommuner och markägare", "undertitel": "av Magnus Oscarsson (KD)"}, {"dok_id": "HB0214", "typ": "mot", "label": "Motion 2023/24:14", "titel": "Museum för varvs- och industrihistoria i Göteborg", "undertitel": "av Björn Tidland (SD)"}, {"dok_id": "HB021433", "typ": "mot", "label": "Motion 2023/24:1433", "titel": "Samhällets stöd till och uppmuntran av landets samlare", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HB021469", "typ": "mot", "label": "Motion 2023/24:1469", "titel": "Hemvärnets militärhistoriska arv", "undertitel": "av Björn Söder (SD)"}, {"dok_id": "HB021524", "typ": "mot", "label": "Motion 2023/24:1524", "titel": "Politik för de nationella minoriteterna", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB021528", "typ": "mot", "label": "Motion 2023/24:1528", "titel": "En nationell arena för byggnadsvård", "undertitel": "av Janine Alm Ericson m.fl. (MP)"}, {"dok_id": "HB021532", "typ": "mot", "label": "Motion 2023/24:1532", "titel": "Uppåkra", "undertitel": "av Boriana Åberg m.fl. (M)"}, {"dok_id": "HB021613", "typ": "mot", "label": "Motion 2023/24:1613", "titel": "Finansiering av utgrävningar i Uppåkra", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HB021729", "typ": "mot", "label": "Motion 2023/24:1729", "titel": "Svenska minoriteter i utlandet", "undertitel": "av John E Weinerhall (M)"}, {"dok_id": "HB021734", "typ": "mot", "label": "Motion 2023/24:1734", "titel": "Runstensvård", "undertitel": "av Fredrik Malm (L)"}, {"dok_id": "HB021755", "typ": "mot", "label": "Motion 2023/24:1755", "titel": "Tillgängliggörande av bortglömda byggnader av historisk betydelse", "undertitel": "av Michael Rubbestad (SD)"}, {"dok_id": "HB021859", "typ": "mot", "label": "Motion 2023/24:1859", "titel": "Folkbildningens betydelse för det rullande kulturarvet", "undertitel": "av Isak From och Erik Ezelius (båda S)"}, {"dok_id": "HB02187", "typ": "mot", "label": "Motion 2023/24:187", "titel": "Jakt med löshund som ett världskulturarv", "undertitel": "av Magnus Persson (SD)"}, {"dok_id": "HB021885", "typ": "mot", "label": "Motion 2023/24:1885", "titel": "Kulturpolitiska frågor", "undertitel": "av Amanda Lind och Jacob Risberg (båda MP)"}, {"dok_id": "HB021962", "typ": "mot", "label": "Motion 2023/24:1962", "titel": "Minnesmonument över folkmordet i Srebrenica", "undertitel": "av Laila Naraghi m.fl. (S)"}, {"dok_id": "HB022068", "typ": "mot", "label": "Motion 2023/24:2068", "titel": "Skogspolitik med helhetssyn", "undertitel": "av Mattias Eriksson Falk m.fl. (SD)"}, {"dok_id": "HB022185", "typ": "mot", "label": "Motion 2023/24:2185", "titel": "Kostnaden för arkeologiska undersökningar", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HB022400", "typ": "mot", "label": "Motion 2023/24:2400", "titel": "Syrisk-ortodoxa kloster och kyrkor i Turkiet", "undertitel": "av Yusuf Aydin (KD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01KrU5.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01KrU5.html", "votering_url": "https://data.riksdagen.se/votering/9781DF49-6147-4DAD-AF8C-E7EE3B4FEEAB/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01KrU5/", "meta": {"type": "motion", "policy_area": "culture", "subject": {"sv": "Fortsatta insatser för nationella minoriteters språk och kultur", "en": "Further measures for national minorities' languages and culture"}, "at_stake": {"sv": "Beslutet påverkar hur väl de nationella minoriteterna, bland andra samer och tornedalingar, får sitt språk och sin kultur synliggjorda och stärkta i samhället, till exempel genom institutioner, platsnamn och högtidsdagar.", "en": "The decision affects how well the national minorities, including the Sámi and Tornedalians, have their languages and culture made visible and strengthened in society, for example through institutions, place names and days of recognition."}, "subtopics": ["nationella minoriteter", "minoritetsspråk", "samisk kultur", "tornedalsk kultur", "kulturarv"], "parties_involved": ["MP"], "decision": {"sv": "Frågan gäller om riksdagen nu ska besluta om nya åtgärder för nationella minoriteters språk och kultur, eller om pågående insatser och beredning ska få fortsätta utan nya tillkännagivanden.", "en": "The question is whether parliament should decide on new measures for the national minorities' languages and culture now, or whether ongoing efforts and preparation should continue without new directives to government."}, "ja": {"sv": "Utskottet delar uppfattningen att det är angeläget att stärka de nationella minoriteternas språk och kultur och konstaterar att omfattande insatser redan görs på området. Eftersom beredningen av redan lämnade förslag inte bör föregripas avstyrker utskottet motionerna, men avser att fortsätta följa frågan noga.", "en": "The committee shares the view that it is important to strengthen the national minorities' languages and culture and notes that extensive efforts are already under way in the area. Since it should not pre-empt the ongoing processing of proposals already submitted, the committee rejects the motions, while stating that it will continue to follow the issue closely."}, "nej": [{"alt_id": "res-20", "sv": "Reservanten vill göra Sápmi och de nationella minoriteterna mer synliga i samhället, bland annat genom att uppmuntra samiska ortnamn och genom att uppmärksamma samernas nationaldag och urfolksdagen, och vill inrätta ett permanent center för tornedalsk historia och kultur eftersom endast en institution i dag får statligt stöd för det tornedalska kulturarbetet.", "en": "The reservation wants to make Sápmi and the national minorities more visible in society, including by encouraging the use of Sámi place names and by marking the Sámi National Day and Indigenous Peoples' Day, and wants to establish a permanent centre for Tornedalian history and culture, since only one institution currently receives state funding for that work."}]}}