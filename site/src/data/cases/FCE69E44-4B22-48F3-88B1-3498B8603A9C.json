D", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021068", "typ": "mot", "label": "Motion 2025/26:1068", "titel": "Stärkt skydd för kvinnor och barn som lämnar våldsamma män", "undertitel": "av Carina Ödebrink m.fl. (S)"}, {"dok_id": "HD021072", "typ": "mot", "label": "Motion 2025/26:1072", "titel": "Barns rätt till sina föräldrar", "undertitel": "av Daniel Vencu Velasquez Castro (S)"}, {"dok_id": "HD0211", "typ": "mot", "label": "Motion 2025/26:11", "titel": "Reform av namnlagen", "undertitel": "av Robert Stenkvist (SD)"}, {"dok_id": "HD021103", "typ": "mot", "label": "Motion 2025/26:1103", "titel": "Arvode till vigselförrättare", "undertitel": "av Ulrika Heie (C)"}, {"dok_id": "HD02115", "typ": "mot", "label": "Motion 2025/26:115", "titel": "Undantag från samtyckeskravet i namnlagen", "undertitel": "av Angelica Lundberg (SD)"}, {"dok_id": "HD02118", "typ": "mot", "label": "Motion 2025/26:118", "titel": "Effektivare bodelningsprocess", "undertitel": "av Angelica Lundberg (SD)"}, {"dok_id": "HD021315", "typ": "mot", "label": "Motion 2025/26:1315", "titel": "Ersättningsnivån för borgerliga vigselförrättare", "undertitel": "av Per-Arne Håkansson (S)"}, {"dok_id": "HD021328", "typ": "mot", "label": "Motion 2025/26:1328", "titel": "Vårdnadstvister och konsekvenser", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HD021523", "typ": "mot", "label": "Motion 2025/26:1523", "titel": "Digitala testamenten - säkerställ skydd för äldre och utsatta mot otillbörlig påverkan", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HD021650", "typ": "mot", "label": "Motion 2025/26:1650", "titel": "Byte av efternamn på barn vid ensam vårdnad och skyddad identitet", "undertitel": "av Ludvig Ceimertz (M)"}, {"dok_id": "HD021788", "typ": "mot", "label": "Motion 2025/26:1788", "titel": "Betänketiden för äktenskapsskillnad", "undertitel": "av Boriana Åberg (M)"}, {"dok_id": "HD021816", "typ": "mot", "label": "Motion 2025/26:1816", "titel": "Barnets bästa i vårdnadsmål där en förälder dömts för sexualbrott", "undertitel": "av Aylin Nouri (S)"}, {"dok_id": "HD02183", "typ": "mot", "label": "Motion 2025/26:183", "titel": "Införande av en lag om digitalt arv", "undertitel": "av Victoria Tiblom (SD)"}, {"dok_id": "HD021993", "typ": "mot", "label": "Motion 2025/26:1993", "titel": "Blodprov för föräldratest", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022068", "typ": "mot", "label": "Motion 2025/26:2068", "titel": "Likvärdig myndighetsutövning vid borgerlig vigsel", "undertitel": "av Kerstin Lundgren (C)"}, {"dok_id": "HD022148", "typ": "mot", "label": "Motion 2025/26:2148", "titel": "Skyndsam hantering vid skilsmässa", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022264", "typ": "mot", "label": "Motion 2025/26:2264", "titel": "Förenklat regelverk för ensam förälder efter insemination", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022318", "typ": "mot", "label": "Motion 2025/26:2318", "titel": "Förenklad adoption", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022320", "typ": "mot", "label": "Motion 2025/26:2320", "titel": "Begränsning för kriminella att byta namn", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD02245", "typ": "mot", "label": "Motion 2025/26:245", "titel": "Förenkling av ekonomiska och juridiska processer för efterlevande", "undertitel": "av Johnny Svedin (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01CU12.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01CU12.html", "votering_url": "https://data.riksdagen.se/votering/FCE69E44-4B22-48F3-88B1-3498B8603A9C/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01CU12/", "meta": {"type": "motion", "policy_area": "civil", "subject": {"sv": "Evidensbaserade metoder och bevisfrågor i vårdnadstvister", "en": "Evidence-based methods and questions of evidence in custody disputes"}, "at_stake": {"sv": "I vårdnadstvister där våld förekommer eller påstås förekomma avgör kvaliteten på det underlag domstolen bygger sitt beslut på hur rättssäkert och tryggt utfallet blir för barnet och den utsatta föräldern. Kravet på evidensbaserade metoder syftar till att minska risken för att obestyrkta teorier eller ogrundade påståenden får för stort genomslag i sådana avgöranden.", "en": "In custody disputes where violence occurs or is alleged, the quality of the material the court bases its decision on determines how legally secure and safe the outcome is for the child and the parent at risk. The call for evidence-based methods aims to reduce the risk that unsubstantiated theories or unfounded claims carry too much weight in such rulings."}, "subtopics": ["familjemål", "vårdnadstvister", "bevisföring", "våld i nära relation", "domarkompetens", "föräldraalienation"], "parties_involved": ["V", "C", "MP"], "decision": {"sv": "Frågan gäller om regeringen ska åläggas att vidta generella åtgärder för att säkerställa att evidensbaserade metoder används i vårdnadstvister, särskilt när det finns uppgifter om våld, eller om nuvarande principer om fri bevisföring och domstolarnas egen bevisvärdering ska gälla oförändrade.", "en": "The question is whether the government should be directed to take general measures to ensure evidence-based methods are used in custody disputes, particularly where there are allegations of violence, or whether the current principles of free presentation of evidence and the courts' own assessment of evidence should remain unchanged."}, "ja": {"sv": "Utskottet avstyrker samtliga motionsyrkanden. Utskottet står fast vid tidigare ställningstaganden och framhåller att det är parterna själva som lägger upp sin argumentation och åberopar bevisning i svensk rätt, varefter domstolen värderar bevisningen fritt; att begränsa vilken bevisning som får åberopas skulle urholka principerna om fri bevisföring och fri bevisvärdering. Utskottet ser inte heller skäl att utreda teorier om föräldraalienation eller att gå vidare med särskilda kompetenskrav för domare utöver den utbildning som redan sker inom Sveriges Domstolar.", "en": "The committee rejects all the motions. The committee stands by its previous positions and stresses that under Swedish law it is the parties themselves who present their arguments and invoke evidence, after which the court freely assesses that evidence; restricting which evidence may be invoked would undermine the principles of free presentation and free assessment of evidence. The committee also sees no reason to investigate theories of parental alienation or to proceed with special competence requirements for judges beyond the training already provided within the Swedish courts system."}, "nej": [{"alt_id": "res-23", "sv": "Reservationen (V, C, MP) vill att regeringen vidtar generella åtgärder för att säkerställa att evidensbaserade metoder används i vårdnadstvister och ligger till grund för domsluten, särskilt när det förekommer uppgifter om våld. Skälet är att lagstiftning och myndigheters styrande dokument i dag är otydliga, och att evidens och vetenskap måste vara bärande för att våldsutsatta kvinnor och barn ska kunna garanteras en rättssäker och rättvis prövning.", "en": "The reservation (V, C, MP) calls for the government to take general measures to ensure that evidence-based methods are used in custody disputes and form the basis for court rulings, particularly where there are allegations of violence. The reasoning is that current legislation and agencies' guiding documents are unclear, and that evidence and science must underpin such disputes for abused women and children to be guaranteed a legally secure and fair hearing."}]}}