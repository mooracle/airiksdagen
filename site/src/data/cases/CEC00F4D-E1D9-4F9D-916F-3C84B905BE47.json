ram_override": null}, "KD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "KD:s arbetsmarknadssyn bygger på parternas ansvar och att staten verkar genom rådgivning och stöd snarare än nya pålagor. Oppositionens (S, MP) förslag om sanktionsavgifter avvisas därför. Utskottets avslag stöds med Ja.", "citations": [{"document": "partiprogram", "quote": "Utformningen ska göras av arbetsmarknadens parter.", "princip": "parternas ansvar"}, {"document": "partiprogram", "quote": "Staten ska bland annat genom rådgivning, stöd och kontroll aktivt verka för en förbättrad", "princip": "stödjande stat"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["motionsavslag"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "L värnar partsmodellen och driver arbetsmiljöfrågor inom regeringens politik. S- och MP-yrkandena om sanktionsavgifter motsvarar ingen bindande L-utfästelse, varför utskottets avslag stöds = Ja.", "citations": [{"document": "partiprogram", "quote": "villkoren i huvudsak bestäms genom avtal och inte i lag", "princip": "svenska partsmodellen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["citat_blockerat"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Utskottet avslår S- och MP-yrkanden om sanktionsavgifter i arbetsmiljön med hänvisning till pågående arbete och partsmodellen. M motsätter sig ökade regelbördor och står bakom regeringslinjen. Därför Ja till avslag.", "citations": [{"document": "valmanifest", "quote": "Ta bort en tredjedel av företagens administrationskostnader och en tredjedel av regelkrånglet", "princip": "minskad regelbörda"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Nej", "confidence": "medium", "coverage": "inferred", "motivering": "Ärendet om sanktionsavgifter i arbetsmiljön bär MP:s egna motioner (Westerlund, Stenevi). MP vill ha en stark arbetsmiljö med verkningsfulla påföljder. MP stödjer reservationen mot avslaget.", "citations": [{"document": "partiprogram", "quote": "Alla har rätt till friskvård och en god fysisk och psykosocial arbetsmiljö.", "princip": "stark arbetsmiljö/sanktioner"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Nej", "confidence": "medium", "coverage": "inferred", "motivering": "Ärendet gäller sanktionsavgifter på arbetsmiljöområdet, med en S-motion (Carvalho) i underlaget. S vill ta krafttag mot arbetslivskriminalitet och förstärka Arbetsmiljöverket; partiet bör stödja reservationen.", "citations": [{"document": "budgetmotion", "quote": "Arbetsmiljöverkets anslag ska förstärkas med 100 miljoner kronor för att arbetet mot fusk och arbetslivskriminalitet ska kunna intensifieras.", "princip": "skärpt mot arbetslivskriminalitet"}, {"document": "valmanifest", "quote": "Krafttag mot arbetslivskriminaliteten.", "princip": "krafttag arbetslivskriminalitet"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "SD vill värna den svenska partsmodellen och avpolitisera arbetsmiljöarbetet snarare än att bygga ut fackligt drivna regelverk och sanktioner. Utskottet avslår S/MP-motionerna med hänvisning till pågående arbete och parternas ansvar, vilket ligger i linje med SD:s dokument. Därför Ja till utskottets förslag.", "citations": [{"document": "valmanifest", "quote": "Sverigedemokraterna vill avpolitisera arbetsmiljöarbetet genom att avveckla politiskt styrda fackförbunds företrädesrätt att utse skyddsombud.", "princip": "avpolitisera arbetsmiljöarbetet"}, {"document": "valmanifest", "quote": "Försvara den svenska modellen", "princip": "värna partsmodellen"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens partihärkomst oviss"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "V": {"rost": "Nej", "confidence": "medium", "coverage": "inferred", "motivering": "V försvarar en stark arbetsrättslagstiftning och skyddet för anställda mot maktfullkomlighet och godtycke. En reservation som skärper sanktioner och arbetsmiljöansvar ligger i linje med detta, medan utskottets avslag inte gör det. V bör rösta Nej.", "citations": [{"document": "valmanifest", "quote": "Vänsterpartiet kommer att fortsätta försvara förhandlingsrätten och en stark arbetsrättslagstiftning.", "princip": "stark arbetsrätt"}, {"document": "valmanifest", "quote": "Kollektivavtalen och arbetsrättslagstiftningen säkerställer ett grundläggande inflytande och skyddar oss anställda från maktfullkomlighet och godtycke.", "princip": "skydd för anställda"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["sanktionsavgifter ej explicit"], "model": "claude-opus-4-8", "en": null, "program_override": null}}, "probe": null, "seats": [["V", "Nej", "Ali Esbati", "Stockholms kommun"], ["V", "Nej", "Andrea Andersson Tay", "Stockholms län"], ["V", "Nej", "Birger Lahti", "Norrbottens län"], ["V", "Nej", "Ciczie Weidby", "Jönköpings län"], ["V", "Nej", "Daniel Riazat", "Stockholms län"], ["V", "Nej", "Frida Tånghag", "Göteborgs kommun"], ["V", "Nej", "Gudrun Nordborg", "Västerbottens län"], ["V", "Nej", "Hanna Gunnarsson", "Skåne läns södra"], ["V", "Nej", "Håkan Svenneling", "Värmlands län"], ["V", "Frånvarande", "Ida Gabrielsson", "Stockholms kommun"], ["V", "Nej", "Ilona Szatmári Waldau", "Uppsala län"], ["V", "Nej", "Isabell Mixter", "Västernorrlands län"], ["V", "Nej", "Jessica Wetterling", "Västra Götalands läns västra"], ["V", "Nej", "Kajsa Fredholm", "Dalarnas län"], ["V", "Nej", "Karin Rågsjö", "Stockholms kommun"], ["V", "Nej", "Linda W 