url": "https://data.riksdagen.se/votering/9CA058BC-473D-4C43-817F-C51892F34C18/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01NU19/", "meta": {"type": "proposition", "policy_area": "business", "subject": {"sv": "Ny prövningsordning för kärntekniska anläggningar", "en": "New review and approval process for nuclear facilities"}, "at_stake": {"sv": "Prövningsordningen avgör hur nya kärntekniska anläggningar godkänns och regleras, vilket påverkar både utbyggnaden av kärnkraft och miljö- och säkerhetsprövningen kring den.", "en": "The review process determines how new nuclear facilities are approved and regulated, affecting both the expansion of nuclear power and the environmental and safety scrutiny around it."}, "subtopics": ["kärnkraft", "kärnteknisk anläggning", "tillståndsprövning", "miljöbalken", "strålskydd"], "parties_involved": ["S", "V", "C", "MP"], "decision": {"sv": "Frågan gäller om riksdagen ska anta regeringens förslag till en ny prövningsordning för kärntekniska anläggningar, med ändringar i flera lagar, eller om förslaget ska avslås.", "en": "The question is whether parliament should adopt the government's proposal for a new review and approval process for nuclear facilities, involving changes to several laws, or reject the proposal."}, "ja": {"sv": "Utskottet ställer sig bakom regeringens förslag till en ny prövningsordning för kärntekniska anläggningar och tillstyrker de sex lagändringarna av de skäl som anförs i propositionen.", "en": "The committee backs the government's proposal for a new review process for nuclear facilities and endorses the six legislative amendments for the reasons set out in the government bill."}, "nej": [{"alt_id": "res-1", "sv": "Reservanterna motsätter sig regeringens nya prövningsordning för kärntekniska anläggningar av flera skäl, som utvecklas närmare i särskilda yttranden, och vill att propositionen avslås.", "en": "The reservation opposes the government's new review process for nuclear facilities for several reasons, elaborated in separate individual statements, and wants the government bill rejected."}]}}