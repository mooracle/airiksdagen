ag om företag, kapital och fastighet i motioner från den allmänna motionstiden 2023. Riksdagen hänvisar bland annat till att riksdagen redan har tagit ställning i de aktuella frågorna eller att utredningar pågår.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motionerna \n\n2023/24:428 av Tobias Andersson m.fl. (SD) yrkande 7 och \n\n2023/24:1716 av Camilla Brunsberg (M).", "source_partier": []}, {"alt_id": "res-10", "text": "Reservation 10", "source_partier": ["SD"], "substance": {"sv": "Motförslaget vill att regeringen utreder möjligheten att låta företag kvitta förluster mot tidigare års vinster.", "en": "The counter-proposal wants the government to investigate the possibility for companies to offset losses against previous years' profits."}}], "actual": {"S": {"position": "Ja", "n_ja": 92, "n_nej": 0, "n_avstar": 0, "n_franvarande": 14, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Nej", "n_ja": 0, "n_nej": 63, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": true}, "V": {"position": "Ja", "n_ja": 21, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "L": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Ja", "n_ja": 13, "n_nej": 1, "n_avstar": 0, "n_franvarande": 4, "cohesion": 0.929, "authored_reservation": false}, "C": {"position": "Ja", "n_ja": 21, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "KD": {"position": "Ja", "n_ja": 15, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 60, "n_nej": 0, "n_avstar": 0, "n_franvarande": 8, "cohesion": 1.0, "authored_reservation": false}}, "ai": {"C": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "Centerpartiet vill värna det egna sparandet och motsätter 