 ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC02102", "typ": "mot", "label": "Motion 2024/25:102", "titel": "Kvalitetssäkring av personlig assistans", "undertitel": "av Gudrun Brunegård (KD)"}, {"dok_id": "HC021070", "typ": "mot", "label": "Motion 2024/25:1070", "titel": "Förbättrad och likvärdig ledsagning för dövblinda i hela landet", "undertitel": "av Magnus Berntsson (KD)"}, {"dok_id": "HC021114", "typ": "mot", "label": "Motion 2024/25:1114", "titel": "Kravet på särskilda skäl för assistans i skola och daglig verksamhet", "undertitel": "av Marléne Lund Kopparklint (M)"}, {"dok_id": "HC021252", "typ": "mot", "label": "Motion 2024/25:1252", "titel": "Nationellt kunskapscenter för dövfrågor", "undertitel": "av Jessica Rodén och Louise Thunström (båda S)"}, {"dok_id": "HC021333", "typ": "mot", "label": "Motion 2024/25:1333", "titel": "Goda levnadsförhållanden för människor med funktionsnedsättning", "undertitel": "av Ulrika Westerlund m.fl. (MP)"}, {"dok_id": "HC021367", "typ": "mot", "label": "Motion 2024/25:1367", "titel": "Ökad delaktighet", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021482", "typ": "mot", "label": "Motion 2024/25:1482", "titel": "Handläggning av bilstöd för anpassning av fordon", "undertitel": "av Helena Gellerman (L)"}, {"dok_id": "HC021694", "typ": "mot", "label": "Motion 2024/25:1694", "titel": "Habiliteringsersättning", "undertitel": "av Tomas Eneroth och Monica Haider (båda S)"}, {"dok_id": "HC021740", "typ": "mot", "label": "Motion 2024/25:1740", "titel": "Långsiktigt hållbar LSS", "undertitel": "av Carina Ståhl Herrstedt m.fl. (SD)"}, {"dok_id": "HC021796", "typ": "mot", "label": "Motion 2024/25:1796", "titel": "Utökat anhörigstöd till