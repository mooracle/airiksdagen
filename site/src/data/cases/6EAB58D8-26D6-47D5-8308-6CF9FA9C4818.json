tedt", "Västmanlands län"], ["SD", "Ja", "Patrick Reslow", "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Timothy Tréville", "Västra Götalands läns västra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"]], "references": [{"dok_id": "HD021048", "typ": "mot", "label": "Motion 2025/26:1048", "titel": "Ekonomi för ett jämlikt och hållbart samhälle", "undertitel": "av Jamal El-Haj (-)"}, {"dok_id": "HD021146", "typ": "mot", "label": "Motion 2025/26:1146", "titel": "Utredning av möjligheten att införa euron som svensk valuta", "undertitel": "av Anders Karlsson (C)"}, {"dok_id": "HD022493", "typ": "mot", "label": "Motion 2025/26:2493", "titel": "Tillväxtmål", "undertitel": "av Jesper Skalberg Karlsson (M)"}, {"dok_id": "HD022496", "typ": "mot", "label": "Motion 2025/26:2496", "titel": "Utökad budgetgranskning", "undertitel": "av Jesper Skalberg Karlsson (M)"}, {"dok_id": "HD023150", "typ": "mot", "label": "Motion 2025/26:3150", "titel": "Eurooption och färdplan inför 2029", "undertitel": "av Malin Danielsson m.fl. (L)"}, {"dok_id": "HD023421", "typ": "mot", "label": "Motion 2025/26:3421", "titel": "Klimatanpassning av Sverige 2026", "undertitel": "av Katarina Luhr m.fl. (MP)"}, {"dok_id": "HD023422", "typ": "mot", "label": "Motion 2025/26:3422", "titel": "En grön klimathandlingsplan 2026", "undertitel": "av Katarina Luhr m.fl. (MP)"}, {"dok_id": "HD024101", "typ": "mot", "label": "Motion 2025/26:4101", "titel": "med anledning av prop. 2025/26:100 2026 års ekonomiska vårproposition", "undertitel": "av Magdalena Andersson m.fl. (S)"}, {"dok_id": "HD024108", "typ": "mot", "label": "Motion 2025/26:4108", "titel": "med anledning av prop. 2025/26:100 2026 års ekonomiska vårproposition", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HD024109", "typ": "mot", "label": "Motion 2025/26:4109", "titel": "med anledning av skr. 2025/26:241 Riksrevisionens rapport om tillämpningen av det finanspolitiska ramverket 2025", "undertitel": "av Martin Ådahl (C)"}, {"dok_id": "HD024110", "typ": "mot", "label": "Motion 2025/26:4110", "titel": "med anledning av prop. 2025/26:100 2026 års ekonomiska vårproposition", "undertitel": "av Martin Ådahl m.fl. (C)"}, {"dok_id": "HD024118", "typ": "mot", "label": "Motion 2025/26:4118", "titel": "med anledning av prop. 2025/26:100 2026 års ekonomiska vårproposition", "undertitel": "av Daniel Helldén m.fl. (MP)"}, {"dok_id": "HD02617", "typ": "mot", "label": "Motion 2025/26:617", "titel": "Finanspolitiskt ramverk för klimatomställningen", "undertitel": "av Markus Kallifatides (S)"}, {"dok_id": "HD03100", "typ": "prop", "label": "Proposition 2025/26:100", "titel": "2026 års ekonomiska vårproposition", "undertitel": ""}, {"dok_id": "HD03241", "typ": "prop", "label": "Regeringens skrivelse 2025/26:241", "titel": "Riksrevisionens rapport om tillämpningen av det finanspolitiska ramverket 2025", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01FiU20.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01FiU20.html", "votering_url": "https://data.riksdagen.se/votering/6EAB58D8-26D6-47D5-8308-6CF9FA9C4818/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01FiU20/", "meta": {"type": "motion", "policy_area": "finance", "subject": {"sv": "Riksrevisionens rapport om tillämpningen av det finanspolitiska ramverket", "en": "The National Audit Office's report on application of the fiscal policy framework"}, "at_stake": {"sv": "Riksrevisionens granskning rör hur väl regeringens budgetpolitik följer det regelverk som ska säkra sunda offentliga finanser; utfallet påverkar förtroendet för den ekonomiska politiken och handlingsutrymmet för framtida regeringar.", "en": "The National Audit Office's review concerns how well government budget policy follows the framework meant to secure sound public finances; the outcome affects trust in economic policy and the room for manoeuvre of future governments."}, "subtopics": ["finanspolitiska ramverket", "Riksrevisionen", "budgetpolitik", "överskottsmål", "transparens"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om regeringens skrivelse med anledning av Riksrevisionens granskning av det finanspolitiska ramverket kan läggas till handlingarna utan vidare åtgärd, eller om granskningens kritik om bristande efterlevnad och transparens i budgetpolitiken kräver en förändrad inriktning.", "en": "The question is whether the government's report responding to the National Audit Office's review of the fiscal framework can simply be filed without further action, or whether the review's criticism of insufficient compliance and transparency in budget policy requires a change of course."}, "ja": {"sv": "Utskottet föreslår att motionen avslås och att skrivelsen med anledning av Riksrevisionens rapport läggs till handlingarna, utan att ytterligare åtgärder anses nödvändiga.", "en": "The Committee proposes that the motion be rejected and that the report responding to the National Audit Office's review be filed, without further action being considered necessary."}, "nej": [{"alt_id": "res-5", "sv": "C anser att Riksrevisionens rapport visar att regeringens politik varken är utformad i enlighet med det finanspolitiska ramverket eller redovisad på ett transparent sätt, att budgeten bygger på alltför optimistiska prognoser och en otillräcklig plan för återgång till överskottsmålet, samt att regeringen inte lyssnar på sina expertmyndigheter; en omedelbar återgång till ramverkets principer krävs.", "en": "C believes the National Audit Office's report shows that government policy is neither designed in accordance with the fiscal framework nor transparently reported, that the budget rests on overly optimistic forecasts and an inadequate plan for returning to the surplus target, and that the government does not listen to its expert authorities; an immediate return to the framework's principles is required."}]}}