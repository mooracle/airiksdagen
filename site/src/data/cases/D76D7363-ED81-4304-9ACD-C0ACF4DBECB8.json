arande": 3, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 20, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 60, "n_nej": 0, "n_avstar": 0, "n_franvarande": 8, "cohesion": 1.0, "authored_reservation": false}, "L": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 2, "cohesion": 1.0, "authored_reservation": false}}, "ai": {"C": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "Reservationen bygger på en SD-motion om ändrade antagningskrav till polisutbildningen. C:s dokument efterfrågar fler poliser och stärkta villkor, men uttalar sig inte om ändrade antagningskrav; SD:s specifika förslag är inte C:s linje. C bör därför stödja utskottets avslag och rösta Ja.", "citations": [{"document": "valmanifest", "quote": "Sverige behöver fler poliser, hårdare straff och bättre förebyggande insatser", "princip": "fler poliser, ej antagningskrav"}, {"document": "budgetmotion", "quote": "villkoren för poliser förbättras och yrkets attraktivitet stärkas", "princip": "bättre polisvillkor"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["dokument_tysta"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "KD": {"rost": "Ja", "confidence": "low", "coverage": "inferred", "motivering": "En SD-motion vill ändra antagningskraven till polisutbildningen. KD:s dokument tar inte ställning för just denna förändring, men prioriterar fler poliser och ett attraktivare polisyrke inom pågående arbete. Som regeringsparti stödjer KD utskottets avslag. Ja.", "citations": [{"document": "valmanifest", "quote": "Fler poliser och höjda polislöner.", "princip": "attraktivare polisyrke"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["svag_dokumenttackning", "reservation_innehall_ospecificerat"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "L": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "L vill ha fler och bättre poliser men driver polisreformen via regeringens gemensamma agenda, inte enskilda motioner. Utskottet avslår SD:s motion om antagningskrav med hänvisning till pågående arbete; L röstar Ja med utskottet.", "citations": [{"document": "valmanifest", "quote": "Därför vill vi på sikt nå 33 000 poliser så att polistätheten blir minst lika hög som i övriga Europa.", "princip": "fler poliser"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "M": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Voteringen avslår en SD-motion om antagningskrav till polisutbildningen. Moderaternas linje för att göra yrket attraktivt handlar om lönesatsning och avskrivna studielån, inte ändrade antagningskrav, och frågan bereds inom regeringens arbete. Därför Ja till avslag.", "citations": [{"document": "valmanifest", "quote": "Rikta en särskild lönesatsning till poliser – så att fler stannar kvar och söker sig till yrket", "princip": "attraktivare polisyrke"}, {"document": "valmanifest", "quote": "Skriva av studielånen för den som utbildar sig och börjar arbeta som polis", "princip": "rekrytering via förmåner"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": [], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Ja", "confidence": "medium", "coverage": "inferred", "motivering": "Motförslaget bygger på SD:s motion om antagningskrav till polisutbildningen. MP värnar mångfald av bakgrunder inom polisen och delar inte SD:s linje, varför partiet stödjer utskottets avslag.", "citations": [{"document": "partiprogram", "quote": "finns representerade inom både polis", "princip": "mångfald inom polisen"}], "omvarld": {"paverkar": false, "faktorer": []},