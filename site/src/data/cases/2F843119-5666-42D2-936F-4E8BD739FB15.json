SD", "Frånvarande", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Frånvarande", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Ulf Rexefjord", "Västra Götalands läns norra"], ["SD", "Ja", "Unni Björnerfors", "Stockholms kommun"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB021034", "typ": "mot", "label": "Motion 2023/24:1034", "titel": "Återinförande av estetiska ämnen på gymnasiet", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HB021040", "typ": "mot", "label": "Motion 2023/24:1040", "titel": "Bättre arbetsmiljö", "undertitel": "av Carina Ödebrink och Azra Muranovic (båda S)"}, {"dok_id": "HB02119", "typ": "mot", "label": "Motion 2023/24:119", "titel": "Totalförsvarskunskap i skolan", "undertitel": "av Eric Palmqvist (SD)"}, {"dok_id": "HB021223", "typ": "mot", "label": "Motion 2023/24:1223", "titel": "Utbildning för arbete", "undertitel": "av Martina Johansson (C)"}, {"dok_id": "HB021461", "typ": "mot", "label": "Motion 2023/24:1461", "titel": "Bättre matchning inför framtida yrkesval", "undertitel": "av Markus Wiechel och Alexander Christiansson (båda SD)"}, {"dok_id": "HB021462", "typ": "mot", "label": "Motion 2023/24:1462", "titel": "En samhällsförberedande skola", "undertitel": "av Markus Wiechel och Alexander Christiansson (båda SD)"}, {"dok_id": "HB021570", "typ": "mot", "label": "Motion 2023/24:1570", "titel": "Om stärkt trygghet för företagare", "undertitel": "av Mathias Tegnér och Jennie Nilsson (båda S)"}, {"dok_id": "HB021800", "typ": "mot", "label": "Motion 2023/24:1800", "titel": "Kortare tillståndsprocesser för nya gymnasiekurser", "undertitel": "av Lili André (KD)"}, {"dok_id": "HB021804", "typ": "mot", "label": "Motion 2023/24:1804", "titel": "Ung Företagsamhet i alla gymnasieutbildningar", "undertitel": "av Lili André (KD)"}, {"dok_id": "HB022095", "typ": "mot", "label": "Motion 2023/24:2095", "titel": "Drogtester i skolan för att motverka missbruk", "undertitel": "av Roger Hedlund och Mattias Eriksson Falk (båda SD)"}, {"dok_id": "HB022117", "typ": "mot", "label": "Motion 2023/24:2117", "titel": "Främjat entreprenörskap i grundskolan", "undertitel": "av Saila Quicklund (M)"}, {"dok_id": "HB022194", "typ": "mot", "label": "Motion 2023/24:2194", "titel": "Underlätta för ungdomar att få jobb och bostad", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HB022302", "typ": "mot", "label": "Motion 2023/24:2302", "titel": "Hantverkare för att bidra i en cirkulär ekonomi", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HB022305", "typ": "mot", "label": "Motion 2023/24:2305", "titel": "Företagsamhet och entreprenörskap för alla elever", "undertitel": "av Johanna Rantsi (M)"}, {"dok_id": "HB022447", "typ": "mot", "label": "Motion 2023/24:2447", "titel": "Barns och ungas tillgång till kultur", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB022451", "typ": "mot", "label": "Motion 2023/24:2451", "titel": "Utbildning och forskning för ett hållbart samhälle", "undertitel": "av Camilla Hansén m.fl. (MP)"}, {"dok_id": "HB022454", "typ": "mot", "label": "Motion 2023/24:2454", "titel": "Utbildning och forskning - för en stark kunskapsnation", "undertitel": "av Anders Ådahl m.fl. (C)"}, {"dok_id": "HB022482", "typ": "mot", "label": "Motion 2023/24:2482", "titel": "En skola för livsresor", "undertitel": "av Muharrem Demirok m.fl. (C)"}, {"dok_id": "HB022489", "typ": "mot", "label": "Motion 2023/24:2489", "titel": "Utbildning för livslångt lärande", "undertitel": "av Niels Paarup-Petersen m.fl. (C)"}, {"dok_id": "HB02254", "typ": "mot", "label": "Motion 2023/24:254", "titel": "En konkurrenskraftig och säker taxibransch i Sverige", "undertitel": "av Serkan Köse (S)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01UbU12.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01UbU12.html", "votering_url": "https://data.riksdagen.se/votering/2F843119-5666-42D2-936F-4E8BD739FB15/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01UbU12/", "meta": {"type": "motion", "policy_area": "education", "subject": {"sv": "Övriga frågor om branschskolor: fler branschskolor inom naturbruksområdet", "en": "Other issues concerning industry schools: more industry schools in agriculture and forestry"}, "at_stake": {"sv": "Branschskolor ger yrkesutbildning inom smala områden med få elever, ofta på orter där det annars inte skulle finnas ett tillräckligt elevunderlag. Utfallet påverkar därför möjligheten att utbilda sig till yrken med kompetensbrist på mindre orter, inte minst inom naturbruk.", "en": "Industry schools provide vocational training in niche fields with few students, often in places that would otherwise lack a large enough student base. The outcome therefore affects the opportunity to train for occupations facing skills shortages in smaller communities, not least within agriculture and forestry."}, "subtopics": ["branschskolor", "yrkesutbildning", "naturbruk", "gymnasieskolan", "landsbygd"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om riksdagen aktivt ska uppmana regeringen att bygga ut fler branschskolor, särskilt inom naturbruksområdet, eller om detta ska hanteras inom ramen för det arbete som redan pågår kring framtidens yrkesutbildningar.", "en": "The question is whether parliament should actively call on the government to expand the number of industry schools, particularly in agriculture and forestry, or whether this should instead be left to the work already under way on the future shape of vocational education."}, "ja": {"sv": "Utskottet hänvisar till att det redan pågår en utredning med uppdrag att föreslå hur behovet av utbildning inom små yrkesområden bättre kan tillgodoses inom gymnasieskolan, bland annat genom att dra nytta av erfarenheterna från försöksverksamheten med branschskolor. Med hänvisning till detta pågående arbete avstyrker utskottet motionsyrkandet om fler branschskolor inom naturbruksområdet.", "en": "The committee points to an ongoing inquiry tasked with proposing how the need for training in small vocational fields can be better met within upper-secondary education, including by drawing on experience from the industry-schools trial. In light of this ongoing work, the committee rejects the motion calling for more industry schools within agriculture and forestry."}, "nej": [{"alt_id": "res-6", "sv": "Reservationen (C) vill se fler branschskolor, bland annat inom naturbruksområdet, genom att permanenta och bredda försöksverksamheten till fler skolor och ämnesområden. Skälet är att fler yrkesförberedande utbildningar, liksom lärlingsplatser, behövs i hela landet för att möta arbetsmarknadens kompetensbehov och göra det möjligt att bedriva yrkesutbildning även på mindre orter.", "en": "The reservation (C) calls for more industry schools, including within agriculture and forestry, by making the trial scheme permanent and expanding it to more schools and subject areas. The reasoning is that more vocational-preparatory programmes, as well as apprenticeship places, are needed throughout the country to meet the labour market's skills needs and to make it possible to offer vocational training even in smaller communities."}]}}