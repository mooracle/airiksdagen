], ["SD", "Ja", "Michael Rubbestad", "Örebro län"], ["SD", "Ja", "Mikael Eskilandersson", "Skåne läns norra och östra"], ["SD", "Ja", "Mona Olin", "Kalmar län"], ["SD", "Ja", "Nima Gholam Ali Pour", "Malmö kommun"], ["SD", "Ja", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Ja", "Patrick Reslow", "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Frånvarande", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Unni Björnerfors", "Stockholms kommun"], ["SD", "Frånvarande", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB022829", "typ": "mot", "label": "Motion 2023/24:2829", "titel": "med anledning av prop. 2023/24:84 Säkerhetszoner", "undertitel": "av Gudrun Nordborg m.fl. (V)"}, {"dok_id": "HB022831", "typ": "mot", "label": "Motion 2023/24:2831", "titel": "med anledning av prop. 2023/24:84 Säkerhetszoner", "undertitel": "av Ardalan Shekarabi m.fl. (S)"}, {"dok_id": "HB022832", "typ": "mot", "label": "Motion 2023/24:2832", "titel": "med anledning av prop. 2023/24:84 Säkerhetszoner", "undertitel": "av Rasmus Ling m.fl. (MP)"}, {"dok_id": "HB022833", "typ": "mot", "label": "Motion 2023/24:2833", "titel": "med anledning av prop. 2023/24:84 Säkerhetszoner", "undertitel": "av Ulrika Liljeberg m.fl. (C)"}, {"dok_id": "HB0384", "typ": "prop", "label": "Proposition 2023/24:84", "titel": "Säkerhetszoner", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01JuU13.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01JuU13.html", "votering_url": "https://data.riksdagen.se/votering/AEE83524-D807-4B2A-86E1-A91FEF1FABB0/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01JuU13/", "meta": {"type": "motion", "policy_area": "justice", "subject": {"sv": "Krav på dokumentation vid polisens ingripanden i säkerhetszoner", "en": "Documentation requirements for police interventions in security zones"}, "at_stake": {"sv": "Beslutet påverkar rättssäkerheten för personer som visiteras av polisen i säkerhetszoner, och om de får ett tydligt, skriftligt besked om varför de blev stoppade.", "en": "The decision affects the legal certainty of people searched by police in security zones, and whether they receive a clear, written explanation of why they were stopped."}, "subtopics": ["security zones", "police searches", "documentation requirements", "legal certainty", "appeals process"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om den som visiteras i en säkerhetszon utöver protokollföring även ska få ett kvitto med angiven orsak till visitationen, eller om regeringens förslag om säkerhetszoner är tillräckligt utformat som det är.", "en": "The question is whether a person searched in a security zone should, beyond the recording of a protocol, also receive a receipt stating the reason for the search, or whether the government's proposal on security zones is adequately designed as it stands."}, "ja": {"sv": "Utskottet anser att regeringens förslag om säkerhetszoner, inklusive möjligheten att överklaga beslut om säkerhetszoner till förvaltningsdomstol, är väl avvägt, proportionerligt och förenligt med grundläggande fri- och rättigheter, och avstyrker motionerna om ytterligare dokumentationskrav.", "en": "The committee considers the government's proposal on security zones, including the possibility of appealing security-zone decisions to an administrative court, to be well balanced, proportionate and consistent with fundamental rights and freedoms, and rejects the motions calling for additional documentation requirements."}, "nej": [{"alt_id": "res-5", "sv": "Reservanten (S) välkomnar förslaget om protokoll men vill utöver det se en förändring av polislagen som innebär att den som visiteras får ett kvitto där bland annat orsaken till visitationen anges, för att öka rättssäkerheten.", "en": "The reservation (S) welcomes the proposal for a protocol but additionally wants a change to the Police Act so that a person who is searched receives a receipt stating, among other things, the reason for the search, in order to strengthen legal certainty."}]}}