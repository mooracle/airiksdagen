"SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Frånvarande", "Sven-Olof Sällström", "Östergötlands län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Ulf Rexefjord", "Västra Götalands läns norra"], ["SD", "Ja", "Unni Björnerfors", "Stockholms kommun"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB021123", "typ": "mot", "label": "Motion 2023/24:1123", "titel": "Opinionsbildande myndigheter och statliga bolag", "undertitel": "av Helena Storckenfeldt och Lars Püss (båda M)"}, {"dok_id": "HB021153", "typ": "mot", "label": "Motion 2023/24:1153", "titel": "Precisering av proportionalitetsprincipens tillämpning i förvaltningslagen", "undertitel": "av Staffan Eklöf (SD)"}, {"dok_id": "HB021265", "typ": "mot", "label": "Motion 2023/24:1265", "titel": "Offentlig information på lättläst svenska", "undertitel": "av Anne-Li Sjölund och Ulrika Heie (båda C)"}, {"dok_id": "HB021394", "typ": "mot", "label": "Motion 2023/24:1394", "titel": "Begränsning av rätten till tolk", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HB021628", "typ": "mot", "label": "Motion 2023/24:1628", "titel": "För ett tryggare Malmö och Sverige", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HB021671", "typ": "mot", "label": "Motion 2023/24:1671", "titel": "Stärkt demokrati", "undertitel": "av Alexandra Völker och Azadeh Rojhan (båda S)"}, {"dok_id": "HB021688", "typ": "mot", "label": "Motion 2023/24:1688", "titel": "Införandet av tjänstemannaansvar", "undertitel": "av Larry Söder (KD)"}, {"dok_id": "HB02173", "typ": "mot", "label": "Motion 2023/24:173", "titel": "Ukrainsk stavning på Ukrainas huvudstad", "undertitel": "av Markus Wiechel (SD)"}, {"dok_id": "HB021874", "typ": "mot", "label": "Motion 2023/24:1874", "titel": "Statliga jobb och statlig service i hela landet", "undertitel": "av Amanda Lind m.fl. (MP)"}, {"dok_id": "HB022170", "typ": "mot", "label": "Motion 2023/24:2170", "titel": "En säkrare myndighetsutövning", "undertitel": "av Helena Storckenfeldt (M)"}, {"dok_id": "HB0224", "typ": "mot", "label": "Motion 2023/24:24", "titel": "Åtgärder mot korruption, vänskapskorruption och nepotism inom kommunala och regionala verksamheter", "undertitel": "av Johnny Svedin (SD)"}, {"dok_id": "HB022413", "typ": "mot", "label": "Motion 2023/24:2413", "titel": "Kampen mot separatismen", "undertitel": "av Mauricio Rojas m.fl. (L)"}, {"dok_id": "HB022455", "typ": "mot", "label": "Motion 2023/24:2455", "titel": "Digitalisering för hela Sverige", "undertitel": "av Niels Paarup-Petersen m.fl. (C)"}, {"dok_id": "HB022490", "typ": "mot", "label": "Motion 2023/24:2490", "titel": "Demokrati och konstitution", "undertitel": "av Malin Björk m.fl. (C)"}, {"dok_id": "HB022527", "typ": "mot", "label": "Motion 2023/24:2527", "titel": "Ett transparent skattesystem", "undertitel": "av Markus Wiechel och Alexander Christiansson (båda SD)"}, {"dok_id": "HB022685", "typ": "mot", "label": "Motion 2023/24:2685", "titel": "Utgiftsområde 1 Rikets styrelse", "undertitel": "av Ida Karkiainen m.fl. (S)"}, {"dok_id": "HB02415", "typ": "mot", "label": "Motion 2023/24:415", "titel": "Post och it i hela landet", "undertitel": "av Jimmy Ståhl m.fl. (SD)"}, {"dok_id": "HB02443", "typ": "mot", "label": "Motion 2023/24:443", "titel": "Regional tillväxt - För ett levande Sverige", "undertitel": "av Tobias Andersson m.fl. (SD)"}, {"dok_id": "HB02463", "typ": "mot", "label": "Motion 2023/24:463", "titel": "Ett Sverige fritt från rasism", "undertitel": "av Tony Haddou m.fl. (V)"}, {"dok_id": "HB02468", "typ": "mot", "label": "Motion 2023/24:468", "titel": "Offentlig förvaltning", "undertitel": "av Matheus Enholm m.fl. (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01KU8.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01KU8.html", "votering_url": "https://data.riksdagen.se/votering/9FD8DB60-5D6D-4D2A-9132-5655B72AE885/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01KU8/", "meta": {"type": "motion", "policy_area": "constitution", "subject": {"sv": "Åtgärder för att stärka demokratisk delaktighet, särskilt för personer med funktionsnedsättning", "en": "Measures to strengthen democratic participation, particularly for people with disabilities"}, "at_stake": {"sv": "Hur tillgängliga val och offentlig information är påverkar om alla medborgare, inte minst personer med funktionsnedsättning, i praktiken kan delta i de demokratiska processerna på lika villkor.", "en": "How accessible elections and public information are affects whether all citizens, not least people with disabilities, can in practice take part in democratic processes on equal terms."}, "subtopics": ["demokrati", "delaktighet", "funktionsnedsättning", "val", "tillgänglighet"], "parties_involved": ["C"], "decision": {"sv": "Frågan gäller om befintliga mål för demokrati- och funktionshinderspolitiken samt den pågående översynen av valsystemet räcker, eller om riksdagen bör ta ett eget initiativ för att staten mer aktivt ska arbeta för ökad demokratisk delaktighet, till exempel genom mer tillgängliga vallokaler och valinformation.", "en": "The question is whether the existing goals for democracy and disability policy, together with the ongoing review of the electoral system, are sufficient, or whether parliament should take its own initiative for the state to work more actively to increase democratic participation, for example through more accessible polling stations and election information."}, "ja": {"sv": "Utskottet instämmer i att den demokratiska delaktigheten bör vara så stor som möjligt, men pekar på att det redan finns fastställda mål för demokratipolitiken och funktionshinderspolitiken samt att en parlamentarisk kommitté ser över valsystemet. Utskottet finner därför inte skäl för riksdagen att ta ett eget initiativ och avstyrker motionerna.", "en": "The committee agrees that democratic participation should be as broad as possible, but notes that established goals for democracy policy and disability policy already exist, and that a parliamentary committee is reviewing the electoral system. The committee therefore finds no grounds for parliament to take its own initiative and rejects the motions."}, "nej": [{"alt_id": "res-1", "sv": "Reservationen (C) vill att regeringen aktivt verkar för ökad demokratisk delaktighet, från möjligheten att rösta till att kunna ta del av offentliga handlingar. Reservanterna pekar särskilt på personer med funktionsnedsättning och vill att vallokaler anpassas för att säkerställa valhemligheten, att myndigheter erbjuder lättläst information inför val samt information anpassad för nedsatt syn och hörsel, och att lokaler där demokratin utövas görs tillgängliga för alla.", "en": "The reservation (C) calls for the government to actively work for increased democratic participation, from the ability to vote to accessing public documents. It highlights people with disabilities in particular, calling for polling stations to be adapted to safeguard the secrecy of the ballot, for authorities to provide easy-to-read election information as well as information adapted for impaired sight and hearing, and for venues where democracy is exercised to be made accessible to everyone."}]}}