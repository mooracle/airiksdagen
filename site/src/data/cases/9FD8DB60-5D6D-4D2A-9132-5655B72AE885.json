onstiden 2023.\nMotionerna handlar bland annat om främjande av demokrati, statlig anställning, korruption och skydd av beslutsfattare.\nRiksdagen hänvisar bland annat till gällande bestämmelser och pågående arbete.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motion \n\n2023/24:2490 av Malin Björk m.fl. (C) yrkandena 6 och 7.", "source_partier": []}, {"alt_id": "res-1", "text": "Reservation 1", "source_partier": ["C"], "substance": {"sv": "Motförslaget vill stärka tillgängligheten för personer med funktionsnedsättning i alla demokratiska processer och säkerställa att val- och möteslokaler är fullt anpassade.", "en": "The counter-proposal wants to strengthen accessibility for people with disabilities in all democratic processes and ensure that polling and meeting venues are fully adapted."}}], "actual": {"C": {"position": "Nej", "n_ja": 0, "n_nej": 20, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": true}, "S": {"position": "Ja", "n_ja": 91, "n_nej": 0, "n_avstar": 0, "n_franvarande": 15, "cohesion": 1.0, "authored_reservation": false}, "MP": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 20, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "KD": {"position": "Ja", "n_ja": 15, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Ja", "n_ja": 62, "n_nej": 0, "n_avstar": 0, "n_franvarande": 10, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 59, "n_nej": 0, "n_avstar": 0, "n_franvarande": 9, "cohesion": 1.0, "authored_reservation": false}, "L": {"position": "Ja", "n_ja": 13, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}}, "ai": {}, "probe": null, "seats": [["V", "Ja", "Andrea Andersson Tay", "Stockholms län"], ["V", "Ja