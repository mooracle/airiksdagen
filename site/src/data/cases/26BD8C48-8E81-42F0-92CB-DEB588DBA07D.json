, "Örebro län"], ["SD", "Ja", "Pia Trollehjelm", "Skåne läns västra"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Frånvarande", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Frånvarande", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021003", "typ": "mot", "label": "Motion 2025/26:1003", "titel": "Lärdomar från Finland: jägare som del av landets krisberedskap", "undertitel": "av Magnus Jacobsson (KD)"}, {"dok_id": "HD021016", "typ": "mot", "label": "Motion 2025/26:1016", "titel": "Översyn av polisens strategi vid upplopp", "undertitel": "av Camilla Rinaldo Miller och Magnus Jacobsson (båda KD)"}, {"dok_id": "HD021017", "typ": "mot", "label": "Motion 2025/26:1017", "titel": "Slopat krav på anmälan av danstillställning", "undertitel": "av Daniel Persson (SD)"}, {"dok_id": "HD02112", "typ": "mot", "label": "Motion 2025/26:112", "titel": "Förstärkt skydd och ökade befogenheter för ordningsvakter", "undertitel": "av Angelica Lundberg (SD)"}, {"dok_id": "HD021187", "typ": "mot", "label": "Motion 2025/26:1187", "titel": "En förenklad anmälningsprocess för företagare", "undertitel": "av Magnus Resare (M)"}, {"dok_id": "HD021220", "typ": "mot", "label": "Motion 2025/26:1220", "titel": "Rättspsykiatrin", "undertitel": "av Eva Lindh (S)"}, {"dok_id": "HD021236", "typ": "mot", "label": "Motion 2025/26:1236", "titel": "Utredning av behovet av att utveckla en nationell definition av brottsförebyggande arbete", "undertitel": "av Ingela Nylund Watz och Anna Vikström (båda S)"}, {"dok_id": "HD021277", "typ": "mot", "label": "Motion 2025/26:1277", "titel": "Sexualbrott", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HD021279", "typ": "mot", "label": "Motion 2025/26:1279", "titel": "Skärpta insatser mot bidragsfusk", "undertitel": "av Josefin Malmqvist (M)"}, {"dok_id": "HD021348", "typ": "mot", "label": "Motion 2025/26:1348", "titel": "Återöppnande av de värmländska polisstationerna", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HD021349", "typ": "mot", "label": "Motion 2025/26:1349", "titel": "Närhet till polis för en tryggare landsbygd", "undertitel": "av Runar Filper (SD)"}, {"dok_id": "HD021365", "typ": "mot", "label": "Motion 2025/26:1365", "titel": "Åtgärder mot diskriminering i Polismyndighetens arbete", "undertitel": "av Dzenan Cisija (S)"}, {"dok_id": "HD021402", "typ": "mot", "label": "Motion 2025/26:1402", "titel": "Lättad sekretess mellan myndigheter för ett tryggare Sverige", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021407", "typ": "mot", "label": "Motion 2025/26:1407", "titel": "Topsningsregister", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD021431", "typ": "mot", "label": "Motion 2025/26:1431", "titel": "Förstärkning av ordningsvakternas roll genom auktoriserade företag och skärpta krav", "undertitel": "av Mattias Ottosson m.fl. (S)"}, {"dok_id": "HD021463", "typ": "mot", "label": "Motion 2025/26:1463", "titel": "Mängdbrott på större allvar", "undertitel": "av Ann-Sofie Lifvenhage och Oskar Svärd (båda M)"}, {"dok_id": "HD021524", "typ": "mot", "label": "Motion 2025/26:1524", "titel": "Stärkt demokrati - mot hot och förföljelse av förtroendevalda, tjänstemän och minoriteter", "undertitel": "av Emma Ahlström Köster (M)"}, {"dok_id": "HD021562", "typ": "mot", "label": "Motion 2025/26:1562", "titel": "Inrättande av ett nationellt stalkerregister", "undertitel": "av Torsten Elofsson (KD)"}, {"dok_id": "HD021674", "typ": "mot", "label": "Motion 2025/26:1674", "titel": "Maskeringsförbud vid allmänna sammankomster och offentliga tillställningar", "undertitel": "av Katarina Tolgfors m.fl. (M)"}, {"dok_id": "HD021767", "typ": "mot", "label": "Motion 2025/26:1767", "titel": "Förenkling för utlandssvenskar att förnya sina svenska pass", "undertitel": "av Jan Ericson (M)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01JuU16.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01JuU16.html", "votering_url": "https://data.riksdagen.se/votering/26BD8C48-8E81-42F0-92CB-DEB588DBA07D/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01JuU16/", "meta": {"type": "motion", "policy_area": "justice", "subject": {"sv": "Polisens inriktning mot organiserad brottslighet och brott i nära relationer", "en": "Police focus on organised crime and violence in close relationships"}, "at_stake": {"sv": "Utfallet påverkar hur mycket vikt som läggs vid förebyggande och långsiktigt jämlikhetsskapande arbete jämfört med repressiva åtgärder i kampen mot gängkriminalitet och brott i nära relationer. Det handlar om säkerheten för människor i utsatta områden och för dem som drabbas av våld i nära relation, samt om hur resurser fördelas mellan polisiärt arbete och bredare sociala insatser.", "en": "The outcome affects how much weight is given to preventive and long-term equality-building work compared with repressive measures in the fight against gang crime and violence in close relationships. It concerns the safety of people in vulnerable areas and of those affected by violence in close relationships, as well as how resources are divided between police work and broader social measures."}, "subtopics": ["organiserad brottslighet", "brottsförebyggande arbete", "polisresurser", "våld i nära relationer", "kriminalpolitik"], "parties_involved": ["S"], "decision": {"sv": "Frågan gäller om Polismyndighetens nuvarande resurser, verktyg och prioriteringar mot organiserad brottslighet och brott i nära relationer är tillräckliga, eller om regeringen bör ta nya initiativ - bland annat en princip om att matcha varje satsad krona på rättsväsendet med lika mycket på förebyggande och jämlikhetsskapande insatser.", "en": "The question is whether the Police Authority's current resources, tools and priorities against organised crime and violence in close relationships are sufficient, or whether the government should take new initiatives - including a principle of matching every krona spent on the justice system with an equal amount on preventive and equality-building measures."}, "ja": {"sv": "Utskottet avstyrker motionerna. Utskottet konstaterar att Polismyndigheten de senaste åren fått både resurser och nya verktyg för att bekämpa organiserad brottslighet i en omfattning som inte setts tidigare, och att rapporter tyder på att satsningarna gör skillnad. Utskottet noterar även att brott i nära relationer redan är uppmärksammat av regeringen och Polismyndigheten. Med hänsyn till det arbete som redan pågår finns det enligt utskottet inte skäl att ta något nytt initiativ.", "en": "The committee rejects the motions. It notes that the Police Authority has in recent years received both resources and new tools to combat organised crime on a scale not seen before, and that reports suggest these efforts are making a difference. The committee also notes that violence in close relationships is already being addressed by the government and the Police Authority. Given the work already under way, the committee considers there is no reason to take a new initiative."}, "nej": [{"alt_id": "res-1", "sv": "Reservationen (S) utgår från att kriminalpolitiken ska bygga på människors grundläggande behov av trygghet och säkerhet, med två prioriteringar: att vända utvecklingen med växande gängkriminalitet och organiserad brottslighet, och att bekämpa mäns våld mot kvinnor. Enligt reservationen bör regeringen se till att repressiva åtgärder utvärderas och kompletteras med långsiktigt jämlikhetsskapande och brottsförebyggande insatser - bland annat genom att bryta segregationen i utsatta områden - och en ny princip införs där varje krona som satsas på rättsväsendet matchas av lika mycket till förebyggande arbete.", "en": "The reservation (S) holds that criminal policy should be based on people's fundamental need for security and safety, with two priorities: reversing the growth of gang crime and organised crime, and combating men's violence against women. According to the reservation, the government should ensure that repressive measures are evaluated and supplemented with long-term equality-building and crime-preventive efforts - including breaking up segregation in vulnerable areas - and a new principle introduced whereby every krona spent on the justice system is matched by an equal amount for preventive work."}]}}