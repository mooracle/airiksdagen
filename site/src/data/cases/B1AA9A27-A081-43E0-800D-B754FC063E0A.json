, "Jönköpings län"], ["SD", "Avstår", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Avstår", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Avstår", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Avstår", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Avstår", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HC021044", "typ": "mot", "label": "Motion 2024/25:1044", "titel": "Prövning av nedläggningshotade flygplatser för Sveriges civila och militära beredskap", "undertitel": "av Lili André (KD)"}, {"dok_id": "HC02118", "typ": "mot", "label": "Motion 2024/25:118", "titel": "Klassning av skjutbanor som kritisk infrastruktur", "undertitel": "av Kjell-Arne Ottosson (KD)"}, {"dok_id": "HC021266", "typ": "mot", "label": "Motion 2024/25:1266", "titel": "Ett robust försvar i Halland", "undertitel": "av Aida Birinxhiku m.fl. (S)"}, {"dok_id": "HC021313", "typ": "mot", "label": "Motion 2024/25:1313", "titel": "Minskande av PFAS i vår närmiljö", "undertitel": "av Katarina Luhr m.fl. (MP)"}, {"dok_id": "HC021373", "typ": "mot", "label": "Motion 2024/25:1373", "titel": "Livsmedel", "undertitel": "av Martin Kinnunen m.fl. (SD)"}, {"dok_id": "HC021406", "typ": "mot", "label": "Motion 2024/25:1406", "titel": "Militärt försvar", "undertitel": "av Lars Wistedt m.fl. (SD)"}, {"dok_id": "HC021407", "typ": "mot", "label": "Motion 2024/25:1407", "titel": "Civilt försvar", "undertitel": "av Björn Söder m.fl. (SD)"}, {"dok_id": "HC021433", "typ": "mot", "label": "Motion 2024/25:1433", "titel": "Säkerhetspolitik", "undertitel": "av Aron Emilsson m.fl. (SD)"}, {"dok_id": "HC021434", "typ": "mot", "label": "Motion 2024/25:1434", "titel": "Sveriges Natopolitik", "undertitel": "av Aron Emilsson m.fl. (SD)"}, {"dok_id": "HC021734", "typ": "mot", "label": "Motion 2024/25:1734", "titel": "Omreglering för användning av militära övnings- och skjutfält", "undertitel": "av Mikael Oscarsson (KD)"}, {"dok_id": "HC022598", "typ": "mot", "label": "Motion 2024/25:2598", "titel": "Hemvärnets övningsfält och rimligheten i kortare avstånd", "undertitel": "av Marie Nicholson (M)"}, {"dok_id": "HC022613", "typ": "mot", "label": "Motion 2024/25:2613", "titel": "En grön klimathandlingsplan för Sverige 2025", "undertitel": "av Elin Söderberg m.fl. (MP)"}, {"dok_id": "HC022848", "typ": "mot", "label": "Motion 2024/25:2848", "titel": "Stärkt försvarsförmåga med ett ökat samarbete mellan jägare, sportskyttar och försvaret", "undertitel": "av Sten Bergheden och Johanna Rantsi (båda M)"}, {"dok_id": "HC022954", "typ": "mot", "label": "Motion 2024/25:2954", "titel": "En folkrörelse för klimatet", "undertitel": "av Muharrem Demirok m.fl. (C)"}, {"dok_id": "HC023031", "typ": "mot", "label": "Motion 2024/25:3031", "titel": "Vindkraftsutbyggnad", "undertitel": "av Aron Emilsson (SD)"}, {"dok_id": "HC023037", "typ": "mot", "label": "Motion 2024/25:3037", "titel": "Kraftsamling för levande hav och vatten", "undertitel": "av Daniel Helldén m.fl. (MP)"}, {"dok_id": "HC023038", "typ": "mot", "label": "Motion 2024/25:3038", "titel": "Stärkt beredskap och ett robustare samhälle", "undertitel": "av Daniel Helldén m.fl. (MP)"}, {"dok_id": "HC023047", "typ": "mot", "label": "Motion 2024/25:3047", "titel": "Ett miljövänligt, robust och konkurrenskraftigt energisystem", "undertitel": "av Linus Lakso m.fl. (MP)"}, {"dok_id": "HC023116", "typ": "mot", "label": "Motion 2024/25:3116", "titel": "Integrera civila skjutbanor som en del i totalförsvaret", "undertitel": "av Eric Westroth (SD)"}, {"dok_id": "HC023160", "typ": "mot", "label": "Motion 2024/25:3160", "titel": "Krisberedskap och utveckling av militärt och civilt försvar", "undertitel": "av Mikael Larsson m.fl. (C)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01FöU5.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01FöU5.html", "votering_url": "https://data.riksdagen.se/votering/B1AA9A27-A081-43E0-800D-B754FC063E0A/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01FöU5/", "meta": {"type": "motion", "policy_area": "defense", "subject": {"sv": "Försvarsmaktens miljö- och klimatarbete", "en": "The Armed Forces' environmental and climate work"}, "at_stake": {"sv": "Beslutet påverkar hur snabbt förorenad mark, till exempel vid Karlsborgs flygplats, saneras och hur försvarets fordon och övningar anpassas till klimatmålen. Det berör lokalsamhällen nära förorenade områden samt takten i försvarets klimatomställning.", "en": "The decision affects how quickly contaminated land - for instance at Karlsborg airfield - gets remediated, and how the Armed Forces adapts its vehicles and exercises to climate targets. It concerns communities near polluted sites as well as the pace of the defence sector's shift toward lower emissions."}, "subtopics": ["miljöhänsyn i försvaret", "klimatanpassning", "PFAS-sanering", "växthusgasutsläpp", "krigets miljöpåverkan"], "parties_involved": ["V", "MP"], "decision": {"sv": "Frågan gäller om riksdagen ska rikta nya uppmaningar till regeringen om Försvarsmaktens miljö- och klimatarbete - till exempel snabbare sanering av PFAS-föroreningar och en plan för klimatanpassning - eller om det pågående arbetet inom myndigheten och regeringen redan är tillräckligt.", "en": "The question is whether parliament should issue new calls to the government on the Armed Forces' environmental and climate work - for example faster remediation of PFAS contamination and a climate-adaptation plan - or whether the ongoing work within the agency and government is already sufficient."}, "ja": {"sv": "Utskottet konstaterar att Försvarsmakten redan enligt sin instruktion är skyldig att ta miljöhänsyn i sin fredstida verksamhet och att rapportera om sitt miljö- och klimatarbete. Myndigheten arbetar med att sanera förorenade områden, bland annat inom det uppmärksammade PFAS-arbetet, och kartlägger sina utsläpp av växthusgaser för att kunna vidta lämpliga åtgärder. Mot denna bakgrund ser utskottet inte skäl att rikta ytterligare tillkännagivanden till regeringen i frågan.", "en": "The committee notes that the Armed Forces is already required by its instructions to take environmental considerations into account in peacetime operations and to report on its environmental and climate work. The agency is working to remediate contaminated areas, including through the high-profile PFAS effort, and is mapping its greenhouse gas emissions so it can take appropriate action. Against that background, the committee sees no need for parliament to issue further directives to the government on the matter."}, "nej": [{"alt_id": "res-6", "sv": "Reservationen (V, MP) vill att regeringen ger Försvarsmakten i uppdrag att ta fram en plan för hur försvarsutbyggnaden kan genomföras utan ytterligare klimat- och miljöpåverkan, bland annat genom snabbare sanering av PFAS-föroreningar vid Karlsborgs flygplats och en utredning av krigets miljöeffekter. Skälet är att klimatförändringarna är ett allvarligt hot som hela samhället, försvaret inkluderat, måste hantera.", "en": "The reservation (V, MP) calls for the government to task the Armed Forces with producing a plan for how defence expansion can proceed without further climate and environmental impact, including through faster remediation of PFAS contamination at Karlsborg airfield and a study of the environmental effects of war. The reasoning is that climate change is a serious threat that the whole of society, including defence, must address."}]}}