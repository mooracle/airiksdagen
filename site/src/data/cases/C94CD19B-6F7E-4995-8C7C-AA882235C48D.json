iden 2024.\nFörslagen handlar bland annat om utbildningen i gymnasieskolan, ämnen och särskilda kunskapsområden samt studie- och yrkesvägledning.\nRiksdagen hänvisar bland annat till gällande bestämmelser och pågående arbete.", "alternatives": [{"alt_id": "utskottet", "text": "Riksdagen avslår motion \n\n2024/25:3024 av Åsa Westlund m.fl. (S) yrkande 55.", "source_partier": []}, {"alt_id": "res-1", "text": "Reservation 1", "source_partier": ["S"], "substance": {"sv": "Motförslaget vill att regeringen aktivt implementerar och följer upp lagstiftningen om att arbetsmarknadens behov ska vägas in vid dimensionering av gymnasieutbildningar.", "en": "The counter-proposal wants the government to actively implement and follow up on legislation that requires labor market needs to be considered when sizing upper secondary education programs."}}], "actual": {"S": {"position": "Nej", "n_ja": 0, "n_nej": 93, "n_avstar": 0, "n_franvarande": 13, "cohesion": 1.0, "authored_reservation": true}, "MP": {"position": "Ja", "n_ja": 14, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "SD": {"position": "Ja", "n_ja": 61, "n_nej": 0, "n_avstar": 0, "n_franvarande": 11, "cohesion": 1.0, "authored_reservation": false}, "V": {"position": "Ja", "n_ja": 20, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "C": {"position": "Ja", "n_ja": 19, "n_nej": 0, "n_avstar": 0, "n_franvarande": 5, "cohesion": 1.0, "authored_reservation": false}, "L": {"position": "Ja", "n_ja": 13, "n_nej": 0, "n_avstar": 0, "n_franvarande": 3, "cohesion": 1.0, "authored_reservation": false}, "KD": {"position": "Ja", "n_ja": 15, "n_nej": 0, "n_avstar": 0, "n_franvarande": 4, "cohesion": 1.0, "authored_reservation": false}, "M": {"position": "Ja", "n_ja": 60, "n_nej": 0, "n_avstar": 0, "n_franvarande": 8, "cohesion": 1.0, "authored_reservation": false}}, "ai": {}, "probe": null, "seats": [["V", "Ja", "Andrea Andersson Tay", "Stockh