tml", "votering_url": "https://data.riksdagen.se/votering/454377C3-FEC3-4D86-8356-600252AE317B/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HA01SoU19/", "meta": {"type": "motion", "policy_area": "health", "subject": {"sv": "Alkohol-, narkotika-, dopning-, tobak- och spelpolitiken (ANDTS-politiken) samt alkohollagstiftningen.", "en": "Alcohol, narcotics, doping, tobacco and gambling policy (ANDTS policy) and alcohol legislation."}, "at_stake": {"sv": "Besluten rör den övergripande hälsopolitiken för skadliga ämnen och beroende. Implementeringen av ANDTS-politiken och alkohollagstiftningen påverkar folkhälsan och möjligheten att förebygga beroende och missbruk.", "en": "The decisions concern overall health policy for harmful substances and addiction. Implementation of ANDTS policy and alcohol legislation affects public health and the ability to prevent addiction and abuse."}, "subtopics": ["andts-politik", "alkohol", "spelberoende", "folkhälsa"], "parties_involved": ["SD"]}}