022504", "typ": "mot", "label": "Motion 2024/25:2504", "titel": "Avskaffande av EBO-lagen och etablering av nya asylboenden", "undertitel": "av Ingela Nylund Watz m.fl. (S)"}, {"dok_id": "HC022514", "typ": "mot", "label": "Motion 2024/25:2514", "titel": "Stockholm som hållbar tillväxtmotor", "undertitel": "av Mathias Tegnér m.fl. (S)"}, {"dok_id": "HC022949", "typ": "mot", "label": "Motion 2024/25:2949", "titel": "Migration och integration", "undertitel": "av Jonny Cato m.fl. (C)"}, {"dok_id": "HC023025", "typ": "mot", "label": "Motion 2024/25:3025", "titel": "Utgiftsområde 8 Migration", "undertitel": "av Anders Ygeman m.fl. (S)"}, {"dok_id": "HC023072", "typ": "mot", "label": "Motion 2024/25:3072", "titel": "Utgiftsområde 13 Integration och jämställdhet", "undertitel": "av Ardalan Shekarabi m.fl. (S)"}, {"dok_id": "HC023263", "typ": "mot", "label": "Motion 2024/25:3263", "titel": "med anledning av prop. 2024/25:49 En ny ordning för asylsökandes boende", "undertitel": "av Tony Haddou m.fl. (V)"}, {"dok_id": "HC023266", "typ": "mot", "label": "Motion 2024/25:3266", "titel": "med anledning av prop. 2024/25:49 En ny ordning för asylsökandes boende", "undertitel": "av Anders Ygeman m.fl. (S)"}, {"dok_id": "HC023269", "typ": "mot", "label": "Motion 2024/25:3269", "titel": "med anledning av prop. 2024/25:49 En ny ordning för asylsökandes boende", "undertitel": "av Annika Hirvonen m.fl. (MP)"}, {"dok_id": "HC0349", "typ": "prop", "label": "Proposition 2024/25:49", "titel": "En ny ordning för asylsökandes boende", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01SfU11.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01SfU11.html", "votering_url": "https://data.riksdagen.se/votering/03D14FA3-128F-4AA2-845C-59B0EB88ED8A/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01SfU11/", "meta": {"type": "motion", "policy_area": "migration", "subject": {"sv": "Riksdagen föreslås anta regeringens förslag att asylsökande endast får ekonomiskt bistånd vid boendet på tilldelad asylboende, med möjlighet till inspektioner och obligatorisk samhällsintroduktion.", "en": "The Riksdag is proposed to approve the government's proposals requiring asylum seekers to live exclusively at assigned accommodation to receive financial assistance, with provisions for inspections and mandatory civic integration."}, "at_stake": {"sv": "Godkännande innebär nya lagkrav på asylsökandes bosättning, ekonomiskt stöd och deltagandeskyldighet i integrationsprogram. Migrationsverket får nya befogenheter att inspektera boenden och kan behandla vandring från tilldelat boende som återkallelse av uppehållstillståndsansökan.", "en": "Approval introduces new legal requirements for asylum seekers' housing conditions, financial support eligibility, and mandatory participation in integration programs. The Migration Agency gains authority to inspect accommodations and can treat departure from assigned housing as withdrawal of residence permit applications."}, "subtopics": ["asylboende", "ekonomiskt bistånd", "migration", "integration", "bosättning"], "parties_involved": ["S"]}}