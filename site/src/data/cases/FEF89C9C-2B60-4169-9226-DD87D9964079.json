data.riksdagen.se/dokument/HD01UU6.html", "votering_url": "https://data.riksdagen.se/votering/FEF89C9C-2B60-4169-9226-DD87D9964079/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01UU6/", "meta": {"type": "motion", "policy_area": "foreign", "subject": {"sv": "Riksdagen avslår motioner om kärnvapen, Nato-medlemskap, internationella militära insatser och försvarssamarbete.", "en": "Parliament rejects motions on nuclear weapons, NATO membership, international military operations, and defence cooperation agreements."}, "at_stake": {"sv": "Avslaget innebär att motionärernas förslag om kärnvapenpolitik och försvarssamarbete inte genomförs, vilket påverkar Sveriges långsiktiga säkerhetspolitiska orientering.", "en": "Rejection means proposed changes to nuclear weapons policy and defence cooperation frameworks do not proceed, maintaining current security policy orientation."}, "subtopics": ["kärnvapen", "nato", "säkerhetspolitik", "försvar"], "parties_involved": ["V", "MP"]}}