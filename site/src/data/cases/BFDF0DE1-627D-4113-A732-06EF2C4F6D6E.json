Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HD021087", "typ": "mot", "label": "Motion 2025/26:1087", "titel": "Åtgärder för rättvis dold mervärdesskatt", "undertitel": "av Anna Wallentheim (S)"}, {"dok_id": "HD021128", "typ": "mot", "label": "Motion 2025/26:1128", "titel": "Dansbandsmomsen", "undertitel": "av Anna Lasses m.fl. (C)"}, {"dok_id": "HD021517", "typ": "mot", "label": "Motion 2025/26:1517", "titel": "Rättvis moms för stiftelser och aktiebolag", "undertitel": "av Peter Ollén (M)"}, {"dok_id": "HD021687", "typ": "mot", "label": "Motion 2025/26:1687", "titel": "Dubbelbeskattning", "undertitel": "av Margareta Cederfelt (M)"}, {"dok_id": "HD02184", "typ": "mot", "label": "Motion 2025/26:184", "titel": "Sänkt moms på privat musikundervisning", "undertitel": "av Victoria Tiblom (SD)"}, {"dok_id": "HD021977", "typ": "mot", "label": "Motion 2025/26:1977", "titel": "Översyn av leasingregler för lätta lastbilar", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD021978", "typ": "mot", "label": "Motion 2025/26:1978", "titel": "Sänkt moms på secondhand", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022013", "typ": "mot", "label": "Motion 2025/26:2013", "titel": "Sänkt matmoms för alla som säljer mat", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022016", "typ": "mot", "label": "Motion 2025/26:2016", "titel": "Lägre moms för secondhandvaror", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022036", "typ": "mot", "label": "Motion 2025/26:2036", "titel": "Sänkt eller avskaffad moms på körkort", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022040", "typ": "mot", "label": "Motion 2025/26:2040", "titel": "Sänkt moms på körkort", "undertitel": "av Ann-Sofie Lifvenhage (M)"}, {"dok_id": "HD022140", "typ": "mot", "label": "Motion 2025/26:2140", "titel": "Sänkt moms för ökad turism", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022344", "typ": "mot", "label": "Motion 2025/26:2344", "titel": "Sänkt moms för fritidsbåtar i gästhamn", "undertitel": "av Johanna Rantsi (M)"}, {"dok_id": "HD022426", "typ": "mot", "label": "Motion 2025/26:2426", "titel": "Sänkt moms på preventivmedel och digitala preventivmedelstjänster", "undertitel": "av Saila Quicklund och Merit Frost Lindberg (båda M)"}, {"dok_id": "HD022461", "typ": "mot", "label": "Motion 2025/26:2461", "titel": "Sänkt dansbandsmoms", "undertitel": "av Sten Bergheden (M)"}, {"dok_id": "HD022531", "typ": "mot", "label": "Motion 2025/26:2531", "titel": "Sänkt moms för bio och nöjesfält", "undertitel": "av Mattias Eriksson Falk m.fl. (SD)"}, {"dok_id": "HD022551", "typ": "mot", "label": "Motion 2025/26:2551", "titel": "Halverad moms på skolmaterial inför skolstart", "undertitel": "av Mattias Eriksson Falk och Roger Hedlund (båda SD)"}, {"dok_id": "HD022820", "typ": "mot", "label": "Motion 2025/26:2820", "titel": "Idrott, friluftsliv och folkhälsa", "undertitel": "av Vasiliki Tsouplaki m.fl. (V)"}, {"dok_id": "HD022823", "typ": "mot", "label": "Motion 2025/26:2823", "titel": "Cirkulär ekonomi och kemikalier", "undertitel": "av Stina Larsson m.fl. (C)"}, {"dok_id": "HD022834", "typ": "mot", "label": "Motion 2025/26:2834", "titel": "Ett jämställt samhälle", "undertitel": "av Helena Vilhelmsson m.fl. (C)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HD01SkU17.json", "fulltext_url": "https://data.riksdagen.se/dokument/HD01SkU17.html", "votering_url": "https://data.riksdagen.se/votering/BFDF0DE1-627D-4113-A732-06EF2C4F6D6E/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HD01SkU17/", "meta": {"type": "motion", "policy_area": "tax", "subject": {"sv": "Övriga momsfrågor: bedrägeribekämpning och dold moms för kommuner", "en": "Other VAT issues: fraud prevention and hidden-VAT compensation for municipalities"}, "at_stake": {"sv": "Utfallet påverkar hur snabbt myndigheterna får verktyg mot organiserade momsbedrägerier som kostar staten miljarder, och om kommuner och regioner får en ersättning för dold moms som inte gynnar upphandlad drift framför egen regi.", "en": "The outcome affects how quickly authorities get tools against organized VAT fraud that costs the state billions, and whether municipalities and regions get hidden-VAT compensation that doesn't favor outsourced operations over in-house delivery."}, "subtopics": ["momsbedrägerier", "dold moms", "kommuner och regioner", "donation av varor", "skatteundandragande"], "parties_involved": ["V"], "decision": {"sv": "Frågan gäller om riksdagen nu ska uppmana regeringen att gå vidare med ytterligare åtgärder mot momsbedrägerier och att ändra ersättningen för dold moms till kommuner, eller om pågående lagstiftning och tidigare utredningar räcker.", "en": "The vote is about whether parliament should now call on the government to take further action against VAT fraud and change the hidden-VAT compensation for municipalities, or whether legislation already under way and earlier inquiries are enough."}, "ja": {"sv": "Utskottet hänvisar till att regeringen redan lagt fram propositioner mot momsbedrägerier och att flera frågor - donation av varor, dold moms, momsavdrag - redan bereds eller nyligen utretts, och avstyrker därför motionerna.", "en": "The committee points to government bills already introduced against VAT fraud, and to donation of goods, hidden VAT, and VAT deductions already being reviewed or recently investigated, and therefore rejects the motions."}, "nej": [{"alt_id": "res-11", "sv": "Regeringen bör tillsätta en utredning om ersättning för dold moms så att den inte gynnar upphandlad eller bolagiserad drift, och omgående gå vidare med den färdiga utredningen mot organiserade momsbedrägerier.", "en": "The government should set up an inquiry into hidden-VAT compensation so it no longer favors outsourced or incorporated operations, and immediately act on the completed inquiry against organized VAT fraud."}]}}