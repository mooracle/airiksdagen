, "Södermanlands län"], ["SD", "Ja", "Mattias Karlsson", "Kronobergs län"], ["SD", "Ja", "Michael Rubbestad", "Örebro län"], ["SD", "Ja", "Mikael Eskilandersson", "Skåne läns norra och östra"], ["SD", "Frånvarande", "Mona Olin", "Kalmar län"], ["SD", "Ja", "Nima Gholam Ali Pour", "Malmö kommun"], ["SD", "Ja", "Oscar Sjöstedt", "Västmanlands län"], ["SD", "Frånvarande", "Patrick Reslow", "Malmö kommun"], ["SD", "Ja", "Patrik Jönsson", "Västra Götalands läns södra"], ["SD", "Ja", "Per Söderlund", "Örebro län"], ["SD", "Ja", "Pontus Andersson Garpvall", "Västerbottens län"], ["SD", "Ja", "Rashid Farivar", "Västra Götalands läns västra"], ["SD", "Ja", "Rasmus Giertz", "Dalarnas län"], ["SD", "Ja", "Richard Jomshof", "Blekinge län"], ["SD", "Ja", "Robert Stenkvist", "Stockholms län"], ["SD", "Ja", "Roger Hedlund", "Gävleborgs län"], ["SD", "Ja", "Runar Filper", "Värmlands län"], ["SD", "Ja", "Sara Gille", "Dalarnas län"], ["SD", "Ja", "Sara-Lena Bjälkö", "Hallands län"], ["SD", "Ja", "Staffan Eklöf", "Jönköpings län"], ["SD", "Ja", "Thomas Morell", "Skåne läns norra och östra"], ["SD", "Ja", "Tobias Andersson", "Västra Götalands läns östra"], ["SD", "Ja", "Ulf Lindholm", "Västernorrlands län"], ["SD", "Ja", "Unni Björnerfors", "Stockholms kommun"], ["SD", "Ja", "Victoria Tiblom", "Skåne läns södra"], ["SD", "Ja", "Yasmine Eriksson", "Västra Götalands läns västra"]], "references": [{"dok_id": "HB022883", "typ": "mot", "label": "Motion 2023/24:2883", "titel": "med anledning av skr. 2023/24:111 Strategi för företag i kulturella och kreativa branscher", "undertitel": "av Fredrik Olovsson m.fl. (S)"}, {"dok_id": "HB022885", "typ": "mot", "label": "Motion 2023/24:2885", "titel": "med anledning av skr. 2023/24:111 Strategi för företag i kulturella och kreativa branscher", "undertitel": "av Elisabeth Thand Ringqvist och Rickard Nordin (båda C)"}, {"dok_id": "HB022889", "typ": "mot", "label": "Motion 2023/24:2889", "titel": "med anledning av skr. 2023/24:111 Strategi för företag i kulturella och kreativa branscher", "undertitel": "av Elin Söderberg och Amanda Lind (båda MP)"}, {"dok_id": "HB03111", "typ": "prop", "label": "Regeringens skrivelse 2023/24:111", "titel": "Strategi för företag i kulturella och kreativa branscher", "undertitel": ""}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01NU19.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01NU19.html", "votering_url": "https://data.riksdagen.se/votering/5EB8E9FE-85A5-4165-9929-B447950E1985/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01NU19/", "meta": {"type": "motion", "policy_area": "business", "subject": {"sv": "Företagsfrämjande åtgärder för kulturella och kreativa branscher", "en": "Business-promotion measures for the cultural and creative industries"}, "at_stake": {"sv": "Strategins konkretion avgör hur mycket riktat stöd, rådgivning och finansiering företag inom musik, design, dataspel, mode och film får för att växa och exportera. Det berör företagare i kulturella och kreativa branscher samt Sveriges konkurrenskraft och Sverigebild utomlands.", "en": "How concrete the strategy is determines how much targeted support, advice and financing companies in music, design, gaming, fashion and film receive to grow and export. It concerns entrepreneurs in the cultural and creative industries as well as Sweden's competitiveness and international image."}, "subtopics": ["kulturella och kreativa branscher", "näringslivsstrategi", "företagsstöd", "export"], "parties_involved": ["MP"], "decision": {"sv": "Frågan gäller om regeringens strategi för företag i kulturella och kreativa branscher är tillräckligt konkret och ambitiös, eller om en uppdaterad strategi med tydligare åtgärder och höjd finansiering behövs.", "en": "The question is whether the government's strategy for companies in the cultural and creative industries is sufficiently concrete and ambitious, or whether an updated strategy with clearer measures and increased funding is needed."}, "ja": {"sv": "Utskottet välkomnar regeringens strategi för företag i kulturella och kreativa branscher och delar visionen för 2033 om en stärkt svensk position inom sektorn, ökad tillväxt, export och en positiv Sverigebild. Utskottet ser positivt på att Kulturdepartementet får en samordnande roll och att regeringen för en löpande dialog med branschföreträdare, och anser att systemen för råd, stöd och finansiering till företag bör vara generella.", "en": "The committee welcomes the government's strategy for companies in the cultural and creative industries and shares the vision for 2033 of a strengthened Swedish position in the sector, greater growth, exports and a positive image of Sweden abroad. It welcomes the coordinating role given to the Ministry of Culture and the government's ongoing dialogue with industry representatives, and considers that systems for advice, support and financing for companies should be generic rather than sector-specific."}, "nej": [{"alt_id": "res-3", "sv": "Miljöpartiet anser att regeringens strategi lämnar mycket övrigt att önska och ger för lite vägledning om hur identifierade hinder ska åtgärdas. Partiet vill att regeringen skyndsamt återkommer med en uppdaterad strategi med konkreta åtgärder, höjd ambitionsnivå för reformer och finansiering, samt utreder ett institut för kulturella och kreativa näringar.", "en": "The Green Party argues that the government's strategy leaves much to be desired and gives too little guidance on how identified obstacles will be addressed. It wants the government to promptly return with an updated strategy featuring concrete measures, a higher level of ambition on reforms and funding, and an investigation into establishing an institute for the cultural and creative industries."}]}}