": "HB021496", "typ": "mot", "label": "Motion 2023/24:1496", "titel": "Stärkt småskaligt och hållbart fiske", "undertitel": "av Linnéa Wickman m.fl. (S)"}, {"dok_id": "HB02166", "typ": "mot", "label": "Motion 2023/24:166", "titel": "Bevarandet av ålfiske", "undertitel": "av Björn Söder m.fl. (SD)"}, {"dok_id": "HB021873", "typ": "mot", "label": "Motion 2023/24:1873", "titel": "För havets och människans framtid", "undertitel": "av Emma Nohrén m.fl. (MP)"}, {"dok_id": "HB021920", "typ": "mot", "label": "Motion 2023/24:1920", "titel": "Ett system med fisketillsyningspersoner även längs med kusterna", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB021924", "typ": "mot", "label": "Motion 2023/24:1924", "titel": "Förbud mot bottentrålning för att skapa förutsättningar för friska och levande hav", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB021955", "typ": "mot", "label": "Motion 2023/24:1955", "titel": "Ekosystembaserad havsförvaltning", "undertitel": "av Magnus Manhammar (S)"}, {"dok_id": "HB022209", "typ": "mot", "label": "Motion 2023/24:2209", "titel": "Levande fiske i Skåne", "undertitel": "av Ann-Charlotte Hammar Johnsson m.fl. (M)"}, {"dok_id": "HB022479", "typ": "mot", "label": "Motion 2023/24:2479", "titel": "Livskraftiga gröna och blå näringar", "undertitel": "av Daniel Bäckström m.fl. (C)"}, {"dok_id": "HB022487", "typ": "mot", "label": "Motion 2023/24:2487", "titel": "Förbättring av förhållandena för det kustnära fisket", "undertitel": "av Catarina Deremar och Anne-Li Sjölund (båda C)"}, {"dok_id": "HB02253", "typ": "mot", "label": "Motion 2023/24:253", "titel": "Långsiktigt hållbart fiske av strömming", "undertitel": "av Peder Björk och Anna-Belle Strömberg (båda S)"}, {"dok_id": "HB022536", "typ": "mot", "label": "Motion 2023/24:2536", "titel": "Satsning på Stockholms skärgård", "undertitel": "av Markus Wiechel m.fl. (SD)"}, {"dok_id": "HB022540", "typ": "mot", "label": "Motion 2023/24:2540", "titel": "Bevarande av ålfisket som ett nationellt kulturarv", "undertitel": "av Lars Johnsson m.fl. (M)"}, {"dok_id": "HB022628", "typ": "mot", "label": "Motion 2023/24:2628", "titel": "Utgiftsområde 23 Areella näringar, landsbygd och livsmedel", "undertitel": "av Anna-Caren Sätherberg m.fl. (S)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HB01MJU10.json", "fulltext_url": "https://data.riksdagen.se/dokument/HB01MJU10.html", "votering_url": "https://data.riksdagen.se/votering/08D443AE-FABF-42DB-A299-EF846C96114F/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HB01MJU10/", "meta": {"type": "motion", "policy_area": "environment", "subject": {"sv": "Fiskerikontroll och straff vid överträdelser", "en": "Fisheries control and penalties for violations"}, "at_stake": {"sv": "Frågan gäller hur effektivt fusk och överträdelser inom fisket, som olagligt fiske och felrapporterade fångster, upptäcks och beivras. Det berör fiskenäringen, kontrollmyndigheter och det marina ekosystemet, vars bestånd riskerar överfiske om kontrollen brister.", "en": "At stake is how effectively cheating and violations in fishing, such as illegal catches and misreported catches, are detected and punished. It affects the fishing industry, control authorities and the marine ecosystem, whose stocks risk overfishing if enforcement is weak."}, "subtopics": ["fiskerikontroll", "sanktioner", "landningsskyldighet", "EU-reglering", "fiskefusk"], "parties_involved": ["S"], "decision": {"sv": "Riksdagen tar ställning till om ansvaret för att stärka fiskerikontrollen och skärpa straffen vid regelbrott ska vila på pågående EU-reglering och en statlig utredning, eller om riksdagen redan nu aktivt bör kräva skärpta kontroller och straff.", "en": "Parliament decides whether strengthening fisheries control and penalties for violations should rest on ongoing EU regulation and a government inquiry, or whether parliament should already actively demand tighter controls and penalties."}, "ja": {"sv": "Utskottet välkomnar EU:s nya fiskerikontrollförordning, som inför spårning av fiskefartyg, elektronisk fångstrapportering och krav på kameror och sensorer på större fartyg, och vill invänta en pågående utredning om skärpta straff och sanktionsavgifter för överträdelser innan riksdagen agerar ytterligare.", "en": "The committee welcomes the EU's new fisheries control regulation, which introduces tracking of fishing vessels, electronic catch reporting and requirements for cameras and sensors on larger vessels, and wants to await an ongoing inquiry into tightened penalties and sanction fees for violations before parliament takes further action."}, "nej": [{"alt_id": "res-12", "sv": "Socialdemokraterna vill skärpa kontrollerna och straffen för avsiktlig felrapportering av fiskefångster, eftersom sådant fusk underminerar arbetet för ett hållbart fiske och den svenska fiskerinäringens långsiktiga potential.", "en": "The Social Democrats want to tighten controls and penalties for intentional misreporting of fish catches, since such cheating undermines efforts for sustainable fishing and the long-term potential of the Swedish fishing industry."}]}}