id": "HB02474", "typ": "mot", "label": "Motion 2023/24:474", "titel": "Grundlag", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HC02105", "typ": "mot", "label": "Motion 2024/25:105", "titel": "Om krav på enbart svenskt medborgarskap för statsråd och riksdagsledamöter", "undertitel": "av Rashid Farivar (SD)"}, {"dok_id": "HC021193", "typ": "mot", "label": "Motion 2024/25:1193", "titel": "Avskaffande av anonyma partibidrag", "undertitel": "av Niels Paarup-Petersen (C)"}, {"dok_id": "HC021295", "typ": "mot", "label": "Motion 2024/25:1295", "titel": "Skydda även svensk kultur i regeringsformen", "undertitel": "av Staffan Eklöf (SD)"}, {"dok_id": "HC021345", "typ": "mot", "label": "Motion 2024/25:1345", "titel": "Det svenska språkets bevarande", "undertitel": "av Runar Filper m.fl. (SD)"}, {"dok_id": "HC021374", "typ": "mot", "label": "Motion 2024/25:1374", "titel": "Granskning", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HC021375", "typ": "mot", "label": "Motion 2024/25:1375", "titel": "Grundlag", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HC021376", "typ": "mot", "label": "Motion 2024/25:1376", "titel": "Konservativ politik för samtid och framtid", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HC021377", "typ": "mot", "label": "Motion 2024/25:1377", "titel": "Några valfrågor", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HC021380", "typ": "mot", "label": "Motion 2024/25:1380", "titel": "En behövlig myndighetsöversyn", "undertitel": "av Matheus Enholm m.fl. (SD)"}, {"dok_id": "HC021481", "typ": "mot", "label": "Motion 2024/25:1481", "titel": "En riksrevision för kommunerna", "undertitel": "av Malin Danielsson och Cecilia Rönn (båda L)"}, {"dok_id": "HC02150", "typ": "mot", "label": "Motion 2024/25:150", "titel": "Ökad transparens i partifinansieringen", "undertitel": "av Ola Möller (S)"}, {"dok_id": "HC021774", "typ": "mot", "label": "Motion 2024/25:1774", "titel": "Stärkt kulturpolitik - stärkt demokrati", "undertitel": "av Mats Berglund m.fl. (MP)"}, {"dok_id": "HC021784", "typ": "mot", "label": "Motion 2024/25:1784", "titel": "Ett modernt statsskick", "undertitel": "av Niels Paarup-Petersen m.fl. (C, S, L, MP, V)"}, {"dok_id": "HC021922", "typ": "mot", "label": "Motion 2024/25:1922", "titel": "En funktionsrättspolitik för trygghet och delaktighet", "undertitel": "av Nadja Awad m.fl. (V)"}, {"dok_id": "HC021934", "typ": "mot", "label": "Motion 2024/25:1934", "titel": "Konstitutionella frågor", "undertitel": "av Jessica Wetterling m.fl. (V)"}, {"dok_id": "HC021935", "typ": "mot", "label": "Motion 2024/25:1935", "titel": "Åtgärder för de nationella minoriteterna och minoritetsspråken", "undertitel": "av Nooshi Dadgostar m.fl. (V)"}, {"dok_id": "HC021984", "typ": "mot", "label": "Motion 2024/25:1984", "titel": "Värnande av demokratin", "undertitel": "av Ann-Sofie Alm (M)"}, {"dok_id": "HC02222", "typ": "mot", "label": "Motion 2024/25:222", "titel": "Införande av sanktioner för överträdelse i lagen om restriktioner vid statsråds och statssekreterares övergång till annan än statlig verksamhet", "undertitel": "av Josef Fransson (SD)"}, {"dok_id": "HC02223", "typ": "mot", "label": "Motion 2024/25:223", "titel": "Nationellt organiserad kommun- och regionrevision", "undertitel": "av Josef Fransson (SD)"}], "source_url": "https://data.riksdagen.se/dokumentstatus/HC01KU16.json", "fulltext_url": "https://data.riksdagen.se/dokument/HC01KU16.html", "votering_url": "https://data.riksdagen.se/votering/C069A29F-7F6E-447A-A834-2FB35B1577DF/json", "riksdagen_url": "https://www.riksdagen.se/sv/dokument-och-lagar/dokument/betankande/_HC01KU16/", "meta": {"type": "motion", "policy_area": "constitution", "subject": {"sv": "Skärpta karensregler för statsråd och höga tjänstemän", "en": "Stricter cooling-off rules for ministers and senior officials"}, "at_stake": {"sv": "Karensregler ska minska risken för intressekonflikter när personer med inflytande över offentlig verksamhet övergår till privata uppdrag inom samma område; frågan är om fler befattningar och striktare regler behövs redan nu, eller om det nuvarande, begränsade regelverket är tillräckligt i väntan på utredningens resultat.", "en": "Cooling-off rules are meant to reduce the risk of conflicts of interest when people with influence over public activities move into private roles in the same field; the question is whether more positions and stricter rules are needed now, or whether the current, limited framework is sufficient pending the inquiry's findings."}, "subtopics": ["karensregler", "övergångsrestriktioner", "statsråd", "jäv", "offentlig förvaltning"], "parties_involved": ["S", "V"], "decision": {"sv": "Frågan gäller om lagstiftningen om karensregler (övergångsrestriktioner) för statsråd och höga tjänstemän redan nu bör skärpas och utvidgas, eller om resultatet av en pågående statlig utredning bör inväntas innan eventuella lagändringar.", "en": "The question is whether the legislation on cooling-off rules (transition restrictions) for ministers and senior officials should be tightened and expanded now, or whether the outcome of an ongoing government inquiry should be awaited before any legislative changes."}, "ja": {"sv": "Utskottet konstaterar att en statlig utredning om övergångsrestriktioner redan har haft i uppdrag att pröva vilka som bör omfattas av regleringen och om en sanktionsmöjlighet bör införas, att utredningens förslag bereds inom Regeringskansliet, och att resultatet av den beredningen inte bör föregripas. Utskottet avstyrker därför motionerna om att skärpa karensreglerna för statsråd och höga tjänstemän.", "en": "The committee notes that a government inquiry into transition restrictions has already been tasked with examining who should be covered by the regulation and whether a sanction mechanism should be introduced, that the inquiry's proposals are being processed within the Government Offices, and that the outcome of that process should not be pre-empted. The committee therefore rejects the motions calling for stricter cooling-off rules for ministers and senior officials."}, "nej": [{"alt_id": "res-19", "sv": "Reservationen (S, V) vill att regeringen återkommer med förslag som ytterligare stärker regelverket om övergångsrestriktioner, med hänvisning till att endast en begränsad grupp befattningar omfattas i dag och att fler bör täckas in för att övergångar från centrala offentliga uppdrag till privata uppdrag inte ska skada förtroendet för den offentliga verksamheten.", "en": "The reservation (S, V) wants the government to come back with proposals that further strengthen the framework on transition restrictions, arguing that only a limited group of positions is covered today and that more should be included so that moves from central public roles into private roles do not damage trust in public administration."}]}}