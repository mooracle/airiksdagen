 []}, "flags": ["citat_blockerat"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "MP": {"rost": "Avstår", "confidence": "low", "coverage": "inferred", "motivering": "MP:s familjelinje bygger på autonomi och skydd för våldsutsatta, inte på SD:s traditionalistiska syn på äktenskapet. Reservationens riktning (förlängd eller förkortad betänketid) är oklar och MP:s egen linje matchar varken utskottet eller ett entydigt motförslag, varför MP avstår.", "citations": [{"document": "partiprogram", "quote": "En familj bygger på kärlek,", "princip": "familjeautonomi"}, {"document": "valmanifest", "quote": "skapa en dörr ut för våldsutsatta i hela landet", "princip": "skydd för våldsutsatta"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["reservationens riktning (SD-förlängning eller V-förkortning) osäker"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "S": {"rost": "Ja", "confidence": "low", "coverage": "not_covered", "motivering": "Betänketid vid äktenskapsskillnad och närliggande familjerättsliga yrkanden från V och SD saknar stöd i partiets dokument. Utskottets avslag stöds (Ja).", "citations": [{"document": "partiprogram", "quote": "Alla barn ska ha rätt till en trygg uppväxt i enlighet med FN:s barnkonvention.", "princip": "barns bästa"}], "omvarld": {"paverkar": false, "faktorer": []}, "flags": ["svag dokumenttäckning", "reservationens partihärkomst osäker"], "model": "claude-opus-4-8", "en": null, "program_override": null}, "SD": {"rost": "Nej", "confidence": "low", "coverage": "inferred", "motivering": "Betänketid vid äktenskapsskillnad ligger utanför Tidöavtalet och SD:s familjepolitik betonar familjens stabilitet och barnets bästa. SD stödjer reservationen som speglar den egna motionslinjen framför utskottets avslag och röstar Nej.", "citations": [{"document": "valmanifest", "quote": "Att barnets bästa alltid ska beaktas", "princip": "barnets bästa"}, {"document": "valmanifest", "quote": "Att gemensam vårdnad u