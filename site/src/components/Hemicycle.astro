---
/**
 * 349-seat chamber, rendered at build time as static SVG.
 * Each seat = one MP colored by their actual vote; party wedges are contiguous
 * (seats arrive pre-sorted in party-block order from export-site).
 *
 * The chamber draws and colours itself with no JS. Only the per-seat name
 * tooltip needs it: names live in one shared roster file (getMemberRoster) and
 * each seat carries `<roster index><vote>[!]` in the svg's data-seats, because
 * 349 inline <title>s made every case page ~40% the same text as every other.
 *
 * With `labels` set, a badge row follows the chamber: per party, the AI vote
 * beside the real one with a match/mismatch mark. The embed widget uses it,
 * having no other comparison; the case page passes no `labels` because its
 * table below already is that comparison, and a second copy under the chamber
 * read as a legend for the seats.
 */
import { hemicycleLayout, VOTE_COLORS } from '../lib/hemicycle';
import { getMemberRoster, memberIndex, partyInk } from '../lib/data';
import type { AiDecision, ActualPosition, PartyInfo } from '../lib/data';

interface Props {
  seats: [string, string, string, string][]; // [parti, rost, namn, valkrets]
  parties: Record<string, PartyInfo>;
  ai: Record<string, AiDecision>;
  actual: Record<string, ActualPosition>;
  voteLabels: Record<string, string>;
  /** labels for the badge row: the two chips ("AI" / "actual vote") and the
      ✓/✕ verdict. Rendered as a key line above the badges and as tooltips. */
  labels?: {
    heading?: string; note?: string;      // optional lead-in over the badge row
    ai: string; actual: string;           // full names, for the key line and tooltips
    aiShort: string; actualShort: string; // the tag on each chip ("AI" / "Röst")
    match: string; mismatch: string;
  };
}

const { seats, parties, ai, actual, voteLabels, labels } = Astro.props;
const layout = hemicycleLayout(seats.length);

// party label arcs: min/max seat index per party (seats are party-contiguous)
const partyRanges: Record<string, { from: number; to: number }> = {};
seats.forEach(([p], i) => {
  partyRanges[p] ??= { from: i, to: i };
  partyRanges[p].to = i;
});
// Seats include members sitting outside every party group, so that the chamber
// drawn here is the one that voted rather than an eight-party subtotal. They get
// a seat and a tooltip, but no label arc and no AI badge: an independent has no
// party programme, so there is no decision to compare and no code to letter a
// disc with. Keyed off `parties` rather than a hardcoded '-' so any future
// non-party code is handled the same way.
const partyOrder = Object.entries(partyRanges)
  .filter(([code]) => code in parties)
  .sort((a, b) => a[1].from - b[1].from);

// Per seat: roster index, then a one-letter vote code, then `!` when the member
// broke with the party line. An empty index means the seat has no member record.
const VOTE_CODE: Record<string, string> = { Ja: 'J', Nej: 'N', 'Avstår': 'A', 'Frånvarande': 'F' };
const seatData = layout.map((_, i) => {
  const [parti, rost, namn, valkrets] = seats[i] ?? ['?', 'Frånvarande', '', ''];
  const partyPos = actual[parti]?.position;
  const dissent = rost !== 'Frånvarande' && partyPos && partyPos !== 'Frånvarande' && rost !== partyPos;
  return { parti, rost, dissent, code: `${memberIndex(namn, parti, valkrets) ?? ''}${VOTE_CODE[rost] ?? 'F'}${dissent ? '!' : ''}` };
});
const voteByCode = Object.fromEntries(Object.entries(VOTE_CODE).map(([v, c]) => [c, voteLabels[v] ?? v]));
const rosterUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/data/members/${getMemberRoster().version}.json`;

function labelPos(range: { from: number; to: number }) {
  const mid = layout[Math.floor((range.from + range.to) / 2)];
  const cx = 340, cy = 340;
  const dx = mid.x - cx, dy = mid.y - cy;
  const len = Math.hypot(dx, dy) || 1;
  const r = 345;
  return { x: cx + (dx / len) * r, y: cy + (dy / len) * r };
}
---

<figure class="hemicycle">
  <svg
    viewBox="-18 -18 716 400"
    role="img"
    aria-label={`${seats.length} seats`}
    data-seats={seatData.map((s) => s.code).join(',')}
    data-vl={JSON.stringify(voteByCode)}
    data-roster={rosterUrl}
  >
    {layout.map((seat, i) => {
      // a dark ring marks an MP who voted against their party's majority position
      const { rost, dissent } = seatData[i];
      return (
        <circle
          class="seat"
          cx={seat.x}
          cy={seat.y}
          r={seat.r}
          fill={VOTE_COLORS[rost] ?? '#999'}
          stroke={dissent ? '#14202b' : 'none'}
          stroke-width={dissent ? 2 : 0}
        />
      );
    })}
    {partyOrder.map(([code, range]) => {
      const pos = labelPos(range);
      const color = parties[code]?.color ?? '#444';
      // a filled disc with the letter, not colored text: light party colors
      // (SD yellow, M sky-blue) are unreadable as text on the white surface
      return (
        <g>
          <circle cx={pos.x} cy={pos.y} r="11.5" fill={color} stroke="#fff" stroke-width="1.5" />
          <text
            x={pos.x}
            y={pos.y}
            text-anchor="middle"
            dominant-baseline="central"
            font-size={code.length > 1 ? 9.5 : 12}
            font-weight="700"
            fill={partyInk(color)}
          >
            {code}
          </text>
        </g>
      );
    })}
  </svg>

  {/* One badge per party: the AI vote, then the vote the party actually cast,
      then the verdict. Both chips are shown because the AI can only answer
      Ja/Nej while a party can abstain — with the AI chip alone, an "Avstår"
      wedge in the chamber above had no counterpart down here and its ✕ read as
      a rendering error rather than as the miss the metric counts it as. */}
  {/* The badge row is not a second reading of the chamber above it, and on a
      page where the chamber is coloured Ja/Nej/Avstår the same chip colours
      below it read as one. Say what the row is before showing it. */}
  {labels?.heading && (
    <h3 class="ai-head">{labels.heading}</h3>
  )}
  {labels?.note && (
    <p class="ai-note muted">{labels.note}</p>
  )}
  {labels && (
    <p class="ai-key muted">
      <span class="ai-key-item"><span class="tag">{labels.aiShort}</span> {labels.ai}</span>
      <span class="ai-key-item"><span class="tag">{labels.actualShort}</span> {labels.actual}</span>
      <span class="ai-key-item"><span class="match" aria-hidden="true">✓</span> {labels.match}</span>
      <span class="ai-key-item"><span class="mismatch" aria-hidden="true">✕</span> {labels.mismatch}</span>
    </p>
  )}
  {labels && <div class="ai-row">
    {partyOrder.map(([code]) => {
      const decision = ai[code];
      const act = actual[code]?.position;
      const comparable = act && act !== 'Frånvarande';
      const isMatch = decision && comparable && decision.rost === act;
      return (
        <div class="ai-badge" id={code} style={`border-top: 3px solid ${parties[code]?.color ?? '#999'}`}>
          <span class="code">{code}</span>
          <span class="rows">
            <span class="tag" title={labels?.ai}>{labels?.aiShort}</span>
            {decision ? (
              <span class="votechip" data-v={decision.rost} title={labels?.ai}>{voteLabels[decision.rost] ?? decision.rost}</span>
            ) : (
              <span class="muted" title={labels?.ai}>–</span>
            )}
            <span class="tag" title={labels?.actual}>{labels?.actualShort}</span>
            {act ? (
              <span class="votechip" data-v={act} title={labels?.actual}>{voteLabels[act] ?? act}</span>
            ) : (
              <span class="muted" title={labels?.actual}>–</span>
            )}
          </span>
          {decision && comparable && (
            <span class={isMatch ? 'match' : 'mismatch'} title={isMatch ? labels?.match : labels?.mismatch}>
              <span aria-hidden="true">{isMatch ? '✓' : '✕'}</span>
              {labels && <span class="srtext">{isMatch ? labels.match : labels.mismatch}</span>}
            </span>
          )}
        </div>
      );
    })}
  </div>}

  <figcaption class="muted">
    {Object.entries(VOTE_COLORS).map(([v, c]) => (
      <span class="legend"><span class="swatch" style={`background:${c}`} />{voteLabels[v] ?? v}</span>
    ))}
  </figcaption>
</figure>

<style>
  .hemicycle svg { width: 100%; height: auto; display: block; }
  .ai-row {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .ai-badge {
    background: #fff; border: 1px solid var(--line); border-radius: 6px;
    padding: 0.3rem 0.4rem; text-align: center; font-size: 0.85rem;
    display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
  }
  .ai-head { margin: 1.1rem 0 0.2rem; font-size: 1.05rem; text-align: center; }
  .ai-note { margin: 0 auto; max-width: 60ch; font-size: 0.86rem; line-height: 1.5; text-align: center; }
  .ai-key {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem 1.1rem;
    margin: 0.7rem 0 0.35rem; font-size: 0.82rem;
  }
  .ai-key-item { white-space: nowrap; }
  .ai-badge .code { font-weight: 700; }
  .srtext {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  /* two labelled rows: who voted, then how. The tag is the same element in the
     key line above, so the reader learns it once. */
  .ai-badge .rows {
    display: grid; grid-template-columns: auto auto; gap: 0.2rem 0.3rem;
    align-items: center; justify-items: start; margin: 0.1rem 0;
  }
  .tag {
    display: inline-block; min-width: 2.1em; padding: 0 0.3em; border-radius: 3px;
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--ink-2); background: var(--panel-2); border: 1px solid var(--line);
    text-align: center; line-height: 1.5;
  }
  figcaption { font-size: 0.8rem; margin-top: 0.6rem; text-align: center; }
  .legend { margin: 0 0.5rem; white-space: nowrap; }
  .swatch {
    display: inline-block; width: 0.75em; height: 0.75em;
    border-radius: 50%; margin-right: 0.3em;
    box-shadow: inset 0 0 0 1px rgb(23 34 44 / 0.18);
  }
  @media (max-width: 640px) {
    .ai-row { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<style is:global>
  /* appended to <body> by the script below, so it cannot use scoped styles */
  .seat-tip {
    position: fixed; z-index: 50; pointer-events: none; max-width: 18rem;
    background: #14202b; color: #fff; font-size: 0.78rem; line-height: 1.35;
    padding: 0.3rem 0.5rem; border-radius: 4px; box-shadow: 0 2px 8px rgb(0 0 0 / 0.2);
  }
</style>

<script>
  // Seat tooltips: "Namn (P), Valkrets: Ja ⚠", the text the per-seat <title>
  // used to carry. Names come from the shared roster, fetched once on first hover.
  type Member = [string, string, string];
  let roster: Promise<Member[]> | null = null;
  const tip = document.createElement('div');
  tip.className = 'seat-tip';
  tip.setAttribute('role', 'tooltip');
  tip.hidden = true;
  document.body.append(tip);

  function place(x: number, y: number) {
    const pad = 12;
    const left = Math.min(x + pad, window.innerWidth - tip.offsetWidth - 4);
    const top = y + pad + tip.offsetHeight > window.innerHeight ? y - tip.offsetHeight - pad : y + pad;
    tip.style.left = `${Math.max(4, left)}px`;
    tip.style.top = `${Math.max(4, top)}px`;
  }

  for (const svg of document.querySelectorAll<SVGSVGElement>('svg[data-seats]')) {
    const codes = (svg.dataset.seats ?? '').split(',');
    const labels: Record<string, string> = JSON.parse(svg.dataset.vl ?? '{}');
    const seatEls = [...svg.querySelectorAll('circle.seat')];
    const load = () => (roster ??= fetch(svg.dataset.roster ?? '').then((r) => r.json()));
    let current: Element | null = null;

    const hide = () => {
      current = null;
      tip.hidden = true;
    };
    const show = async (target: EventTarget | null, x: number, y: number) => {
      const i = target instanceof Element ? seatEls.indexOf(target) : -1;
      const m = i < 0 ? null : /^(\d*)([JNAF])(!?)$/.exec(codes[i] ?? '');
      if (!m) return hide();
      current = target as Element;
      let who = '';
      if (m[1]) {
        try {
          const member = (await load())[Number(m[1])];
          if (member) who = `${member[0]} (${member[1]}), ${member[2]}: `;
        } catch {
          // roster unavailable: the vote alone is still worth showing
        }
      }
      if (current !== target) return; // the pointer moved on while the roster loaded
      tip.textContent = `${who}${labels[m[2]] ?? ''}${m[3] ? ' ⚠' : ''}`;
      tip.hidden = false;
      place(x, y);
    };

    svg.addEventListener('pointerover', (e) => void show(e.target, e.clientX, e.clientY));
    svg.addEventListener('pointermove', (e) => {
      if (!tip.hidden) place(e.clientX, e.clientY);
    });
    // a touch "leaves" the moment the finger lifts, which would close the tip
    // it just opened — touch tooltips close on the next tap elsewhere instead
    svg.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'touch') hide();
    });
  }
  document.addEventListener('pointerdown', (e) => {
    if (!(e.target instanceof Element) || !e.target.closest('svg[data-seats]')) tip.hidden = true;
  });
</script>
